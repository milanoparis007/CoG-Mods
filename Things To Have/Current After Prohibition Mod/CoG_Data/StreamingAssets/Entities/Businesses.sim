			playerModules { size [ tag-size-small tag-size-medium ] verticals [ tag-vert-booze ] }
		}
	}	
	{
		ident { template biz-drugstore-small-source parent biz-drugstore-small-base }
		biz {
			type com popneeded 16000 movesinto com-small-store-one
			reqsToInstall [ { #type check-current-city is none of [ detroit pittsburgh ] } ]
			modulesInBuilding [ inventory-basement-small flavor-drugs [ source-neutral-alcohol ] ]
		}
	}
	{
		ident { template biz-drugstore-small-source-a parent biz-drugstore-small-source }
		biz { movesinto com-small-store-two }
	}
