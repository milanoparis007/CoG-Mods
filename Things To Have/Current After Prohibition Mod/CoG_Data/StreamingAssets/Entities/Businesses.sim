			playerTakeoverCost { value  2500 mods [
					{ #type law-mod laws [ real-estate-taxes ] enacted true }
					{ #type same-ethnicity-at-node-mod multiplier 0.9 }
					{ #type controlled-biz-mod perbiz 5 skip 25 }
					{ #type law-mod laws [ business-grants ] enacted true }
					{ #type crew-peep-role-test-mod is any of [ deal-maker ] multiplier 0.75 }
					{ #type traits-mod-on-crew-peep if [ trait-friendly ] multiplier 0.9 }
					{ #type traits-mod-on-crew-peep if [ trait-irritable ] multiplier 1.1 }
					{ #type skills-mod if [ starter-buildings ] multiplier 0.8 }
				] }
		}
	}
