{ entities [

	{
		ident { template biz-base }
		biz { 
			emptyImage "BG Empty Back"
		}
	}
	
	
	;; if no partent or template name ends in "-base", the check for move-ins and other businesss logic checks gets skipped.

	;; commercial
	{
		ident { template biz-small-base parent biz-base }
		biz {
			playerTakeoverCost { value  750 mods [
					{ #type law-mod laws [ real-estate-taxes ] enacted true }
					{ #type same-ethnicity-at-node-mod multiplier 0.9 }
					{ #type controlled-biz-mod perbiz 5 skip 25 }
					{ #type law-mod laws [ business-grants ] enacted true }
					{ #type crew-peep-role-test-mod is any of [ deal-maker ] multiplier 0.75 }
					{ #type traits-mod-on-crew-peep if [ trait-friendly ] multiplier 0.9 }
					{ #type traits-mod-on-crew-peep if [ trait-irritable ] multiplier 1.1 }
					{ #type skills-mod if [ starter-buildings ] multiplier 0.8 }
				] }
		}
	}
	{
		ident { template biz-medium-base parent biz-base }
		biz {
			playerTakeoverCost { value  1500 mods [
					{ #type law-mod laws [ real-estate-taxes ] enacted true }
					{ #type same-ethnicity-at-node-mod multiplier 0.9 }
					{ #type controlled-biz-mod perbiz 5 skip 25 }
					{ #type law-mod laws [ business-grants ] enacted true }
					{ #type crew-peep-role-test-mod is any of [ deal-maker ] multiplier 0.75 }
					{ #type traits-mod-on-crew-peep if [ trait-friendly ] multiplier 0.9 }
					{ #type traits-mod-on-crew-peep if [ trait-irritable ] multiplier 1.1 }
					{ #type skills-mod if [ starter-buildings ] multiplier 0.8 }
				] }
		}
	}
	{
		ident { template biz-large-base parent biz-base }
		biz {
			playerTakeoverCost { value  2500 mods [
					{ #type law-mod laws [ real-estate-taxes ] enacted true }
					{ #type same-ethnicity-at-node-mod multiplier 0.9 }
					{ #type controlled-biz-mod perbiz 5 skip 25 }
					{ #type law-mod laws [ business-grants ] enacted true }
					{ #type crew-peep-role-test-mod is any of [ deal-maker ] multiplier 0.75 }
					{ #type traits-mod-on-crew-peep if [ trait-friendly ] multiplier 0.9 }
					{ #type traits-mod-on-crew-peep if [ trait-irritable ] multiplier 1.1 }
					{ #type skills-mod if [ starter-buildings ] multiplier 0.8 }
				] }
		}
	}
	{ 
		ident { template biz-poolhall-base parent biz-small-base }
		biz {
			icon "building.biz-poolhall.icon"
			locname "building.biz-poolhall.locname"
			locdesc "building.biz-poolhall.locdesc"
			bizname "building.biz-poolhall.bizname"
			emptyImage "BG Commercial Backroom"

			playerModules { size [ tag-size-small tag-size-medium ] verticals [ tag-vert-booze ] }
		}
	}
	{ 
		ident { template biz-poolhall parent biz-poolhall-base }
		biz {
			type com popneeded 4000 movesinto com-medium-amusements
			reqsToInstall [ { #type check-current-city is none of [ pittsburgh detroit atlantic-city philadelphia ] } ]

			modulesInBuilding [ inventory-basement-medium tobacconist-small [ bootlegger-homebooze-a bootlegger-homebooze-b bootlegger-homebooze-c bootlegger-homebooze-d ] ]
		}
	}
	{
		ident { template biz-poolhall-pittsburgh parent biz-poolhall }
		biz {
			reqsToInstall [ { #type check-current-city is any of [ pittsburgh ] } ]
			modulesInBuilding [ inventory-basement-medium tobacconist-small [ bootlegger-homebooze-a bootlegger-homebooze-d bootlegger-homebooze-e bootlegger-homebooze-f bootlegger-homebooze-b ] ]
		}
	}
	{
		ident { template biz-poolhall-detroit parent biz-poolhall }
		biz {
			reqsToInstall [ { #type check-current-city is any of [ detroit ] } ]
			reqsToAttachToBuilding [ { #type check-location-district-tags has none of [ canada canada-two ] } ]
			modulesInBuilding [ inventory-basement-medium tobacconist-small [ bootlegger-homebooze-a bootlegger-homebooze-d bootlegger-homebooze-b bootlegger-homebooze-g bootlegger-homebooze-h ] ]
		}
	}
	{
		ident { template biz-poolhall-philadelphia parent biz-poolhall }
		biz {
			reqsToInstall [ { #type check-current-city is any of [ philadelphia ] } ]
			modulesInBuilding [ inventory-basement-medium tobacconist-small [ bootlegger-homebooze-a bootlegger-homebooze-d bootlegger-homebooze-b bootlegger-homebooze-i bootlegger-homebooze-j ] ]
		}
	}
	{
		ident { template biz-poolhall-atlantic-city parent biz-poolhall }
		biz {
			reqsToInstall [ { #type check-current-city is any of [ atlantic-city ] } ]
			modulesInBuilding [ inventory-basement-medium tobacconist-small [ bootlegger-homebooze-a-atlantic-city bootlegger-homebooze-b-atlantic-city bootlegger-homebooze-c-atlantic-city bootlegger-homebooze-d-atlantic-city ] ]
		}
	}
	{
		ident { template biz-poolhall-hi-capacity parent biz-poolhall }
		biz {
			reqsToInstall [ { #type check-current-city is none of [ pittsburgh detroit atlantic-city ] } ]
			popneeded 12000
			modulesInBuilding [ inventory-basement-medium tobacconist-small [ bootlegger-homebooze-a-large bootlegger-homebooze-b-large bootlegger-homebooze-c-large bootlegger-homebooze-d-large ] ]
		}
	}
	{
		ident { template biz-poolhall-hi-capacity-pittsburgh parent biz-poolhall-hi-capacity }
		biz {
			reqsToInstall [ { #type check-current-city is any of [ pittsburgh ] } ]
			modulesInBuilding [ inventory-basement-medium tobacconist-small [ bootlegger-homebooze-a-large bootlegger-homebooze-d-large bootlegger-homebooze-e-large bootlegger-homebooze-f-large bootlegger-homebooze-b-large ] ]
		}
	}
	{
		ident { template biz-poolhall-hi-capacity-detroit parent biz-poolhall-hi-capacity }
		biz {
			reqsToInstall [ { #type check-current-city is any of [ detroit ] } ]
			reqsToAttachToBuilding [ { #type check-location-district-tags has none of [ canada canada-two ] } ]
			modulesInBuilding [ inventory-basement-medium tobacconist-small [ bootlegger-homebooze-a-large bootlegger-homebooze-d-large bootlegger-homebooze-b-large bootlegger-homebooze-g-large bootlegger-homebooze-h-large ] ]
		}
	}
	{
		ident { template biz-poolhall-canada parent biz-poolhall-detroit }
		biz {
			reqsToAttachToBuilding [ { #type check-location-district-tags has any of [ canada canada-two ] } ]
			modulesInBuilding [ inventory-basement-medium tobacconist-small [ canada-homebooze-one canada-homebooze-two canada-homebooze-three canada-homebooze-four canada-homebooze-five ] ]
			popneeded 2000
		}
	}
	{
		ident { template biz-poolhall-hi-capacity-philadelphia parent biz-poolhall-hi-capacity }
		biz {
			reqsToInstall [ { #type check-current-city is any of [ philadelphia ] } ]
			modulesInBuilding [ inventory-basement-medium tobacconist-small [ bootlegger-homebooze-a-large bootlegger-homebooze-d-large bootlegger-homebooze-b-large bootlegger-homebooze-i-large bootlegger-homebooze-j-large ] ]
		}
	}
	{	ident { template biz-poolhall-hi-capacity-atlantic-city parent biz-poolhall-hi-capacity }
		biz {
			reqsToInstall [ { #type check-current-city is any of [ atlantic-city ] } ]
			modulesInBuilding [ inventory-basement-medium tobacconist-small [ bootlegger-homebooze-a-large-atlantic-city bootlegger-homebooze-b-large-atlantic-city bootlegger-homebooze-c-large-atlantic-city bootlegger-homebooze-d-large-atlantic-city ] ]
		}
	}
	{
		ident { template biz-poolhall-hi-capacity-atlantic-city-boardwalk parent biz-poolhall-hi-capacity-atlantic-city }
		biz { movesinto com-medium-boardwalk-one }
	}
	{
		ident { template biz-poolhall-canada-a parent biz-poolhall-canada }
		biz { movesinto com-medium-store-one }
	}
	{
		ident { template biz-poolhall-starter parent biz-poolhall }
		biz {
			reqsToInstall [ { #type check-current-city is any of [ detroit ] } ]
			reqsToAttachToBuilding [ { #type check-location-district-tags has none of [ canada canada-two ] } ]
			modulesInBuilding [ inventory-basement-medium player-legal-barber ]
			type com popneeded 250000 movesinto com-medium-store-one
			skilltrack [ skilltrack-homebooze-fruit-wine skilltrack-homebooze-moonshine ]
			starterPack { 
				crew {
					cash 350
					resources { weapon-bat 1 }
				}
				building {
					cash 100
					resources { half-barrels 8 fruit-wine 60 cider 25 home-brew 40 }
				}
			}
		}
	}
	{
		ident { template biz-poolhall-starter-b parent biz-poolhall-starter }
		biz { movesinto com-medium-store-two }
	}

	{ 
		ident { template biz-supperclub-base parent biz-medium-base }
		biz {
			icon "building.biz-supperclub.icon"
			locname "building.biz-supperclub.locname"
			locdesc "building.biz-supperclub.locdesc"
			bizname "building.biz-supperclub.bizname"
			emptyImage "BG Commercial Backroom"

			playerModules { size [ tag-size-small tag-size-medium ] verticals [ tag-vert-booze ] }
		}
	}
	{ 
	 	ident { template biz-supperclub parent biz-supperclub-base }
	 	biz {
	 		type com popneeded 15000 movesinto com-medium-restaurant-two
	 		reqsToInstall [ { #type check-current-city is none of [ cincinnati detroit atlantic-city ] } ]
	 		reqsToAttachToBuilding [ { #type check-location-district-tags has none of [ canada canada-two ] } ]
	 		modulesInBuilding [ inventory-basement-medium flavor-restaurant-large supper-club-npc ]
	 	}
	}
	{
		ident { template biz-supperclub-downtown parent biz-supperclub }
		biz { movesinto downtown-medium-commercial }
	}
	{
		ident { template biz-supperclub-cincinnati parent biz-supperclub }
		biz {
			reqsToInstall [ { #type check-current-city is any of [ cincinnati ] } ]
	 		modulesInBuilding [ inventory-basement-medium flavor-restaurant-large supper-club-npc-cincinnati ]
		}
	}
	{
		ident { template biz-supperclub-cincinnati-downtown parent biz-supperclub-cincinnati }
		biz { movesinto downtown-medium-commercial }
	}
	{
		ident { template biz-supperclub-detroit parent biz-supperclub }
		biz {
			reqsToInstall [ { #type check-current-city is any of [ detroit ] } ]
	 		modulesInBuilding [ inventory-basement-medium flavor-restaurant-large supper-club-npc-detroit ]
		}
	}
	{
		ident { template biz-supperclub-detroit-canada parent biz-supperclub-detroit }
		biz {
			reqsToInstall [ { #type check-current-city is any of [ detroit ] } ]
			reqsToAttachToBuilding [ { #type check-location-district-tags has any of [ canada canada-two ] } ]
	 		modulesInBuilding [ inventory-basement-medium flavor-restaurant-large ]
		}
	}
	{
		ident { template biz-supperclub-detroit-downtown parent biz-supperclub-detroit }
		biz { movesinto downtown-medium-commercial }
	}

	;; BOARDWALK TEST
	{
		ident { template biz-boardwalk-test-small parent biz-drugstore-small-source }
		biz { movesinto com-small-boardwalk-one }
	}
	{
