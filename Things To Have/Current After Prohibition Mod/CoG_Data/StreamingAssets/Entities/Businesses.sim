			icon "building.biz-warehouse-medium.icon"
			locname "building.biz-wholesale.locname"
			locdesc "building.biz-wholesale.locdesc"
			bizname "building.biz-wholesale.bizname"
			emptyImage "BG Industrial Backroom"

			playerModules { size [ tag-size-small tag-size-medium tag-size-large ] verticals [ tag-vert-booze tag-vert-cars tag-vert-gambling ] }
		}
	}
	{
		ident { template biz-wholesale parent biz-wholesale-base }
		biz {
			type ind popneeded 8000 movesinto ind-med-deliver

			modulesInBuilding [ inventory-warehouse-xlarge source-wholesale ]
