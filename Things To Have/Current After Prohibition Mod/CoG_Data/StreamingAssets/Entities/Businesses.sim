	{
		ident { template biz-grocery-starter parent biz-grocery-small-base }
		biz {
			type com popneeded 250000 movesinto com-small-store-two

			reqsToInstall [ { #type check-current-city is none of [ pittsburgh ] } ]

			reqsToAttachToBuilding [ { #type check-location-district-tags has none of [ kentucky canada canada-two ] } ]
			modulesInBuilding [ inventory-basement-small player-legal-cigarette-distro ]
			skilltrack [ skilltrack-homebooze-cider ]

			starterPack { 
				crew {
					cash 350
					resources { weapon-bat 1 }
				}
				building {
					cash 100
					resources { lumber 4 cider 80 brick-wine 15 home-brew 15 }
				}
			}
		}
	}
