			playerModules { size [ tag-size-small tag-size-medium tag-size-large ] verticals [ tag-vert-booze tag-vert-cars tag-vert-gambling ] }
		}
	}
	{
		ident { template biz-wholesalewarehouse parent biz-wholesalewarehouse-base }
		biz {
			type ind popneeded 10000 movesinto ind-medium-factory
			modulesInBuilding [ inventory-warehouse-xlarge flavor-bank ]
		}
	}
	{
		ident { template biz-wholesalewarehouse-a parent biz-wholesalewarehouse }
		biz { movesinto ind-med-deliver }
	}

	;; --- 담배 판매원 (Cigarette Distributor) ---
	{
		ident { template biz-cigarettedistro-base parent biz-small-base }
		biz {
			icon "building.biz-cigarettedistro.icon"
			locname "building.biz-cigarettedistro.locname"
			locdesc "building.biz-cigarettedistro.locdesc"
			bizname "building.biz-cigarettedistro.bizname"
			emptyImage "BG Commercial Backroom"
			playerModules { size [ tag-size-small tag-size-medium ] verticals [ tag-vert-booze ] }
		}
	}
	{
		ident { template biz-cigarettedistro parent biz-cigarettedistro-base }
		biz {
			type com popneeded 5000 movesinto com-small-store-two
			modulesInBuilding [ inventory-basement-small tobacconist-small ]
		}
	}
	{
		ident { template biz-cigarettedistro-a parent biz-cigarettedistro }
		biz { movesinto com-small-store-one }
	}

] }
