	{
		ident { template biz-deli-consumer parent biz-deli-base }
		biz {
			type com popneeded 4000 movesinto com-small-store-two
			reqsToInstall [ { #type check-current-city is none of [ pittsburgh detroit atlantic-city philadelphia ] } ]

			modulesInBuilding [ inventory-basement-small flavor-deli [ bootlegger-homebooze-a bootlegger-homebooze-b bootlegger-homebooze-c bootlegger-homebooze-d ] ]

			playerTakeoverCost { value  1000 mods [
					{ #type law-mod laws [ real-estate-taxes ] enacted true }
					{ #type same-ethnicity-at-node-mod multiplier 0.9 }
					{ #type territory-size-mod pernode 25 skip 15 }
					{ #type controlled-biz-mod perbiz 250 skip 1 }
					{ #type law-mod laws [ business-grants ] enacted true }
					{ #type crew-peep-role-test-mod is any of [ deal-maker ] multiplier 0.75 }
					{ #type traits-mod-on-crew-peep if [ trait-friendly ] multiplier 0.9 }
					{ #type traits-mod-on-crew-peep if [ trait-irritable ] multiplier 1.1 }
					{ #type skills-mod if [ starter-buildings ] multiplier 0.8 }
				] }
		}
	}
