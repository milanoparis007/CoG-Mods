	{
		ident { template biz-restaurant-base parent biz-medium-base }
		biz {
			icon "building.biz-restaurant.icon"
			locname "building.biz-restaurant.locname"
			locdesc "building.biz-restaurant.locdesc"
			bizname "building.biz-restaurant.bizname"
			emptyImage "BG Commercial Backroom"

			playerModules { size [ tag-size-small tag-size-medium ] verticals [ tag-vert-booze ] }			
		}
	}
	{
		ident { template biz-restaurant parent biz-restaurant-base }
		biz {
			type com popneeded 10000 movesinto com-medium-restaurant-two
			reqsToInstall [ { #type check-current-city is none of [ pittsburgh atlantic-city new-york ] } ]
			reqsToAttachToBuilding [ { #type check-location-district-tags has none of [ canada canada-two ] } ]

			modulesInBuilding [ inventory-basement-medium flavor-restaurant-medium [ small-speakeasy-NPC-a small-speakeasy-NPC-b small-speakeasy-NPC-c small-speakeasy-NPC-d ] ]	
		}
