		biz {
			reqsToInstall [ { #type check-current-city is any of [ new-york ] } ]
			popneeded 35000
			movesinto com-small-store-one type com
			modulesInBuilding [ inventory-warehouse-small player-legal-florist ]
			skilltrack [ skilltrack-homebooze-moonshine-new-york ]
			starterPack { 
				crew {
					cash 350
					resources { weapon-bat 1 }
				}
				building {
					cash 100
					resources { steel-barrels 2 home-brew 40 moonshine 60 cider 20 lumber 4 }
				}
			}
		}
	}
