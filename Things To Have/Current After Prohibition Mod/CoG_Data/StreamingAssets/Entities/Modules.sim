			visreqs [
			{ #type check-laws has any of [ prohibition ] active #true }
			{ #type check-ethnicity is player oneof [ pl ] }
			]
			reqs [
			{ #type check-player-skills has any of [ local-speakeasies ] }
 			{ #type check-backroom-in-convo empty #true }
			]
			display {
				icon "Module Icon Corner Speakeasy"
				locicon	"module.icons.corner-speakeasy"
				operationSprite "Operation Corner Speakeasy"
				locname "module.bootlegger-home-brew-poitinseller.name"
