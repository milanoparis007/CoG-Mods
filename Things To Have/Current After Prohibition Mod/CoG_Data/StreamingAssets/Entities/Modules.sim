{	ident { template backroomgrifter parent supper-club-group }
	defmodule { def {
		id backroomgrifter			#type consumer-module-config
		common {
			tags [ tag-biz-back ]
			upgradetag tag-upgrade-supper-club
			visreqs [
			]
			reqs [
			{ #type check-player-skills has any of [ moneylaundering ] }
			]
			display {
				icon "Module Icon Hardware"
				operationSprite "Hardware"
				locname "module.bootlegger-home-brew-backroomgrifter.name"
				locdesc "module.bootlegger-home-brew-backroomgrifter.desc"
				locInstallDetail "module.bootlegger-home-brew-backroomgrifter.details"
				locintroflavor "convo.ticket-intro-flavor.module.supper-club-group"
				locicon "module.icons.counterfeithideout"
			}
			purchase {
				size [ tag-size-small tag-size-medium ]
				verticals [ tag-vert-booze ]
				buildTurns { value 2 }
				cashCost { cash -1200 }
				consume [ { id streetcredit qty -10 } { id lumber qty -10 } ]
			}
		}
		sink {
			locdesc "recipe.backroomgrifter"
			locScopeOut "recipe.scopeout.illegal-consume-booze-small"
			locFlavorDesc "recipe.flavorcopy.backroomgrifter"

			refill [ { id counterfeitcash below 600 get 500 } { id stolenelectronics below 60 get 50 } { id electronics below 60 get 50 } ]
			
			consumeDayz 35
