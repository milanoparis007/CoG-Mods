;;
;; explanation modules

{
	ident { template explanation-inventory-improved parent module-base }
	defmodule { def {
		id explanation-inventory-improved	#type explanation-module-config
		common {
			tags [ tag-biz-back ]
			visreqs [ { #type always-false } ]
			display {
				icon "Module Storage General"
				locname "module.explanation-inventory-improved.name"
				locdesc "module.explanation-inventory-improved.desc"
				locInstallDetail "module.explanation-inventory-improved.desc"
				operationSprite "BG Industrial Basement"
			}
		}
} } }


;;
;; vehicle modules

;; player-built vehicle modules

{
	ident { template player-garage-base parent module-base }
	defmodule { def {
		id player-garage-base		#type vehicle-module-config
		common {
			tags [ tag-vehicle-module tag-biz-back ]
			visreqs [ { #type always-false } ]
			display {
				icon "Module Garage Small"
			}
			purchase {
				size [ tag-size-small tag-size-medium ]
				verticals [ tag-vert-cars tag-vert-booze ]
				cashCost { cash -5 }
				buildTurns { value 1 }
			}
		}
		repairInfo {
			fullHealPrice { value -50 mods [ { #type skills-mod if [ starter-vehicles ] multiplier 0.8 } ] }
		}
} } }

{	ident { template player-garage-module-small parent player-garage-base } 
	defmodule { def {
		id player-garage-module-small 	#type vehicle-module-config
		common {
			visreqs [ { #type check-player-skills has any of [ small-garages ] } ]
			reqs [ { #type check-player-skills has any of [ small-garages ] } ]
			upgradetag tag-upgrade-garage
			display { 
				locname "module.player-garage-module-small.name" 
				locdesc "module.player-garage-module-small.desc" 
				locInstallDetail "module.player-garage-module-small.details"
				operationSprite "Small Mechanic"
			}
			purchase {
				cashCost { cash -250 }
				buildTurns { value 4 }
				consume [{ id bricks qty -5 } { id sheet-metal qty -2 } ]
			}			
		}
		playerInfo {
			carCapDelta { value 1 mods [
				;{ #type interesting-biz-at-node-mod perbiz 1 }
			] }
			truckCapDelta { value 2 }
		}
} } }

{ ident { template player-garage-module-medium parent player-garage-module-small }
	defmodule { def {
		id player-garage-module-medium		#type vehicle-module-config
		common {
			visreqs [
				{ #type check-module-in-convo has all of [ player-garage-module-small ] } 
			]
			reqs [ 
				{ #type check-player-territory-size is atleast value 10 }
			]
			display {
				locname "module.player-garage-module-medium.name"
				locdesc "module.player-garage-module-medium.desc"
				locInstallDetail "module.player-garage-module-medium.details"
			}
			purchase {
				cashCost { cash -500 }
				buildTurns { value 5 }
				consume [ { id bricks qty -8 } { id sheet-metal qty -4 } ]
			}
		}
		playerInfo {
			carCapDelta { value 3 }
			truckCapDelta { value 4 }
		}
} } }

{ ident { template player-truck-garage-small parent player-garage-base }
	defmodule { def {
		id player-truck-garage-small		#type vehicle-module-config
		common {
			visreqs [
				{ #type check-player-skills has all of [ delivery-driving ] }
			]
			reqs [
				{ #type check-player-crew-size is atleast value 3 }
				{ #type check-player-skills has all of [ delivery-driving ] }
				{ #type check-player-skills has any of [ truck-garage-brick-wine truck-garage-cider truck-garage-home-brew truck-garage-moonshine ] }
			]
			upgradetag tag-upgrade-truck-garage
			display {
				locname "module.player-truck-garage-small.name"
				locdesc "module.player-truck-garage-small.desc"
				locInstallDetail "module.player-truck-garage-small.details"
				operationSprite "Large Mechanic"
			}
			purchase {
				cashCost { cash -750 }
				buildTurns { value 4 }
				consume [ { id bricks qty -6 } { id sheet-metal qty -4 } ]
			}
		}
		playerInfo {
			truckCapDelta { value 4 }
		}
} } }
{ ident { template player-truck-garage-improved	parent player-garage-base }
	defmodule { def {
		id player-truck-garage-improved		#type vehicle-module-config
		common {
			upgradetag tag-upgrade-truck-garage
			visreqs [
				{ #type check-module-in-convo has all of [ player-truck-garage-small ] }
			]
			reqs [
				{ #type check-player-skills has all of [ truck-garage-improved ] }
			]
			display {
				locname "module.player-truck-garage-improved.name"
				locdesc "module.player-truck-garage-improved.desc"
				locInstallDetail "module.player-truck-garage-improved.details"
				operationSprite "Large Mechanic"
			}
			purchase {
				cashCost { cash -1750 }
				buildTurns { value 4 }
				consume [ {  id bricks qty -12 } { id sheet-metal qty -6 } { id lumber qty -6 } ]
			}
		}
		playerInfo { 
			truckCapDelta { value 5 }
		}
} } }

;; NPC vehicle modules

{	ident { template vehicle-base-NPCs parent module-base }
	defmodule { def {
		id vehicle-base-NPCs			#type vehicle-module-config
		common {
			skills [ tag-skills-moonshine tag-skills-brick-wine tag-skills-home-brew tag-skills-cider tag-skills-gambling-tables tag-skill-vehicles tag-skills-moneylaunderingmid tag-skills-mixed-drinks tag-skills-drug-distribution-low tag-skills-moneylaunderinghigh tag-skills-moneylaundering tag-skills-weapon-production tag-skills-advanced-weapon-production tag-skills-delivery-unlock tag-skills-gambling-numbers tag-skills-gambling-tables tag-skills-fancy-brothels tag-skills-drug-distribution tag-skills-drug-distribution-low  tag-skills-cannabis-production tag-skills-cannabis-packaging tag-skills-brothels tag-skills-loan-shark tag-skills-coca-production tag-skills-large-drug-distribution tag-skills-coca-packaging tag-skills-opium-production tag-skills-opium-packaging ]
			tags [ tag-vehicle-module tag-biz-back ]
			visreqs [ { #type always-false } ]
			display {
				icon "Module Garage Small"
			}
		}
		interesting #true
} } }

{	ident { template garage-small-car-repair parent vehicle-base-NPCs }
	defmodule { def {
		id garage-small-car-repair		#type vehicle-module-config
		common {
			display {
				locname "module.garage-small-car-repair.name"
				locdesc "module.garage-small-car-repair.desc"
				locInstallDetail "garage-small-car-repair.details"
				operationSprite "Small Mechanic"
			}
		}
		vehicleModuleLoc {
			locdesc "module.garage-small-car-repair.name"
			locScopeOut	"recipe.scopeout.garage-small-car-repair"
			locFlavorDesc "garage-small-car-repair.details"
		}
		repairInfo {
			fullHealPrice { value -200 mods [
				{ #type person-same-eth-as-human-mod delta 25 }
				{ #type crew-vehicle-template is equalto template vehicle-transit delta 160 }
				{ #type is-node-in-territory expected #true delta 25 }
				{ #type crew-vehicle-condition is equalto type junk multiplier 2 }
				{ #type skills-mod if [ starter-vehicles ] multiplier 0.8 }
			] }
		}		
} } }



{	ident { template car-dealer-used-car-lot parent vehicle-base-NPCs } 
	defmodule { def {
		id car-dealer-used-car-lot 	#type vehicle-module-config
		common {
			display { 
				locname "module.car-dealer-used-car-lot.name" 
				locdesc "module.car-dealer-used-car-lot.desc"
				operationSprite "Small Mechanic"
			}
		}
		vehicleModuleLoc {
			locdesc "module.car-dealer-used-car-lot.desc" 
			locScopeOut "recipe.scopeout.car-dealer-garage"
			locFlavorDesc "recipe.flavorcopy.car-dealer-garage"
		}
		sellInfo {
			vehicles [
				{
					entities [ vehicle-car ]
					visreqs [ { #type check-current-turn is lessorequalto value 730 } ]
					pricemods [
						{ #type skills-mod if [ car-bullies ] multiplier 0.4 }
						{ #type static-mod delta -50 }
						{ #type law-mod laws [ vehicle-tax ] enacted true }
					]
				}
				{
					entities [ vehicle-sports-car vehicle-sportsbenz vehicle-bulletproof-car ]
					visreqs [ { #type check-current-turn is lessorequalto value 730 } ]
					pricemods [
						{ #type skills-mod if [ car-bullies ] multiplier 0.8 }
						{ #type static-mod delta -50 }
						{ #type law-mod laws [ vehicle-tax ] enacted true }
					]
				}
				{
					entities [ vehicle-lseries ]
					visreqs [ { #type check-current-turn is lessorequalto value 1773 } { #type check-current-turn is moreorequalto value 680 } ]
					pricemods [
						{ #type skills-mod if [ car-bullies ] multiplier 0.4 }
						{ #type static-mod delta -50 }
						{ #type law-mod laws [ vehicle-tax ] enacted true }
					]
				}
				{
					entities [ vehicle-bmw327 vehicle-benz-ssk vehicle-jaguarm vehicle-bulletproof-independence ]
					visreqs [ { #type check-current-turn is lessorequalto value 1773 } { #type check-current-turn is moreorequalto value 680 } ]
					pricemods [
						{ #type skills-mod if [ car-bullies ] multiplier 0.8 }
						{ #type static-mod delta -50 }
						{ #type law-mod laws [ vehicle-tax ] enacted true }
					]
				}
				{
					entities [ vehicle-customline ]
					visreqs [ { #type check-current-turn is moreorequalto value 1773 } ]
					pricemods [
						{ #type skills-mod if [ car-bullies ] multiplier 0.4 }
						{ #type static-mod delta -50 }
						{ #type law-mod laws [ vehicle-tax ] enacted true }
					]
				}
				{
					entities [ vehicle-bmw vehicle-benz vehicle-jaguar vehicle-phantom vehicle-bulletproof-camino ]
					visreqs [ { #type check-current-turn is moreorequalto value 1773 } ]
					pricemods [
						{ #type skills-mod if [ car-bullies ] multiplier 0.8 }
						{ #type static-mod delta -50 }
						{ #type law-mod laws [ vehicle-tax ] enacted true }
					]
				}
			]
		}
		buyBackInfo {
			pricemods [
				{ #type static-mod multiplier 0.35 } ;; buy vehicles for half the price
			]
    		entities [ vehicle-transit vehicle-car vehicle-pickup-truck vehicle-dseries vehicle-bulletproof-truck vehicle-sedan vehicle-sports-car vehicle-sportsbenz vehicle-bulletproof-car vehicle-bulletproof-sports-car vehicle-lseries vehicle-independence vehicle-bmw327 vehicle-benz-ssk vehicle-jaguarm vehicle-bulletproof-independence vehicle-bulletproof-jaguar vehicle-lancer vehicle-customline vehicle-skylark vehicle-safari vehicle-camino vehicle-electra vehicle-phantom vehicle-bmw vehicle-benz vehicle-jaguar vehicle-bulletproof-camino vehicle-bulletproof-phantom ]
		}
		repairInfo {
			fullHealPrice { value -250 mods [
				{ #type person-same-eth-as-human-mod delta 25 }
				{ #type crew-vehicle-template is equalto template vehicle-transit delta 220 }
				{ #type is-node-in-territory expected #true delta 25 }
				{ #type crew-vehicle-condition is equalto type junk multiplier 2 }
				{ #type skills-mod if [ starter-vehicles ] multiplier 0.8 }
			] }
		}
} } }
