				locInstallDetail "module.bootlegger-home-brew-poitinseller.details"
				locintroflavor "convo.ticket-intro-flavor.module.supper-club-group"
			}
			purchase {
				size [ tag-size-small tag-size-medium ]
				verticals [ tag-vert-booze ]
				buildTurns { value 2 }
				cashCost { cash -2500 }
				consume [ { id liquor-license qty -1 } { id lumber qty -5 } { id furniture qty -10 } ]
			}
		}
