{	ident { template production-homebooze-moonshine parent production-homebooze-group } 
	defmodule { def {
		id production-homebooze-moonshine	#type manufacture-module-config
		common {
			tags [ tag-biz-back tag-biz-moonshine ]
			visreqs [ { #type check-laws has any of [ prohibition ] active #true } { #type check-current-city is none of [ cincinnati new-york ] } ]
			reqs [ { #type check-player-skills has any of [ homebooze-moonshine ] } ]
			skills [ tag-skills-speakeasy tag-skills-improved-moonshine ]
			upgradetag tag-upgrade-booze-track-four
			display {
				icon "Module Icon Moonshine"
				locicon	"module.icons.moonshine"
				locname "module.production-homebooze-moonshine.name"
				locdesc "module.production-homebooze-moonshine.desc"
				locInstallDetail "module.production-homebooze-moonshine.details"
				locintroflavor "convo.ticket-intro-flavor.module.production-homebooze-moonshine"
				accentSprite "Accent Moonshine"
				operationSprite "Operation Moonshine"
			}
			purchase {
				size [ tag-size-small ]
				verticals [ tag-vert-booze ]
				cashCost { cash -1000 }
				buildTurns { value 5 }
				consume [{ id lumber qty -4 } ]
			}
		}
		recipes [
			{
				locdesc "recipe.production-homebooze-moonshine"
				locScopeOut "recipe.scopeout.illegal-moonshine"
				produceConsumeDayz 28
				refill [ { id neutral-alcohol below 20 get 10 } { id crocks below 30 get 30 } ]
				consume [ { id neutral-alcohol qty -10 } { id crocks qty -25 } ]
				produce [ { id moonshine qty 25 } 
					;{ id bottles qty 15 } 
					]
				selloff [ { id moonshine above 45 sell -30 } 
					;{ id bottles above 30 sell -15 } 
					]
				mods {
					produceqty [ 
					]
				}
			}
			{
				locdesc "recipe.production-homebooze-moonshine"
				locScopeOut "recipe.scopeout.illegal-moonshine"

				visreqs [ { #type check-laws has any of [ prohibition ] active #true } { #type check-has-eth-pack-and-is-eth eth ir } ]

				produceConsumeDayz 28
				refill	[ { id sugar below 20 get 10 } { id barley below 12 get 6 } { id crocks below 30 get 30 } ]
				consume [ { id sugar qty -10 } { id barley qty -6 } { id crocks qty -30 } ]
				produce [ { id moonshine qty 30 } ]
				selloff [ { id moonshine above 50 sell -30 }]
			}

		]
		interesting #true
		locintroflavor "convo.ticket-intro-flavor.module.production-homebooze-moonshine"
	} } }
{ 	ident { template production-homebooze-moonshine-improved parent production-homebooze-moonshine }
