			consumeDayz 35
			consume [ { id cfood qty -20 } { id rfoodsupplies qty -20 } { id sugar qty -12 } { id spices qty -12 } { id food-dyes qty -8 } { id labels qty -12 } { id stretch qty -30 }
				{ id wheat qty -12 } { id herbs qty -12 } { id rye qty -12 } { id paper qty -5 } { id nuts qty -8 } { id neutral-alcohol qty -20 } { id malt qty -22 }
				{ id corn-syrup qty -12 } { id hops qty -12 } { id barley qty -12 } { id fruit-other qty -10 } { id grapes qty -10 }
				{ id citrus qty -8 } { id apples qty -16 } { id plums qty -10 } { id crocks qty -50 } { id apple-juice qty -8 }
				{ id grape-juice qty -8 } { id fruit-other qty -8 }
			]

			aoe {
				priceMarkup { value 1.1 }

				customerRadius 15
				respectRadius { value 14 }
				respectLockey "modulerespect.high"
				respectPointsInRadius {
					value 10
					mods [ { #type same-ethnicity-at-node-mod multiplier 25 } ]
				}
			}
		}
} } }

;; ?? ??? (Cigarette Distributor) - consumer ??
{	ident { template player-legal-cigarette-distro parent player-legal-biz-base }
	defmodule { def {
		id player-legal-cigarette-distro			#type consumer-module-config
		common {
			tags [ tag-biz-front tag-player-legal-biz ]
			upgradetag tag-upgrade-supper-club
			visreqs [
			]
			reqs [
			]
			display {
				icon "Module Cigarettes"
				locname "module.bootlegger-home-brew-cigarette-distro.name"
				locdesc "module.bootlegger-home-brew-cigarette-distro.desc"
				locInstallDetail "module.bootlegger-home-brew-cigarette-distro.details"
				locintroflavor "convo.ticket-intro-flavor.module.supper-club-group"
				operationSprite "Operation Printing Press"
				locicon "module.icons.cigdistro"
			}
			purchase {
				size [ tag-size-small tag-size-medium tag-size-large ]
				verticals [ tag-vert-booze ]
				buildTurns { value 2 }
				cashCost { cash -1000 }
				consume [ { id lumber qty -4 } ]
			}
		}
		sink {
			locdesc "recipe.cigarette-distro"
			locScopeOut "recipe.scopeout.illegal-consume-booze-small"
			locFlavorDesc "recipe.flavorcopy.cigarette-distro"

			refill [ { id cigarettes below 60 get 50 } ]

			consumeDayz 28
			consume [ { id cigarettes qty -500 } ]

			aoe {
				priceMarkup { value 1.1 }

				customerRadius 15
				respectRadius { value 12 }
				respectLockey "modulerespect.high"
				respectPointsInRadius {
					value 35
					mods [ { #type same-ethnicity-at-node-mod multiplier 25 } ]
				}
			}
		}
} } }

