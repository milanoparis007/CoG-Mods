				locdesc "module.supper-club-player.desc"
				locInstallDetail "module.supper-club-player.details"
				locintroflavor "convo.ticket-intro-flavor.module.supper-club-group"
				operationSprite "Supper Club"
				locicon "module.icons.supper-club"
			}
			purchase {
				size [ tag-size-small tag-size-medium ]
				verticals [ tag-vert-booze ]
				buildTurns { value 8 }
				cashCost { cash -10000 }
				consume [ { id liquor-license qty -5 } { id weapon-permit qty -1 } { id furniture qty -50 } ]
			}
		}
		sink {
			locdesc "recipe.supper-club-player"
			locScopeOut "recipe.scopeout.illegal-consume-booze-small"
			locFlavorDesc "recipe.supper-club-player"

			refill [ { id dirty-cash below 6000 get 5000 } { id counterfeitcash below 6000 get 5000 } { id bandlow below 60 get 50 } { id band below 60 get 50 } { id group-level-two below 60 get 50 } { id ethnic-alcohol below 60 get 50 needsEthPack #true } { id group-level-three below 60 get 60 } ]
			
			consumeDayz 58
			consume [ { id dirty-cash qty -5000 } { id counterfeitcash qty -1500 } { id bandlow qty -1 } { id band qty -1 } { id group-level-two qty -60 } { id ethnic-alcohol qty -50 needsEthPack #true } { id group-level-three qty -40 } ]

			aoe {
				priceMarkup { value 2.5 }

				customerRadius 30
				respectRadius { value 28 } ; mods [ ] }
				respectLockey "modulerespect.high"
				respectPointsInRadius {
					value 30
					mods [ { #type same-ethnicity-at-node-mod multiplier 25 } ]
				}
			}
		}
} } }
