{	ident { template player-legal-lawoffice parent player-legal-biz-base }
	defmodule { def {
		id player-legal-lawoffice			#type consumer-module-config
		common {
			tags [ tag-biz-front tag-player-legal-biz ]
			upgradetag tag-upgrade-legal-lawoffice
			visreqs [
				{ #type check-player-skills has any of [ moneylaunderingmid ] }
			]
			reqs [
				{ #type check-player-skills has any of [ moneylaunderinghigh ] }
			]
			display {
				icon "lawoffice"
				locname "module.player-legal-lawoffice.name"
				locdesc "module.player-legal-lawoffice.desc"
				locInstallDetail "module.player-legal-lawoffice.details"
				replacementSprite "Front Small Retail"
			}
			purchase {
				size [ tag-size-medium tag-size-large ]
				verticals [ tag-vert-booze tag-vert-cars tag-vert-gambling ]
				buildTurns { value 4 }
				cashCost { cash -30000 }
				consume [ { id lawyer qty -6 } { id furniture qty -15 } { id lumber qty -15 } { id bricks qty -20 } ]
			}
		}
		sink {
			locdesc "recipe.player-legal-lawoffice"
			locScopeOut "recipe.player-legal-lawoffice.scopeout"

			;; ?? ???: 28?? $30,000 ??, 20% ??
			;; dirty-cash ?? ? clean cash (priceMarkup 0.80) ??
			refill [ { id dirty-cash below 35000 get 30000 } ]

			consumeDayz 28
			consume [ { id dirty-cash qty -10000 } { id gold-bond qty -8 } ]

			aoe {
				priceMarkup { value 0.80 }
			}
		}
		interesting #true
} } }

