	;; homemade booze production

	;; group parent
{ ident { template production-homebooze-group parent module-base }
	defmodule { 
		levelups [  
			{ id levelup-builder is equalto value 1 target produce delta 1 }
			{ id levelup-management is equalto value 1 target consume multiplier 0.9 }
			{ id levelup-management is equalto value 2 target consume multiplier 0.8 }
			{ id levelup-management is equalto value 3 target consume multiplier 0.7 }
			{ id levelup-homemade-boozemaker is equalto value 1 target produceConsumeDays delta -7 }
			{ id levelup-homemade-boozemaker is equalto value 2 target produceConsumeDays delta -14 }
			{ id levelup-homemade-boozemaker is equalto value 3 target produceConsumeDays delta -21 } 
			{ id levelup-brick-wine-maker is equalto value 1 target produce multiplier 1.1 }
			{ id levelup-brick-wine-maker is equalto value 2 target produce multiplier 1.2 }
			{ id levelup-brick-wine-maker is equalto value 3 target produce multiplier 1.4 }
			{ id levelup-brick-wine-maker is equalto value 4 target produce multiplier 1.5 }
			{ id levelup-brick-wine-maker is equalto value 5 target produce multiplier 1.6 }
			{ id levelup-cider-maker is equalto value 1 target produce multiplier 1.1 }
			{ id levelup-cider-maker is equalto value 2 target produce multiplier 1.2 }
			{ id levelup-cider-maker is equalto value 3 target produce multiplier 1.4 }
			{ id levelup-cider-maker is equalto value 4 target produce multiplier 1.5 }
			{ id levelup-cider-maker is equalto value 5 target produce multiplier 1.6 }
			{ id levelup-home-brew-maker is equalto value 1 target produce multiplier 1.1 }
			{ id levelup-home-brew-maker is equalto value 2 target produce multiplier 1.2 }
			{ id levelup-home-brew-maker is equalto value 3 target produce multiplier 1.4 }
			{ id levelup-home-brew-maker is equalto value 4 target produce multiplier 1.5 }
			{ id levelup-home-brew-maker is equalto value 5 target produce multiplier 1.6 }
			{ id levelup-moonshine-maker is equalto value 1 target produce multiplier 1.1 }
			{ id levelup-moonshine-maker is equalto value 2 target produce multiplier 1.2 }
			{ id levelup-moonshine-maker is equalto value 3 target produce multiplier 1.4 }
			{ id levelup-moonshine-maker is equalto value 4 target produce multiplier 1.5 }
			{ id levelup-moonshine-maker is equalto value 5 target produce multiplier 1.6 }
			{ id levelup-apple-jack-maker is equalto value 1 target produce multiplier 1.1 }
			{ id levelup-apple-jack-maker is equalto value 2 target produce multiplier 1.2 }
			{ id levelup-apple-jack-maker is equalto value 3 target produce multiplier 1.4 }
			{ id levelup-apple-jack-maker is equalto value 4 target produce multiplier 1.5 }
			{ id levelup-apple-jack-maker is equalto value 5 target produce multiplier 1.6 }
			{ id levelup-fruit-wine-maker is equalto value 1 target produce multiplier 1.1 }
			{ id levelup-fruit-wine-maker is equalto value 2 target produce multiplier 1.2 }
			{ id levelup-fruit-wine-maker is equalto value 3 target produce multiplier 1.4 }
			{ id levelup-fruit-wine-maker is equalto value 4 target produce multiplier 1.5 }
			{ id levelup-fruit-wine-maker is equalto value 5 target produce multiplier 1.6 }
			{ id levelup-homemade-brandy-maker is equalto value 1 target produce multiplier 1.1 }
			{ id levelup-homemade-brandy-maker is equalto value 2 target produce multiplier 1.2 }
			{ id levelup-homemade-brandy-maker is equalto value 3 target produce multiplier 1.3 }
			{ id levelup-homemade-brandy-maker is equalto value 4 target produce multiplier 1.4 }
			{ id levelup-homemade-brandy-maker is equalto value 5 target produce multiplier 1.5 }
			{ id levelup-homemade-brandy-maker is equalto value 6 target produce multiplier 1.6 }
			{ id levelup-homemade-brandy-maker is equalto value 7 target produce multiplier 1.7 }
			{ id levelup-pot-still-master is equalto value 1 target produce multiplier 1.1 }
			{ id levelup-pot-still-master is equalto value 2 target produce multiplier 1.2 }
			{ id levelup-pot-still-master is equalto value 3 target produce multiplier 1.3 }
			{ id levelup-pot-still-master is equalto value 4 target produce multiplier 1.4 }
			{ id levelup-pot-still-master is equalto value 5 target produce multiplier 1.5 }
			{ id levelup-pot-still-master is equalto value 6 target produce multiplier 1.6 }
			{ id levelup-pot-still-master is equalto value 7 target produce multiplier 1.7 }
			{ id levelup-business is equalto value 1 target produceConsumeDays delta -7 }
			{ id levelup-business is equalto value 2 target produceConsumeDays delta -14 }
			{ id levelup-business is equalto value 3 target produceConsumeDays delta -14 } 
			{ id levelup-business is equalto value 4 target produceConsumeDays delta -21 } 
			{ id levelup-chemist is equalto value 1 target produceConsumeDays delta -7 } 
			{ id levelup-chemist is equalto value 2 target produceConsumeDays delta -14 } 
			{ id levelup-weaponcraft is equalto value 1 target produceConsumeDays delta -7 }
			{ id levelup-weaponcraft is equalto value 2 target produceConsumeDays delta -14 }
			{ id levelup-weaponcraft is equalto value 3 target produceConsumeDays delta -14 } 
			{ id levelup-weaponcraft is equalto value 4 target produceConsumeDays delta -21 }
			{ id levelup-grower is equalto value 1 target produceConsumeDays delta -7 } 
			{ id levelup-grower is equalto value 2 target produceConsumeDays delta -14 } 
			{ id levelup-grower is equalto value 3 target produceConsumeDays delta -21 }
			{ id levelup-film is equalto value 1 target produceConsumeDays delta -7 }
			{ id levelup-film is equalto value 2 target produceConsumeDays delta -14 }
			{ id levelup-film is equalto value 3 target produceConsumeDays delta -28 } 
			{ id levelup-film is equalto value 4 target produceConsumeDays delta -28 } 
			{ id levelup-film is equalto value 5 target produceConsumeDays delta -42 }
			{ id levelup-film is equalto value 6 target produceConsumeDays delta -56 }
			{ id levelup-film is equalto value 7 target produceConsumeDays delta -63 } 
			{ id levelup-film is equalto value 8 target produceConsumeDays delta -84 } 
			{ id levelup-music is equalto value 1 target produceConsumeDays delta -7 }
			{ id levelup-music is equalto value 2 target produceConsumeDays delta -14 }
			{ id levelup-music is equalto value 3 target produceConsumeDays delta -28 } 
			{ id levelup-music is equalto value 4 target produceConsumeDays delta -28 } 
			{ id levelup-music is equalto value 5 target produceConsumeDays delta -35 }
			{ id levelup-music is equalto value 6 target produceConsumeDays delta -42 }
			{ id levelup-music is equalto value 7 target produceConsumeDays delta -42 } 
			{ id levelup-music is equalto value 8 target produceConsumeDays delta -49 }
			{ id levelup-contract is equalto value 1 target produceConsumeDays delta -7 }
			{ id levelup-contract is equalto value 2 target produceConsumeDays delta -14 }
			{ id levelup-contract is equalto value 3 target produceConsumeDays delta -28 } 
			{ id levelup-contract is equalto value 4 target produceConsumeDays delta -28 } 
			{ id levelup-contract is equalto value 5 target produceConsumeDays delta -56 }
			{ id levelup-contract is equalto value 6 target produceConsumeDays delta -84 }
			{ id levelup-contract is equalto value 7 target produceConsumeDays delta -112 } 
			{ id levelup-contract is equalto value 8 target produceConsumeDays delta -133 }
			{ id levelup-dealer is equalto value 1 target produceConsumeDays delta -7 }
			{ id levelup-dealer is equalto value 2 target produceConsumeDays delta -14 }
			{ id levelup-dealer is equalto value 3 target produceConsumeDays delta -21 }
			{ id levelup-realtor is equalto value 1 target produceConsumeDays delta -14 }
			{ id levelup-realtor is equalto value 2 target produceConsumeDays delta -28 }
			{ id levelup-realtor is equalto value 3 target produceConsumeDays delta -35 }
			{ id levelup-packager is equalto value 1 target produce multiplier 1.05 }
			{ id levelup-packager is equalto value 2 target produce multiplier 1.1 }
		]
		expansions {
			maxcount { value 2 mods [ 
				{ #type manager-level-test-mod id levelup-builder is equalto value 1 delta 1 } 
				{ #type traits-mod-on-manager if [ trait-organized ] delta 1 }
				{ #type traits-mod-on-manager if [ trait-lazy ] delta -1 }
			] }
			configs [
			{
				id 		steam-sanitizer
				target	produce
				multiplier { value 1.1 }

				visreqs [ 
					{ #type check-module-in-convo has any of [ production-homebooze-brick-wine production-homebooze-cider production-homebooze-home-brew production-homebooze-moonshine production-homebooze-apple-jack-a production-homebooze-apple-jack-b production-homebooze-corn-moonshine production-homebooze-fruit-wine production-homebooze-homemade-brandy production-homebooze-rye-moonshine ] }
				]
				reqs [
					{ #type check-player-skills has all of [ crock-return ] }
					{ #type check-manager-assigned expected #true }
					;{ #type check-crew-peep-level id levelup-management is atleast value 1 }
				]

				display {
					locicon	"expansion.steam-sanitizer.icon"
					locname	"expansion.steam-sanitizer.name"
					locdesc	"expansion.steam-sanitizer.desc"
					locInstallDetail "expansion.steam-sanitizer.install"
				}

				purchase { cashCost { cash -300 } }
			}
			{
				id 		steam-sanitizer-upgraded
				target	produce
				multiplier { value 1.1 }

				visreqs [ 
					{ #type check-module-in-convo has any of [ 
						production-homebooze-brick-wine-improved production-homebooze-cider-improved production-homebooze-home-brew-improved production-homebooze-moonshine-improved
						production-homebooze-brick-wine-improved-upgrade production-homebooze-cider-improved-upgrade production-homebooze-home-brew-improved-upgrade production-homebooze-moonshine-improved-upgrade
						production-homebooze-apple-jack-improved production-homebooze-apple-jack-improved-upgrade
						production-homebooze-corn-moonshine-improved production-homebooze-corn-moonshine-improved-upgrade
						production-homebooze-fruit-wine-improved production-homebooze-fruit-wine-improved-upgrade
						production-homebooze-homemade-brandy-improved-upgrade
						production-homebooze-grain-moonshine production-homebooze-grain-moonshine-upgrade
					] }
				]
				reqs [
					{ #type check-player-skills has all of [ crock-return ] }
					{ #type check-manager-assigned expected #true }
				]

				display {
					locicon	"expansion.steam-sanitizer.icon"
					locname	"expansion.steam-sanitizer.name"
					locdesc	"expansion.steam-sanitizer.desc"
					locInstallDetail "expansion.steam-sanitizer.install"
				}

				purchase { cashCost { cash -600 } }
			}

			{
				id		industrial-filters
				target	consume
				multiplier	{ value 0.9 }

				visreqs [
					{ #type check-module-in-convo has any of [ production-homebooze-brick-wine production-homebooze-cider production-homebooze-home-brew production-homebooze-moonshine production-homebooze-apple-jack-a production-homebooze-apple-jack-b production-homebooze-corn-moonshine production-homebooze-fruit-wine production-homebooze-homemade-brandy production-homebooze-rye-moonshine ] }
					{ #type check-player-skills has any of [ industrial-filters ] }
				]
				reqs [
					{ #type check-manager-assigned expected #true }
					{ #type check-player-skills has any of [ industrial-filters ] }
				]
				display {
					locicon "expansion.industrial-filters.icon"
					locname "expansion.industrial-filters.name"
					locdesc "expansion.production-homebooze-group.industrial-filters.desc"
					locInstallDetail "expansion.industrial-filters.install"
				}
				purchase { cashCost { cash -400 } }
			}
			{
				id		industrial-filters-upgraded
				target	consume
				multiplier	{ value 0.9 }

				visreqs [
					{ #type check-module-in-convo has any of [ 
						production-homebooze-brick-wine-improved production-homebooze-cider-improved production-homebooze-home-brew-improved production-homebooze-moonshine-improved 
						production-homebooze-brick-wine-improved-upgrade production-homebooze-cider-improved-upgrade production-homebooze-home-brew-improved-upgrade production-homebooze-moonshine-improved-upgrade
						production-homebooze-apple-jack-improved production-homebooze-apple-jack-improved-upgrade
						production-homebooze-corn-moonshine-improved production-homebooze-corn-moonshine-improved-upgrade
