{	ident { template jazz-club-player parent supper-club-group }
	defmodule { def {
		id jazz-club-player					#type consumer-module-config
		common {
			tags [ tag-biz-back ]
			upgradetag tag-upgrade-supper-club
			visreqs [
				{ #type check-module-in-convo has all of [ supper-club-player ] }
			]
			reqs [
				{ #type check-player-skills has all of [ large-clubs ] }
			]
			display {
				icon "Module Icon Jazz Club"
				locname "module.jazz-club.name"
				locdesc "module.jazz-club.desc"
				locInstallDetail "module.jazz-club.details"
				locintroflavor "convo.ticket-intro-flavor.module.supper-club-group"
				operationSprite "Jazz Club"
				locicon "module.icons.jazz-club"
			}
			purchase {
				size [ tag-size-small tag-size-medium ]
				verticals [ tag-vert-booze ]
				buildTurns { value 6 }
				cashCost { cash -12000 }
				consume [ { id liquor-license qty -8 } { id weapon-permit qty -2 } { id furniture qty -15 } ]
			}
		}
		sink {
			locdesc "recipe.jazz-club"
			locScopeOut "recipe.scopeout.illegal-consume-booze-small"
			locFlavorDesc "recipe.flavorcopy.jazz-club"

			refill [ { id dirty-cash below 6000 get 5000 } { id bandlow below 60 get 50 } { id band below 60 get 50 } { id exdancers below 60 get 50 } { id group-level-two below 60 get 50 } { id group-drinks below 60 get 50 } { id ethnic-alcohol below 50 get 40 needsEthPack #true } { id group-level-three below 60 get 60 } { id aged-whiskey below 1 get 5 } { id cordials below 1 get 6 } { id cannabis-joints below 60 get 50 } ]
			
			consumeDayz 58
			consume [ { id dirty-cash qty -5000 } { id counterfeitcash qty -1500 } { id bandlow qty -2 } { id band qty -2 } { id exdancers qty -1 } { id group-level-two qty -60 } { id group-drinks qty -60 } { id group-level-three qty -40 } { id aged-whiskey qty -25 } { id cordials qty -30 } { id cannabis-joints qty -60 } ]

			aoe {
				priceMarkup { value 2.5 }

				customerRadius 30
				respectRadius { value 28 } ; mods [ ] }
				respectLockey "modulerespect.high"
				respectPointsInRadius {
					value 30
					mods [ { #type same-ethnicity-at-node-mod multiplier 25 } ]
				}
			}
		}
} } }
