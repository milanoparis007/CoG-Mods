			locdesc "recipe.backroomlaundererl"
			locScopeOut "recipe.scopeout.illegal-consume-booze-small"
			locFlavorDesc "recipe.flavorcopy.backroomlaundererl"

			refill [ { id poitin below 60 get 50 } ]
			
			consumeDayz 35
			consume [ { id poitin qty -50 } ]

			aoe {
				priceMarkup { value 1 }

				customerRadius 15
				respectRadius { value 14 } ; mods [ ] }
				respectLockey "modulerespect.high"
				respectPointsInRadius {
					value 10
					mods [ { #type same-ethnicity-at-node-mod multiplier 25 } ]
				}
			}
		}
} } }

