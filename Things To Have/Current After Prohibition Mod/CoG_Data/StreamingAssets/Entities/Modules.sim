			consume [ { id fake-beer qty -60 } { id ethnic-alcohol qty -60 needsEthPack #true eth de } { id ethnic-alcohol qty -60 needsEthPack #true eth pl } { id vodka-bottled qty -50 } { id gin qty -45 } { id beer-keg qty -8 } { id german-schnapps qty -60 } ]
		}
} } }



