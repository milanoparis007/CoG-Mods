				produce [ { id whiskey-bottled qty 70 }]
				refill	[ { id barrels below 10 get 10 } { id bottles below 70 get 70 } { id barley below 20 get 20 }]
				selloff [ { id whiskey-bottled above 70 sell -70 }]
			}
		]
		interesting #true
} } }
