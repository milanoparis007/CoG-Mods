{	ident { template sink-industrial-barrels parent module-base }
	defmodule { def {
		id sink-industrial-barrels 			#type consumer-module-config
		common {
			tags [ tag-biz-back ]
			skills [  tag-skills-whiskey-still tag-skills-brandy-still tag-skills-vodka-still tag-skills-rum-still ]
			visreqs [ { #type always-false } ]
			display {
				icon "Module Icon Union Hall"
				locname "module.sink-industrial-barrels.name"
				locdesc "module.sink-industrial-barrels.desc"
				locInstallDetail "module.sink-industrial-barrels.details"
			}
		}
		sink {
			locdesc "recipe.sink-industrial-barrels"
			locScopeOut "recipe.scopeout.sink-industrial-barrels"
			locFlavorDesc "recipe.scopeout.sink-industrial-barrels"

			consumeDayz 42
			refill [ { id whiskey-barrel below 8 get 8 } { id brandy-barrel below 8 get 8 } { id vodka-barrel below 8 get 8 } { id rum-barrel below 8 get 8 } ]
			consume [ { id whiskey-barrel qty -6 } { id brandy-barrel qty -6 } { id vodka-barrel qty -6 } { id rum-barrel qty -6 } ]
		}
		interesting #true
} } }
