				{ #type check-backroom-in-convo empty #true }
			]
			reqs [
				{ #type check-player-skills has any of [ bootleg-whiskey ] }
			]
			display {
				icon "Module Icon Whiskey"
				locicon	"module.icons.whisky"
				locname "module.production-makeshift-still-whiskey.name"
				locdesc "module.production-makeshift-still-whiskey.desc"
				locInstallDetail "module.production-makeshift-still.details"
				locintroflavor "convo.ticket-intro-flavor.module.production-makeshift-still"
				operationSprite "Operation Makeshift Whiskey"
				accentSprite "Accent Makeshift Whiskey"
			}
