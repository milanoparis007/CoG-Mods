		id player-legal-cardealership		#type consumer-module-config
		common {
			tags [ tag-biz-front tag-player-legal-biz ]
			visreqs [ { #type check-player-skills has any of [ moneylaunderingmid ] } ]
			reqs [ { #type check-player-skills has any of [ moneylaunderingmid ] } ]
			display {
				icon "Module Icon Car Dealer"
				locname "module.player-legal-cardealership.name"
				locdesc "module.player-legal-cardealership.desc"
				locInstallDetail "module.player-legal-cardealership.details"
			}
			purchase {
				size [ tag-size-medium tag-size-large ]
				verticals [ tag-vert-booze tag-vert-cars tag-vert-gambling ]
				cashCost { cash -15000 }
				buildTurns { value 8 }
			}
		}
		sink {
			locdesc "recipe.player-legal-cardealership"
			locScopeOut "recipe.player-legal-cardealership.scopeout"
			consumeDayz 28
			consume [ { id stolencarlow qty -2 } { id vehiclelow qty -20 } { id dirty-cash qty -1500 } ]
			aoe {
				priceMarkup { value 1.3 }
			}
		}
		interesting #true
} } }

