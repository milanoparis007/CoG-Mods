{	ident { template production-sparkling-cider parent production-level-two-group } 
	defmodule { def {
		id production-sparkling-cider	#type manufacture-module-config
		common {
			tags [ tag-biz-back tag-biz-sparkling-cider ]
			upgradetag tag-upgrade-booze-track-two
			visreqs [ 
				{ #type check-laws has any of [ prohibition ] active #true }
				{ #type check-player-skills has any of [ sparkling-cider ] } 
				{ #type check-backroom-in-convo empty #true }
				{ #type check-current-city is none of [ pittsburgh ] }
			]
			reqs [ 
				{ #type check-player-skills has any of [ sparkling-cider ] } 
			]
			display {
				icon "Module Icon Sparkling Cider Production"
				locicon	"module.icons.sparkling-cider"
