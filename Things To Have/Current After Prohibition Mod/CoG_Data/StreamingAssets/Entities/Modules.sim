	;; homemade booze consumption

	;; group parent 
{ ident { template bootlegger-homebooze-group parent module-base }
	defmodule {
		levelups [
			{ id levelup-management is equalto value 1 target consume multiplier 1.1 }
			{ id levelup-management is equalto value 2 target consume multiplier 1.2 }
			{ id levelup-management is equalto value 3 target consume multiplier 1.4 }
			{ id levelup-bartending	is equalto value 1 target consume multiplier 1.1 }
			{ id levelup-bartending is equalto value 2 target consume multiplier 1.2 }
			{ id levelup-bartending is equalto value 3 target consume multiplier 1.3 }
			{ id levelup-bartending is equalto value 4 target consume multiplier 1.4 }
			{ id levelup-bartending is equalto value 5 target consume multiplier 1.5 }
			{ id levelup-bartending is equalto value 6 target consume multiplier 1.6 }
			{ id levelup-bartending is equalto value 7 target consume multiplier 1.75 }
			{ id levelup-faster-consume is equalto value 1 target consumeDays multiplier 0.9 }
			{ id levelup-faster-consume is equalto value 2 target consumeDays multiplier 0.8 }
			{ id levelup-faster-consume is equalto value 3 target consumeDays multiplier 0.7 }
			{ id levelup-faster-consume is equalto value 4 target consumeDays multiplier 0.65 }
			{ id levelup-faster-consume is equalto value 5 target consumeDays multiplier 0.6 }
		]
		expansions {
			maxcount { value 1 mods [ 
				{ #type manager-level-test-mod id levelup-builder is equalto value 1 delta 1 } 
				{ #type traits-mod-on-manager if [ trait-organized ] delta 1 }
				{ #type traits-mod-on-manager if [ trait-lazy ] delta -1 }
				] }
			configs [
			{
				id		consumption-increase-bootlegger
				target	consume
				multiplier { value 1.1 }

				visreqs [
					{ #type check-module-in-convo has any of [ 
						bootlegger-homebooze-brick-wine bootlegger-homebooze-cider bootlegger-homebooze-home-brew bootlegger-homebooze-moonshine 
						bootlegger-homebooze-apple-jack bootlegger-homebooze-fruit-wine
					] }
				]
				reqs [
					{ #type check-player-skills has all of [ trap-door ] }
					{ #type check-manager-assigned expected #true }
				]

				display {
					locicon "expansion.bootlegger-homebooze-group.consume.icon"
					locname "expansion.bootlegger-homebooze-group.consume.name"
