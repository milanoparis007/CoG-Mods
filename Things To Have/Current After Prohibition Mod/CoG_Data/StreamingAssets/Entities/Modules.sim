				produce [ { id whiskey-bottled qty 70 } ]
				refill [ { id moonshine below 45 get 45 } { id bottles below 90 get 90 } { id spices below 30 get 30 } { id food-dyes below 30 get 30 } ]
				selloff [ { id whiskey-bottled above 70 sell -70 } ]
