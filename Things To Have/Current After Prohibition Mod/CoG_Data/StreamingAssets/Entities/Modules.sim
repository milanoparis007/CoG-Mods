		;; NPC bootleggers
{	ident { template bootlegger-homebooze parent bootlegger-homebooze-group } 
	defmodule { def {
		id bootlegger-homebooze		#type consumer-module-config
		common {
			tags [ tag-biz-back ]
			reqs [ ]
			visreqs [ { #type always-false } ]
			skills [ tag-quest-bootlegging ]
			display {
				icon "Module Icon Home Booze Consume"
				locicon	"module.icons.consume"
				locname "module.bootlegger-home-brew.name"
				locdesc "module.bootlegger-home-brew.desc"
				locInstallDetail "module.bootlegger-home-brew.details"
				locintroflavor "convo.ticket-intro-flavor.module.bootlegger-home-brew"
			}
			purchase {
				size [ tag-size-small ]
				verticals [ tag-vert-booze ]
				cashCost { cash -750 }
				buildTurns { value 6 }
				consume [ { id lumber qty -7 } ]
			} 
		}
		sink {
			locdesc "recipe.bootlegger-home-brew"
			locScopeOut "recipe.scopeout.illegal-consume-homebrew"
			locFlavorDesc "recipe.flavorcopy.bootlegger-home-brew"

			refill [ { id cider below 5 get 16 } { id home-brew below 6 get 18 } { id brick-wine below 5 get 14 } { id moonshine below 4 get 12 } ]
			
			consumeDayz 42
			consume [ { id cider qty -22 } { id home-brew qty -22 } { id brick-wine qty -19 } { id moonshine qty -24 } ]

			aoe {
				priceMarkup { value 1 }

				customerRadius 15
				respectRadius { value 18 } ; mods [ ] }
				respectLockey "modulerespect.none"				
				respectPointsInRadius {
					value 0
					mods [ { #type same-ethnicity-at-node-mod multiplier 5 } ]
				}
			}
		}
		interesting #true
		locintroflavor "convo.ticket-intro-flavor.module.bootlegger-home-brew"
	} } }
{ ident { template bootlegger-homebooze-a parent bootlegger-homebooze }
	defmodule { def {
		id bootlegger-homebooze-a	#type consumer-module-config
		common {
			skills [ tag-skills-home-brew tag-skills-brick-wine tag-skills-basic-bartending tag-skills-homebooze-bootlegging tag-quest-home-brew-sink tag-quest-brick-wine-sink tag-quest-improved-home-brew tag-quest-bootlegging ]
		}
		sink {
			refill [ { id brick-wine below 1 get 2 } { id home-brew below 1 get 4 } ]
			consumeDayz 49
			consume [ { id brick-wine qty -8 } { id home-brew qty -15 } ]
		}
	} } }
