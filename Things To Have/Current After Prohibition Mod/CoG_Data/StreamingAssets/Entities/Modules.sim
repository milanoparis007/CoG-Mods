{ ident { template junkyard-module parent vehicle-base-NPCs }
	defmodule { def {
		id junkyard-module		#type vehicle-module-config
		common {
			display {
				locname "module.junkyard-module.name"
				locdesc "module.junkyard-module.desc"
				locInstallDetail "junkyard-module.details"
				operationSprite "Small Mechanic"
			}
		}
		vehicleModuleLoc {
			locdesc "module.junkyard-module.name"
			locScopeOut "recipe.scopeout.junkyard-module"
			locFlavorDesc "junkyard-module.details"
		}
		repairInfo {
			fullHealPrice { value -200 mods [
				{ #type person-same-eth-as-human-mod delta 25 }
				{ #type crew-vehicle-template is equalto template vehicle-transit delta 160 }
				{ #type is-node-in-territory expected #true delta 25 }
				{ #type crew-vehicle-condition is equalto type junk multiplier 3 }
				{ #type skills-mod if [ starter-vehicles ] multiplier 0.8 }
			] }
		}
		buyBackInfo {
			pricemods [
				{ #type static-mod multiplier 0.35 } ;; buy vehicles for half the price
			]
    		entities [ vehicle-transit vehicle-car vehicle-pickup-truck vehicle-dseries vehicle-bulletproof-truck vehicle-sedan vehicle-sports-car vehicle-sportsbenz vehicle-bulletproof-car vehicle-bulletproof-sports-car vehicle-lseries vehicle-independence vehicle-bmw327 vehicle-benz-ssk vehicle-jaguarm vehicle-bulletproof-independence vehicle-bulletproof-jaguar vehicle-lancer vehicle-customline vehicle-skylark vehicle-safari vehicle-camino vehicle-electra vehicle-phantom vehicle-bmw vehicle-benz vehicle-jaguar vehicle-bulletproof-camino vehicle-bulletproof-phantom ]
		}
		sellInfo {
			vehicles [
				{
					entities [ vehicle-car vehicle-sedan ]
					visreqs [ { #type check-current-turn is lessorequalto value 730 } ]
					pricemods [
						{ #type static-mod delta 100 }
						{ #type law-mod laws [ vehicle-tax ] enacted true }
					]
				}
				{
					entities [ vehicle-lseries vehicle-independence ]
					visreqs [ { #type check-current-turn is lessorequalto value 1773 } { #type check-current-turn is moreorequalto value 680 } ]
					pricemods [
						{ #type static-mod delta 100 }
						{ #type law-mod laws [ vehicle-tax ] enacted true }
					]
				}
				{
					entities [ vehicle-customline vehicle-skylark vehicle-lancer vehicle-safari vehicle-camino vehicle-electra ]
					visreqs [ { #type check-current-turn is moreorequalto value 1773 } ]
					pricemods [
						{ #type static-mod delta 100 }
						{ #type law-mod laws [ vehicle-tax ] enacted true }
					]
				} 
			]
		}
} } }
{ ident { template truck-garage parent vehicle-base-NPCs }
	defmodule { def {
		id truck-garage			#type vehicle-module-config
		common {
			display {
				locname "module.truck-garage.name"
				locdesc "module.truck-garage.desc"
				operationSprite "Large Mechanic"
			}
		}
		vehicleModuleLoc {
			locdesc "module.truck-garage.desc"
			locScopeOut "recipe.scopeout.truck-garage"
			locFlavorDesc "truck-garage.details"
		}
		sellInfo {
			vehicles [
				{
					entities [ vehicle-pickup-truck ] 
					visreqs [ { #type check-current-turn is lessorequalto value 1773 } ]
					pricemods [
						{ #type skills-mod if [ car-bullies ] multiplier 0.4 }
						{ #type static-mod delta -100 }
						{ #type law-mod laws [ vehicle-tax ] enacted true }
					]
				}
				{
					entities [ vehicle-small-delivery-truck ]
					visreqs [
						{ #type check-module-in-player-territory has any of [ player-garage-module-small player-garage-module-medium player-truck-garage-small player-truck-garage-improved ] }
						{ #type check-laws has any of [ truck-permits ] active #false }
					]
					pricemods [
					{ #type skills-mod if [ car-bullies ] multiplier 0.4 }
						{ #type static-mod delta -50 }
					{ #type law-mod laws [ vehicle-tax ] enacted true }
				]
				} 
				{
					entities [ vehicle-dseries ]
					visreqs [
						{ #type check-current-turn is moreorequalto value 1773 }
					]
					pricemods [
					{ #type skills-mod if [ car-bullies ] multiplier 0.4 }
						{ #type static-mod delta -100 }
						{ #type law-mod laws [ vehicle-tax ] enacted true }
					]
				}
			]
		}
		repairInfo {
			fullHealPrice { value -300 mods [
				{ #type person-same-eth-as-human-mod delta 25 }
				{ #type crew-vehicle-template is equalto template vehicle-transit delta 270 }
				{ #type is-node-in-territory expected #true delta 25 }
				{ #type crew-vehicle-condition is equalto type junk multiplier 2 }
				{ #type skills-mod if [ starter-vehicles ] multiplier 0.8 }
			] }
		}
} } }

