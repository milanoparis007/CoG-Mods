				{ id weapon-mp18 qty -60 } { id weapon-thompson qty -60 }
				{ id weapon-mp-28 qty -60 } { id weapon-emp-35 qty -60 }
			]
			aoe {
				priceMarkup { value 1 }

				customerRadius 18
				respectRadius  { value 20 mods [ 
				{ #type manager-level-test-mod id levelup-protection is equalto value 1 delta 1 } 
				{ #type manager-level-test-mod id levelup-protection is equalto value 2 delta 2 } 
				{ #type manager-level-test-mod id levelup-protection is equalto value 3 delta 3 } 
				{ #type manager-level-test-mod id levelup-protection is equalto value 4 delta 5 }
				{ #type manager-level-test-mod id levelup-hoods is equalto value 1 delta 2 }
				{ #type manager-level-test-mod id levelup-hoods is equalto value 2 delta 2 } 
				{ #type manager-level-test-mod id levelup-hoods is equalto value 3 delta 4 }
				{ #type manager-level-test-mod id levelup-hoods is equalto value 4 delta 8 } 
				] }
				respectLockey "modulerespect.high"
				respectPointsInRadius {
					value 200
					mods [ { #type same-ethnicity-at-node-mod multiplier 125 }
				{ #type manager-level-test-mod id levelup-protection is equalto value 1 delta 5 } 
				{ #type manager-level-test-mod id levelup-protection is equalto value 2 delta 10 } 
				{ #type manager-level-test-mod id levelup-protection is equalto value 3 delta 15 } 
				{ #type manager-level-test-mod id levelup-protection is equalto value 4 delta 20 }
				{ #type manager-level-test-mod id levelup-hoods is equalto value 1 delta 2 }
				{ #type manager-level-test-mod id levelup-hoods is equalto value 2 delta 4 } 
				{ #type manager-level-test-mod id levelup-hoods is equalto value 3 delta 6 }
				{ #type manager-level-test-mod id levelup-hoods is equalto value 4 delta 10 } 
			 ]}	
			}
		}
} } }

{	ident { template hotel-player parent supper-club-group }
	defmodule { def {
		id hotel-player			#type consumer-module-config
		common {
			tags [ tag-biz-back ]
			upgradetag tag-upgrade-supper-club
			visreqs [
				{ #type check-module-in-convo has all of [ supper-club-player ] }
			]
			reqs [
				{ #type check-player-skills has all of [ large-clubs ] }
			]
			display {
				icon "Module Icon Downtown Hotel"
				locname "module.hotel-player.name"
				locdesc "module.hotel-player.desc"
				locInstallDetail "module.hotel.details"
				locintroflavor "convo.ticket-intro-flavor.module.supper-club-group"
				operationSprite "Hotel"
				locicon "module.icons.hotel-player"
			}
			purchase {
				size [ tag-size-small tag-size-medium ]
				verticals [ tag-vert-booze ]
				buildTurns { value 6 }
				cashCost { cash -10000 }
				consume [ { id liquor-license qty -8 } { id weapon-permit qty -2 } { id furniture qty -15 } ]
			}
		}
		sink {
			locdesc "recipe.hotel-player"
			locScopeOut "recipe.scopeout.illegal-consume-booze-small"
			locFlavorDesc "recipe.flavorcopy.hotel"

			refill [ { id group-level-two below 60 get 50 } { id group-drinks below 60 get 50 } { id dirty-cash below 6000 get 5000 } { id counterfeitcash below 6000 get 5000 } { id bandlow below 60 get 50 } { id band below 60 get 50 } { id ethnic-alcohol below 50 get 40 needsEthPack #true } { id group-level-three below 60 get 60 } { id champagne below 1 get 6 } { id gin below 1 get 6 } ]
			
			consumeDayz 58
			consume [ { id group-level-two qty -60 } { id counterfeitcash qty -1500 } { id dirty-cash qty -5000 } { id bandlow qty -4 } { id band qty -4 } { id ethnic-alcohol qty -50 needsEthPack #true } { id group-level-three qty -40 } { id champagne qty -25 } { id gin qty -30 } ]

			aoe {
				priceMarkup { value 2.5 }

				customerRadius 30
				respectRadius { value 28 } ; mods [ ] }
				respectLockey "modulerespect.high"
				respectPointsInRadius {
					value 30
					mods [ { #type same-ethnicity-at-node-mod multiplier 25 } ]
				}
			}
		}
} } }
