				locdesc "recipe.production-homebooze-moonshine"
				locScopeOut "recipe.scopeout.illegal-moonshine"

				visreqs [ { #type check-laws has any of [ prohibition ] active #true } { #type check-has-eth-pack-and-is-eth eth ir } ]

				produceConsumeDayz 28
				refill	[ { id sugar below 30 get 20 } { id barley below 18 get 9 } { id crocks below 70 get 60 } ]
				consume [ { id sugar qty -20 } { id barley qty -12 } { id crocks qty -60 } ]
				produce [ { id moonshine qty 60 } ]
				selloff [ { id moonshine above 90 sell -60 }]
			}
		]
} } }
