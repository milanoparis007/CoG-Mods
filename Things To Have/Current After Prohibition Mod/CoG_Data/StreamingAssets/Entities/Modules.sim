;; subset for player bootlegging operations

{ ident { template bootlegger-homebooze-player	parent bootlegger-homebooze-group }
	defmodule { def {
		id bootlegger-homebooze-player		#type consumer-module-config
		common {
			tags [ tag-biz-back ]
			reqs [ { #type check-player-skills has any of [ homebooze-bootlegging ] } ]
			visreqs [ { #type always-false } ] ;; add per resource type
			display {
				icon "Module Icon Home Booze Consume"
				locicon	"module.icons.consume"
				locintroflavor "convo.ticket-intro-flavor.module.bootlegger-home-brew"
				accentSprite "Operation Bootlegger"
				operationSprite "Operation Bootlegger"
			}
			purchase {
				size [ tag-size-small ]
				verticals [ tag-vert-booze ]
				cashCost { cash -1000 }
				buildTurns { value 6 }
				consume [ { id lumber qty -10 } ]
			}
		}
		sink {
			locdesc "recipe.bootlegger-home-brew"
			locScopeOut "recipe.scopeout.illegal-consume-homebrew"
			locFlavorDesc "recipe.flavorcopy.bootlegger-home-brew"	

			refill [ { id cider below 5 get 16 } { id home-brew below 6 get 18 } { id brick-wine below 5 get 14 } { id moonshine below 4 get 12 } ]
			
			consumeDayz 28
			consume [ { id cider qty -11 } { id home-brew qty -11 } { id brick-wine qty -9 } { id moonshine qty -12 } ]

			aoe {
				priceMarkup { value 1 }

				customerRadius 15
				respectRadius { value 18 } ; mods [ ] }
				respectLockey "modulerespect.none"				
				respectPointsInRadius {
					value 0
					mods [ { #type same-ethnicity-at-node-mod multiplier 5 } ]
				}
			}
		}
		interesting #true
		locintroflavor "convo.ticket-intro-flavor.module.bootlegger-home-brew"
	} } }

