{ entities [


;;  if you'd like to make a resource appear only if you have any ethpack, the syntax is { id ethnic-alcohol below 40 get 40 needsEthPack #true } or {id ethnic-alcohol qty -40 needsEthPack #true}
;;  if you want to limit them to specific ethpacks, its { id ethnic-alcohol below 40 get 40 needsEthPack #true eth de } or { id ethnic-alcohol qty -40 needsEthPack #true eth de }

{
	ident { template module-base }
	defmodule { }
}

{	ident { template inventory-vehicle-car parent module-base }
	defmodule { def {
		id inventory-vehicle-car		#type inventory-module-config		
		common {
			tags [ tag-inventory-vehicle-car ]
		}
		capacity { cubicfeet 2800 }
	} } }
