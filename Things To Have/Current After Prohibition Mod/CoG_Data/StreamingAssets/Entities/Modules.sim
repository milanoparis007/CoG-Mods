;; booze stills
{ ident { template makeshift-stills-group } 
	defmodule {
		levelups [
			{ id levelup-management is equalto value 1 target consume multiplier 0.9 }
			{ id levelup-management is equalto value 2 target consume multiplier 0.8 }
			{ id levelup-management is equalto value 3 target consume multiplier 0.7 }
			{ id levelup-still-master is equalto value 1 target produceConsumeDays delta -7 }
			{ id levelup-still-master is equalto value 2 target produceConsumeDays delta -14 }
			{ id levelup-still-master is equalto value 3 target produceConsumeDays delta -21 }
			{ id levelup-whiskey-stills is equalto value 1 target produce multiplier 1.1 }
			{ id levelup-whiskey-stills is equalto value 2 target produce multiplier 1.2 }
			{ id levelup-whiskey-stills is equalto value 3 target produce multiplier 1.3 }
			{ id levelup-whiskey-stills is equalto value 4 target produce multiplier 1.4 }
			{ id levelup-whiskey-stills is equalto value 5 target produce multiplier 1.5 }
			{ id levelup-brandy-stills is equalto value 1 target produce multiplier 1.1 }
			{ id levelup-brandy-stills is equalto value 2 target produce multiplier 1.2 }
			{ id levelup-brandy-stills is equalto value 3 target produce multiplier 1.3 }
			{ id levelup-brandy-stills is equalto value 4 target produce multiplier 1.4 }
			{ id levelup-brandy-stills is equalto value 5 target produce multiplier 1.5 }
			{ id levelup-rum-stills is equalto value 1 target produce multiplier 1.1 }
			{ id levelup-rum-stills is equalto value 2 target produce multiplier 1.2 }
			{ id levelup-rum-stills is equalto value 3 target produce multiplier 1.3 }
			{ id levelup-rum-stills is equalto value 4 target produce multiplier 1.4 }
			{ id levelup-rum-stills is equalto value 5 target produce multiplier 1.5 }
			{ id levelup-vodka-stills is equalto value 1 target produce multiplier 1.1 }
			{ id levelup-vodka-stills is equalto value 2 target produce multiplier 1.2 }
			{ id levelup-vodka-stills is equalto value 3 target produce multiplier 1.3 }
			{ id levelup-vodka-stills is equalto value 4 target produce multiplier 1.4 }
			{ id levelup-vodka-stills is equalto value 5 target produce multiplier 1.5 }
		]
		expansions {
			maxcount { value 3 mods [ 
				{ #type manager-level-test-mod id levelup-builder is equalto value 1 delta 1 } 
				{ #type traits-mod-on-manager if [ trait-organized ] delta 1 }
				{ #type traits-mod-on-manager if [ trait-lazy ] delta -1 }
				] }
			configs [
				{
				id 		steam-sanitizer
				target	produce
				multiplier { value 1.1 }

				visreqs [ 
				]
				reqs [
					{ #type check-player-skills has all of [ crock-return ] }
					{ #type check-manager-assigned expected #true }
					;{ #type check-crew-peep-level id levelup-management is atleast value 1 }
				]

				display {
					locicon	"expansion.steam-sanitizer.icon"
					locname	"expansion.steam-sanitizer.name"
					locdesc	"expansion.steam-sanitizer.desc"
					locInstallDetail "expansion.steam-sanitizer.install"
				}

				purchase { cashCost { cash -300 } }
			}
			{
				id		industrial-filters
				target	consume
				multiplier	{ value 0.9 }

				visreqs [
					{ #type check-player-skills has any of [ industrial-filters ] }
				]
				reqs [
					{ #type check-manager-assigned expected #true }
					{ #type check-player-skills has any of [ industrial-filters ] }
				]
				display {
					locicon "expansion.industrial-filters.icon"
					locname "expansion.industrial-filters.name"
					locdesc "expansion.material-conversion-group.industrial-filters.desc"
					locInstallDetail "expansion.industrial-filters.install"
				}
				purchase { cashCost { cash -400 } }
			}
			{
				id ledger-book
				target produce
				multiplier { value 1.1 }
				visreqs [
				]
				reqs [
					{ #type check-manager-assigned expected #true }
					{ #type check-manager-traits has any of [ trait-intelligent trait-hardworking trait-organized ] }
				]
				display {
					locicon "expansion.ledger-book.icon"
					locname "expansion.ledger-book.name"
					locdesc "expansion.ledger-book.desc"
					locInstallDetail "expansion.ledger-book.install"
				}
				purchase { cashCost { cash -100 } }
			}
			]
		}
} }

