{	ident { template player-legal-general-contractor parent player-legal-biz-base }
	defmodule { def {
		id player-legal-general-contractor		#type manufacture-module-config
		common {
			tags [ tag-biz-front tag-player-legal-biz ]
			visreqs [
				{ #type check-player-skills has any of [ realestate ] }
			]
			reqs [
				{ #type check-player-skills has any of [ realestate ] }
			]
			skills [ tag-skills-realestate ]
			display {
				icon "construction-company"
				locname "module.player-legal-general-contractor.name"
				locdesc "module.player-legal-general-contractor.desc"
				locInstallDetail "module.player-legal-general-contractor.details"
			}
			purchase {
				size [ tag-size-medium tag-size-large ]
				verticals [ tag-vert-booze tag-vert-cars tag-vert-gambling ]
				cashCost { cash -350000 }
				buildTurns { value 12 }
			}
		}
		recipes [
			;; ?? ?? (New Home) - $6,000
			;; INPUT: bricks 30 ($1,050) + lumber 30 ($900) + pipes 20 ($600) + sheet-metal 20 ($600) = $3,150
			{
				locdesc "recipe.general-contractor.home-new"
				locScopeOut "recipe.general-contractor.home-new.scopeout"
				produceConsumeDayz 91
				consume [ { id bricks qty -200 } { id lumber qty -200 } { id pipes qty -100 } { id sheet-metal qty -200 } ]
				produce [ { id home-new qty 10 } ]
				selloff [ { id home-new above 3 sell -1 } ]
			}
			;; ???? ?? (Remodeled Home) - $4,500
			;; INPUT: lumber 25 ($750) + bricks 15 ($525) + pipes 15 ($450) + sheet-metal 10 ($300) = $2,025
			{
				locdesc "recipe.general-contractor.homemid"
				locScopeOut "recipe.general-contractor.homemid.scopeout"
				produceConsumeDayz 91
				consume [ { id lumber qty -250 } { id bricks qty -150 } { id pipes qty -100 } { id sheet-metal qty -100 } ]
				produce [ { id homemid qty 10 } ]
				selloff [ { id homemid above 3 sell -1 } ]
			}
			;; ??? ?? (Commercial Storefront) - $5,000
			;; INPUT: bricks 25 ($875) + lumber 20 ($600) + pipes 15 ($450) + sheet-metal 15 ($450) = $2,375
			{
				locdesc "recipe.general-contractor.storefront"
				locScopeOut "recipe.general-contractor.storefront.scopeout"
				produceConsumeDayz 91
				consume [ { id bricks qty -250 } { id lumber qty -200 } { id pipes qty -150 } { id sheet-metal qty -150 } ]
				produce [ { id storefront qty 10 } ]
				selloff [ { id storefront above 3 sell -1 } ]
			}
			;; ?? ?? (Commercial Building) - $12,000
			;; INPUT: bricks 60 ($2,100) + lumber 40 ($1,200) + pipes 40 ($1,200) + sheet-metal 40 ($1,200) = $5,700
			{
				locdesc "recipe.general-contractor.commercial-building"
				locScopeOut "recipe.general-contractor.commercial-building.scopeout"
				produceConsumeDayz 91
				consume [ { id bricks qty -200 } { id lumber qty -200 } { id pipes qty -150 } { id sheet-metal qty -150 } ]
				produce [ { id commercial-building qty 4 } ]
				selloff [ { id commercial-building above 2 sell -1 } ]
			}
			;; ??? ?? (Apartment Building) - $15,000
			;; INPUT: bricks 80 ($2,800) + lumber 50 ($1,500) + pipes 50 ($1,500) + sheet-metal 50 ($1,500) = $7,300
			{
				locdesc "recipe.general-contractor.apartment-building"
				locScopeOut "recipe.general-contractor.apartment-building.scopeout"
				produceConsumeDayz 91
				consume [ { id bricks qty -200 } { id lumber qty -200 } { id pipes qty -200 } { id sheet-metal qty -200 } ]
				produce [ { id apartment-building qty 4 } ]
				selloff [ { id apartment-building above 2 sell -1 } ]
			}
			;; ??? ?? (Industrial Warehouse) - $8,000
			;; INPUT: sheet-metal 50 ($1,500) + bricks 40 ($1,400) + lumber 30 ($900) + pipes 25 ($750) = $4,550
			{
				locdesc "recipe.general-contractor.industrial-warehouse"
				locScopeOut "recipe.general-contractor.industrial-warehouse.scopeout"
				produceConsumeDayz 91
				consume [ { id sheet-metal qty -20 } { id bricks qty -20 } { id lumber qty -150 } { id pipes qty -20 } ]
				produce [ { id industrial-warehouse qty 2 } ]
				selloff [ { id industrial-warehouse above 2 sell -1 } ]
			}
		]
		interesting #true
} } }


