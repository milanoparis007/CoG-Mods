;; gambling

{	ident { template gambling-base 			parent module-base }
	defmodule { def {
		id gambling-base					#type gambling-module-config
		common { tags [ tag-res-gambling ] }
} } }

{	ident { template home-small		parent gambling-base }
	defmodule { def {
		id home-small
		common { 
			display {
				locicon	"module.icons.storage-general.icon"
				icon 	"Module Icon Clothing"
				locname "module.home-small.name"
				locdesc "module.home-small.desc"
				locInstallDetail "module.home-small.install-convo"
			}
		}

		gambling {
			installReqs	[
				{ #type special-can-pay-for-casino }
			{ #type check-player-cash type highwater is atleast value 2500 }
			]
			installVisReqs	[ { #type check-player-cash type highwater is atleast value 2500 } ]
			purchaseCost	{ value -3000 }
			upgradeCost { value -2500 } 

			upgradeModule	rental-home


			aoeRadius { value 30 mods [
			;	{ #type amenity-mod if [ imported-furniture ] multiplier 1.25 }
				] }
			amenityCount { value 5 mods [
				] }
			amenityIds	 [ rentalhigh kitchen kitchenhigh livebed housebar housebarhigh livingroom wardrobe lifestyle livingroommid wardrobemid lifestylemid
			 livingroomhigh wardrobehigh lifestylehigh gallery bookroom poker-game numbers-game ]

			regularsGainProbPerTurn { value 0.95 }
		}
} } }
