	;; raw material conversion modules

	;; parent for homebooze material converters
{ ident { template material-conversion-group parent module-base }
	defmodule {
		levelups [
			{ id levelup-builder is equalto value 1 target produce delta 1 }
			{ id levelup-management is equalto value 1 target consume multiplier 0.9 }
			{ id levelup-management is equalto value 2 target consume multiplier 0.8 }
			{ id levelup-management is equalto value 3 target consume multiplier 0.7 }
			{ id levelup-fruit-converter is equalto value 1 target produce multiplier 1.1 }
			{ id levelup-fruit-converter is equalto value 2 target produce multiplier 1.2 }
			{ id levelup-fruit-converter is equalto value 3 target produce multiplier 1.4 }
			{ id levelup-fruit-converter is equalto value 4 target produce multiplier 1.5 }
			{ id levelup-fruit-converter is equalto value 5 target produce multiplier 1.6 }
			{ id levelup-fermenter is equalto value 1 target produce multiplier 1.1 }
			{ id levelup-fermenter is equalto value 2 target produce multiplier 1.2 }
			{ id levelup-fermenter is equalto value 3 target produce multiplier 1.4 }
			{ id levelup-fermenter is equalto value 4 target produce multiplier 1.5 }
			{ id levelup-fermenter is equalto value 5 target produce multiplier 1.6 }
		]
		expansions {
			maxcount { value 1 mods [ 
				{ #type manager-level-test-mod id levelup-builder is equalto value 1 delta 1 } 
				{ #type traits-mod-on-manager if [ trait-organized ] delta 1 }
				{ #type traits-mod-on-manager if [ trait-lazy ] delta -1 }
				] }
			configs [
			{
				id 		steam-sanitizer
				target	produce
				multiplier { value 1.1 }

				visreqs [ 
				]
				reqs [
					{ #type check-player-skills has all of [ crock-return ] }
					{ #type check-manager-assigned expected #true }
					;{ #type check-crew-peep-level id levelup-management is atleast value 1 }
				]

				display {
					locicon	"expansion.steam-sanitizer.icon"
					locname	"expansion.steam-sanitizer.name"
					locdesc	"expansion.steam-sanitizer.desc"
					locInstallDetail "expansion.steam-sanitizer.install"
				}

				purchase { cashCost { cash -300 } }
			}
			{
				id		industrial-filters
				target	consume
				multiplier	{ value 0.9 }

				visreqs [
					{ #type check-player-skills has any of [ industrial-filters ] }
				]
				reqs [
					{ #type check-manager-assigned expected #true }
					{ #type check-player-skills has any of [ industrial-filters ] }
				]
				display {
					locicon "expansion.industrial-filters.icon"
					locname "expansion.industrial-filters.name"
					locdesc "expansion.material-conversion-group.industrial-filters.desc"
					locInstallDetail "expansion.industrial-filters.install"
				}
				purchase { cashCost { cash -400 } }
			}
			{
				id ledger-book
				target produce
				multiplier { value 1.1 }
				visreqs [
				]
				reqs [
					{ #type check-manager-assigned expected #true }
					{ #type check-manager-traits has any of [ trait-intelligent trait-hardworking trait-organized ] }
				]
				display {
					locicon "expansion.ledger-book.icon"
					locname "expansion.ledger-book.name"
					locdesc "expansion.ledger-book.desc"
					locInstallDetail "expansion.ledger-book.install"
				}
				purchase { cashCost { cash -100 } }
			}
			]
		}
	}
}

{	ident { template conversion-apple-juice parent material-conversion-group } 
	defmodule { def {
		id conversion-apple-juice		#type manufacture-module-config
		common {
			tags [ tag-biz-back tag-biz-apple-juice ]
			reqs [ { #type check-player-skills has any of [ juice-pressing juice-pressing-sparkling-cider ] } ]
			visreqs [ 
				{ #type check-player-skills has any of [ juice-pressing juice-pressing-sparkling-cider ] }
			]
			skills [ tag-skills-juice-pressing tag-skills-improved-cider ]
			upgradetag	tag-upgrade-apple-juice
			display {
				icon "Module Icon Apple Juice"
				locname "module.conversion-apple-juice.name"
				locdesc "module.conversion-apple-juice.desc"
				locInstallDetail "module.conversion-apple-juice.details"
				locintroflavor "convo.ticket-intro-flavor.module.conversion-apple-juice"
				accentSprite "Accent Conversion Apple Juice"
				operationSprite "Operation Conversion Apple Juice"
			}
			purchase {
				size [ tag-size-small ]
				verticals [ tag-vert-booze ]
				cashCost { cash -750 }
				buildTurns { value 7 }
				consume [{ id pipes qty -5 } { id half-barrels qty -25 } { id bricks qty -6 } ]
			}			
		}
		recipes [
			{
				locdesc "module.conversion-apple-juice.desc"
				locScopeOut "recipe.scopeout.source-apple-juice"
				produceConsumeDayz 28
				refill [ { id apples below 20 get 8 } { id half-barrels below 12 get 8 } ]
				consume [ { id apples qty -8 } { id half-barrels qty -16 } ]
				produce [ { id apple-juice qty 16 } ]
				selloff [ { id apple-juice above 16 sell -16 } ]
			}
		]
		locintroflavor "convo.ticket-intro-flavor.module.conversion-apple-juice"
		interesting #true
	} } }

