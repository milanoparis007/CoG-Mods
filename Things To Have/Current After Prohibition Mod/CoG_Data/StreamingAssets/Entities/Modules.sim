{ ident { template small-speakeasy-group }
	defmodule {
		levelups [
			{ id levelup-management is equalto value 1 target consume multiplier 1.1 }
			{ id levelup-management is equalto value 2 target consume multiplier 1.2 }
			{ id levelup-management is equalto value 3 target consume multiplier 1.4 }
			{ id levelup-bartending	is equalto value 1 target consume multiplier 1.1 }
			{ id levelup-bartending is equalto value 2 target consume multiplier 1.2 }
			{ id levelup-bartending is equalto value 3 target consume multiplier 1.3 }
			{ id levelup-bartending is equalto value 4 target consume multiplier 1.4 }
			{ id levelup-bartending is equalto value 5 target consume multiplier 1.5 }
			{ id levelup-bartending is equalto value 6 target consume multiplier 1.6 }
			{ id levelup-bartending is equalto value 7 target consume multiplier 1.75 }
			{ id levelup-faster-consume is equalto value 1 target consumeDays multiplier 0.9 }
			{ id levelup-faster-consume is equalto value 2 target consumeDays multiplier 0.8 }
			{ id levelup-faster-consume is equalto value 3 target consumeDays multiplier 0.7 }
			{ id levelup-faster-consume is equalto value 4 target consumeDays multiplier 0.65 }
			{ id levelup-faster-consume is equalto value 5 target consumeDays multiplier 0.6 }
		]

		;expansions {

		;}
	}
}

	;; bottled booze consumption
{	ident { template small-speakeasy-player parent small-speakeasy-group } 
	defmodule { def {
		id small-speakeasy-player		#type consumer-module-config
		common {
			tags [ tag-biz-back ]
			reqs [ { #type check-player-skills has any of [ small-speakeasy ] } ]
			visreqs [ { #type check-laws has any of [ prohibition ] active #true } { #type check-player-skills has any of [ small-speakeasy ] } ]
			display {
				icon "Module Icon Small Speakeasy"
				locicon	"module.icons.small-speakeasy"
				locname "module.small-speakeasy.name"
				locdesc "module.small-speakeasy.desc"
				locInstallDetail "module.small-speakeasy.details"
				locintroflavor "convo.ticket-intro-flavor.module.small-speakeasy"
				operationSprite "Operation Small Speakeasy"
			}
			purchase {
				size [ tag-size-small ]
				verticals [ tag-vert-booze ]
				cashCost { cash -7500 }
				buildTurns { value 8 }
				consume [ { id liquor-license qty -2 }  { id furniture qty -40 } { id lumber qty -40 } ]
			}
		}
		sink {
			locdesc "recipe.small-speakeasy"
			locScopeOut "recipe.scopeout.illegal-consume-booze-small"
			locFlavorDesc "recipe.flavorcopy.small-speakeasy"

			refill [ { id group-level-two below 60 get 50 } ]
			
			consumeDayz 58
			consume [ { id group-level-two qty -40 } ]

			aoe {
				priceMarkup { value 2.5 }

				customerRadius 25
				respectRadius { value 28 } ; mods [ ] }
				respectLockey "modulerespect.high"
				respectPointsInRadius {
					value 30
					mods [ { #type same-ethnicity-at-node-mod multiplier 25 } ]
				}
			}
		}
		interesting #true
		locintroflavor "convo.ticket-intro-flavor.module.small-speakeasy"
} } }
{	ident { template small-speakeasy-player-a parent small-speakeasy-player }
	defmodule { def {
		id small-speakeasy-player-a			#type consumer-module-config
		common {
			upgradetag tag-upgrade-speakeasy-track-four
			visreqs [
				{ #type check-laws has any of [ prohibition ] active #true }
				{ #type check-backroom-in-convo empty #true }
				{ #type check-player-skills has all of [ small-speakeasy ] }
				{ #type check-player-unlocked-resources has all of [ whiskey-bottled ] }
				{ #type check-current-city is none of [ pittsburgh cincinnati new-york ] }
			]
		}
		sink {
			refill [ { id group-level-two below 60 get 60 } { id ethnic-alcohol below 5 get 40 needsEthPack #true eth ir } { id whiskey-bottled below 40 get 40 } ]
			consume [ { id group-level-two qty -60 } { id ethnic-alcohol qty -50 needsEthPack #true eth ir } { id whiskey-bottled qty -40 } ]
		}
} } }
