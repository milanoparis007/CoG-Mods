				refill [ { id neutral-alcohol below 30 get 20 } { id crocks below 60 get 50 } ]
				consume [ { id neutral-alcohol qty -20 } { id crocks qty -50 } ]
				produce [ { id moonshine qty 50 } ]
				selloff [ { id moonshine above 80 sell -50 } ]
				mods {
					produceqty [ 
					]
				}
			}
