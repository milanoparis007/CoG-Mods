{	ident { template production-cannabis-grow-room parent production-homebooze-group }
	defmodule { def {
		id production-cannabis-grow-room	#type manufacture-module-config
		common {
			tags [ tag-biz-back tag-biz-grow-room ]
			visreqs [ { #type check-player-skills has any of [ drug-distribution ] } ]
			reqs [ { #type check-player-skills has any of [ cannabis-production ] } ]
			skills [ tag-skills-drug-distribution tag-skills-cannabis-production ]
			upgradetag tag-upgrade-booze-track-three
			display {
				icon "Module Icon Warehouse"
				operationSprite "BG Industrial Basement"
				locicon "module.icons.grow-room"
				locname "module.production-homebooze-cannabis-grow-room.name"
				locdesc "module.production-homebooze-cannabis-grow-room.desc"
				locInstallDetail "module.production-homebooze-cannabis-grow-room.details"
				locintroflavor "convo.ticket-intro-flavor.module.production-homebooze-cannabis-grow-room"
			}
			purchase {
				size [ tag-size-small ]
				verticals [ tag-vert-booze ]
				cashCost { cash -800 }
				buildTurns { value 3 }
				consume [ { id localdealer qty -1 } { id lumber qty -8 } ]
			}
		}
		recipes [
			{
				locdesc "recipe.biz-home-brewer.grow-room"
				locScopeOut "recipe.scopeout.illegal-grow-room"
				produceConsumeDayz 90
				refill [ { id dirt-barrel below 20 get 12 } { id cannabis-seeds below 20 get 12 } ]
				consume [ { id dirt-barrel qty -12 } { id cannabis-seeds qty -12 } ]
				produce [ { id dirt-barrel qty 6 } { id cannabis-seeds qty 16 } { id dried-cannabis qty 200 } ]
				selloff [ { id dirt-barrel above 90 sell -45 } { id cannabis-seeds above 90 sell -45 } { id dried-cannabis above 90 sell -45 } ]
			}
		]
		interesting #true
		locintroflavor "convo.ticket-intro-flavor.module.production-homebooze-cannabis-grow-room"
	} } }
