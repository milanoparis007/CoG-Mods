{ ident { template corner-speakeasy-group } 
	defmodule {
		levelups [
			{ id levelup-management is equalto value 1 target consume multiplier 1.1 }
			{ id levelup-management is equalto value 2 target consume multiplier 1.2 }
			{ id levelup-management is equalto value 3 target consume multiplier 1.4 }
			{ id levelup-bartending	is equalto value 1 target consume multiplier 1.1 }
			{ id levelup-bartending is equalto value 2 target consume multiplier 1.2 }
			{ id levelup-bartending is equalto value 3 target consume multiplier 1.3 }
			{ id levelup-bartending is equalto value 4 target consume multiplier 1.4 }
			{ id levelup-bartending is equalto value 5 target consume multiplier 1.5 }
			{ id levelup-bartending is equalto value 6 target consume multiplier 1.6 }
			{ id levelup-bartending is equalto value 7 target consume multiplier 1.75 }
			{ id levelup-faster-consume is equalto value 1 target consumeDays multiplier 0.9 }
			{ id levelup-faster-consume is equalto value 2 target consumeDays multiplier 0.8 }
			{ id levelup-faster-consume is equalto value 3 target consumeDays multiplier 0.7 }
			{ id levelup-faster-consume is equalto value 4 target consumeDays multiplier 0.65 }
			{ id levelup-faster-consume is equalto value 5 target consumeDays multiplier 0.6 }
		]
		expansions {
			maxcount { value 3 mods [ 
				{ #type manager-level-test-mod id levelup-builder is equalto value 1 delta 1 } 
				{ #type traits-mod-on-manager if [ trait-organized ] delta 1 }
				{ #type traits-mod-on-manager if [ trait-lazy ] delta -1 }
				] }
			configs [
				{
				id		consumption-increase-corner-speakeasy
				target	consume
				multiplier { value 1.1 }

				visreqs [
				]
				reqs [
					{ #type check-player-skills has all of [ trap-door ] }
				]

				display {
					locicon "expansion.bootlegger-homebooze-group.consume.icon"
					locname "expansion.bootlegger-homebooze-group.consume.name"
					locdesc "expansion.bootlegger-homebooze-group.consume.desc"
					locInstallDetail "expansion.bootlegger-homebooze-group.consume.install"
				}

				purchase { cashCost { cash -1000 } }
			}
			{
				id		consumption-increase-corner-speakeasy-upgraded
				target	consume
				multiplier { value 1.1 }

				visreqs [
					{ #type always-false }
					{ #type check-module-in-convo has any of [ corner-speakeasy-player-a-upgrade corner-speakeasy-player-b-upgrade corner-speakeasy-player-c-upgrade corner-speakeasy-player-d-upgrade corner-speakeasy-player-d-upgrade-pittsburgh ] }
				]
				reqs [
					{ #type check-player-skills has all of [ trap-door ] }
				]

				display {
					locicon "expansion.bootlegger-homebooze-group.consume.icon"
					locname "expansion.bootlegger-homebooze-group.consume.name"
					locdesc "expansion.bootlegger-homebooze-group.consume.desc"
					locInstallDetail "expansion.bootlegger-homebooze-group.consume.install"
				}

				purchase { cashCost { cash -1800 } }
			}
			{
				id time-reduction-corner-speakeasy
				target consumeDays
				multiplier { value 0.9 }

				visreqs [
					{ #type check-player-skills has all of [ dishwashers ] }
				]

				reqs [ { #type check-player-skills has all of [ dishwashers ] } ]

				display {
					locicon "expansion.bootlegger-homebooze-group.time.icon"
					locname "expansion.bootlegger-homebooze-group.time.name"
					locdesc "expansion.bootlegger-homebooze-group.time.desc"
					locInstallDetail "expansion.bootlegger-homebooze-group.time.install"
				}

				purchase { cashCost { cash -1100 } }
			}
			{
				id time-reduction-bootlegger-upgraded
				target consumeDays
				multiplier { value 0.9 }

				visreqs [
					{ #type always-false }
				;	{ #type check-module-in-convo has any of [ corner-speakeasy-player-a-upgrade corner-speakeasy-player-b-upgrade corner-speakeasy-player-c-upgrade corner-speakeasy-player-d-upgrade corner-speakeasy-player-d-upgrade-pittsburgh ] }
				]

				reqs [ { #type check-player-skills has all of [ dishwashers ] } ]

				display {
					locicon "expansion.bootlegger-homebooze-group.time.icon"
					locname "expansion.bootlegger-homebooze-group.time.name"
					locdesc "expansion.bootlegger-homebooze-group.time.desc"
					locInstallDetail "expansion.bootlegger-homebooze-group.time.install"
				}

				purchase { cashCost { cash -2000 } }
			}
			{
				id fancy-glasses-corner
				target consume
				multiplier { value 1.25 }

				visreqs [
					{ #type check-player-skills has all of [ old-glassware ] }
				]

				reqs [
					{ #type check-player-skills has all of [ old-glassware ] }
				]

				display {
					locicon "expansion.bootlegger-homebooze-group.old-glassware.icon"
					locname "expansion.bootlegger-homebooze-group.old-glassware.name"
					locdesc "expansion.bootlegger-homebooze-group.old-glassware.desc"
					locInstallDetail "expansion.bootlegger-homebooze-group.old-glassware.install"
				}
				purchase { cashCost { cash -500 } }
			}
			{
				id printed-promotions
				target consumeDays
				multiplier { value 0.8 }

				visreqs [
					{ #type check-player-skills has any of [ ethnic-bump-speakeasy native-bump-speakeasy ] }
				]
				reqs [
					{ #type check-player-skills has any of [ ethnic-bump-speakeasy native-bump-speakeasy ] }
				]

				display {
					locicon "expansion.corner-speakeasy-group.printed-promotions.icon"
					locname "expansion.corner-speakeasy-group.printed-promotions.name"
					locdesc "expansion.corner-speakeasy-group.printed-promotions.desc"
					locInstallDetail "expansion.corner-speakeasy-group.printed-promotions.install"
				}
				purchase { cashCost { cash -250 } }
			}
			{
				id pool-table
				target consumeDays
				multiplier { value 0.9 }

				visreqs [
					{ #type check-player-skills has all of [ pool-table ] }
				]
				reqs [
					{ #type check-player-skills has all of [ pool-table ] }
				]

				display {
					locicon "expansion.corner-speakeasy-group.pool-table.icon"
					locname "expansion.corner-speakeasy-group.pool-table.name"
					locdesc "expansion.corner-speakeasy-group.pool-table.desc"
					locInstallDetail "expansion.corner-speakeasy-group.pool-table.install"
				}
				purchase { cashCost { cash -750 } }
			}
			{
				id player-piano
				target consume
				multiplier { value 1.1 }

				visreqs [
					{ #type check-player-skills has all of [ player-piano ] }
				]
				reqs [
					{ #type check-player-skills has all of [ player-piano ] }
				]

				display {
					locicon "expansion.corner-speakeasy-group.player-piano.icon"
					locname "expansion.corner-speakeasy-group.player-piano.name"
					locdesc "expansion.corner-speakeasy-group.player-piano.desc"
					locInstallDetail "expansion.corner-speakeasy-group.player-piano.install"
				}
				purchase { cashCost { cash -750 } }
			}
			{
				id extra-chairs
				target consume
				multiplier { value 1.1 }
				visreqs [
				]
				reqs [
					{ #type check-manager-assigned expected #true }
					{ #type check-manager-traits has any of [ trait-talkative trait-friendly trait-kind trait-attractive ] }
				]
				display {
					locicon "expansion.extra-chairs.icon"
					locname "expansion.extra-chairs.name"
					locdesc "expansion.extra-chairs.desc"
					locInstallDetail "expansion.extra-chairs.install"
				}
				purchase { cashCost { cash -200 } }
			}
			{
				id fancy-ashtray
				target consume
				multiplier { value 1.25 }

				visreqs [
					{ #type check-has-eth-pack-and-is-eth eth en }
				]
				reqs []
				display {
					locicon "expansion.fancy-ashtray.icon"
					locname "expansion.fancy-ashtray.name"
					locdesc "expansion.fancy-ashtray.desc"
					locInstallDetail "expansion.fancy-ashtray.install"
				}
				purchase { cashCost { cash -500 }}
			}
			]
		}
	}
}


{	ident { template corner-speakeasy-player-a parent corner-speakeasy-group }
	defmodule { def {
		id corner-speakeasy-player-a		#type consumer-module-config
		common {
			tags [ tag-biz-back ]
			upgradetag tag-upgrade-speakeasy-track-four
			reqs [ 
				{ #type check-player-skills has any of [ local-speakeasies ] }
			]
			visreqs [  
				 { #type check-laws has any of [ prohibition ] active #true }
				 { #type check-player-skills has any of [ local-speakeasies ] }
				 { #type check-backroom-in-convo empty #true }
				 { #type check-current-city is none of [ pittsburgh detroit cincinnati philadelphia new-york ] }
				]
			skills [  ]
			display {
				icon "Module Icon Corner Speakeasy"
				locicon	"module.icons.corner-speakeasy"
				locname "module.corner-speakeasy.name"
				locdesc "module.corner-speakeasy.desc"
				locInstallDetail "module.corner-speakeasy.details"
				locintroflavor "convo.ticket-intro-flavor.module.corner-speakeasy"
				operationSprite "Operation Corner Speakeasy"
			}
			purchase {
				size [ tag-size-small tag-size-medium ]
				verticals [ tag-vert-booze ]
				cashCost { cash -5000 }
				buildTurns { value 8 }
				consume [ { id liquor-license qty -1 } { id lumber qty -20 } { id furniture qty -30 } ]
			}
		}
		sink {
			locdesc "recipe.corner-speakeasy"
			locScopeOut "recipe.scopeout.illegal-consume-homebrew"
			locFlavorDesc "recipe.flavorcopy.biz-speakeasy"

			refill [ { id brick-wine below 40 get 40 } { id cider below 50 get 50 } { id home-brew below 75 get 75} { id moonshine below 30 get 30 } { id bathtub-gin below 20 get 20 } { id beer-keg below 20 get 20 } { id cigarettes below 8 get 8 } ]
			
			consumeDayz 28
			consume [ { id brick-wine qty -40 } { id cider qty -50 } { id home-brew qty -75 } { id moonshine qty -20 } { id bathtub-gin qty -20 } { id beer-keg qty -8 } { id cigarettes qty -8 } ]


			aoe {
				priceMarkup { value 2 }

				customerRadius 15
				respectRadius { value 24 } ; mods [ ] }
				respectLockey "modulerespect.low"
				respectPointsInRadius {
					value 20
					mods [ { #type same-ethnicity-at-node-mod multiplier 15 } ]
				}
			}
		}
		interesting #true
		locintroflavor "convo.ticket-intro-flavor.module.corner-speakeasy"
} } }
