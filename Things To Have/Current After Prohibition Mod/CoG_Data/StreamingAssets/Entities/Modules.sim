				locdesc "module.flavor-bank.desc"
			}
		}
		recipes [{
			locdesc "recipe.flavor-bank"
			locScopeOut "recipe.scopeout.flavor-bank"
			locFlavorDesc "recipe.flavorcopy.flavor-bank"
			produceConsumeDayz 14

			;; NPC? ???? ?? ? ????? ?? ??
			produce [
				{ id privateaccountsmall qty 4 }
				{ id privateaccount qty 4 }
				{ id privateaccountbank qty 2 }
				{ id privateaccountcredl qty 2 }
				{ id privateaccountsav qty 2 }
			]
			selloff [
				{ id privateaccountsmall above 12 sell -4 }
				{ id privateaccount above 12 sell -4 }
				{ id privateaccountbank above 8 sell -2 }
				{ id privateaccountcredl above 8 sell -2 }
				{ id privateaccountsav above 8 sell -2 }
			]

			;; NPC? ???? ?? ? ????? ?? ??
			refill [
				{ id privateaccountsmall below 2 get 8 }
				{ id privateaccount below 2 get 8 }
				{ id privateaccountbank below 1 get 4 }
				{ id privateaccountcredl below 1 get 4 }
				{ id privateaccountsav below 1 get 4 }
			]
		}]
} } }

