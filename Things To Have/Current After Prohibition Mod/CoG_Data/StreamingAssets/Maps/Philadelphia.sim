			{
				id CenterCity
				forceStart { x 351 y 223 }
				nodeSpacing { width 8 height 8 }
				forceAngle 12
				forceMaxSize 225
				forceMaxSpread { width 100 height 100 }
				stopAtWater #true
			}
			{
				id PennsLanding
				forceStart { x 411 y 243 }
