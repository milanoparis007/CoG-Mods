{ maps [ {
	id philadelphia
	citytype philadelphia

	citylockey	"city-name.philadelphia"
	statelockey	"state-name.pennsylvania"
	citydesckey	"city-desc.philadelphia"
	cityscreen	"Philadelphia Screenshot"
	citylocicon	"city-icon.philadelphia"
	citypolunitkey	"city-pol-unit.ward"

	map {
		mapSize		{ width 600 height 400 }
		streetNames [ 
			"streets.usfounders" "streets.famouspeople" "streets.usstates" "streets.uscities"
			"streets.smalltown" "streets.trees" "streets.plants" "streets.birds" 
			"streets.lastnames" "streets.generic" ]
