{
	people {

		allBuffs {

		definitions [
			;; 
			;; relationship buffs

			;; persistent. priority gets sorted in ascending order (0 on top, 1 below, etc)
			

			;; this buff is for the player themselves ("it's you" etc)
			{ 	id relbuff-starting-self		locdesc "relbuff.starting-self" 
				delta { value 50 }
			}
			;; this buff is for the player's immediate family ("they're not perfect, but they're family" etc)
			{ 	id relbuff-starting-fam			locdesc "relbuff.starting-fam" 
				delta { value 30 
					mods [{ #type traits-mod if [ trait-friendly ] delta 10 }]
					mods [{ #type traits-mod if [ trait-irritable trait-unkind ] delta -10 }]
					mods [{ #type traits-mod if [ trait-cruel ] delta -15 }]
				}
			}
			;; this buff is for the player's extended family ("they're distant family, but they're family" etc)
			{ 	id relbuff-starting-fam-ext		locdesc "relbuff.starting-fam-ext" 
				delta { value 20 
					mods [{ #type traits-mod if [ trait-friendly ] delta 2 }]
					mods [{ #type traits-mod if [ trait-irritable trait-unkind ] delta -2 }]
					mods [{ #type traits-mod if [ trait-cruel ] delta -5 }]
				}
			}
			;; this buff is related to the player's starting area ("they know you back in the day" etc)
			{ 	id relbuff-starting-oldfriends	locdesc "relbuff.starting-buff" 
				delta { value 20 
					mods [{ #type traits-mod if [ trait-friendly ] delta 8 }]
					mods [{ #type traits-mod if [ trait-irritable trait-unkind ] delta -8 }]
				}
			}
			;; this buff is specifically for francine (adds on top of relbuff-starting-fam-ext)
			{ 	id relbuff-starting-francine	locdesc "relbuff.starting-francine" 
				delta { value 10 }
			}
			;; this buff is applied to how the player thinks about their crew
			{ 	id relbuff-player-to-crew	locdesc "relbuff.player-to-crew" 
				delta { value 20 }
			}
			;; this buff is applied to how the crew think about the player
			{ 	id relbuff-crew-to-player	locdesc "relbuff.crew-to-player" 
				delta { value 20 }
			}
			;; buff for how crew family thinks of the player
			{ 	id relbuff-crew-fam-to-player	locdesc "relbuff.crew-fam-to-player" 
				delta { value 10 }
			}

			;; buff applied on scopeout, based on just npc's personality
			{ 	id relbuff-scopeout-npc			locdesc "relbuff.scopeout-npc" 
				delta { value 0 
					mods [
						{ #type traits-mod if [ trait-friendly ] delta 3 }
						{ #type traits-mod if [ trait-irritable trait-cautious ] delta -5 }
						{ #type traits-mod if [ trait-curious ] delta 8 }
						{ #type traits-mod-on-crew-peep if [ trait-friendly ] delta 2 }
					]
				}
			}
			;; buff applied on scopeout, grants a slight buff due to same ethnicity
			{ 	id relbuff-scopeout-ethnicity	locdesc "relbuff.scopeout-ethnicity" 
				delta { value 6 
					mods [
						{ #type skills-mod if [ starter-crew ] delta 4 }
						{ #type traits-mod if [ trait-friendly ] delta 4 }
						{ #type traits-mod if [ trait-cautious ] delta -4 }
						{ #type quest-mod id polish-patriot-three is completed delta 6 }
					]
				}
			}
			{ 	id relbuff-goldticket-buff		locdesc "relbuff.goldticket-buff" 
				delta { value 10 }
			}

			;; based on tribute

			;; they don't like being extorted
			{ 	id relbuff-tribute-any			locdesc "relbuff.tribute-any" 
				cancels [ relbuff-tribute-canceled relbuff-tribute-after-cancel ]
				delta { value -20 
					mods [
						{ #type traits-mod if [ trait-irritable ] delta -5 }
						{ #type traits-mod if [ trait-vindictive ] delta -10 }
						{ #type traits-mod-on-either if [ trait-friendly ] delta 10 }
						{ #type skills-mod if [ starter-protection ] delta 6 }
					]
				}
				dayz { value 180  
					mods [
						{ #type traits-mod if [ trait-irritable trait-unkind ] multiplier 1.2 }
						{ #type traits-mod if [ trait-vindictive ] multiplier 1.2 }
						{ #type traits-mod-on-either if [ trait-friendly ] multiplier 0.5 }
						{ #type skills-mod if [ starter-protection ] delta -40 }
					]
				}
			}

			;; they don't like being extorted while helping you
			{ 	id relbuff-tribute-after-helping	locdesc "relbuff.tribute-after-helping" 
				cancels [ relbuff-tribute-canceled relbuff-tribute-after-cancel ]
				delta { value -40 
					mods [
						{ #type traits-mod if [ trait-vindictive ] multiplier 1.5 }
					]
				}
				dayz { value 365 
					mods [
						{ #type traits-mod if [ trait-vindictive ] multiplier 1.2 }
					]
				}
			}

			;; relief after the player intentionally cancels tribute
			{	id relbuff-tribute-canceled		locdesc "relbuff.tribute-canceled"
				dayz { value 84 }
				delta { value 10
					mods [
						{ #type traits-mod if [ trait-forgiving ] multiplier 1.5 }
					]
				}
			}

			;; residual dislike after protection (whether lost accidentally, or canceled by player)
			{	id relbuff-tribute-after-cancel		locdesc "relbuff.tribute-after-cancel"
				delta { value -10 }
				dayz { value 42 					
					mods [
						{ #type traits-mod if [ trait-vindictive ] multiplier 2 }
					]
				}
			}

			;; based on specific quests
			;; getting to know people who buy the booze the player makes/has
			{	id relbuff-quest-homebooze			locdesc "relbuff.quest-same-biz"
				delta { value 10 }
				dayz { value 14 }
			}
			{	id relbuff-quest-counterfeit			locdesc "relbuff.quest-counterfeit"
				delta { value 8 }
				dayz { value 28 }
			}
			{	id relbuff-quest-gatsbyrec			locdesc "relbuff.quest-gatsbyrec"
				delta { value 15 }
				dayz { value 21 }
			}
			{	id relbuff-quest-schoolstart			locdesc "relbuff.quest-schoolstart"
				delta { value 6 }
				dayz { value 7 }
			}
			{	id relbuff-quest-schoolstarts			locdesc "relbuff.quest-schoolstarts"
				delta { value 18 }
				dayz { value 720 }
			}
			{	id relbuff-quest-schoolstart3			locdesc "relbuff.quest-schoolstart3"
				delta { value 4 }
				dayz { value 7 }
			}
			{	id relbuff-quest-churchstart			locdesc "relbuff.quest-churchstart"
				delta { value 8 }
				dayz { value 7 }
			}
			{	id relbuff-quest-churchstarts			locdesc "relbuff.quest-churchstarts"
				delta { value 18 }
				dayz { value 720 }
			}
			{	id relbuff-quest-churchstart2			locdesc "relbuff.quest-churchstart2"
				delta { value 3 }
			}
			{	id relbuff-quest-churchstart3			locdesc "relbuff.quest-churchstart3"
				delta { value 8 }
				dayz { value 28 }
				cancels [ relbuff-quest-churchstart2 ]
			}
			{	id relbuff-quest-leaderstart			locdesc "relbuff.quest-leaderstart"
				delta { value 21 }
				dayz { value 84 }
			}
			{	id relbuff-quest-dance-offers			locdesc "relbuff.quest-dance-offers"
				delta { value 15 }
				dayz { value 21 }
			}
			{	id relbuff-quest-dealer-offers			locdesc "relbuff.quest-dealer-offers"
				delta { value 35 }
				dayz { value 14 }
			}
			{	id relbuff-quest-musician-offers			locdesc "relbuff.quest-musician-offers"
				delta { value 15 }
				dayz { value 21 }
			}
			{	id relbuff-quest-small-gatsby			locdesc "relbuff.quest-small-gatsby"
				delta { value 20 }
				dayz { value 84 }
			}
			{	id relbuff-quest-large-gatsby			locdesc "relbuff.quest-large-gatsby"
				delta { value 35 }
				dayz { value 168 }
			}
			{	id relbuff-quest-bottled-booze		locdesc "relbuff.quest-bottled-booze"
				delta { value 15 }
				;; no expiration - gets cleaned up by later quest.
			}
			{	id relbuff-quest-bottled-booze-skill		locdesc "relbuff.quest-bottled-booze"
				delta { value 15 }
				;; no expiration - gets cleaned up by later quest.
			}
			{	id relbuff-quest-bottled-booze-partners		locdesc "relbuff.quest-bottled-partners"
				delta { value 15 }
				;; no expiration - gets cleaned up by later quest.
			}
			{
				id homebooze-drop-fail-buff			locdesc "relbuff.drop-failed"
				delta { value -5 mods [ { #type traits-mod if [ trait-irritable trait-unkind ] delta -5 } ] }
				dayz { value 84 mods [
					{ #type traits-mod if [ trait-upright ] delta 14 }
					{ #type traits-mod if [ trait-slow ] delta -28 }
					{ #type traits-mod if [ trait-immoral ] delta -28 }
					{ #type traits-mod if [ trait-vindictive ] multiplier 1.25 }
					{ #type traits-mod-on-either if [ trait-forgiving ] multiplier 0.8 }
				] }
			}
			{
				id relbuff-loan-granted				locdesc "relbuff.loan-granted"
				delta { value 5 }
				dayz { value 720 mods [
					{ #type traits-mod if [ trait-mellow ] multiplier 1.25 }
				] }
			}
			{
				id learn-level-two-fail-buff		locdesc "relbuff.learn-fail"
				delta { value -5 mods [ { #type traits-mod if [ trait-irritable ] delta -5 } ] }
				dayz { value 84 mods [
					{ #type traits-mod if [ trait-upright ] delta 14 }
					{ #type traits-mod if [ trait-slow ] delta -28 }
					{ #type traits-mod if [ trait-immoral ] delta -28 }
					{ #type traits-mod if [ trait-vindictive ] multiplier 1.25 }
					{ #type traits-mod-on-either if [ trait-forgiving ] multiplier 0.8 }
				] }
			}
			{ 	id relbuff-quest-expired			locdesc "relbuff.quest-expired" 
				delta { value -10 mods [ { #type traits-mod if [ trait-irritable trait-unkind ] delta -5 } ] }
				dayz { value 42 mods [
					{ #type traits-mod if [ trait-upright ] delta 14 }
					{ #type traits-mod if [ trait-slow ] delta -28 }
					{ #type traits-mod if [ trait-immoral ] delta -28 }
					{ #type traits-mod if [ trait-vindictive ] multiplier 1.25 }
					{ #type traits-mod-on-either if [ trait-forgiving ] multiplier 0.8 }
				] }
			}
			{ 	id relbuff-resevent-quest-expired	locdesc "relbuff.resevent-quest-expired" 
				delta { value -15 mods [ { #type traits-mod if [ trait-irritable trait-unkind ] delta -5 } ] }
				dayz { value 42 mods [
					{ #type traits-mod if [ trait-upright ] delta 14 }
					{ #type traits-mod if [ trait-slow ] delta -28 }
					{ #type traits-mod if [ trait-immoral ] delta -28 }
					{ #type traits-mod if [ trait-vindictive ] multiplier 1.25 }
					{ #type traits-mod-on-either if [ trait-forgiving ] multiplier 0.8 }
				] }
			}
			;; quests asking for protection from harassment
			{	id relbuff-quest-protection-pos 	locdesc "relbuff.quest.protection-broken.pos"
				delta { value 20 mods [ { #type traits-mod if [ trait-irritable trait-unkind ] delta -5 } ] }
				dayz { value 126 mods [
					{ #type traits-mod if [ trait-mellow ] multiplier 1.25 }
				] }
			}
			{	id relbuff-quest-protection-neg 	locdesc "relbuff.quest.protection-broken.neg"
				delta { value -40 }
				dayz { value 252 mods [
					{ #type traits-mod if [ trait-upright ] delta 14 }
					{ #type traits-mod if [ trait-slow ] delta -28 }
					{ #type traits-mod if [ trait-immoral ] delta -28 }
					{ #type traits-mod if [ trait-vindictive ] multiplier 1.25 }
					{ #type traits-mod-on-either if [ trait-forgiving ] multiplier 0.8 }
				] }
			}
			{	id relbuff-goon-trouble-pos 		locdesc "relbuff.quest.goon-trouble.pos"
				delta { value 20 }
				dayz { value 126 mods [
					{ #type traits-mod if [ trait-mellow ] multiplier 1.25 }
				] }
			}
			{	id relbuff-goon-trouble-neg 		locdesc "relbuff.quest.goon-trouble.neg"
				delta { value -40 mods [ 
					{ #type crew-peep-level-test-mod id levelup-smooth-talker is equalto value 1 delta 5 }
					{ #type crew-peep-level-test-mod id levelup-smooth-talker is equalto value 2 delta 10 }
					{ #type traits-mod if [ trait-irritable trait-unkind ] delta -5 } 
				] }
				dayz { value 252 mods [
					{ #type traits-mod if [ trait-upright ] delta 14 }
					{ #type traits-mod if [ trait-slow ] delta -28 }
					{ #type traits-mod if [ trait-immoral ] delta -28 }
					{ #type traits-mod if [ trait-vindictive ] multiplier 1.25 }
					{ #type traits-mod-on-either if [ trait-forgiving ] multiplier 0.8 }
				] }
			}
			{	id relbuff-harassed-family-inf-pos 	locdesc "relbuff.quest.harassed-family-inf.pos"
				delta { value 10 }
				dayz { value 126 }
			}
			{	id relbuff-harassed-family-inf-neg 	locdesc "relbuff.quest.harassed-family-inf.neg"
				delta { value -20 mods [ { #type traits-mod if [ trait-irritable trait-unkind ] delta -5 } ] }
				dayz { value 252 }
			}
			{
				id relbuff-volksfest	locdesc "relbuff.quest.volksfest"
				delta { value 15 }
				dayz { value 364 }
			}


			;; based on tix

			;; introduced to somebody
			{ 	id relbuff-ticket-intro			locdesc "relbuff.ticket-intro" 
				delta { value 15 
					mods [
					{ #type crew-peep-level-test-mod id levelup-smooth-talker is equalto value 1 delta 4 }
					{ #type traits-mod if [ trait-sociable trait-nervous trait-cautious ] delta 4 } 
				]
				}
				cancels [ relbuff-goons-wrong-foot ]
				dayz { value 252 }
			}

			;; npc put in a good word
			{ 	id relbuff-ticket-npcboost		locdesc "relbuff.ticket-npcboost" 
				delta { value 20 }
				cancels [ relbuff-goons-wrong-foot ]
				dayz { value 252 }
			}

			;; friendly npc helped us with a crew hire, and now they like us a lot
			{ 	id relbuff-ticket-crewhire-friend	locdesc "relbuff.ticket-crewboost-friend" 
				delta { value 20 }
				dayz { value 252 }
			}

			;; player bought a building for this npc's family member or friend
			{	id relbuff-ticket-building-intro	locdesc "relbuff.ticket-building-intro"
				delta { value 10 }
				;; no expiry
			}
			;; player bought a building and this is the newly installed manager npc
			{	id relbuff-ticket-building-manager	locdesc "relbuff.ticket-building-manager"
				delta { value 20 }
				;; no expiry
			}
			;; taught the player a skill
			{ 	id relbuff-ticket-taught-skill		locdesc "relbuff.ticket-taught-skill"
				delta { 
					value 15 
					mods [ 
						{ #type traits-mod if [ trait-intelligent ] delta 3 } 
						{ #type traits-mod if [ trait-hardworking ] multiplier 2 } 
					]
				} 
				dayz { value 126 mods [
					{ #type traits-mod if [ trait-mellow ] multiplier 1.25 }
				] }
			}
			;; ticket request for political support
			{
				id relbuff-ticket-politician-boost	locdesc	"relbuff.ticket-politician-boost"
				delta { value 5 }
				dayz { value 252 }
			}
			{
				id relbuff-ny-pol-starter	locdesc	"relbuff.ny-pol-starters"
				delta { value 25 }
			}
			{
				id relbuff-recent-campaign-action	locdesc "relbuff.recent-campaign-action"
				delta	{ value 5 }
				dayz	{ value 21 }
			}
			;; this npc is a tied house
			{ 	id relbuff-tied-house				locdesc "relbuff.tied-house" 
				delta { value 10 }
				dayz { value 126 mods [
					{ #type traits-mod if [ trait-mellow ] multiplier 1.25 }
				] }
			}
			;; this npc manages a player outpost
			{ 	id relbuff-outpost-manager			locdesc "relbuff.outpost-manager" 
				delta { value 30 }
				;; no expiry, this will go away once they're fired
			}
			;; has got the player a weapon
			{	id relbuff-outpost-weapons			locdesc "relbuff.outpost-weapons"
				delta { value 5 }
				;; no expiry - one weapon per outpost
			}
			;; this npc used to manage an outpost for the player
			{ 	id relbuff-outpost-manager-fired	locdesc "relbuff.outpost-manager-fired" 
				delta { value -10 mods [
					{ #type traits-mod if [ trait-upright ] delta 10 }
					{ #type traits-mod if [ trait-slow ] delta -20 }
					{ #type traits-mod if [ trait-immoral ] delta -20 }
					{ #type traits-mod if [ trait-vindictive ] multiplier 1.25 }
					{ #type traits-mod-on-either if [ trait-forgiving ] multiplier 0.8 }
				] }
				dayz { value 126 }
			}
			;; this npc used to manage an outpost for the player but it closed due to non-payment
			{ 	id relbuff-outpost-manager-neg		locdesc "relbuff.outpost-manager-neg" 
				delta { value -15 mods [ { #type traits-mod if [ trait-irritable trait-unkind ] delta -5 } ] }
				dayz { value 126 mods [
					{ #type traits-mod if [ trait-upright ] delta 14 }
					{ #type traits-mod if [ trait-slow ] delta -28 }
					{ #type traits-mod if [ trait-immoral ] delta -28 }
					{ #type traits-mod if [ trait-vindictive ] multiplier 1.25 }
					{ #type traits-mod-on-either if [ trait-forgiving ] multiplier 0.8 }
				] }
			}
			;; similarly but for the family of the manager who wasn't paid
			{ 	id relbuff-outpost-manager-negfam	locdesc "relbuff.outpost-manager-negfam" 
				delta { value -5 }
				dayz { value 126 }
			}

