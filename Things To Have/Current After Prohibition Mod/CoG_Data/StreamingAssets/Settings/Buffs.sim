			{	
				id heatbuff-from-crew-personality
				delta { value 0 mods [
					{ #type traits-mod-on-crew-peep if [ trait-intelligent ] delta -5 }
					{ #type traits-mod-on-crew-peep if [ trait-cautious ] delta -5 }
					{ #type traits-mod-on-crew-peep if [ trait-talkative ] delta 10 }
					{ #type traits-mod-on-crew-peep if [ trait-quiet ] delta -10 }
					{ #type crew-peep-level-test-mod id levelup-leader1 is atleast value 1 delta 10 }
					{ #type crew-peep-level-test-mod id levelup-alley-master is atleast value 1 delta -5 }
					{ #type crew-peep-level-test-mod id levelup-alley-master is atleast value 2 delta -5 }
					{ #type crew-peep-level-test-mod id levelup-alley-master is atleast value 3 delta -5 }
				]}
