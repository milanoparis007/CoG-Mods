				delta { value 0 mods [
					{ #type traits-mod-on-crew-peep if [ trait-intelligent ] delta 2 }
					{ #type traits-mod-on-crew-peep if [ trait-sociable trait-friendly ] delta 3 }
					{ #type traits-mod-on-crew-peep if [ trait-confident ] delta 4 }
					{ #type traits-mod-on-crew-peep if [ trait-talkative ] delta 4 }
					{ #type crew-peep-level-test-mod id levelup-leader1 is atleast value 1 delta 10 }
					{ #type crew-peep-level-test-mod id levelup-city-driver is atleast value 1 delta 5 }
					{ #type crew-peep-level-test-mod id levelup-city-driver is atleast value 2 delta 5 }
					{ #type crew-peep-level-test-mod id levelup-city-driver is atleast value 3 delta 5 }
				]}
				dayz { value 126 }
				locdesc	"relbuff.from-crew-personality"
			}

