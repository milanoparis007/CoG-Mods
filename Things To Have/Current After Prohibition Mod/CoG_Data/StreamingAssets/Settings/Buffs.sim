			;; related to business dealings and the results of haggling, expiring

			{ 	id relbuff-player-pays-more		locdesc "relbuff.player-pays-more" 
				delta { value 5 
					mods [
						{ #type traits-mod if [ trait-hardworking ] delta 5 }
					]
				}
				dayz { value 42 }
			}
			{ 	id relbuff-player-pays-less		locdesc "relbuff.player-pays-less" 
				delta { value -3 
					mods [
						{ #type traits-mod if [ trait-upright ] delta -2 }
						{ #type traits-mod if [ trait-irritable trait-unkind ] delta -5 }
					]
				}
				dayz { value 42 mods [
					{ #type traits-mod if [ trait-upright ] delta 14 }
					{ #type traits-mod if [ trait-slow ] delta -28 }
					{ #type traits-mod if [ trait-immoral ] delta -28 }
					{ #type traits-mod if [ trait-vindictive ] multiplier 1.25 }
					{ #type traits-mod-on-either if [ trait-forgiving ] multiplier 0.8 }
				] }
			}
			{ 	id relbuff-player-sells-cheap	locdesc "relbuff.player-sells-cheap" 
				delta { value 5 
					mods [
						{ #type traits-mod if [ trait-hardworking ] delta 5 }
					]
				}
				dayz { value 42 }
			}
			{ 	id relbuff-player-gouges		locdesc "relbuff.player-gouges" 
				delta { value -7 
					mods [
						{ #type traits-mod if [ trait-hardworking trait-upright ] delta -8 }
						{ #type traits-mod if [ trait-irritable trait-unkind ] delta -5 }
					]
				}
				dayz { value 42 }
			}

