					cost [ { money { cash -750 } } ]
					nextState late-night-delivery-aged-whiskey
				}
				{
					visReqs [
						{ #type check-player-unlocked-resources has all of [ gin ] }
					]
					locoption "chapter.suburban-supplies.decide.late-night-delivery.gin"
					cost [ { money { cash -750 } } ]
					nextState late-night-delivery-gin
				}
				{	;; stop - no visreqs for a cancel
					locoption	"chapter.schemes-general.decide.cancel"
					locepilogue	"chapter.schemes-general-nothing.decide.cancel.epilogue"
					earlyEnd	true
				}
			]
			failChoices [
				{
					visReqs [
						{ #type check-crew-traits has any of [ trait-loner trait-confident trait-aggressive trait-immoral trait-vindictive ]  }
					]
					locoption "chapter.suburban-supplies.fail.runaway-crew"
					nextState runaway-crew
				}
				{
					visReqs [
						{ #type check-crew-traits has any of [ trait-slow trait-myopic trait-clumsy trait-lazy ] }
					]
					locoption "chapter.suburban-supplies.fail.dumb-crew"
					nextState dumb-crew
				}
				{
					visReqs [
						{ #type check-crew-traits has none of [ trait-loner trait-confident trait-aggressive trait-immoral trait-vindictive trait-slow trait-myopic trait-clumsy trait-lazy ] }
					]
					locoption "chapter.suburban-supplies.fail.no-traits"
					locepilogue "chapter.suburban-supplies.fail.no-traits.epilogue"
				}
			]
		}
