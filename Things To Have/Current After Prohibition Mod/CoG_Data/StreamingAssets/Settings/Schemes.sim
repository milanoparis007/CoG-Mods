			successChance { value 0.9 }
			timeCostDays { value 21 }

			script move-to-target-and-wait
			recoveryScript teleport-to-target
			selectTarget true

			successChoices [
				{
					visReqs []
					locoption "chapter.jewel-search.decide.cat-burglary"
					nextState cat-burglary
				}
				{
					visReqs []
					locoption "chapter.jewel-search.decide.daylight-robbery"
					nextState daylight-robbery
				}
				{	;; stop - no visreqs for a cancel
					locoption	"chapter.schemes-general.decide.cancel"
					locepilogue	"chapter.schemes-general-nothing.decide.cancel.epilogue"
					earlyEnd	true
				}
			]
			failChoices [
				{
					visReqs []
					locoption "chapter.jewel-search.fail"
					locepilogue "chapter.jewel-search.fail.epilogue"
					grants [ { #type add-resource id weapon-winchester qty 1 at safehouse } ]
				}
			]
		}
