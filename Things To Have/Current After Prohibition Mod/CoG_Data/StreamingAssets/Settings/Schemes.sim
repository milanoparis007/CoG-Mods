{ schemes {

	concurrentSchemesAllowed	{ value 4  mods [
			{ #type current-city-mod is any of [ philadelphia ] check id-only delta 1 }
		] }

	schemeDefs [
		{
			id bank-heist

			display {
				loctitle	"scheme.bank-heist.title"
				locdesc		"scheme.bank-heist.desc"
				locconvo	"convo.scheme.bank-heist"
			}

			startup {
				targetIdPrefixes [ biz-bank biz-treasury biz-downtown-bank biz-neighborhood-bank ]
				visreqs [
					{ #type check-scheme-crew-alive }
					{ #type check-scheme-crew-in-canada expected false }
					{ #type check-crew-convo-role id enforcer }
					{ #type check-player-cash type current is lessthan value 1000000 }
					{ #type check-player-has-valid-scheme-target id bank-heist}
					{ #type check-scheme-cooldown id bank-heist expected false }
				]
				reqs [
					{ #type check-under-concurrent-scheme-max expected #true }
					{ #type special-can-pay-scheme-startup-costs }
					{ #type check-crew-peep-assigned to vehicle target npc}
				]
				cost [
					{ money {cash -800} }
				]

				firstChapter	find-banks
			}
			
			cooldownDays	21
		}
		{
			id jewel-heist
			display {
				loctitle	"scheme.jewel-heist.title"
				locdesc		"scheme.jewel-heist.desc"
				locconvo	"convo.scheme.jewel-heist"
			}

			startup {
				targetIdPrefixes [ biz-jeweler-philadelphia ]
				visreqs [
					{ #type check-scheme-crew-alive }
					{ #type check-scheme-crew-in-canada expected false }
					{ #type check-crew-convo-role id enforcer }
					{ #type check-player-unlocked-resources has all of [ jewelry ] }
					{ #type check-player-has-total resource jewelry is lessthan value 5 }
					{ #type check-player-has-valid-scheme-target id jewel-heist }
					{ #type check-scheme-cooldown id jewel-heist expected false }
				]
				reqs [
					{ #type check-under-concurrent-scheme-max expected #true }
					{ #type special-can-pay-scheme-startup-costs }
					{ #type check-crew-peep-assigned to vehicle target npc}
				]
				cost [
					{ money { cash -250 } }
					{ raq { id weapon-thompson qty 1 } }
				]

				firstChapter	jewel-search
			}

			cooldownDays 21
		}
		{
			id warehouse-pressure

			display {
				loctitle	"scheme.warehouse-pressure.title"
				locdesc		"scheme.warehouse-pressure.desc"
				locconvo	"convo.scheme.warehouse-pressure"
			}

			startup {
				targetIdPrefixes [ biz-warehouse-medium biz-cold-storage-source ]
				visreqs [
					{ #type check-scheme-crew-alive }
					{ #type check-scheme-crew-in-canada expected false }
					{ #type check-crew-convo-role id persuader }
					{ #type check-player-has-valid-scheme-target id warehouse-pressure }
					{ #type check-scheme-cooldown id warehouse-pressure expected #false }
					{ #type check-player-production-stalled daysBack 365 expected #true }
				]
				reqs [ { #type check-under-concurrent-scheme-max expected #true } 
					   { #type special-can-pay-scheme-startup-costs } 
					   { #type check-crew-peep-assigned to vehicle target npc}
				]
				cost [
					{ raq { id weapon-bat qty 4 } }
					{ money { cash -800 } }
				]

				firstChapter	find-warehouses
			}

			cooldownDays	35
		}
		{
			id speakeasy-pressure
			display {
				loctitle	"scheme.speakeasy-pressure.title"
				locdesc		"scheme.speakeasy-pressure.desc"
				locconvo	"convo.scheme.speakeasy-pressure"
			}

			startup {
				targetIdPrefixes [ biz-drugstore biz-restaurant-buffet biz-cafeteria ]
				visreqs [
					{ #type check-scheme-crew-alive }
					{ #type check-scheme-crew-in-canada expected false }
					{ #type check-crew-convo-role id deal-maker }
				]
				reqs [
					{ #type check-under-concurrent-scheme-max expected #true }
					{ #type special-can-pay-scheme-startup-costs }
					{ #type check-crew-peep-assigned to vehicle target npc}
				]
				cost [
					{ money { cash -1200 } }			
				]

				firstChapter	find-connections
			}

			cooldownDays	21
		}
		{
			id burglar-man
			display {
				loctitle	"scheme.burglar-man.title"
				locdesc		"scheme.burglar-man.desc"
				locconvo	"convo.scheme.burglar-man"
			}

			startup {
				targetIdPrefixes [ biz-drugstore biz-restaurant-buffet biz-cafeteria ]
				visreqs [
					{ #type check-scheme-crew-alive }
					{ #type check-scheme-crew-in-canada expected false }
					{ #type check-crew-convo-role id robber }
				]
				reqs [
					{ #type check-under-concurrent-scheme-max expected #true }
					{ #type special-can-pay-scheme-startup-costs }
					{ #type check-crew-peep-assigned to vehicle target npc}
				]
				cost [
					{ money { cash -300 } }			
				]

				firstChapter	burglar-talk
			}

			cooldownDays	21
		}
		{
			id advisor-man
			display {
				loctitle	"scheme.advisor-man.title"
				locdesc		"scheme.advisor-man.desc"
				locconvo	"convo.scheme.advisor-man"
			}

			startup {
				targetIdPrefixes [ biz-drugstore biz-restaurant-buffet biz-cafeteria ]
				visreqs [
					{ #type check-scheme-crew-alive }
					{ #type check-scheme-crew-in-canada expected false }
					{ #type check-crew-convo-role id advisor }
				]
				reqs [
					{ #type check-under-concurrent-scheme-max expected #true }
					{ #type special-can-pay-scheme-startup-costs }
					{ #type check-crew-peep-assigned to vehicle target npc}
				]
				cost [
					{ money { cash -1500 } }			
				]

				firstChapter	advisor-help
			}

			cooldownDays	21
		}
		{
			id boss-man
			display {
				loctitle	"scheme.boss-man.title"
				locdesc		"scheme.boss-man.desc"
				locconvo	"convo.scheme.boss-man"
			}

			startup {
				targetIdPrefixes [  biz-drugstore biz-restaurant-buffet biz-cafeteria  ]
				visreqs [
					{ #type check-scheme-crew-alive }
					{ #type check-scheme-crew-in-canada expected false }
					{ #type check-crew-convo-role id distributor }
				]
				reqs [
					{ #type check-under-concurrent-scheme-max expected #true }
					{ #type special-can-pay-scheme-startup-costs }
					{ #type check-crew-peep-assigned to vehicle target npc}
				]
				cost [
					{ money { cash -800 } }			
				]

				firstChapter	long-chat
			}

			cooldownDays	21
		}
		{
			id top-man
			display {
				loctitle	"scheme.top-man.title"
				locdesc		"scheme.top-man.desc"
				locconvo	"convo.scheme.top-man"
			}

			startup {
				targetIdPrefixes [  biz-drugstore biz-restaurant-buffet biz-cafeteria  ]
				visreqs [
					{ #type check-scheme-crew-alive }
					{ #type check-scheme-crew-in-canada expected false }
					{ #type check-crew-convo-role id connector }
				]
				reqs [
					{ #type check-under-concurrent-scheme-max expected #true }
					{ #type special-can-pay-scheme-startup-costs }
					{ #type check-crew-peep-assigned to vehicle target npc}
				]
				cost [
					{ money { cash -300 } }			
				]

				firstChapter	quick-chat
			}

			cooldownDays	21
		}
		{
			id tip-off
			display {	
				loctitle		"scheme.tip-off.title"
				locdesc			"scheme.tip-off.desc"
				locconvo		"convo.scheme.tip-off"
			}

			startup {

				targetIdPrefixes [  ]
				alternateTargeting	FindPrecincts

				visreqs [
					{ #type check-scheme-crew-alive }
					{ #type check-scheme-crew-in-canada expected false }
					{ #type check-crew-convo-role id convict }
					{ #type check-player-met-gangs is atleast value 1 }
					{ #type check-aggro-gang-exists }
					{ #type check-player-has-valid-scheme-target id tip-off }
					{ #type check-player-unlocked-resources has all of [ weapon-thompson ] }
					{ #type check-scheme-cooldown id tip-off expected false }
				]
				reqs [
					{ #type check-under-concurrent-scheme-max expected #true }
					{ #type special-can-pay-scheme-startup-costs }
					{ #type check-crew-peep-assigned to vehicle target npc}
				]
				cost [
					{ money { cash -1500 } }
				]

				firstChapter	connection-from-prison
			}

			cooldownDays		60
		}
		{
			id cop-blackmail
			display {
				loctitle		"scheme.cop-blackmail.title"
				locdesc 		"scheme.cop-blackmail.desc"
				locconvo		"convo.scheme.cop-blackmail"
			}

			startup {
				
				targetIdPrefixes [  ]
				alternateTargeting FindPrecinctsForBlackmail

				visreqs [
					{ #type check-scheme-crew-alive }
					{ #type check-scheme-crew-in-canada expected false }
					{ #type check-crew-convo-role id negotiator }
					{ #type check-player-territory-size is atleast value 20 }
					{ #type check-player-has-valid-scheme-target id cop-blackmail }
					{ #type check-player-unlocked-resources has any of [ whiskey-bottled brandy-bottled vodka-bottled rum-bottled ] }
					{ #type check-scheme-cooldown id cop-blackmail expected false }
				]
				reqs [ 
					{ #type check-under-concurrent-scheme-max expected #true }
					{ #type special-can-pay-scheme-startup-costs } 
					{ #type check-crew-peep-assigned to vehicle target npc}
				]
				cost [
					{ money { cash -100 } }
				]

				firstChapter digging-for-dirt
			}

			cooldownDays	35
		}
		{
			id real-estate-deal
			display {
				loctitle		"scheme.real-estate-deal.title"
				locdesc 		"scheme.real-estate-deal.desc"
				locconvo		"convo.scheme.real-estate-deal"
			}
			startup {
				
				targetIdPrefixes []
			 	alternateTargeting FindBuildingsToTakeOver

				visreqs [
					{ #type check-scheme-crew-alive }
					{ #type check-scheme-crew-in-canada expected false }
					{ #type check-crew-convo-role id accountant }
					{ #type check-player-has-valid-scheme-target id real-estate-deal }
					{ #type check-scheme-cooldown id real-estate-deal expected false }
				]
				reqs [
					{ #type check-under-concurrent-scheme-max expected #true }
					{ #type check-crew-peep-assigned to vehicle target npc}
				]
				cost []

				firstChapter neighborhood-tour
			}

			cooldownDays 35
		}
		{
			id distant-outpost
			display {
				loctitle		"scheme.distant-outpost.title"
				locdesc			"scheme.distant-outpost.desc"
				locconvo		"convo.scheme.distant-outpost"
			}
			startup {
				targetIdPrefixes []
				alternateTargeting FindDistantFronts
				
				visreqs [
					{ #type check-scheme-crew-alive }
					{ #type check-scheme-crew-in-canada expected false }
					{ #type check-crew-convo-role id driver }
					{ #type check-any-outpost-expanding expected #false }
					{ #type check-player-has-valid-scheme-target id distant-outpost }
					{ #type check-scheme-cooldown id distant-outpost expected false }
				]
				reqs [
					{ #type check-under-concurrent-scheme-max expected #true }
					{ #type special-can-pay-scheme-startup-costs }
					{ #type check-crew-peep-assigned to vehicle target npc }
					{ #type check-crew-vehicle-condition is equalto type good }
				]
				cost [ { money { cash -100 } } ]

				firstChapter secret-recon			
			}
			cooldownDays 35
		}
		{
			id political-schemes
			display {
				loctitle 		"scheme.political-schemes.title"
				locdesc			"scheme.political-schemes.desc"
				locconvo 		"convo.scheme.political-schemes"
			}

			startup {
				targetIdPrefixes []
				alternateTargeting FindNearbyIndependentPoliticians

				visreqs [
					{ #type check-scheme-crew-alive }
					{ #type check-scheme-crew-in-canada expected false }
					{ #type check-crew-convo-role id politician }
					{ #type check-player-has-valid-scheme-target id political-schemes }
					{ #type check-scheme-cooldown id political-schemes expected false }
				]
				reqs [
					{ #type check-under-concurrent-scheme-max expected #true }
					{ #type special-can-pay-scheme-startup-costs }
					{ #type check-crew-peep-assigned to vehicle target npc }
					{ #type check-crew-vehicle-condition is equalto type good }
					{ #type check-election-stage-in-this-ward stage offcycle }  
				]
				cost [ { money { cash -200 } } ]

				firstChapter find-politician
			}
			cooldownDays 540
		}
	
	]

	chapterDefs [
		{
			id find-banks

			loctitle	"chapter.find-banks.title"
			locstartic	"chapter.find-banks.ic-start"
			locstartoc	"chapter.find-banks.oc-start"
			locendoc	"chapter.find-banks.oc-end"
			locendicsuccess	"chapter.find-banks.ic-end.success"
			locendicfail	"chapter.arrest.ic-end.fail"

			bannerImage	"UI Scheme Heist"

			successChance	{ value 1 }
			timeCostDays	{ value 35 }

			script move-to-target-and-wait
			recoveryScript	teleport-to-target
			selectTarget	true

			successChoices [
				{	;; let's get control of the bank - it's in our territory
					visReqs [
						{ #type check-scheme-target-is-in-territory expected true }
						{ #type check-completed-chapter-success id gain-bank succeeded false }
						{ #type check-current-city is any of [ philadelphia ] }
					]
					locoption	"chapter.find-banks.decide.bank-take-over"
					nextState	bank-take-over
					cost [{ money { cash -1500 } }]
				}
				{
					locoption "chapter.gang-help.decide.quick-chat"
					cost [ { money { cash -150 } } ]
					nextState quick-chat
				}
				{
					locoption "chapter.burglar-help.decide.burglar-talk"
					cost [ { money { cash -500 } } ]
					nextState burglar-talk
				}
				{	;; inside job
					visReqs [
						{ #type check-player-unlocked-resources has any of [ paper ] }
					]
					cost [ { money { cash -750 } } { raq { id paper qty 10 } } ]
					locoption	"chapter.find-banks.decide.inside-job"
					nextState	inside-job
				}
				{	;; front door
					visReqs [
					]
					cost [ { money { cash -750 } } ]
					locoption	"chapter.find-banks.decide.bank-robbery"
					nextState	bank-robbery
				}
				{	;; bigger bank job
					visReqs [
					{ #type check-current-turn is moreorequalto value 100 }
					]
					cost [ { raq { id kidnaptarget qty 2 } } { raq { id kidnaptarget2 qty 1 } } ]
					locoption	"chapter.find-banks.decide.inside-job2"
					nextState	inside-job2
				}
				{	;; stop - no visreqs for a cancel
					locoption	"chapter.schemes-general.decide.cancel"
					locepilogue	"chapter.schemes-general-weapons.decide.cancel.epilogue"
					earlyEnd	true
				}
			]
		}
		{	;; bank heist - take over branch
			id bank-take-over
			loctitle	"chapter.bank-take-over.title"
			locstartic	"chapter.bank-take-over.ic-start"
			locstartoc	"chapter.bank-take-over.oc-start"
			locendoc	"chapter.bank-take-over.oc-end"
			locendicsuccess	"chapter.bank-take-over.ic-end.success"
			locendicfail	"chapter.arrest.ic-end.fail"

			bannerImage	"UI Scheme Heist"

			successChance	{ value 0.9 }
			timeCostDays	{ value 21 }

			script move-to-target-and-wait
			recoveryScript teleport-to-target

			successChoices [
				{
					visReqs [
						{ #type check-player-produced-total resource brick-wine is atleast value 1 }
					]
					locoption	"chapter.bank-take-over.decide.talkative-executive"
					nextState	talkative-executive
					cost [ { raq { id brick-wine qty 25 } } ]
				}
				{
					visReqs [
						{ #type check-player-produced-total resource fake-wine is atleast value 1 }
					]
					locoption	"chapter.bank-take-over.decide.drunken-accident"
					nextState	drunken-accident
					cost [ { raq { id fake-wine qty 15 } } ]
				}
				{
					visReqs [
						{ #type check-player-produced-total resource cider is atleast value 1 }
					]
					locoption	"chapter.bank-take-over.decide.talkative-executive"
					nextState	talkative-executive
					cost [ { raq { id cider qty 25 } } ]
				}
				{
					visReqs [
						{ #type check-player-produced-total resource sparkling-cider is atleast value 1 }
					]
					locoption	"chapter.bank-take-over.decide.drunken-accident"
					nextState	drunken-accident
					cost [ { raq { id sparkling-cider qty 15 } } ]
				}
				{
					visReqs [
						{ #type check-player-produced-total resource home-brew is atleast value 1 }
					]
					locoption	"chapter.bank-take-over.decide.talkative-executive"
					nextState 	talkative-executive
					cost [ { raq { id home-brew qty 25 } } ]
				}
				{
					visReqs [
						{ #type check-player-produced-total resource fake-beer is atleast value 1 }
					]
					locoption	"chapter.bank-take-over.decide.drunken-accident"
					nextState 	drunken-accident
					cost [ { raq { id fake-beer qty 15 } } ]
				}
				{
					visReqs [
						{ #type check-player-produced-total resource moonshine is atleast value 1 }
					]
					locoption	"chapter.bank-take-over.decide.talkative-executive"
					nextState	talkative-executive
					cost [ { raq { id moonshine qty 25 } } ]					
				}
				{
					visReqs [
						{ #type check-player-produced-total resource bathtub-gin is atleast value 1 }
					]
					locoption	"chapter.bank-take-over.decide.drunken-accident"
					nextState	drunken-accident
					cost [ { raq { id bathtub-gin qty 15 } } ]
				}
				{
					visReqs [
						{ #type check-player-produced-total resource corn-whiskey is atleast value 1 }
					]
					locoption	"chapter.bank-take-over.decide.drunken-accident"
					nextState	drunken-accident
					cost [ { raq { id corn-whiskey qty 15 } } ]
				}
				{
					visReqs [
						{ #type check-player-produced-total resource apple-jack is atleast value 1 }
					]
					locoption 	"chapter.bank-take-over.decide.talkative-executive"
					nextState	talkative-executive
					cost [ { raq { id apple-jack qty 25 } } ]
				}
				{
					visReqs [
						{ #type check-player-produced-total resource fruit-brandy is atleast value 1 }
					]
					locoption	"chapter.bank-take-over.decide.drunken-accident"
					nextState	drunken-accident
					cost [ { raq { id fruit-brandy qty 15 } } ]
				}
				{
					visReqs [
						{ #type check-player-produced-total resource fruit-wine is atleast value 1 }
					]
					locoption	"chapter.bank-take-over.decide.talkative-executive"
					nextState	talkative-executive
					cost [ { raq { id fruit-wine qty 25 } } ]
				}
				{	;; stop - no visreqs for a cancel
					locoption	"chapter.schemes-general.decide.cancel"
					locepilogue	"chapter.schemes-general-cash.decide.cancel.epilogue"
					grants [ { #type add-cash amount 500 at safehouse } ]
					earlyEnd	true
				}
			]
			failChoices [
				{
					visReqs [
						{ #type check-player-cash type current is moreorequalto value 2500 }
						{ #type check-player-cash type current is lessthan value 10000 }
					]
					locoption	"chapter.bank-take-over.fail.bribe"
					locepilogue	"chapter.general.fail.epilogue"
					grants [ { #type add-cash amount -1000 } ]
				}
				{
					visReqs [
						{ #type check-player-cash type current is moreorequalto value 10000 }
						{ #type check-player-cash type current is lessthan value 25000 }
					]
					locoption 	"chapter.bank-take-over.fail.bribe"
					locepilogue	"chapter.general.fail.epilogue"
					grants [ { #type add-cash amount -2500 } ]
				}
				{
					visReqs [
						{ #type check-player-cash type current is moreorequalto value 25000 }
						{ #type check-player-cash type current is lessthan value 50000 }
					]
					locoption 	"chapter.bank-take-over.fail.bribe"
					locepilogue	"chapter.general.fail.epilogue"
					grants [ { #type add-cash amount -5000 } ]
				}
				{
					visReqs [
						{ #type check-player-cash type current is moreorequalto value 50000 }
					]
					locoption 	"chapter.bank-take-over.fail.bribe"
					locepilogue	"chapter.general.fail.epilogue"
					grants [ { #type add-cash amount -10000 } ]
				}
				{
					visReqs [
					]
					locoption	"chapter.bank-take-over.fail.lay-low"
					locepilogue	"chapter.bank-take-over.lay-low.epilogue"
					grants [  ]
				}
			]

		}
		{
			id talkative-executive
			loctitle	"chapter.talkative-executive.title"
			locstartic	"chapter.talkative-executive.ic-start"
			locstartoc	"chapter.talkative-executive.oc-start"
			locendoc	"chapter.talkative-executive.oc-end"
			locendicsuccess	"chapter.talkative-executive.ic-end.success"
			locendicfail	"chapter.arrest.ic-end.fail"

			bannerImage		"UI Scheme Heist"

			successChance	{ value 0.9 }
			timeCostDays	{ value 14 }

			script leave-board
			recoveryScript return-board

			successChoices [
				{
					visReqs []
					locoption "chapter.talkative-executive.decide.follow-executive"
					nextState follow-executive
				}
				{	;; stop - no visreqs for a cancel
					locoption	"chapter.schemes-general.decide.cancel"
