				text { key "convo.outpost-weapon.1934-winchester" icon "weapon.winchester.icon" }
				grants [ { #type add-rel-buff with owner id "relbuff-outpost-weapons" }  { #type add-resource id weapon-1934-winchster qty 1 at crew } { #type add-cash amount -750 at safehouse } ]
			}
			{
				reqs [ { #type check-current-turn is moreorequalto value 680 } { #type check-player-cash type current is morethan value 475 } { #type check-player-has-too-many resource weapon-iver-johnson is lessthan value 4 } ] 
				text { key "convo.outpost-weapon.iver" icon "weapon.colt.icon" }
				grants [ { #type add-rel-buff with owner id "relbuff-outpost-weapons" } { #type add-resource id weapon-iver-johnson qty 1 at crew } { #type add-cash amount -475 at safehouse } ]
