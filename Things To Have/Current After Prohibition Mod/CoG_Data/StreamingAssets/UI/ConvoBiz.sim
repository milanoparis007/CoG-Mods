	bottle-rack-ready {
		npcsays [ { lockey "convo.bottle-rack-ready-npc" } ]
		buttons [
			{ 
				text { key "convo.bottle-rack-ready-confirm" addmo #true }
				;; this grant should be identical to that at AutomationExecutor.cs. If you change something here, make sure to change there to match.
				visreqs [ { #type check-current-city is none of [ new-york ] } ]
				grants [ 
					{ #type consume-actions for convo }
					{ #type add-resource id small-bottles qty 20 at safehouse }
					{ #type add-rel-buff with owner id "relbuff-bottle-rack-cooldown" }
				]
				next { goto bottle-rack-outro }
			}
			{ 
				text { key "convo.bottle-rack-ready-confirm" addmo #true }
				;; this grant should be identical to that at AutomationExecutor.cs. If you change something here, make sure to change there to match.
				visreqs [ { #type check-current-city is any of [ new-york ] } ]
				grants [ 
					{ #type consume-actions for convo }
					{ #type add-resource id bottles qty 25 at safehouse }
					{ #type add-rel-buff with owner id "relbuff-bottle-rack-cooldown" }
				]
				next { goto bottle-rack-outro }
			}
			{
				text { key "convo.bottle-rack-ready-pass" }
				;; no next --> top
			}
		]
	}
