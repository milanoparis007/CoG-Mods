				text { key "convo.outpost-weapon.bearcat" icon "weapon.colt.icon" }
				grants [ { #type consume-tickets count 1 } { #type add-rel-buff with owner id "relbuff-outpost-weapons" } { #type add-resource id weapon-bearcat qty 1 at crew } { #type add-cash amount -425 at safehouse } ]
