				text { key "convo.outpost-weapon.1912-winchester" icon "weapon.winchester.icon" }
				grants [ { #type add-rel-buff with owner id "relbuff-outpost-weapons" } { #type add-resource id weapon-1912-winchester qty 1 at crew } { #type add-cash amount -600 at safehouse } ]
			}
			{
				reqs [ { #type check-current-turn is moreorequalto value 260 } { #type check-player-cash type current is morethan value 800 } { #type check-player-has-too-many resource weapon-winchester is lessthan value 2 } ]
				text { key "convo.outpost-weapon.winchester" icon "weapon.winchester.icon" }
				grants [ { #type add-rel-buff with owner id "relbuff-outpost-weapons" } { #type add-resource id weapon-winchester qty 1 at crew } { #type add-cash amount -800 at safehouse } ]
			}
			{
				reqs [ { #type check-current-turn is moreorequalto value 200 } { #type check-player-cash type current is morethan value 700 } { #type check-player-has-too-many resource weapon-enfield is lessthan value 2 } ]
				text { key "convo.outpost-weapon.enfield" icon "weapon.winchester.icon" }
				grants [ { #type add-rel-buff with owner id "relbuff-outpost-weapons" } { #type add-resource id weapon-enfield qty 1 at crew } { #type add-cash amount -700 at safehouse } ]
			}
			{
				reqs [ { #type check-relationship-tickets is moreorequalto value 1 } { #type check-current-turn is moreorequalto value 260 } { #type check-player-cash type current is morethan value 1100 } { #type check-player-has-too-many resource weapon-beretta-m1918 is lessthan value 2 } ]
				text { key "convo.outpost-weapon.m1918" icon "weapon.thompson.icon" }
				grants [ { #type consume-tickets count 1 } { #type add-rel-buff with owner id "relbuff-outpost-weapons" } { #type add-resource id weapon-beretta-m1918 qty 1 at crew } { #type add-cash amount -1100 at safehouse } ]
			}
			{
				reqs [ { #type check-relationship-tickets is moreorequalto value 1 } { #type check-current-turn is moreorequalto value 260 } { #type check-player-cash type current is morethan value 1400 } { #type check-player-has-too-many resource weapon-mp18 is lessthan value 2 } ]
				text { key "convo.outpost-weapon.mp18" icon "weapon.thompson.icon" }
				grants [ { #type consume-tickets count 1 } { #type add-rel-buff with owner id "relbuff-outpost-weapons" } { #type add-resource id weapon-mp18 qty 1 at crew } { #type add-cash amount -1400 at safehouse } ]
			}
			{
				reqs [  { #type check-relationship-tickets is moreorequalto value 1 } { #type check-current-turn is moreorequalto value 340 } { #type check-player-cash type current is morethan value 1250 } { #type check-player-has-too-many resource weapon-thompson is lessthan value 2 } ]
				text { key "convo.outpost-weapon.thompson" icon "weapon.thompson.icon" }
				grants [ { #type consume-tickets count 1 } { #type add-rel-buff with owner id "relbuff-outpost-weapons" } { #type add-resource id weapon-thompson qty 1 at crew } { #type add-cash amount -1250 at safehouse } ]
			}
