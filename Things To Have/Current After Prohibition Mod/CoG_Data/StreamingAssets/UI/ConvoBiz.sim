		}
		{	;; 		"never mind"
			text 	{ key "convo.ticket-hirecrew-cancel-button" icon "convo.icon-back" }
			next 	{ goto redeem-favor-owed }
		}
		]
	}

	;; ticket hire crew - confirm who they are
	ticket-hirecrew-confirm {
		; NPC SAYS "what do you think"
		npcsays [{ #type rel-type-blurb to target keyroot "convo.ticket-hirecrew-confim-npc" }]
		buttons [
		{	;; 		"your cousin sounds great"
			text {
				dynkey	[{ #type rel-type-blurb to target keyroot "convo.ticket-hirecrew-confirm-button" }]
				dynnpc 	[{ #type rel-type-blurb to target keyroot "convo.ticket-hirecrew-epilogue-npc" }]
			}
			
			onClick	 ExecuteCrewHire
			grants 	 [{ #type add-rel-buff with owner id "relbuff-ticket-crewhire-friend" }
					  { #type consume-actions for convo }
					  { #type add-xp source from-social }]
			;; no next - restart from top level
		}
		{	;; 		"never mind"
			text	{ key "convo.ticket-hirecrew-cancel-button" icon "convo.icon-back" }
			next 	{ goto redeem-favor-owed }
		}
		]
	}


	ticket-politician-boost {
		; NPC SAYS "you want me to spread the word?"
		npcsays	[{ lockey "convo.ticket-politician-boost-start.npc"} ]
		buttons [
		{
			text	{ key "convo.ticket-politician-boost-confirm-button"}

			grants [{ #type add-rel-buff with owner id "relbuff-ticket-politician-boost"}
					{ #type grant-action-to-supported-politician id "player-bizowner-favor"}
					{ #type consume-tickets count 1 }
					{ #type consume-actions for convo }
					{ #type add-xp source from-social }]
			;; no next - restart from top level
		}
		{
			text	{ key "convo.ticket-politician-boost-cancel-button" icon "convo.icon-back"}
			next 	{ goto redeem-favor-owed }
		}
		]
	}

	ticket-politician-frontboost {
		; NPC SAYS "you need local businesses on your side?"
		npcsays	[{ lockey "convo.ticket-politician-frontboost-start.npc"}]
		buttons [
		{
			text { key "convo.ticket-politician-frontboost-confirm-button"}

			grants [{ #type grant-front-political-support-dump id "player-frontowner-favor"}
					{ #type consume-tickets count 1 }
					{ #type consume-actions for convo }
					{ #type add-xp source from-social }]
			;; no next - restart from top level
		}
		{
			text { key "convo.ticket-politician-boost-cancel-button" icon "convo.icon-back"}
			next { goto redeem-favor-owed }
		}
		]
	}

	;; ticket building - start the convo 
	ticket-building-start {
		; NPC SAYS "my cousin wants to start a business, and i'd like to help"
		npcsays [{ #type rel-type-blurb to target keyroot "convo.ticket-building-start-npc" }]
		buttons [
		{	;; 		"tell me more"
			text 	{ key "convo.ticket-building-tellmore-button" }

			onClick	ExecuteBuildingZoom
			next	{ goto ticket-building-details }
		}
		{	;; 		"never mind"
			text 	{ key "convo.ticket-building-cancel-button" icon "convo.icon-back" }
			next 	{ goto redeem-favor-owed }
		}
		]
	}
	;; ticket building details - what the business is
	ticket-building-details {
		; NPC SAYS "this business is for sale"
		npcsays [{ #type rel-type-blurb to target keyroot "convo.ticket-building-details-npc" }]
		buttons [
		{	;; 		"and you need an investor?"
			text 	{ key "convo.ticket-building-details-button" }
			next	{ goto ticket-building-details2 }
		}
		]
	}
	;; ticket building details - what the business is
	ticket-building-details2 {
		; NPC SAYS "you could have the back room for your own use"
		npcsays [{ #type rel-type-blurb to target keyroot "convo.ticket-building-details2-npc" }]
		buttons [
		{	;; 		"so what do you need from me?"
			text 	{ key "convo.ticket-building-details2-button" }
			next	{ goto ticket-building-request }
		}
		]
	}
	;; ticket building request for assistance, starts the quest
	ticket-building-request {
		; NPC SAYS "i would need x and y"
		npcsays [
			{ lockey "convo.ticket-building-request-npc" reqs [{ #type check-tribute-status is notpaying }] }
			{ lockey "convo.ticket-building-request-npc-trib" reqs [{ #type check-tribute-status is paying }] }
		]
		buttons [
		{	;; 		"consider it done"
			reqs 	[{ #type special-biz-purchase-button test CurrentOnCrew }]
			text 	{ key "convo.ticket-building-request-ok-button" addmo #true }

			onClick ExecuteBuildingTakeover
			grants	[{ #type set-topic-from-conversation }
					 { #type add-rel-buff with owner id "relbuff-ticket-building-intro" }
					 { #type add-rel-buff with topic id "relbuff-ticket-building-manager" }
					 { #type add-respect-buff-at-node id "respectbuff-good-word" instant #true }
					 { #type set-rel-flag with owner id "building-takeover" }
					 { #type consume-tickets count 1 }
					 { #type consume-actions for convo }
					 { #type add-xp source from-social }
;;					 { #type grant-from-law id biz-owner-stimulus }
					 { #type clear-topic }]
			next 	{ goto ticket-building-done }
		}
		{	;; 		"never mind"
			text 	{ key "convo.ticket-building-request-later-button" icon "convo.icon-back" }
			next 	{ goto redeem-favor-owed }
		}
		]
	}
	
	ticket-building-done {
		; NPC SAYS "wonderful news"
		npcsays [{ lockey "convo.ticket-building-done-npc" }]
		buttons [
		{	;; 		"cheers"
			text 	{ key "convo.ticket-building-done-ok-button" icon "convo.icon-confirm" }
			;; no next - restart from top level
		}
		]
	}

	outpost-weapons {
		npcsays [{ lockey "convo.outpost-weapon.npc" }]
		buttons [
			{
				reqs [ { #type check-current-turn is moreorequalto value 130 } { #type check-player-cash type current is morethan value 300 } { #type check-player-has-too-many resource weapon-colt is lessthan value 4 } ]
				text { key "convo.outpost-weapon.colt" icon "weapon.colt.icon" }
				grants [  { #type add-rel-buff with owner id "relbuff-outpost-weapons" } { #type add-resource id weapon-colt qty 1 at crew } { #type add-cash amount -300 at safehouse } ]
			}
			{
				reqs [ { #type check-current-turn is moreorequalto value 130 } { #type check-player-cash type current is morethan value 320 } { #type check-player-has-too-many resource weapon-lemat is lessthan value 4 } ]
				text { key "convo.outpost-weapon.lemat" icon "weapon.colt.icon" }
				grants [  { #type add-rel-buff with owner id "relbuff-outpost-weapons" } { #type add-resource id weapon-lemat qty 1 at crew } { #type add-cash amount -320 at safehouse } ]
			}
			{
				reqs [ { #type check-current-turn is moreorequalto value 120 } { #type check-player-cash type current is morethan value 375 } { #type check-player-has-too-many resource weapon-pistol is lessthan value 4 } ]
				text { key "convo.outpost-weapon.pistol" icon "weapon.pistol.icon" }
				grants [ { #type add-rel-buff with owner id "relbuff-outpost-weapons" } { #type add-resource id weapon-pistol qty 1 at crew } { #type add-cash amount -375 at safehouse } ]
			}
			{
				reqs [ { #type check-current-turn is moreorequalto value 120 } { #type check-player-cash type current is morethan value 400 } { #type check-player-has-too-many resource weapon-remington is lessthan value 4 } ]
				text { key "convo.outpost-weapon.remington" icon "weapon.pistol.icon" }
				grants [ { #type add-rel-buff with owner id "relbuff-outpost-weapons" } { #type add-resource id weapon-remington qty 1 at crew } { #type add-cash amount -400 at safehouse } ]
			}
