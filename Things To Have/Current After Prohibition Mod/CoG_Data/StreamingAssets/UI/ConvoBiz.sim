	;; ticket hire crew - start the convo and say who they are
	ticket-hirecrew-start {
		; NPC SAYS "i have this good-for-nothing cousin"
		npcsays [{ #type rel-type-blurb to target keyroot "convo.ticket-hirecrew-start-npc" }]
		buttons [
		{	;; 		"sounds great"
			text 	{ key "convo.ticket-hirecrew-tellmore-button" }
