{

convos {
	toplevel-state { 
		npcsays [ 
			;; for the very first convo, pre-empt any special initiative rolls
			{ #type toplevel-start-blurb rootkey "convo.toplevel-train-passenger" reqs [{ #type special-toplevel-start firststate #true } { #type check-convo-query id kb-civic-buidling } { #type check-module-in-convo has any of [ civic-passenger-station ] } ] }
			{ #type toplevel-start-blurb rootkey "convo.toplevel-train-freight" reqs [{ #type special-toplevel-start firststate #true } { #type check-convo-query id kb-civic-buidling } { #type check-module-in-convo has any of [ civic-freight-station ] } ] }
			{ #type toplevel-start-blurb rootkey "convo.toplevel-start" reqs [{ #type special-toplevel-start firstconvo #true }] }
			;; then try to talk about social history
			{ #type rel-history-with-other-blurb reqs [{ #type check-peep-has-npc-history }] }
			{ #type rel-history-blurb reqs [{ #type check-peep-has-player-history }] }
			;; otherwise do either a "opening move" or subsequent blurbs
			{ #type toplevel-start-blurb rootkey "convo.toplevel-start" reqs [{ #type special-toplevel-start firststate #true }] }
			{ #type relationship-based-blurb rootkey "convo.toplevel-state" }
			;; civic building
		]

		buttons [
			{	;; player below relationship threshold
				visreqs [
					{ #type check-convo-query id kb-civic-buidling }
					{ #type check-owner-relationship is lessorequalto value 10 }
					{ #type check-quests has none of [ train-station-bribe ] status complete with owner }
					{ #type check-quests has none of [ train-station-bribe ] status active with owner }
				]
				text { key "convo.train-station-start-bad" addmo #true }
				onClick Goodbye
			}
			{	;; player above relationship threshold
				visreqs [
					{ #type check-convo-query id kb-civic-buidling }
					{ #type check-owner-relationship is atleast value 10 }
					{ #type check-quests has none of [ train-station-bribe ] status complete with owner }
					{ #type check-quests has none of [ train-station-bribe ] status active with owner }
				]
				text { key "convo.train-station-start-good"
					icon "convo.train-station.icon" }
				next { goto train-station-start }
			}
			{	
				visreqs [ 
					{ #type check-owner-relbuffs has any of [ relbuff-passenger-bribe relbuff-cargo-bribe ] }
					{ #type check-owner-relbuffs has none of [ 
						relbuff-train-brick-wine relbuff-train-cider relbuff-train-home-brew relbuff-train-moonshine relbuff-train-apple-jack
						relbuff-train-fake-wine relbuff-train-sparkling-cider relbuff-train-fake-beer relbuff-train-bathtub-gin relbuff-train-corn-whiskey relbuff-train-fallback
						relbuff-train-barrels relbuff-passenger-weapons relbuff-train-restart relbuff-train-smuggling
					] }
				]
				text { key "convo.train-station-mission-start"
					icon "convo.train-station.icon" }
				next { goto train-station-mission-start }
			}
			{	
				visreqs [ 
					{ #type check-owner-relbuffs has any of [ relbuff-passenger-bribe ] }
					{ #type check-owner-relbuffs has any of [ 
						relbuff-train-brick-wine relbuff-train-cider relbuff-train-home-brew relbuff-train-moonshine relbuff-train-apple-jack
						relbuff-train-fake-wine relbuff-train-sparkling-cider relbuff-train-fake-beer relbuff-train-bathtub-gin relbuff-train-corn-whiskey relbuff-train-fallback
						relbuff-train-barrels relbuff-passenger-weapons relbuff-train-smuggling
					] }
					{ #type check-owner-relbuffs has none of [ relbuff-train-restart ] }
					{ #type check-active-quest-count with owner is equalto value 0 }
					{ #type check-current-month is any of [ 9 10 11 12 ] }
				]
				text { key "convo.train-station-mission-start"
					icon "convo.train-station.icon" }
				next { goto train-station-mission-start }
			}

			{
				visreqs [ 
					{ #type check-owner-relbuffs has all of [ relbuff-train-restart ] }
					{ #type check-active-quest-count with owner is equalto value 0 }
				]
				text { key "convo.train-passenger-restart" 
					icon "convo.train-station.icon"}
				next { goto train-station-mission-start }
			}
			{	;; cash boost
				visreqs [ { #type check-convo-query id kb-cash-boost } ]

				text { key "convo.cash-boost" icon "ui.pipicon.cash-boost" }
				next { goto cash-boost-grant }
			}
			{	;; cop interlude
				visreqs [{ #type check-blocking-cop expected #true }]
				text 	{ key "convo.cop-effect.at-node.button"
						  icon "convo.cop-effect.at-node.icon" }
				next 	{ goto cop-at-node-start }
			}

			;; got active quest
			{	visreqs [{ #type check-convo-query id kb-has-active-quest-with-owner }]

				text 	{ key "convo.delivery-button" icon "ui.pipicon.quest" addmo #true }

				onShow  StoreQuestActive
				next 	{ goto show-quest-delivery-choices }
			}

			;; quest expired
			{	visreqs [{ #type check-convo-query id kb-has-expired-quest-with-owner }]

				text 	{ key "convo.expired-quest.button" icon "ui.pipicon.quest" addmo #true }

				onShow  StoreQuestActive
				next 	{ goto show-quest-expired }
			}

			;; player storage rail shipments
			{
				visreqs [
					{ #type check-module-in-player-territory has any of [ inventory-basement-improved ] scope player-only }
					{ #type check-is-convo-at-controlled-building expected #true }
					{ #type check-is-convo-inside-territory expected #true }
					{ #type check-module-in-player-territory has any of [ civic-passenger-station civic-freight-station ] }
					{ #type check-quests has none of [
						rail-liquor-home-brew-short rail-liquor-home-brew-full rail-liquor-home-brew-long
						rail-liquor-cider-short rail-liquor-cider-full rail-liquor-cider-long
						rail-liquor-brick-wine-short rail-liquor-brick-wine-full rail-liquor-brick-wine-long
						rail-liquor-moonshine-short rail-liquor-moonshine-full rail-liquor-moonshine-long
						rail-liquor-bathtub-gin-short rail-liquor-bathtub-gin-full rail-liquor-bathtub-gin-long
						rail-liquor-sparkling-cider-short rail-liquor-sparkling-cider-full rail-liquor-sparkling-cider-long
						rail-liquor-fake-beer-short rail-liquor-fake-beer-full rail-liquor-fake-beer-long
						rail-liquor-fake-wine-short rail-liquor-fake-wine-full rail-liquor-fake-wine-long
					] status active }
				]
				text { key "convo.rail-storage-shipment-button" icon "convo.train-station.icon" addmo #true }
				next { goto rail-storage-shipment-start }
			}
			
			;; buy / sell buttons
			;; button to buy / sell if the relationship is not there
			{	visreqs [
						 { #type check-owner-relationship is lessorequalto value -10 }
						 { #type special-is-trade-locked expected #false }
						 { #type check-blocking-cop expected #false }
						 { #type check-player-skills has none of [ italian-persuasion] }]
				reqs 	[{ #type check-convo-actions has enough }]

				text {
					key		"convo.buysell-button"
					icon	"convo.buysell-button.icon"
					dynmo	[{ lockey "convo.buysell-button.dis.mo" reqs [{ #type check-convo-actions has notenough }] }]
				}
				
				quickType	buy-sell
				
				next 	{ goto buysell-failed-state }
			}
			;; button to buy / sell if the relationship is bad but you're italian
			{	visreqs [
						 { #type check-owner-relationship is lessorequalto value -10 }
						 { #type check-owner-relationship is moreorequalto value -30 }
						 { #type special-is-trade-locked expected #false }
						 { #type check-blocking-cop expected #false }
						 { #type check-player-skills has any of [ italian-persuasion ]}]
				reqs	[{ #type check-convo-actions has enough}]
				text {
					key		"convo.buysell-button.italian-persuasion"
					icon	"convo.buysell-button.icon"
					dynmo	[{ lockey "convo.buysell-button.dis.mo" reqs [{ #type check-convo-actions has notenough }] }]
				}
				
				quickType	buy-sell
				
				next	{ 
					#type next-state-chain 
					defs [{ 
						reqs [ { #type check-peep-has-history-element labelled [ burglary extortion vandalism ] } ] 
						then buysell-failed-harassed 
					}] 
					default buysell-state 
				}
			}

			;; button to buy-and-sell if the relationship is too bad even if you're italian
			{	visreqs [
						 { #type check-owner-relationship is lessorequalto value -30 }
						 { #type special-is-trade-locked expected #false }
						 { #type check-blocking-cop expected #false }
						 { #type check-player-skills has any of [ italian-persuasion ]}]
				reqs	[{ #type check-convo-actions has enough}]
				text {
					key		"convo.buysell-button.italian-persuasion"
					icon	"convo.buysell-button.icon"
					dynmo	[{ lockey "convo.buysell-button.dis.mo" reqs [{ #type check-convo-actions has notenough }] }]
				}
				
				quickType	buy-sell
				
				next 	{ goto buy-sell-failed-state }
			}

			;; button to buy-and-sell, depending on what's available
			{	visreqs	[
						 { #type check-owner-relationship is morethan value -10 }
						 { #type check-blocking-cop expected #false }]
				reqs	[{ #type check-convo-actions has enough }]

				text { 
					key		"convo.buysell-button" 
					icon	"convo.buysell-button.icon"
					dynmo	[{ lockey "convo.buysell-button.dis.mo" reqs [{ #type check-convo-actions has notenough }] }]
				}
				
				quickType	buy-sell
				
				next	{ 
					#type next-state-chain 
					defs [{ 
						reqs [ { #type check-peep-has-history-element labelled [ burglary extortion vandalism ] } ] 
						then buysell-failed-harassed 
					}] 
					default buysell-state 
				}
			}

			;; button to buy / sell if trade is locked - can't do trading at all
			{	visreqs [
						 { #type check-owner-relationship is lessthan value -30 }
						 { #type special-is-trade-locked expected #false }
						 { #type check-blocking-cop expected #false }]
				reqs 	[{ #type check-convo-actions has enough }]

				onShow	StoreDataTradeLocked
				text {
					key		"convo.buysell-button"
					icon	"convo.buysell-button.icon"
					dynmo	[{ lockey "convo.buysell-button.dis.mo" reqs [{ #type check-convo-actions has notenough }] }]
				}
				
				quickType	buy-sell
				
				next 	{
					#type next-state-chain 
					defs [{
						reqs [{ #type special-is-trade-locked expected #true reason tiedhouse }]
						then buysell-tradelocked-tiedhouse
					} {
						reqs [{ #type special-is-trade-locked expected #true reason forceclosed }]
						then buysell-tradelocked-forceclosed
					}]
					
					default buysell-tradelocked-trade
				}
			}

			;; threaten a buysell business into closure
			{	visreqs [
						 { #type check-blocking-cop expected #false }
						 { #type special-trading-with-enemy-ai expected #true }]
				reqs 	[{ #type check-convo-actions has enough }]
				text	{ key "convo.buysell-forceclosed-ask" icon "convo.gangs.fight.icon" }
				onShow  StoreForceClosedDemand
				next	{ goto buysell-forceclosed-demand }
			}


			;;
			;; car stuff - top
			{ ;; can repair anything
				visreqs [
					{ #type check-vehicle-module-in-convo has any of [ vehicle-repair ] }
					{ #type check-blocking-cop expected #false }
					{ #type check-crew-vehicle-condition is equalto type good }
					{ #type check-owner-relationship is moreorequalto value 0 }
				]
				reqs [
				]
				text	{ key "convo.vehicle-group-button-repair" icon "ui.icon.car" }
				next	{ goto vehicle-can-repair }
			}
			{
				visreqs	[
					{ #type check-vehicle-module-in-convo has any of [ vehicle-repair ] }
					{ #type check-owner-relationship is lessthan value 0 }
					{ #type check-blocking-cop expected #false }
				]
				reqs [
				]
				text	{ key "convo.vehicle-group-button-repair" icon "ui.icon.car" }
				next	{ goto vehicle-dislikes-you }
			}
			{ ;; can't repair trucks
				visreqs [
					{ #type always-false }
					{ #type check-vehicle-module-in-convo has any of [ vehicle-repair ] }
					{ #type check-crew-vehicle-condition is equalto type clunker }
					{ #type check-crew-vehicle-condition is equalto type junk }
					{ #type check-crew-peep-assigned to vehicle vehtype truck }
					{ #type check-owner-relationship is moreorequalto value 0 }
					{ #type check-blocking-cop expected #false }
				]
				text	{ key "convo.vehicle-group-button-repair" icon "ui.icon.car" }
				next	{ goto vehicle-no-trucks }
			}
			{ ;; can only repair cars
				visreqs [
					{ #type always-false }
					{ #type check-vehicle-module-in-convo has any of [ vehicle-repair ] }
					{ #type check-crew-vehicle-condition is notequalto type good }
					{ #type check-blocking-cop expected #false }
					{ #type check-owner-relationship is moreorequalto value 0 }
				]
				reqs [
				]
				text	{ key "convo.vehicle-group-button-repair" icon "ui.icon.car" }
				next	{ goto vehicle-group-start-repair }
			}
			{ ;; can repair anything
				visreqs [
					{ #type check-vehicle-module-in-convo has any of [ vehicle-repair ] }
					{ #type check-crew-vehicle-condition is notequalto type good }
					{ #type check-owner-relationship is moreorequalto value 0 }
					{ #type check-blocking-cop expected #false }
				]
				reqs 	[{ #type check-owner-relationship is atleast value 0 }]

				text 	{ key "convo.vehicle-group-button-repair" icon "ui.icon.car" }
				next 	{ goto vehicle-group-start-repair }
			}
			;; vehicle sales
			;; NPC buys and sells vehicles			
			{
				visreqs [
					{ #type check-vehicle-module-in-convo has all of [ vehicle-sell-to-player vehicle-buy-from-player ] }
					{ #type check-location-district-tags has none of [ canada canada-two ] } 
					]
				reqs 	[{ #type check-owner-relationship is atleast value -5 }]

				text 	{ key "convo.vehicle-group-button-buy-sell" icon "ui.icon.car" }
				next 	{ goto vehicle-group-start-buy-sell }
			}
			;; NPC only buys vehicles
			{
				visreqs [
					{ #type check-vehicle-module-in-convo has all of [ vehicle-buy-from-player ] }
				 	{ #type check-blocking-cop expected #false } 
				 	{ #type check-vehicle-module-in-convo has none of [ vehicle-sell-to-player ] }
				 	{ #type check-location-district-tags has none of [ canada canada-two ] } 
				 	]
				reqs 	[{ #type check-owner-relationship is atleast value -5 }]

				text 	{ key "convo.vehicle-group-button-buy-sell" icon "ui.icon.car" }
				next 	{ goto vehicle-group-start-buy-only }
			}
			
			{ ;; npc only sells trucks
				visreqs [
					{ #type check-vehicle-module-in-convo has none of [ vehicle-buy-from-player ] } 
					{ #type check-blocking-cop expected #false }
					{ #type check-vehicle-module-in-convo has all of [ vehicle-sell-to-player ] }
					{ #type check-module-in-convo has any of [ truck-garage ]  }
					{ #type check-location-district-tags has none of [ canada canada-two ] } 
				]

				text 	{ key "convo.vehicle-group-button-buy-truck" icon "ui.icon.car" }
				next 	{ goto vehicle-group-start-buy-truck }
			}



			;; so about that favor you owe me (single favor)
			{
				visreqs [ 
					{ #type check-relationship-tickets is equalto value 1 }
					{ #type check-blocking-cop expected #false }
				]
				reqs [{ #type check-convo-actions has enough }]

				text 	{ key "convo.single-favor-owed" icon "ui.ticket" }
				next	{ goto redeem-favor-owed }
			}

			;; so about those favors you owe me (multiple favors)
			{
				visreqs [ 
					{ #type check-relationship-tickets is morethan value 1 }
					{ #type check-blocking-cop expected #false }
				]
				reqs [{ #type check-convo-actions has enough }]

				text 	{ key "convo.many-favors-owed" icon "ui.ticket" }
				next	{ goto redeem-favor-owed }
			}

			;; learn a new skill
			{
				;;		"i'd like to learn from you"
				visreqs [
					{ #type check-convo-query id kb-can-learn-new-skills }
					{ #type check-can-learn-new-skills } ;; belt and suspenders, just in case the kb pip is incorrectly valid for remainder of turn
				]
				reqs 	[{ #type check-active-quest-count with owner is equalto value 0 } { #type check-convo-actions has enough } ]

				text 	{ key "convo.ticket-skills-button" icon	"ui.pipicon.social-skill" addmo #true }

			  	onShow	StoreTicketSkillChoice
			next	{ reqs [{ #type check-num-skills-offered is atleast value 2 }]
					  then ticket-skills-start 
					  else ticket-skills-beforechoice }
			}

			

			;; tribute introduction
			;;
			;; mention tribute for the first time
			{	visreqs [
					{ #type check-is-convo-inside-territory expected #true }
					{ #type check-tribute-status is notasked }
					{ #type check-has-outpost location this-building expected #false }
					{ #type check-has-outpost location this-node-or-nearby expected #true }
					{ #type check-blocking-cop expected #false }
					{ #type check-is-convo-at-controlled-building expected #false }
					{ #type check-owner-relbuffs has none of [ relbuff-starting-francine ] }
					{ #type check-module-in-convo has none of [ civic-freight-station civic-passenger-station civic-worship-regular civic-worship-large source-materials-medium-back-one source-materials-medium-back-two ] }
				] 
				reqs [{ #type check-convo-actions has enough }]
			
				; "we've taken control of this corner, and some things will change"
			  	text {
					icon	"ui.pipicon.front-extortion"
			  		dynkey	[{ #type relationship-based-blurb rootkey "convo.first-tribute-button" }]
			  	}

				grants	[{ #type set-tribute-human-asked }]
				next	{ goto tribute-confirm-state }
			}

			;; tribute was mentioned before but player cancelled
			{	visreqs [
					{ #type check-is-convo-inside-territory expected #true }
					{ #type check-tribute-status is asked }
					{ #type check-has-outpost location this-building expected #false }
					{ #type check-has-outpost location this-node-or-nearby expected #true }
					{ #type check-blocking-cop expected #false }
				] 
				reqs [{ #type check-convo-actions has enough }]
			
				; "we need to finish our little chat from before"
				text {
					icon	"convo.tribute-button.icon"
			  		dynkey	[{ #type relationship-based-blurb rootkey "convo.later-tribute-button" }]
				}

				next	{ goto tribute-confirm-state }
			}

			;; maybe cancel tribute
			{	visreqs [
					{ #type check-tribute-status is paying }
				] 
				reqs [{ #type check-convo-actions has enough }]
			
				; "i wish to change our arrangement"
			  	text {
					icon	"ui.pipicon.front-extortion"
			  		dynkey	[{ #type relationship-based-blurb rootkey "convo.cancel-tribute-button" }]
			  	}

				next	{ goto cancel-tribute-state }
			}



			;;
			;; outpost stuff

			;; at the outpost: see if we want to reconsider any of our plans
			{	visreqs [{ #type check-has-outpost location this-building expected #true }] 
				reqs [ { #type check-convo-actions has enough } ]

				; "let's talk about our arrangement"
			  	text {
			  		dynicon	[
			  			{ lockey "ui.pipicon.front-needs" reqs [{ #type special-must-support-outpost }] }
			  			{ lockey "ui.pipicon.front-ready" reqs [{ #type check-outpost-status is ready-to-collect }] }
			  			{ lockey "ui.pipicon.front-can-expand" reqs [{ #type check-convo-query id kb-front-can-expand }] }
			  			{ lockey "ui.pipicon.front" }
			  		]
			  		dynkey	[
			  			{ lockey "convo.at-outpost-button.expanding" reqs [{ #type check-outpost-expanding expected #true }] }
			  			{ lockey "convo.at-outpost-button.active" }
			  		]
			  	}

			  	next { goto at-outpost-state }
			}

			;; ask about other person's outpost (front)
			{ 	visreqs [{ #type check-outpost-nonhuman expected #true }
						 { #type check-convo-demand-state is notset to defiant }]
				reqs [{ #type check-blocking-rival expected #false }]
				text 	{ key "convo.outpost.nonhuman-ask" icon "ui.pipicon.front-ai" }
				
				onShow 	StoreDemandToCloseOutpost
				next 	{ goto demand-close-outpost-ask }
			}

			;; they don't want to close other person's outpost
			{ 	visreqs [{ #type check-outpost-nonhuman expected #true }
						 { #type check-convo-demand-state is set to defiant }]
				text 	{ key "convo.outpost.nonhuman-defiant-ask" icon "ui.pipicon.front-ai" }
				
				onShow 	StoreDemandToCloseOutpost
				next 	{ goto demand-close-outpost-defiant }
			}

			;; ;;; city-specific stuff

			{	visreqs [ 
					{ #type check-current-city is any of [ pittsburgh detroit new-york ] }
					{ #type check-player-skills has any of [ homebooze-apple-jack homebooze-fruit-wine ] }
					{ #type check-owner-relbuffs has none of [ relbuff-bottle-rack relbuff-bottle-rack-cooldown ] }
					{ #type check-player-skills has none of [ bottle-return-racks ] }
					{ #type check-has-outpost location this-building expected #true }
					{ #type check-quests has none of [ bottle-rack-build ] status active }
				]
				reqs [
					{ #type check-active-quest-count with owner is lessthan value 1 }
					{ #type check-relationship-tickets is moreorequalto value 1 }
					{ #type check-owner-relbuffs has none of [ relbuff-bottle-rack-cooldown ] }
				]
				text { key "convo.outopost.bottle-return-ask" icon "skill.knowledge-general.icon" }
				next { goto bottle-rack-build }
			}
			{
				visreqs [
					{ #type check-has-outpost location this-building expected #true }
					{ #type check-player-skills has all of [ bottle-return-racks ] }
					{ #type check-owner-relbuffs has none of [ relbuff-bottle-rack ] }
				]
				reqs [
					{ #type check-active-quest-count with owner is lessthan value 1 }
					{ #type check-relationship-tickets is moreorequalto value 1 }
				]
				text { key "convo.outopost.bottle-return-ask" icon "skill.knowledge-general.icon" }
				next { goto bottle-rack-build-subsequent }
			}
			{
				visreqs [ { #type check-owner-relbuffs has all of [ relbuff-bottle-rack ] } { #type check-player-skills has all of [ bottle-return-racks ] }
				]
