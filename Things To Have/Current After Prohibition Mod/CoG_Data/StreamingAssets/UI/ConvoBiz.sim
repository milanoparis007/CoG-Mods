				text { key "convo.rail-storage-shipment-long-120k" addmo #true }
				grants [ { #type force-start-quest-on-owner id rail-liquor-fake-beer-long } ]
			}
			{
				text { key "convo.rail-storage-shipment-back" }
				next { goto rail-storage-shipment-start }
			}
		]
	}

	rail-storage-shipment-fake-wine {
		npcsays [ { lockey "convo.rail-storage-shipment-fake-wine-npc" } ]
		buttons [
			{
