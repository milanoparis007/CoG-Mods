	canada-unlock-start {
		npcsays [ { lockey "convo.canada-unlock-npc" } ]
		buttons [
			{
				text { key "convo.canada-unlock-ok" }
				grants [
					{ #type grant-building at district districtTag "canada" newBuildingTag "canadahouse" }
					{ #type add-crew at tag buildingTag "canadahouse" vehTemplate "vehicle-pickup-truck" }
					{ #type remove-rel-buff with owner id "relbuff-canada-access" }
					{ #type add-rel-buff with owner id "relbuff-canadian-friend" }
				]
			}
			{
				text { key "convo.canada-access-pass" }
				;; no next --> top
			}
		]
	}

	canada-access-cash {
		npcsays [ { lockey "convo.canada-access-cash-npc" } ]
		buttons [
			{
				text { key "convo.canada-access-cash-ok" icon "quest.canada.icon" addmo #true }
				grants [
					{ #type force-start-quest-on-owner id "canada-access-cash" }
				]
			}
			{
				text { key "convo.canada-access-cash-pass" }
				;; no next --> top
			}
		]
	}

	canada-transport-thawed {
		npcsays [ { lockey "convo.canada-transport-thawed-npc" } ]
		buttons [
			{
				text { key "convo.canada-transport-yes" addmo #true }
				grants [
					{ #type consume-actions for convo }
					{ #type teleport-from-vehicle-to-safehouse resources #true money #false }
					{ #type add-rel-buff with owner id "relbuff-canada-cooldown-thawed" }
				]
			}
			{
				text { key "convo.canada-access-cash-pass" }
				;; no next --> top
			}
		]
	}
	canada-transport-frozen {
		npcsays [ { lockey "convo.canada-transport-frozen-npc" } ]
		buttons [
			{
				text { key "convo.canada-transport-yes" addmo #true }
				grants [
					{ #type consume-actions for convo }
					{ #type teleport-from-vehicle-to-safehouse resources #true money #false }
					{ #type add-rel-buff with owner id "relbuff-canada-cooldown-frozen" }
				]
			}
			{
				text { key "convo.canada-access-cash-pass" }
				;; no next --> top
			}
		]
	}

	canada-transport-repeat {
		npcsays [ 
			{ reqs [ { #type check-owner-relbuffs has all of [ relbuff-canada-cooldown-frozen ] } ] lockey "convo.canada-transport-repeat-frozen" }
			{ reqs [ { #type check-owner-relbuffs has all of [ relbuff-canada-cooldown-thawed ] } ] lockey "convo.canada-transport-repeat-thawed" }
		]
		buttons [
			{
				text { key "convo.canada-transport-repeat-yes" }
				grants [
					{ #type force-start-quest-on-owner id canada-transport-repeat }
				]
			}
			{
				text { key "convo.canada-access-cash-pass" }
				;; no next --> top
			}
		]
	}


	;; Atlantic City

	ticket-import-reveal {
		npcsays [
			{ reqs [ { #type check-rel-flag id "canadian-whiskey" is set } ] lockey "convo.imported-booze-reveal-canadian-whiskey" }
			{ reqs [ { #type check-rel-flag id "scotch-whiskey" is set } ] lockey "convo.imported-booze-reveal-scotch-whiskey" }
			{ reqs [ { #type check-rel-flag id "caribbean-rum" is set } ] lockey "convo.imported-booze-reveal-caribbean-rum" }
			{ reqs [ { #type check-rel-flag id "irish-whiskey" is set } ] lockey "convo.imported-booze-reveal-irish-whiskey" }
			{ reqs [ { #type check-rel-flag id "english-gin" is set } ] lockey "convo.imported-booze-reveal-english-gin" }
			{ reqs [ { #type check-rel-flag id "german-schnapps" is set } ] lockey "convo.imported-booze-reveal-german-schnapps" }
		]
		buttons [
			{
				visreqs [ { #type check-rel-flag id "canadian-whiskey" is set } ]
				text { key "convo.imported-booze-reveal" }
				grants [ { #type unlock-resource id canadian-whiskey } { #type consume-tickets count 1 } ]
			}
			{
				visreqs [ { #type check-rel-flag id "scotch-whiskey" is set } ]
				text { key "convo.imported-booze-reveal" }
				grants [ { #type unlock-resource id scotch-whiskey } { #type consume-tickets count 1 } ]
			}
			{
				visreqs [ { #type check-rel-flag id "caribbean-rum" is set } ]
				text { key "convo.imported-booze-reveal" }
				grants [ { #type unlock-resource id caribbean-rum } { #type consume-tickets count 1 } ]
			}
			{
				visreqs [ { #type check-rel-flag id "irish-whiskey" is set } ]
				text { key "convo.imported-booze-reveal" }
				grants [ { #type unlock-resource id irish-whiskey } { #type consume-tickets count 1 } ]
			}
			{
				visreqs [ { #type check-rel-flag id "english-gin" is set } ]
				text { key "convo.imported-booze-reveal" }
				grants [ { #type unlock-resource id english-gin } { #type consume-tickets count 1 } ]
			}
			{
				visreqs [ { #type check-rel-flag id "german-schnapps" is set } ]
				text { key "convo.imported-booze-reveal" }
				grants [ { #type unlock-resource id german-schnapps } { #type consume-tickets count 1 } ]
			}
			{	;; nope.
				text { key "convo.imported-booze-reveal-nope" }
			}
		]
	}

	imported-booze-drop-select {
		npcsays [
			{ reqs [ { #type check-rel-flag id "canadian-whiskey" is set } ] lockey "convo.imported-booze-drop-npc-canadian" }
			{ reqs [ { #type check-rel-flag id "scotch-whiskey" is set } ] lockey "convo.imported-booze-drop-npc-scottish" }
			{ reqs [ { #type check-rel-flag id "caribbean-rum" is set } ] lockey "convo.imported-booze-drop-npc-caribbean" }
			{ reqs [ { #type check-rel-flag id "irish-whiskey" is set } ] lockey "convo.imported-booze-drop-npc-irish" }
			{ reqs [ { #type check-rel-flag id "english-gin" is set } ] lockey "convo.imported-booze-drop-npc-english" }
