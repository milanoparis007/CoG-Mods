	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	;;
	;; BUY SELL CONVOS

	buysell-state {
		npcsays [{ #type buy-sell-npc-blurb 
			rootkey "convo.buysell-state" 
			buydeets "convo.buysell-details-buying"
			selldeets "convo.buysell-details-selling"
			buyselldeets "convo.buysell-details-buysell"
			}]

		dynamicButtons CustomBuySellList
		dynamicTemplate {
			text	{ 
				dynkey [{ #type buy-sell-item-blurb 
					buykey "convo.buysell-button-buy" 
					sellkey "convo.buysell-button-sell" }]
			}
			onClick ShowNextBuySellState
		}

		buttons [{ 
			text { key "convo.buysell-button-footer" icon "convo.icon-back" }
			onShow	CancelBuySellSelection ;; restarts from top level
		}]
	}

	buysell-failed-state {
		npcsays [{ lockey "convo.buysell-failed-state" }]
		buttons [{ text { key "convo.buysell-failed-state-button" icon "convo.icon-cross" }}]
		;; no next - restart from top level
	}

	buysell-failed-harassed {
		npcsays [{ lockey "convo.buysell-failed-harassed" }]
		buttons [{ text { key "convo.buysell-failed-harassed-button" icon "ui.tickers.icon.forceclose-gang" }}]
		;; no next - restart from top level
	}

	buysell-tradelocked-trade {
		npcsays [{ lockey "convo.buysell-tradelocked-trade" }]
		buttons [{ text	{ key "convo.buysell-tradelocked-button" icon "ui.pipicon.biz-with-ai" }}]
		;; no next - restart from top level
	}

	buysell-tradelocked-territory {
		npcsays [{ lockey "convo.buysell-tradelocked-territory" }]
		buttons [{ text	{ key "convo.buysell-tradelocked-button" icon "convo.icon-cross" }}]
		;; no next - restart from top level
	}

	buysell-tradelocked-forceclosed {
		npcsays [{ lockey "convo.buysell-tradelocked-forceclosed" }]
		buttons [{ text	{ key "convo.buysell-tradelocked-button" icon "ui.tickers.icon.forceclose-gang" }}]
		;; no next - restart from top level
	}

	buysell-tradelocked-tiedhouse {
		npcsays [{ lockey "convo.buysell-tradelocked-tiedhouse-npc" }]
		buttons [{ 
			text	{ key "convo.buysell-tradelocked-tiedhouse-say" }
			onClick	ExecuteAddTiedHouseSocialHistory
			next 	{ goto buysell-tradelocked-tiedhouse-2 } 
		}]
	}

	buysell-tradelocked-tiedhouse-2 {
		npcsays [{ lockey "convo.buysell-tradelocked-tiedhouse-npc2" }]
		buttons [{ text	{ key "convo.buysell-tradelocked-button" icon "convo.icon-back" }}]
		;; no next - restart from top level
	}


	buysell-forceclosed-demand {
		npcsays [{ lockey "convo.buysell-forceclosed-npc1" }]
		buttons [{
			text { key "convo.buysell-forceclosed-say1" }
			next { goto buysell-forceclosed-demand2 }
		}]
	}

	buysell-forceclosed-demand2 {
		npcsays [{ lockey "convo.buysell-forceclosed-npc2" }]
		buttons [{ 
			text { key "convo.buysell-forceclosed-say2" }
			onClick ExecuteForceClosedDemand

			next { 
				reqs [{ #type special-is-trade-locked expected #true reason forceclosed }]
				then buysell-forceclosed-npcyes 
				else buysell-forceclosed-npcno
			}
		} {
			text { key "convo.buysell-forceclosed-later" icon "convo.icon-back" }
			;; no next - restart from toplevel
		}]
	}

	buysell-forceclosed-npcyes {
		npcsays [{ lockey "convo.buysell-forceclosed-npcyes" }]
		buttons [{ 
			text { key "convo.buysell-forceclosed-epiyes" }
			;; no next - restart from toplevel
		}]
	}

	buysell-forceclosed-npcno {
		npcsays [{ lockey "convo.buysell-forceclosed-npcno" }]
		buttons [{ 
			text { key "convo.buysell-forceclosed-epino" }
			;; no next - restart from toplevel
		}]
	}


	cash-boost-grant {
		npcsays [{ lockey "convo.cash-boost-npc-1" }]
		buttons [
			{
				text { key "convo.cash-boost-accept" }
				grants [
					{ #type add-cash amount 750 at crew }
					{ #type add-rel-buff id "relbuff-loan-granted" }
					{ #type consume-tickets count 1 }
					{ #type add-xp source from-social }
				]
				next { goto cash-boost-outro }
			}
			{
				text { key "convo.cash-boost-later" icon "convo.icon-back" }
				;; no next - restart from top level
			}
		]
	}
	cash-boost-outro {
		npcsays [ { lockey "convo.cash-boost-outro-npc" } ]
		buttons [ { text { key "convo.cash-boost-outro-accept" }} ]
		;; no next - restart from top level
	}



	;; actual buy and sell

	buy-selection-state {
		npcsays [{ lockey "convo.buy-select-npc" }]
		buttons [
			{ 	text 	{ key "convo.buy-select-button-now" npc "convo.buy-select-button-now.npc" }
			  	onClick ShowBuySellPopup 
			}
		 	{ 	reqs 	[{ #type check-rel-flag id "buysell-price" is notset lockey "req.check-rel-flag.buysell-price" }]
		 		text 	{ key "convo.buy-select-button-price" } 
		 		next 	{ goto buy-price-state }
		 	}
			{   visreqs	[{ #type special-is-tied-house type none }]
				reqs	[{ #type check-owner-relationship is atleast value 10 }] 
				text 	{ key "convo.buy-select-button-tied" icon #null }
				onShow	StoreOwnerTiedHouseProposal
		 		next 	{ goto buysell-state-tied-start } 
		 	}
		 	{ 	text 	{ key "convo.buy-select-button-later" icon "convo.icon-back" } 
		 		onShow	CancelBuySellSelection
		 		next 	{ goto buysell-state } 
		 	}
		]
	}

	buy-territory-problem-state {
		npcsays [{ lockey "convo.buy-territory-problem-npc" }]
		buttons [{ 
			text 	{ key "convo.buy-territory-problem-say" addmo #true }
			grants 	[{ #type show-one-time-hint-photo id explainCornerNeed }]
			next 	{ goto buysell-state }
		}]
	}

	sell-selection-state {
		npcsays [{ lockey "convo.sell-select-npc" }]
		buttons [
			{ 	text 	{ key "convo.sell-select-button-now" npc "convo.sell-select-button-now.npc" }
			  	onClick ShowBuySellPopup 
			}
		 	{ 	reqs 	[{ #type check-rel-flag id "buysell-price" is notset lockey "req.check-rel-flag.buysell-price" }]
		 		text 	{ key "convo.sell-select-button-price" } 
		 		next 	{ goto sell-price-state }
		 	}
			{   visreqs	[{ #type special-is-tied-house type none }]
				reqs 	[{ #type check-owner-relationship is atleast value 10 }] 
				text 	{ key "convo.sell-select-button-tied" icon #null }
				onShow	StoreOwnerTiedHouseProposal
		 		next 	{ goto buysell-state-tied-start } 
		 	}
		 	{ 	text 	{ key "convo.sell-select-button-later" icon "convo.icon-back" } 
		 		onShow	CancelBuySellSelection
		 		next 	{ goto buysell-state } 
		 	}
		]
	}

	sell-selection-state-pickup {
		npcsays [{ lockey "convo.sell-select-button-pickup.npc" }]
		buttons [{ text { key "convo.sell-select-button-pickup.say" } 
		 		   next { goto buysell-state } }]
	}

	sell-territory-problem-state {
		npcsays [{ lockey "convo.sell-territory-problem-npc" }]
		buttons [{ 
			text 	{ key "convo.sell-territory-problem-say" addmo #true }
			grants 	[{ #type show-one-time-hint-photo id explainCornerNeed }]
			next 	{ goto buysell-state }
		}]
	}




	buy-price-state {
		npcsays [{ lockey "convo.buy-price-state" }]

		;; confirm buttons: higher, normal, and lower price
		buttons [
		{	
			text 	{ key "convo.buy-price-pos-button" addmo #true 	
					  npc "convo.buy-price-pos-button.epilogue" }

			multiplier 	1.2
			onShow		StorePriceMultiplier	
			onClick		ExecutePriceMultiplier

			next 	{ goto buy-selection-state }
			grants  [{ #type set-rel-flag with owner id "buysell-price" dayz { value 14 } }
					 { #type add-rel-buff with owner id "relbuff-player-pays-more" }]
		}
		{	
			text { key "convo.buy-price-any-button" addmo #true 
				   npc "convo.buy-price-any-button.epilogue" }

			multiplier 	1.0
			onShow		StorePriceMultiplier	
			onClick		ExecutePriceMultiplier

			grants  [{ #type set-rel-flag with owner id "buysell-price" dayz { value 14 } }] 
			next 	{ goto buy-selection-state }
		}
		{	
			reqs [{ #type check-owner-relationship is atleast value 10 }]
			text { key "convo.buy-price-neg-button" addmo #true 
				   npc "convo.buy-price-neg-button.epilogue" }

			multiplier 	0.8
			onShow		StorePriceMultiplier	
			onClick		ExecutePriceMultiplier

			grants  [{ #type set-rel-flag with owner id "buysell-price" dayz { value 14 } }]
			next 	{ goto buy-selection-state }
		}
		{
			visreqs	[ { #type check-owner-relationship is atleast value 5 }
				      { #type check-player-same-ethnicity } 
					  { #type check-player-skills has any of [ polish-speaker ]}]

			text { key "convo.buy-price-neg-button.polish" addmo #true 
				   npc "convo.buy-price-neg-button.polish.epilogue"
				   icon "eth.pl.flag-icon"}

			multiplier	0.7
			onShow		StorePriceMultiplier
			onClick		ExecutePriceMultiplier

			grants	[ { #type set-rel-flag with owner id "buysell-price" dayz { value 14 }}]

			next	{ goto sell-selection-state }
		}
		]
	}

	sell-price-state {
		npcsays [{ lockey "convo.sell-price-state" }]

		;; confirm buttons: lower, normal, and higher price
		buttons [
		{	
			text { key "convo.sell-price-pos-button" addmo #true 
				   npc "convo.sell-price-pos-button.epilogue" }

			multiplier 	0.8
			onShow		StorePriceMultiplier	
			onClick		ExecutePriceMultiplier

			grants  [{ #type set-rel-flag with owner id "buysell-price" dayz { value 14 } }
			         { #type add-rel-buff with owner id "relbuff-player-sells-cheap" }]

			next 	{ goto sell-selection-state }
		}
		{	
			text { key "convo.sell-price-any-button" addmo #true 
				   npc "convo.sell-price-any-button.epilogue" }

			multiplier 	1.0
			onShow		StorePriceMultiplier	
			onClick		ExecutePriceMultiplier

			grants  [{ #type set-rel-flag with owner id "buysell-price" dayz { value 14 } }]
			next 	{ goto sell-selection-state }
		}
		{	
			reqs [{ #type check-owner-relationship is atleast value 1 }]
			text { key "convo.sell-price-neg-button" addmo #true 
				   npc "convo.sell-price-neg-button.epilogue" }

			multiplier 	1.2
			onShow		StorePriceMultiplier	
			onClick		ExecutePriceMultiplier

			grants  [{ #type set-rel-flag with owner id "buysell-price" dayz { value 14 } }
			         { #type add-rel-buff with owner id "relbuff-player-gouges" }]

			next 	{ goto sell-selection-state }
		}
		{
			visreqs	[ { #type check-owner-relationship is atleast value 1 }
				      { #type check-player-same-ethnicity } 
					  { #type check-player-skills has any of [ polish-speaker ]}]

			text { key "convo.sell-price-pos-button.polish" addmo #true 
				   npc "convo.sell-price-pos-button.polish.epilogue"
				   icon "eth.pl.flag-icon" }

			multiplier	1.3
			onShow		StorePriceMultiplier
			onClick		ExecutePriceMultiplier

			grants	[ { #type set-rel-flag with owner id "buysell-price" dayz { value 14 }}]

			next	{ goto sell-selection-state }
		}
		]
	}

	buysell-state-tied-start {
		npcsays [{ lockey "convo.buysell-state-tied-start-npc1" }]
		buttons [{ text { key "convo.buysell-state-tied-start-say1" } next { goto buysell-state-tied-2 } }]
	}

	buysell-state-tied-2 {
		npcsays [{ lockey "convo.buysell-state-tied-start-npc2" }]
		buttons [{ text { key "convo.buysell-state-tied-start-say2" } next { goto buysell-state-tied-3 } }]
	}

	buysell-state-tied-3 {
		npcsays [{ lockey "convo.buysell-state-tied-start-npc3" }]
		buttons [{ 
			reqs [{ #type special-can-pay-for-tied-house-proposal }]
			text { 
				key "convo.buysell-state-tied-start-say3" 
				npc "convo.buysell-state-tied-start-say3epi"
				} 
			onClick	ExecutePayForTiedHouseProposal
			;; no next, start from the top
		} {
			text { 
				key "convo.buysell-state-tied-start-no" 
				npc "convo.buysell-state-tied-start-noepi"
				icon "convo.icon-back" }
			;; no next, start from the top
		}]
	}



	;; ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	;;
	;; TRIBUTE CONVOS


	;; tribute starter
	tribute-confirm-state {
		; NPC SAYS "i don't like where this is going"
		npcsays [{ #type relationship-based-blurb rootkey "convo.tribute-confirm-state-npc" }]

		buttons [
		{	; "you have a nice army base here. it would be a shame if it burned down."
			text 	{ dynkey [{ #type relationship-based-blurb rootkey "convo.tribute-confirm-button" }] }
			
			visreqs [ { #type check-convo-demand-state is notset to compliant } ]
			
			onShow 	StoreTributeInfo
			next 	{ reqs	[ { #type check-convo-demand-state is set to defiant } ]
					  then 	tribute-refuse
					  else	tribute-select-state }
		}
		{	; "the old deal is still on"
			text 	{ dynkey [{ #type relationship-based-blurb rootkey "convo.tribute-reconfirm-button" }] }

			visreqs [ { #type check-convo-demand-state is set to compliant } ]

			onShow 	StoreTributeInfo
			onClick ExecuteDemandProtectionAlreadyCompliant
			grants 	[{ #type consume-actions for convo }]
			next 	{ goto tribute-finish } 
		}
		{	; "actually never mind"
			text { key "convo.tribune-confirm-cancel-button" icon "convo.icon-back" }
			;; no next - restart from top level 
		}
		]
	}

	;; tribute confirm
	tribute-select-state {
		; NPC SAYS "what do you want from me"
		npcsays [{ #type relationship-based-blurb rootkey "convo.tribute-select-state-npc" }]

		buttons [
		{	;; 		execute tribute
			text 	{ dynkey [{ #type relationship-based-blurb rootkey "convo.tribute-select-cash-button" }] 
					  mo "convo.tribute-select-cash-button" }

			onClick ExecuteDemandProtectionVerbal
			grants 	[{ #type consume-actions for convo } { #type add-heat-buff-at-node id "heatbuff-extortion" instant #true } ]

			next 	{ reqs	[ { #type check-convo-demand-state is set to compliant } ]
					  then 	tribute-finish
					  else	tribute-refuse }
		}

		{	; "i was just testing you"
			text { 
				dynkey 	[{ #type relationship-based-blurb rootkey "convo.tribute-select-cancel-button" }]
				icon 	"convo.icon-back"
			}
			;; no next - restart from top level
		}
		]
	}

	;; tribute epilogue
	tribute-finish {
		; NPC SAYS "i don't have a choice, do i?"
		npcsays [{ #type relationship-based-blurb rootkey "convo.tribute-finish-npc" }]
		buttons [
		{	;; 		 "then we're in agreement"
			text { 
				dynkey [{ #type relationship-based-blurb rootkey "convo.tribute-finish-button" }]
				dynnpc [{ #type relationship-based-blurb rootkey "convo.tribute-finish-epilogue-npc" }]
			}
			;; no next - restart from top level
		}
		]
	}

	;; tribute defiance
	tribute-refuse {
		; NPC SAYS "go to hell"
		npcsays [{ #type relationship-based-blurb rootkey "convo.tribute-refuse-npc" }]
		buttons [
		{	;; 		 "i'm going to bust up the joint"
			text { 
				dynkey [{ #type relationship-based-blurb rootkey "convo.tribute-refuse-force-button" }]
			}
			onClick ExecuteDemandProtectionAttack
			next	{ reqs	[ { #type check-convo-demand-state is set to compliant } ]
					  then 	tribute-forced
					  else	tribute-refuse-2 }
		}
		{	;; 		 "i'll be back but i won't be as nice then"
			text { 
				dynkey [{ #type relationship-based-blurb rootkey "convo.tribute-refuse-fine-button" }]
				dynnpc [{ #type relationship-based-blurb rootkey "convo.tribute-refuse-fine-epilogue-npc" }]
			}
			;; no next - restart from top level
		}
		]
	}

	;; tribute forced, acquiesce
	tribute-forced {
		; NPC SAYS "what have i don't to deserve this! (comply)"
		npcsays [{ #type relationship-based-blurb rootkey "convo.tribute-forced-npc" }]
		buttons [
		{	;; 		 "it's only business"
			text { 
				dynkey [{ #type relationship-based-blurb rootkey "convo.tribute-forced-button" }]
				npc "convo.tribute-forced-epilogue-npc"
			}
			;; no next - restart from top level
		}
		]
	}

	;; tribute forced, still refuse
	tribute-refuse-2 {
		; NPC SAYS "you can't intimidate me"
		npcsays [{ lockey "convo.tribute-refuse-2-npc" }]
		buttons [
		{	;; 		 "we'll see about that"
			text { key "convo.tribute-refuse-2-button" }
			onClick Goodbye
		}
		]
	}


	;; confirm canceling tribute
	cancel-tribute-state {
		; NPC SAYS "what's up?"
		npcsays [{ #type relationship-based-blurb rootkey "convo.cancel-tribute-npc" }]
		buttons [
		{	;; 		 "we're withdrawing protection"
			text { 
				dynkey [{ #type relationship-based-blurb rootkey "convo.cancel-tribute-confirm-button" }]
				dynnpc [{ #type relationship-based-blurb rootkey "convo.cancel-tribute-confirm-npc" }]
				mo "convo.cancel-tribute-confirm-button.mo"
			}
			onClick		ExecuteTributeCancel
			grants 		[
				{ #type consume-actions for convo }
				{ #type add-rel-buff id relbuff-tribute-canceled }
				;; do not remove buffs here, they're removed automatically when cancelling tribute
			]
			;; no next - restart from top level
		}
		{	; "maybe later"
			text { key "convo.cancel-tribute-later-button" icon "convo.icon-back" }
			;; no next - restart from top level
		}
		]
	}



	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	;;
	;; TICKET SPEND
	;; call in a favor
	
	redeem-favor-owed {
		npcsays [ { #type rel-type-blurb to player keyroot "convo.ticket-group-soc-npc" } ]

		buttons [
			{
				;;		"tell me about any interesting events happening here"
				text 	{ key "convo.ticket-resevent-button" icon "ui.pipicon.resevent" addmo #true }

				visreqs [{ #type check-rel-flag id "ticket-resevent-rel-flag" is notset }
						 { #type special-res-event-can-be-picked expected #true }]
				reqs 	[{ #type check-owner-relationship is atleast value 10 }] 
				onClick StorePickResEvent

				next 	{
					reqs [{ #type special-res-event-has-been-picked expected #true }]
					then ticket-resevent-intro
					else ticket-resevent-missing
				}
			}
			{
				;;		"you're going to be making a deposit in my new bank"
				text 	{ key "convo.force-deposit-button" icon "convo.crew.start-scheme.icon" addmo #true }

				visreqs [ { #type check-completed-chapter-success id gain-bank succeeded true } { #type check-rel-flag id "forced-loan" is notset } ]
				reqs [ { #type check-relationship-tickets is atleast value 2 } ]
				next { goto ticket-force-loan-start }
			}		
			{	;; 		"i hear you want to play matchmaker"
				text 	{ key "convo.ticket-moduleintro-button" icon "ui.pipicon.social-bizintro" addmo #true }

				visreqs [{ #type check-convo-query id kb-can-intro-for-business }
						 { #type check-can-intro-for-business }] ;; belt and suspenders bc there's a caching bug somewhere
			  	onClick	StoreModuleIntro

			  	next	{ goto ticket-moduleintro-start }
			}
			{	;; 		"need your support with a common friend"
				text 	{ key "convo.ticket-npcboost-button" icon "ui.pipicon.social" addmo #true }

				reqs [{ #type check-npc-knows-common-friend }]
			  	onClick ShowTicketBoostPopup
				;; next state will be advanced in code
			}
			{
				;;		"i'm looking to hire someone for my crew"
				text 	{ key "convo.ticket-hirecrew-button" icon "ui.pipicon.social-crew" addmo #true }

				visreqs [{ #type check-convo-query id kb-can-hire-new-crew }]
				reqs 	[{ #type check-connections-and-cap-for-crew-intro }]

			  	onShow	StoreTicketCrewIntroChoice
				next	{ goto ticket-hirecrew-start }
			}
			{
				;;		i'm looking to buy local support for my politician
				text	{ key "convo.ticket-politician-boost-button" icon "ui.pipicon.politics" addmo #true }

				visreqs	[ { #type check-election-stage-in-this-ward stage campaign } 
						  { #type check-has-sponsored-politician-in-ward expected #true }
						  { #type check-owner-relbuffs has none of [relbuff-ticket-politician-boost]}
						  { #type check-has-outpost location this-building expected #false}
				]

				next	{ goto ticket-politician-boost }
			}
			{
				;;		i'm looking to buy local support for my politician (OUTPOST EDITION)
				text	{ key "convo.ticket-politician-frontboost-button" icon "ui.pipicon.politics" addmo #true }

				visreqs	[ { #type check-election-stage-in-this-ward stage campaign } 
						  { #type check-has-sponsored-politician-in-ward expected #true }
						  { #type check-owner-relbuffs has none of [ relbuff-ticket-politician-boost ]}
						  { #type check-has-outpost location this-building expected #true }
				]

				next	{ goto ticket-politician-frontboost }
			}
			{	;; matchmaker with goon
				text 	{
					key "convo.ticket-boost.goon.button"
					icon "ui.pipicon.social-goon-intro"
					addmo #true
				}

				visreqs [{ #type check-convo-query id kb-can-boost-for-goon }]
			  	onClick	StoreTicketBoostGoon
			  	next	{ goto ticket-goon-boost-start }
			}
			{	;; set up an outpost - outside
				visreqs [{ #type check-is-convo-inside-territory expected #false } { #type check-location-district-tags has none of [ kentucky canada canada-two ] } 
						{ #type check-module-in-convo has none of [ civic-passenger-station civic-freight-station source-materials-medium-back-one source-materials-medium-back-two ] }
						 { #type check-has-outpost location this-node-or-nearby expected #false }]
				reqs 	[{ #type check-owner-relationship is atleast value 10 }
						 ]

				text 	{ 
					icon "ui.pipicon.front" mo "convo.start-outpost-outside.mo"
					dynkey	[
						{ lockey "convo.start-outpost-outside.old" reqs [{ #type check-outpost-closures is atleast value 1 }] }
						{ lockey "convo.start-outpost-outside.new" }
					]
				}
				next	{ reqs [{ #type check-outpost-closures is atleast value 1 }] 
						  then start-outpost-outside-old else start-outpost-outside-new }
			}
			{   ;; set up an outpost - inside
				visreqs [{ #type check-has-outpost location this-node expected #false } 
						{ #type check-module-in-convo has none of [ civic-passenger-station civic-freight-station source-materials-medium-back-one source-materials-medium-back-two ] }
						{ #type check-owner-relbuffs has none of [ relbuff-starting-francine ] }
						 { #type check-is-convo-inside-territory expected #true }]
				reqs 	[{ #type check-owner-relationship is atleast value 15 }
						 { #type check-is-convo-at-controlled-building expected #false }
						 ]

				text 	{ 
					icon "ui.pipicon.front" mo "convo.start-outpost-inside.mo"
					dynkey	[
						{ lockey "convo.start-outpost-inside.old" reqs [{ #type check-outpost-closures is atleast value 1 }] }
						{ lockey "convo.start-outpost-inside.new" }
					]
				}
				next	{ reqs [{ #type check-outpost-closures is atleast value 1 }]
						  then start-outpost-inside-old else start-outpost-inside-new }
			}
			{
				;;			"prompt to find a gambling house"
				visreqs	[ { #type check-player-has-corners-for-casino }
						
						  { #type check-potential-casino-in-range }
						]
				
				reqs	[ 
						  ;{ #type check-biz-in-paid-off-precinct expected #true }
						  { #type check-owner-relationship is atleast value 20 }
						  { #type check-relationship-tickets is atleast value 2 }
						  { #type check-casinos-in-precinct }
						]
				text	{ key "convo.ticket-gambling-house.button" icon "ui.pipicon.gambling-house" addmo #true}
				
				next 	{ goto ticket-gambling-start }
			}
			{
				;;		"i'm looking for expansion opportunities"
				visreqs [{ #type check-convo-query id kb-can-take-over-business }]

				reqs 	[
						 { #type check-owner-relationship is atleast value 20 }
						 { #type check-potential-biz-building }
						 { #type check-potential-biz-family }
						 { #type special-biz-purchase-button test HighWatermark }
						 ]

				text 	{ key "convo.ticket-building-button" icon "ui.pipicon.social-expansion" addmo #true }

				onShow	StoreTicketBuildingChoice
				next	{ goto ticket-building-start }
			}
			{	;; how about some weapons?
				visreqs [
					{ #type check-has-outpost location this-building expected #true }
				]
				text { key "convo.outpost-weapon.request" icon "rescat.weapon.icon" }
				next { goto outpost-weapons }
			}
			{   ;; "help me find some legal resources"
				visreqs [{ #type special-check-has-legal-reveal-options }
						 { #type check-has-outpost location this-building expected #true}]
				
				onPreshow	StoreTicketResourceRevealChoice
				
				text { key "convo.resources-reveal.request" icon "rescat.ingredient.icon" addmo #true }
				next { goto ticket-resource-reveal-start}
			}

			;; atlantic city import booze favors

			;; reveal imported booze on map

			;; player and owner same ethnicity
			{	
				text { key "convo.ticket.imported-booze-reveal-same-same" icon "rescat.booze.icon" mo "imported-booze-reveal-same-same.mo" }
				visreqs [ 
					{ #type check-current-city is any of [ atlantic-city ] }
					{ #type check-player-territory-size is atleast value 10 }
					{ #type check-ethnicity is player oneof [ ca ] } { #type check-ethnicity is owner oneof [ ca ] } 
					{ #type check-player-unlocked-resources has none of [ canadian-whiskey ] } 
					{ #type check-rel-flag id "building-takeover" is notset }
					{ #type check-has-outpost location this-building expected #false }
				]
