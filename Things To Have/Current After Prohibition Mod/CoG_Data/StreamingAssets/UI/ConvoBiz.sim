	;; pick something to spend the relationship ticket on - social options
	ticket-group-soc {
		;; NPC SAYS "i'd love to help you in some way"
		npcsays [{ #type rel-type-blurb to player keyroot "convo.ticket-group-soc-npc" }]

		buttons [ 
			
			{	;; 		"know anyone i should meet?"
				text 	{ key "convo.ticket-intro-button" addmo #true }

			  	onClick	ShowTicketIntroPopup
			  	;; next state will be advanced in code
			}
			
		]
	}
	;; pick something to spend the relationship ticket on - learning options
	ticket-group-help {
		;; NPC SAYS "i'd love to help you in some way"
		npcsays [{ #type rel-type-blurb to player keyroot "convo.ticket-group-help-npc" }]

		buttons [ 
			


			

			
			{	;; 		"never mind"
				text 	{ key "convo.ticket-back-button" icon "convo.icon-back" }
				;; no next - restart from top level
			}
		]
	}

	;; ticket intro - got one
	ticket-intro-confirm {
		; NPC SAYS "i know X"
		npcsays [{ lockey "convo.ticket-intro-confirm-npc" }]
		buttons [
		{	;; 		"let's do it"
			text 	{ key "convo.ticket-intro-confirm-button" }

			onClick ExecuteTicketIntro
			grants	[ 
					 { #type consume-actions for convo }
					 { #type add-xp source from-social }]

			;; no next - restart from top level
		}
		{	;; 		"never mind"
			text 	{ key "convo.ticket-back-button" icon "convo.icon-back" }
			grants 	[{ #type center-camera-on-building }]
			next 	{ goto ticket-group-soc }
		}
		]
	}

	;; ticket intro - got one
	ticket-goon-intro-confirm {
		; NPC SAYS "i know X"
		npcsays [{ lockey "convo.ticket-intro-confirm-npc" }]
		buttons [
		{	;; 		"let's do it"
			text 	{ key "convo.ticket-intro-confirm-button" }

			onClick ExecuteTicketIntro
			grants	[ 
					 { #type consume-actions for convo }
					 { #type add-xp source from-social }]

			;; no next - restart from top level
		}
		{	;; 		"never mind"
			text 	{ key "convo.ticket-back-button" icon "convo.icon-back" }
			grants 	[{ #type center-camera-on-building }]
			next 	{ goto redeem-favor-owed }
		}
		]
	}

	;; ticket intro - nobody available
	ticket-intro-none {
		; NPC SAYS "i don't have anyone"
		npcsays [{ lockey "convo.ticket-intro-none-npc" }]
		buttons [
		{	;; 		"never mind"
			text	{ key "convo.ticket-intro-none-button" icon "convo.icon-back" }
			grants 	[{ #type center-camera-on-building }]
			next	{ goto redeem-favor-owed }
		}
		]
	}

	ticket-moduleintro-start {
		; NPC says "you're still making booze right? you should meet someone"
		npcsays [{ lockey "convo.ticket-moduleintro-start-npc" }]
		buttons [
		{	;; 		"tell me more"
			text 	{ key "convo.ticket-moduleintro-start-button" }
			onClick	ExecuteNPCSelectionZoom
			next	{ goto ticket-moduleintro-tellmore }
		}
		]
	}

	ticket-force-loan-start {
		;; NPC says "a deposit, eh?"
		npcsays	[{ lockey "convo.ticket-force-loan-start-npc" }]
		buttons [
		{
			text	{ key "convo.ticket-force-loan-start-button" }
			grants [ { #type add-cash amount 500 at crew } { #type set-rel-flag with owner id "forced-loan" } { #type add-rel-buff with owner id "relbuff-forced-loan" } { #type consume-tickets count 1 } ]
			next { goto redeem-favor-owed }
		}
		{ ;; nevermind
			text { key "convo.ticket-force-loan-start-cancel" }
			next { goto redeem-favor-owed }
		}
		]
	}

	ticket-moduleintro-tellmore {
		; NPC says "you should meet my friend bob, you have common business interests"
		npcsays [{ lockey "convo.ticket-moduleintro-tellmore-npc" }]
		buttons [
		{	;; 		"let's do it"
			text 	{ key "convo.ticket-moduleintro-tellmore-button" }

			onClick ExecuteTicketIntro
			grants	[ 
					 { #type consume-actions for convo }
					 { #type add-xp source from-social }]

			;; no next - restart from top level
		}
		{	;; 		"never mind"
			text 	{ key "convo.ticket-moduleintro-maybe-later" icon "convo.icon-back" }
			grants  [{ #type center-camera-on-building }]
			next 	{ goto ticket-moduleintro-maybe-later }
		}
		]
	}
	ticket-moduleintro-maybe-later {
		npcsays [{lockey "convo.ticket-moduleintro-maybe-later-npc"}]
		buttons [
		{
			text 	{ key "convo.social-cancel" icon "convo.icon-back" }
			;; no next - restart from top level
		}
		]
	}

	;; residential event
	ticket-resevent-intro {
		; NPC SAYS: "yeah i know of a quiet little poker game..."
		npcsays [{ #type special-res-event-blurb }]
		buttons [
		{	;; 		"please intro me"
			text 	{ key "convo.ticket-resevent-intro-confirm-button"
					  npc "convo.ticket-resevent-intro-confirm-epilogue" }

			onClick ExecuteResEventIntro
			grants	[{ #type set-rel-flag with owner id "ticket-resevent-rel-flag" } 
					 { #type consume-actions for convo }
					 { #type add-xp source from-social }]

			;; no next - restart from top level
		}
		{	;; 		"never mind"
			text 	{ key "convo.ticket-resevent-intro-cancel-button" icon "convo.icon-back" }
			grants  [{ #type center-camera-on-building }]
			next 	{ goto redeem-favor-owed }
		}
		]
	}

	ticket-resevent-missing {
		;; NPC SAYS "i know nothing about nothing"
		npcsays [{ lockey "convo.ticket-resevent-missing-npc" }]
		buttons [
		{	;; 		"too bad"
			text 	{ key "convo.ticket-resevent-missing-button" }
			next 	{ goto ticket-group-soc }
		}
		]
	}
	
	ticket-goon-boost-start {
		npcsays [{ lockey "convo.ticket-boost.goon.start.blurb" }]
