				;; no next -->top
			}
			{
				visreqs [
					{ #type check-player-skills has any of [ fruit-brandy ] }
				]
				text { key "convo.train-station-mission-start-four-fruit-brandy" }
				grants [
					{ #type remove-rel-buff with owner matchall #true id "relbuff-train" }
					{ #type add-rel-buff id relbuff-train-smuggling }
					{ #type force-start-quest-on-owner id train-station-mission-four-fruit-brandy }
					{ #type remove-rel-buff with owner id relbuff-train-restart }
				]
				;; no next -->top
			}
			{
				visreqs [
					{ #type check-player-skills has any of [ corn-whiskey ] }
				]
				text { key "convo.train-station-mission-start-four-corn-whiskey" }
				grants [
					{ #type remove-rel-buff with owner matchall #true id "relbuff-train" }
					{ #type add-rel-buff id relbuff-train-smuggling }
					{ #type force-start-quest-on-owner id train-station-mission-four-corn-whiskey }
					{ #type remove-rel-buff with owner id relbuff-train-restart }
				]
				;; no next -->top
			}
			{
				text { key "convo.train-station-mission-start-four-pass" }
				next { goto train-station-mission-start }
			}

		]
	}

	;; city-specific actions

	bottle-rack-build {
		npcsays [ { lockey "convo.bottle-rack-build-npc" } ]
		buttons [
			{
				text { key "convo.bottle-rack-build-confirm" addmo #true }
				grants [
					{ #type force-start-quest-on-owner id bottle-rack-build }
					{ #type consume-tickets count 1 }
				]
				;; no next --> top
			}
			{
				text { key "convo.bottle-rack-build-pass" }
				;; no next --> top
