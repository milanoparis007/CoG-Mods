		{
			text 	{ key "convo.ticket-boost.goon.start.button" }
			onClick	ExecuteNPCSelectionZoom
			next	{ goto ticket-goon-boost-tell-more }
		}
		]
	}
	
	ticket-goon-boost-tell-more {
