				text { key "convo.outpost-weapon.broomhandle" icon "weapon.pistol.icon" }
				grants [ { #type add-rel-buff with owner id "relbuff-outpost-weapons" } { #type add-resource id weapon-broomhandle qty 1 at crew } { #type add-cash amount -450 at safehouse } ]
