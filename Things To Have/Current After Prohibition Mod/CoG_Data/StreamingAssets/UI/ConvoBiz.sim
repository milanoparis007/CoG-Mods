	imported-booze-favor-option {
		npcsays [
			{ reqs [ { #type check-rel-flag id "canadian-whiskey" is set } { #type check-relationship-tickets is lessorequalto value 2 } { #type check-quests has none of [ imported-booze-favor-one imported-booze-favor-two imported-booze-favor-three ] status active } ] lockey "convo.imported-booze-favor-option-npc-canadian" }
			{ reqs [ { #type check-rel-flag id "scotch-whiskey" is set } { #type check-relationship-tickets is lessorequalto value 2 } { #type check-quests has none of [ imported-booze-favor-one imported-booze-favor-two imported-booze-favor-three ] status active } ] lockey "convo.imported-booze-favor-option-npc-scottish" }
			{ reqs [ { #type check-rel-flag id "caribbean-rum" is set } { #type check-relationship-tickets is lessorequalto value 2 } { #type check-quests has none of [ imported-booze-favor-one imported-booze-favor-two imported-booze-favor-three ] status active } ] lockey "convo.imported-booze-favor-option-npc-caribbean" }
			{ reqs [ { #type check-rel-flag id "irish-whiskey" is set } { #type check-relationship-tickets is lessorequalto value 2 } { #type check-quests has none of [ imported-booze-favor-one imported-booze-favor-two imported-booze-favor-three ] status active } ] lockey "convo.imported-booze-favor-option-npc-irish" }
			{ reqs [ { #type check-rel-flag id "english-gin" is set } { #type check-relationship-tickets is lessorequalto value 2 } { #type check-quests has none of [ imported-booze-favor-one imported-booze-favor-two imported-booze-favor-three ] status active } ] lockey "convo.imported-booze-favor-option-npc-english" }
			{ reqs [ { #type check-rel-flag id "german-schnapps" is set } { #type check-relationship-tickets is lessorequalto value 2 } { #type check-quests has none of [ imported-booze-favor-one imported-booze-favor-two imported-booze-favor-three ] status active }] lockey "convo.imported-booze-favor-option-npc-german" }
			{ reqs [ { #type check-relationship-tickets is morethan value 2 } { #type check-quests has none of [ imported-booze-favor-one imported-booze-favor-two imported-booze-favor-three ] status active } ] lockey "convo.imported-booze-favor-friends-npc" }
			{ reqs [ { #type check-quests has any of [ imported-booze-favor-one imported-booze-favor-two imported-booze-favor-three ] status active } ] lockey "convo.imported-booze-favor-friends-npc" }

		]
		buttons [
			{
				visreqs [
					{ #type check-owner-relationship is lessthan value 20 }
					{ #type check-relationship-tickets is lessorequalto value 2 }
				]
				text { key "convo.imported-booze-favor-option-confirm" addmo #true }
				grants [
					{ #type force-start-quest-on-owner id imported-booze-favor-one }
				]
				;; no next - top
			}
			{
				visreqs [
					{ #type check-owner-relationship is morethan value 20 }
					{ #type check-owner-relationship is lessthan value 60 }
					{ #type check-relationship-tickets is lessorequalto value 2 }
				]
				text { key "convo.imported-booze-favor-option-confirm" addmo #true }
				grants [
					{ #type force-start-quest-on-owner id imported-booze-favor-two }
				]
				;; no next - top
			}
			{
				visreqs [
					{ #type check-owner-relationship is morethan value 60 }
					{ #type check-relationship-tickets is lessorequalto value 2 }
					{ #type check-quests has none of [ imported-booze-favor-one imported-booze-favor-two imported-booze-favor-three ] status active }
				]
				text { key "convo.imported-booze-favor-option-confirm" addmo #true }
				grants [
					{ #type force-start-quest-on-owner id imported-booze-favor-three }
				]
				;; no next - top
			}
			{
				visreqs [ { #type check-relationship-tickets is morethan value 2 } { #type check-quests has none of [ imported-booze-favor-one imported-booze-favor-two imported-booze-favor-three ] status active } ]
				text { key "convo.imported-booze-favor-friends" }
				;; you're cool with them. top.
			}
			{
				visreqs [ { #type check-quests has any of [ imported-booze-favor-one imported-booze-favor-two imported-booze-favor-three ] status active } ]
				text { key "convo.imported-booze-favor-friends" }
				;; quest active - top
			}
			{
				visreqs [ { #type check-relationship-tickets is lessorequalto value 2 } ]
				text { key "convo.imported-booze-favor-option-pass" }
				;; nope. top.
			}
		]
	}
	




