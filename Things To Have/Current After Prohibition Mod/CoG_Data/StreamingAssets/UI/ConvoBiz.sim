				;; top
			}
			{
				visreqs [
					{ #type check-current-city is any of [ cincinnati ] }
					{ #type check-owner-relbuffs has all of [ relbuff-cargo-active relbuff-train-corn-whiskey ] }
					{ #type check-is-convo-inside-territory expected #true }
					{ #type check-biz-in-paid-off-precinct expected #true }
					{ #type check-active-quest-count with owner is equalto value 0 }
				]

				grants [
					{ #type remove-rel-buff with owner id relbuff-cargo-active }
				]

				text { key "convo.train-station-mission-three-restart" }
				
				next { goto train-station-mission-three-confirm }
			}
			{
				visreqs [
					{ #type check-current-city is any of [ pittsburgh ] }
					{ #type check-owner-relbuffs has all of [ relbuff-cargo-active relbuff-train-corn-whiskey ] }
					{ #type check-player-skills has all of [ corn-whiskey ] }
					{ #type check-is-convo-inside-territory expected #true }
					{ #type check-biz-in-paid-off-precinct expected #true }
					{ #type check-active-quest-count with owner is equalto value 0 }
				]

				grants [
					{ #type remove-rel-buff with owner id relbuff-cargo-active }
				]

				text { key "convo.train-station-mission-three-stop" }
				
				next { goto train-station-mission-three-confirm }
			}
			{
				visreqs [
					{ #type check-owner-relbuffs has all of [ relbuff-cargo-active relbuff-train-fallback ] }
					{ #type check-player-skills has all of [ fake-wine sparkling-cider fake-beer bathtub-ginworks ] }
					{ #type check-is-convo-inside-territory expected #true }
					{ #type check-biz-in-paid-off-precinct expected #true }
					{ #type check-active-quest-count with owner is equalto value 0 }
				]

				grants [
					{ #type force-start-quest-on-owner id train-station-mission-three-fallback }
					{ #type remove-rel-buff with owner id relbuff-train-restart }
				]

				text { key "convo.train-station-mission-three-repeat" }
				;; top
			}

			{
				visreqs [
					{ #type check-is-convo-inside-territory expected #true }
					{ #type check-biz-in-paid-off-precinct expected #true }
				]
				text { key "convo.train-station-mission-pass" }
				;; back to top
			}
			{
				visreqs [
					{ #type check-is-convo-inside-territory expected #false }
					{ #type check-biz-in-paid-off-precinct expected #false }
				]
				text { key "convo.train-station-mission-fail" }
				;; top
			}
			{
				visreqs [
					{ #type check-is-convo-inside-territory expected #true }
					{ #type check-biz-in-paid-off-precinct expected #false }
				]
				text { key "convo.train-station-mission-fail" }
				;; top
			}
			{
				visreqs [
					{ #type check-is-convo-inside-territory expected #false }
					{ #type check-biz-in-paid-off-precinct expected #true }
				]
				text { key "convo.train-station-mission-fail" }
				;; top
			}


		]
	}
