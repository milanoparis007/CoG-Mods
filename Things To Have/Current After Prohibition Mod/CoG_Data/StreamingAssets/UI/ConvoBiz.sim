				text { key "convo.outpost-weapon.beretta" icon "weapon.pistol.icon" }
				grants [ { #type add-rel-buff with owner id "relbuff-outpost-weapons" } { #type add-resource id weapon-beretta qty 1 at crew } { #type add-cash amount -500 at safehouse } ]
