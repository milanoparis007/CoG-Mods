	;; skills learning, and goods delivery that requires

	;; ticket skills - start the skills conversation
	ticket-skills-start {
		npcsays	[{ lockey "convo.ticket-skills-select-npc"}]

		dynamicButtons CustomSkillButtons
		dynamicTemplate {
			text	{ key "convo.ticket-skills-select-npc.skillchoice" }

			next	{ goto ticket-skills-beforechoice }
		}

		buttons [
		{	;; 		"never mind"
			text 	{ key "convo.ticket-skills-cancel-button" icon "convo.icon-back" }
			;; no next - back to main
		}
		]
	}

	ticket-skills-beforechoice {
		; NPC SAYS custom flavor text for the skill being taught
		npcsays [{ lockey "convo.ticket-skills-start-npc" }]
		buttons [
		{	;; 		"i need some more details"
			text 	{ key "convo.ticket-skills-details-button" icon "convo.icon-qmark" addmo #true }
			onClick ExecuteTicketSkillsInfo
		}
		{	;; 		"what do you need?"
			text 	{ key "convo.ticket-skills-tellmore-button" }
			next 	{ goto ticket-skills-confirm-quest }
		}
		{	;; 		"never mind"
			text 	{ key "convo.ticket-skills-cancel-button" icon "convo.icon-back" }
			;; no next - back to main
		}
		]
	}

	;; ticket skills - start the skills conversation (there is a quest)
	ticket-skills-confirm-quest {
		; NPC SAYS "i can teach you but i'll need stuff"
		npcsays [{ lockey "convo.ticket-skills-confirm-quest-npc" }]
		buttons [
		{	;; 		"it's a deal"
			reqs 	[{ #type special-can-pay-for-skills-button-req } { #type check-convo-actions has enough }]

			text 	{ key "convo.ticket-skills-confirm-quest-button"
					  npc "convo.ticket-skills-epilogue-quest-npc" }

			onClick  ExecuteTicketSkillsStartDeliveryQuest
			grants	 [{ #type consume-tickets count 1 }
					  { #type consume-actions for convo }
					  { #type add-xp source from-social }]
			;; no next - restart from top level
		}
		{	;; 		"never mind"
			text 	{ key "convo.ticket-skills-cancel-button" icon "convo.icon-back" }
		;	next 	{ goto ticket-group-help }
		}
		]
	}
	
	ticket-resource-reveal-start {
		npcsays	[{ lockey "convo.ticket-resources-reveal-npc" }]
		buttons [
		{
			reqs	[{ #type special-check-has-legal-reveal-specific reveal containers }]
			
			text { key "convo.ticket-resources-reveal-containers-button" 
				   npc "convo.ticket-resources-reveal-epilogue-npc" }
			
			onClick	ExecuteContainerReveal
			
			grants [{ #type consume-tickets count 1 }
					{ #type consume-actions for convo }
					{ #type add-xp source from-social }]
		}
		{
			reqs	[{ #type special-check-has-legal-reveal-specific reveal construction }]
			
			text { key "convo.ticket-resources-reveal-construction-button"
				   npc "convo.ticket-resources-reveal-epilogue-npc" }	
			
			onClick ExecuteConstructionReveal
			
			grants	[{ #type consume-tickets count 1 }
					 { #type consume-actions for convo }
					 { #type add-xp source from-social}]
		}
		{	;; never mind
			text { key "convo.ticket-resources-reveal-cancel-button" icon "convo.icon-back" }
		}
		]
	}
	

	;; ticket get casino
	ticket-gambling-start {
		; NPC SAYS "you need a quiet room in some nondescript apartment building?"
		npcsays [{ lockey "convo.ticket-gambling-house.npc" }]
		buttons [{
			text 	{ key "convo.ticket-gambling-house.say" }
			onClick	ShowCasinoBuildPopup
		} 
		{
			text 	{ key "convo.ticket-gambling-house.cancel" icon "convo.icon-back" }
			next 	{ goto redeem-favor-owed }
		}]
	}

	ticket-gambling-house-type-select {
		; NPC SAYS "what size/type of casino would you be interested in building"
		npcsays	[{ lockey "convo.ticket-gambling-house.type-choose.npc" }]

		dynamicButtons CustomGamblingModuleOptions
		dynamicTemplate {
			text	{ key "convo.ticket-gambling-house.type-choose.human"}

			next	{ goto ticket-gambling-house-confirm }
		}

		buttons	[
			{
				text 	{ key "convo.ticket-gambling-house.cancel" icon "convo.icon-back" }
				next 	{ goto redeem-favor-owed }
			}
		]
	}

	ticket-gambling-house-confirm {
		npcsays	[{ lockey "convo.ticket-gambling-house-confirm-npc" }]
		buttons [
		{	;;		"let's do it"
			text	{ key "convo.ticket-gambling-house-confirm-button" 
					  npc "convo.ticket-gambling-house-epilogue-npc"}
					  
			onClick	ExecuteGrantGamblingHouse
			grants [ { #type consume-tickets count 1 } 
					 { #type consume-actions for convo }
					 { #type add-xp source from-social} ] 
				;; no next - restart from top level
		}
		{
			text	{ key "convo.ticket-back-button" icon "convo.icon-back" }
			grants	[ { #type center-camera-on-building} ]
			next	{ goto redeem-favor-owed }
 		}
		]
	}
	
	ticket-gambling-house-none {
		npcsays	[ { lockey "convo.ticket-gambling-house-none-npc" } ]
		buttons [
		{
			text	{ key "convo.ticket-gambling-house-none-button" }
			grants	[{ #type center-camera-on-building }]
			next	{ goto redeem-favor-owed }
		}
		]
	}
	


	;; ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	;;
	;; vehicles

	vehicle-can-repair {
		;; NPC SAYS "yeah, but your car looks fine"
		npcsays	[{ lockey "convo.vehicle-state-good" }]

		buttons [{
			reqs		[ { #type check-crew-vehicle-condition is equalto type good } ]
			text	{ key "convo.vehicle-state-good-player" }
		}]
	}

	vehicle-dislikes-you {
		;; NPC SAYS "I do, but only for my friends."
		npcsays [{ lockey "convo.vehicle-dislikes-you" }]

		buttons [{
			text	{ key "convo.vehicle-dislikes-you-player" }
		}]
	}
	vehicle-no-trucks {
		;; NPC SAYS "That's a big truck..."
		npcsays [{ lockey "convo.vehicle-no-trucks" }]

		buttons [{
			text { key "convo.vehicle-no-trucks-player" }
		}]
	}

	vehicle-group-start-repair {
		;; NPC SAYS "yeah i know a little about cars"
		npcsays [{ lockey "convo.vehicle-group-npc" }]

		buttons [{
			;; npc can repair car
			visreqs [{ #type check-crew-peep-assigned to vehicle vehtype car }
					 { #type check-vehicle-module-in-convo has all of [ vehicle-repair ] }]
			reqs	[{ #type check-crew-vehicle-condition is notequalto type good }
					 { #type check-convo-actions has enough }]

			onShow	StoreVehicleCosts
			text 	{ key "convo.vehicle-repair-car-button" addmo #true }
			next	{ goto vehicle-repair-state }
		} {
			;; npc can repair truck
			visreqs [{ #type check-crew-peep-assigned to vehicle vehtype truck }
					 { #type check-vehicle-module-in-convo has all of [ vehicle-repair ] }
					 ;{ #type check-module-in-convo has any of [ truck-garage junkyard-module player-truck-garage-small player-truck-garage-small-improved ] }
					 ]
			reqs	[{ #type check-crew-vehicle-condition is notequalto type good }
					 { #type check-convo-actions has enough }]

			onShow	StoreVehicleCosts
			text 	{ key "convo.vehicle-repair-truck-button" addmo #true }
			next	{ goto vehicle-repair-state }
		}]
	} 
	vehicle-group-start-buy-sell {
		;; NPC SAYS "yeah i know a little about cars"
		npcsays [{ lockey "convo.vehicle-group-npc" }]
		buttons [{
			;; npc can buy car from player
			visreqs [{ #type check-crew-peep-assigned to vehicle vehtype car }
					 { #type check-vehicle-module-in-convo has all of [ vehicle-buy-from-player ] }]
			reqs 	[{ #type special-is-vehicle-empty-for-sale }
					 { #type check-convo-actions has enough }]

			onShow	StoreVehicleCosts
			text 	{ key "convo.vehicle-buy-car-button" addmo #true }
			next	{ reqs [{ #type check-crew-vehicle-condition is notequalto type junk }]
					  then vehicle-buy-yes-state 
					  else vehicle-buy-no-state }
		} {
			;; npc can buy trucks from player
			visreqs [{ #type check-crew-peep-assigned to vehicle vehtype truck }
					 { #type check-vehicle-module-in-convo has all of [ vehicle-buy-from-player ] }]
			reqs 	[{ #type special-is-vehicle-empty-for-sale }
					 { #type check-convo-actions has enough }]

			onShow	StoreVehicleCosts
			text 	{ key "convo.vehicle-buy-truck-button" addmo #true }
			next	{ reqs [{ #type check-crew-vehicle-condition is notequalto type junk }]
					  then vehicle-buy-yes-state 
					  else vehicle-buy-no-state }
		} {
			;; npc can sell vehicle to player
			visreqs [{ #type check-vehicle-module-in-convo has all of [ vehicle-sell-to-player ] }]
			reqs 	[{ #type check-convo-actions has enough }]

			onShow	StoreVehicleForSale
			text 	{ key "convo.vehicle-sell-button" addmo #true }
			next	{ reqs [{ #type special-can-find-vehicle-to-sell }] 
					  then vehicle-sell-yes-state 
					  else vehicle-sell-no-state }
		} {
			text 	{ key "convo.vehicle-back" icon "convo.icon-back" }
		}]
	}

	vehicle-group-start-buy-truck {
		;; NPC SAYS "yeah i know a little about cars"
		npcsays [{ lockey "convo.vehicle-group-npc" }]
		buttons [{ ;; npc can sell vehicle to player
			visreqs [{ #type check-vehicle-module-in-convo has all of [ vehicle-sell-to-player ] }]
			reqs 	[{ #type check-convo-actions has enough }]

			onShow	StoreVehicleForSale
			text 	{ key "convo.vehicle-sell-button" addmo #true }
			next	{ reqs [{ #type special-can-find-vehicle-to-sell }] 
					  then vehicle-sell-yes-state 
					  else vehicle-sell-no-state }
		} {
			text 	{ key "convo.vehicle-back" icon "convo.icon-back" }
		}]
	}

	vehicle-group-start-buy-only {
		;; NPC SAYS "yeah i know a little about cars"
		npcsays [{ lockey "convo.vehicle-group-npc" }]
		buttons [{
			;; npc can buy car from player
			visreqs [{ #type check-crew-peep-assigned to vehicle vehtype car }
					 { #type check-vehicle-module-in-convo has all of [ vehicle-buy-from-player ] }]
			reqs 	[{ #type special-is-vehicle-empty-for-sale }
					 { #type check-convo-actions has enough }]

			onShow	StoreVehicleCosts
			text 	{ key "convo.vehicle-buy-car-button" addmo #true }
			next	{ reqs [{ #type check-crew-vehicle-condition is notequalto type junk }]
					  then vehicle-buy-yes-state 
					  else vehicle-buy-no-state }
		} {
			;; npc can buy trucks from player
			visreqs [{ #type check-crew-peep-assigned to vehicle vehtype truck }
					 { #type check-vehicle-module-in-convo has all of [ vehicle-buy-from-player ] }]
			reqs 	[{ #type special-is-vehicle-empty-for-sale }
					 { #type check-convo-actions has enough }]

			onShow	StoreVehicleCosts
			text 	{ key "convo.vehicle-buy-truck-button" addmo #true }
			next	{ reqs [{ #type check-crew-vehicle-condition is notequalto type junk }]
					  then vehicle-buy-yes-state 
					  else vehicle-buy-no-state }
		} {
			text 	{ key "convo.vehicle-back" icon "convo.icon-back" }
		}]
	}

	vehicle-repair-state {
		;; NPC SAYS "i'll fix it for you"
		npcsays [{ lockey "convo.vehicle-repair-npc" }]
		buttons [{
			reqs 	[{ #type special-can-pay-for-vehicle-repair }]
			text 	{ key "convo.vehicle-repair-confirm-button" addmo #true }
			onClick	ExecuteVehicleRepair
			grants	[{ #type consume-actions for convo } { #type add-rel-buff with owner id relbuff-car-repair } { #type set-rel-flag with owner id "fixed vehicle" dayz { value 252 } } { #type add-xp source from-social }]
			;; no next, start from the top
		} {
			text 	{ key "convo.vehicle-back" icon "convo.icon-back" }
			;; no next, start from the top
		}]
	}

	vehicle-buy-yes-state {
		;; NPC SAYS "i'll buy it for $$$"
		npcsays [{ lockey "convo.vehicle-buy-yes-npc" }]
		buttons [{
			text 	{ key "convo.vehicle-buy-yes-button" }
			onClick	ExecuteVehicleBuyFromPlayer
			grants	[{ #type consume-actions for convo } { #type add-rel-buff with owner id relbuff-car-bought } { #type add-xp source from-social }]
			;; no next, start from the top
		} {
			text 	{ key "convo.vehicle-buy-cancel" icon "convo.icon-back" }
			next	{ goto vehicle-group-start }
		}]
	}

	vehicle-buy-no-state {
		;; NPC SAYS "this is a pile of junk"
		npcsays [{ lockey "convo.vehicle-buy-no-npc" }]
		buttons [{
			text 	{ key "convo.vehicle-buy-no-button" npc "convo.vehicle-buy-no-epilogue-npc" }
			next	{ goto vehicle-group-start }
		}]
	}

	vehicle-sell-yes-state {
		;; NPC SAYS "i've got a car for you"
		npcsays [{ lockey "convo.vehicle-sell-yes-npc" }]
		buttons [{
			reqs 	[{ #type special-can-pay-for-vehicle-on-sale }
					 { #type special-can-fit-vehicle-on-sale }] 
			text 	{ key "convo.vehicle-sell-yes-button" npc "convo.vehicle-sell-yes-button-epilogue" }
			onClick	ExecuteVehicleSellToPlayer
			grants	[{ #type consume-actions for convo } { #type add-rel-buff with owner id relbuff-car-sold } { #type set-rel-flag with owner id "sold-vehicle" } { #type add-xp source from-social }]
			;; no next, start from the top
		} {
			text 	{ key "convo.vehicle-sell-cancel" icon "convo.icon-back" npc "convo.vehicle-sell-cancel-epilogue" }
			next	{ goto vehicle-group-start-buy-sell }
		}]
	}

	vehicle-sell-no-state {
		;; NPC SAYS "got nothing to sell"
		npcsays [{ lockey "convo.vehicle-sell-no-npc" }]
		buttons [{
			text 	{ key "convo.vehicle-sell-no-button" }
			next	{ goto vehicle-group-start-buy-sell }
		}]
	}



	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	;;
	;; initiative convo - quest request

	;; this one is started by code-side logic
	initiative-qreq-start { 
		npcsays [ 
			{ #type relationship-based-blurb rootkey "convo.initiative-qreq-npc" }
		]

		buttons [

		;; tell me more
		{	text 	{ key "convo.initiative-qreq-ok-button" addmo #true }

			onShow	StoreQReqInfo
			onClick ShowQReqBlurbOrDecision
		}

		;; not now
		{	text 	{ key "convo.initiative-qreq-notnow-button" addmo #true
					  npc "convo.initiative-qreq-notnow-npc" }
		}

		;; decline
		{	text 	{ key "convo.initiative-qreq-no-button" addmo #true
					  npc "convo.initiative-qreq-no-npc" }

			grants  [{ #type reject-qreq }]
		}
		]
	}

	show-qreq-blurb {
		npcsays [{ #type qreq-next-blurb type npc-req }] ;; this will be replaced with forcedResponse anyway
		buttons [{
			text 	{ 
				dynkey [{ #type qreq-next-blurb type player-req }] 
			}
			onClick ShowQReqBlurbOrDecision
		}]
	}

	show-qreq-decision {
		npcsays [{ #type qreq-next-blurb type npc-req }] ;; this will be replaced with forcedResponse anyway
		buttons [

		;; 		"it's a deal"
		{	text {
				dynkey [{ #type qreq-next-blurb type player-req }]
				dynnpc [{ #type qreq-next-blurb type npc-req-epilogue }]
			}
			;reqs [ { #type check-convo-actions has enough } ]
			onClick  ExecuteStartQReq
			grants [
			;	{ #type consume-actions for convo }
			]
		}

		;; decline
		{	text 	{ key "convo.initiative-qreq-no-button" addmo #true 
					  npc "convo.initiative-qreq-no-npc" }

			grants  [{ #type reject-qreq }]
		}
		]
	}

	;; this one is started by code-side logic
	initiative-qreq-collect { 
		npcsays [{ lockey "convo.initiative-qreqdone-npc-unhappy" reqs [{ #type check-has-reverse-timeout-quest-with-owner expected #true }] }
				 { lockey "convo.initiative-qreqdone-npc" }]

		buttons [
		;; tell me more - unhappy
		{	visreqs [{ #type check-has-reverse-timeout-quest-with-owner expected #true }]
			text 	{ key "convo.initiative-qreqdone-ok-button-unhappy" 
					  icon "ui.pipicon.quest-ready"
					  dynnpc [{ #type qreq-next-blurb type npc-collect }] }

			onShow	StoreQuestActive
			next 	{ goto show-quest-reward-choices }
		}
		;; tell me more - happy
		{	visreqs [{ #type check-has-reverse-timeout-quest-with-owner expected #false }]
			text 	{ key "convo.initiative-qreqdone-ok-button" 
					  icon "ui.pipicon.quest-ready"
					  dynnpc [{ #type qreq-next-blurb type npc-collect }] }

			onShow	StoreQuestActive
			next 	{ goto show-quest-reward-choices }
		}

		;; not now
		{	text 	{ key "convo.initiative-qreqdone-notnow-button" addmo #true 
			          npc "convo.initiative-qreqdone-notnow-npc" }
		}
		]
	}
	
	initiative-heal {
		npcsays [{ lockey "convo.initiative-heal"}]  
		
		buttons [
		;; Yes, please heal me!
		{	text 	{ key "convo.initiative-heal-ok-button" icon "ui.pipicon.heal-prompt"
					  npc "convo.initiative-heal-ok-npc" }
			onClick ExecuteHealReward
			next { goto toplevel-state }
		}
		{	text	{ key "convo.initiative-heal-no-button" icon "convo.icon-back"
					  npc "convo.initiative-heal-no-npc" }
			next { goto toplevel-state }
		}
		]
	}

	;; reward choices for regular as well as requested quests - started from above as well as from code
	show-quest-reward-choices {
		npcsays [{ #type qreq-next-blurb type npc-collect }
				 { lockey "convo.delivery-quest-done-npc" }] ;; this may be overridden from previous step

		dynamicButtons CustomChoiceButtons
		dynamicTemplate {
			text	{ key "convo.initiative-qreq-choice" dis "convo.initiative-qreq-choice" }
			onClick ExecuteRewardChoice ;; this will generate "afterchoice" and return us to toplevel
			grants [ { #type add-xp source from-social } ]
		}
	}

	show-quest-expired {
		npcsays [{ #type expired-blurb }
				 { lockey "convo.delivery-quest-done-npc" }] ;; this may be overridden from previous step

		dynamicButtons CustomExpirationButtons ;; get the buttons from the quest def's expiration info
		dynamicTemplate {
			text 	{ key "convo.expired-quest.template" dis "convo.expired-quest.template" }
			onClick ExecuteExpirationFinish
			next 	{ goto show-quest-expired-post }
		}
	}

	show-quest-expired-post {
		npcsays [{ lockey "convo.goodbye-npc" }] ;; note: should be overridden in last step
		buttons [{
			text 	{ key "convo.goodbye-button" icon "convo.icon-leave" addmo #true }
			onClick Goodbye
		}]
	}


	;; ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	;;
	;; finishing delivery quests of any type
	;; code-side logic picks whether it's still pending or done

	;; show all the things the player can deliver
	show-quest-delivery-choices {
		npcsays [{ lockey "convo.delivery-items-npc" }] ;; NPC: show me what you got

		dynamicButtons CustomQuestDeliveryButtons
		dynamicTemplate {
			text	{ key "convo.delivery-items-back-button" } ;; doesn't matter: determined at runtime
			onClick ExecuteQuestDeliveryChoice ;; next step determined in code: pending or done
		}

		buttons [{ text { key "convo.delivery-items-back-button" icon "convo.icon-back" } }]
	}

	;; player still has more stuff to deliver
	delivery-quest-pending {
		; NPC SAYS "i still need more stuff"
		npcsays [{ lockey "convo.delivery-quest-pending-npc" }]
		buttons [
		{	;; 		 "i'll get you more stuff later"
			text 	{ key "convo.delivery-quest-pending-button"
					  npc "convo.delivery-quest-pending-epilogue-npc" }
			;; no next - restart from top level
		}
		]
	}

	;; player finished the quest and already got the reward
	delivery-quest-done {
		; NPC SAYS "ok i've got everything"
		npcsays [{ lockey "convo.delivery-quest-done-npc" }]
		buttons [
		{	;; 		"good"
			text 	{ key "convo.delivery-quest-done-button" }
			;; no next - restart from top level
		}
		]
	}




	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	;;
	;; OUTPOST SETUP 

	;; SETTING UP OUTSIDE


	start-outpost-outside-new {
		npcsays [{ lockey "convo.outpost-outside1-npc.new" }] ;; "what can i do for you?"
		buttons [
		{ 	;; "i have a proposition"
			text 	{ key "convo.outpost-outside1-say.new" }	
			next 	{ goto outpost-outside2 }
		}
		{   ;; "let's talk later"
			text 	{ key "convo.outpost-outside1-later" icon "convo.icon-back" }
			next 	{ goto redeem-favor-owed }
		}
		]
	}

	start-outpost-outside-old {
		npcsays [{ lockey "convo.outpost-outside1-npc.old" }] ;; "oh yeah, what do you want to do?"
		buttons [
		{ 	;; "let's restart it"
			text 	{ key "convo.outpost-outside1-say.old" }	
			onShow	StoreStartOutsideOutpost
			next 	{ goto outpost-outside4 }
		}
		{   ;; "let's talk later"
			text 	{ key "convo.outpost-outside1-later" icon "convo.icon-back" }
			next 	{ goto redeem-favor-owed }
		}
		]
	}

	outpost-outside2 {
		npcsays [{ lockey "convo.outpost-outside2-npc" }] ;; "what do you mean?"
		buttons [
		{	;; "i need a collector"
			text 	{ key "convo.outpost-outside2-say" }
			onShow	StoreStartOutsideOutpost
			next 	{
				reqs [{ #type check-owner-traits has any of [ ] }]
				then outpost-outside3
				else outpost-outside4
			}
		}]
	}

	outpost-outside3 {
		npcsays [{ lockey "convo.outpost-outside3-npc" }] ;; "i'm not the right person for this"
		buttons [
		{	text 	{ key "convo.outpost-outside3-say" }  ;; "how disappointing"
			;; no next - restart from the top
		}]
	}

	outpost-outside4 {
		npcsays [{ lockey "convo.outpost-outside4-npc" }] ;; "i'd be happy to; let's talk costs"
		buttons [
		{	;; 		"i need some more details"
			text 	{ key "convo.outpost-outside4-more" icon "convo.icon-qmark" }
			onClick ExecuteOutpostCostInfo
			;; no next, we stay on this step
		}
		{	text 	{ key "convo.outpost-outside4-say" addmo #true }  ;; "i got you covered (spend favor)"
			reqs 	[{ #type special-can-pay-for-outpost type install }
					 ]
			onClick ExecuteStartOutpost
			grants  [
				{ #type consume-tickets count 1 }
				{ #type consume-actions for convo }
				{ #type add-xp source from-social }
			]
			next	{ goto outpost-outside5 }
		}
		{   ;; "let's talk later"
			text 	{ key "convo.outpost-outside4-later" icon "convo.icon-back" }
			next 	{ goto redeem-favor-owed }
		}
		]
	}

	outpost-outside5 {
		npcsays [{ lockey "convo.outpost-outside5-npc" }] ;; "then we're set"
		buttons [
		{	text 	{ key "convo.outpost-outside5-say" ;; "i'm glad"
					  npc "convo.outpost-outside5-epilogue" }  
			next	{ goto at-outpost-state }
		}]
	}

	;; SETTING UP INSIDE EXISTING TERRITORY

	start-outpost-inside-new {
		npcsays [{ lockey "convo.outpost-inside1-npc.new" }] ;; "what can i do for you?"
		buttons [
		{ 	;; "i have a proposition"
			text 	{ key "convo.outpost-inside1-say.new" }	
			next 	{ goto "outpost-inside2" }
		}
		{   ;; "let's talk later"
			text 	{ key "convo.outpost-inside1-later" icon "convo.icon-back" }
			next 	{ goto redeem-favor-owed }
		}
		]
	}

	start-outpost-inside-old {
		npcsays [{ lockey "convo.outpost-inside1-npc.old" }] ;; "oh yeah, what about it?"
		buttons [
		{ 	;; "let's revisit our proposition"
			text 	{ key "convo.outpost-inside1-say.old" }	
			onShow	StoreStartInsideOutpost
			next 	{ goto "outpost-inside4" }
		}
		{   ;; "let's talk later"
			text 	{ key "convo.outpost-inside1-later" icon "convo.icon-back" }
			next 	{ goto redeem-favor-owed }
		}
		]
	}

	outpost-inside2 {
		npcsays [{ lockey "convo.outpost-inside2-npc" }] ;; "what do you mean?"
		buttons [
		{	;; "i need a collector"
			text 	{ key "convo.outpost-inside2-say" }
			onShow	StoreStartInsideOutpost
			next 	{
				reqs [{ #type check-owner-traits has any of [ ] }]
				then outpost-inside3
				else outpost-inside4
			}
		}]
	}

	outpost-inside3 {
		npcsays [{ lockey "convo.outpost-inside3-npc" }] ;; "i'm not the right person for this"
		buttons [
		{	text 	{ key "convo.outpost-inside3-say" }  ;; "how disappointing"
			;; no next - restart from the top
		}]
	}

	outpost-inside4 {
		npcsays [{ lockey "convo.outpost-inside4-npc" }] ;; "i'd be happy to"
		buttons [
		{	;; 		"i need some more details"
			text 	{ key "convo.outpost-inside4-more" icon "convo.icon-qmark" }
			onClick ExecuteOutpostCostInfo
			;; no next, we stay on this step
		}
		{	text 	{ key "convo.outpost-inside4-say" addmo #true 
					  npc "convo.outpost-inside4-epilogue" }  ;; "i got you covered (spend favor)"
			onClick ExecuteStartOutpost
			grants  [
				{ #type consume-tickets count 1 }
				{ #type consume-actions for convo }
				{ #type add-xp source from-social }
			]
			next	{ goto at-outpost-state }
		}
		{   ;; "let's talk later"
			text 	{ key "convo.outpost-inside4-later" icon "convo.icon-back" }
			next 	{ goto redeem-favor-owed }
		}
		]
	}

	;; check in on existing outpost
	at-outpost-state {
		; NPC SAYS "things are doing okay i think"
		npcsays [{ #type special-at-outpost-state-blurb
				   reqs [{ #type special-must-support-outpost }]
				   lockey "convo.at-outpost-npc.support" }

			  	 { #type special-at-outpost-state-blurb
			  	    reqs [{ #type check-outpost-expanding expected #true }]
			  	   lockey "convo.at-outpost-npc.expanding" }

				 { #type special-at-outpost-state-blurb
				   reqs [{ #type check-convo-query id kb-front-can-expand }]
				   lockey "convo.at-outpost-npc.can-expand" }

				 { #type special-at-outpost-state-blurb
				   lockey "convo.at-outpost-npc.active" }]

		buttons [
			;; tributes are ready to collect
			{	reqs [{ #type check-outpost-status is ready-to-collect }
					  { #type check-convo-actions has enough }] 
			
				; "i believe you have something for me"
			  	text {
			  		dynicon	[
			  			{ lockey "ui.pipicon.front-needs" reqs [{ #type special-must-support-outpost }] }
			  			{ lockey "ui.pipicon.front-ready" }
			  		]
			  		dynkey	[
			  			{ lockey "convo.tribute-ready-button.support" reqs [{ #type special-must-support-outpost }] }
			  			{ lockey "convo.tribute-ready-button.default" }
			  		]
			  	}

			  	onShow		StoreCollectionFromOutpost
			  	next 		{ reqs [{ #type special-must-support-outpost }] 
			  				  then outpost-support
			  				  else outpost-collect }
			}
			;; let's expand
			{
				visreqs	[{ #type check-convo-query id kb-front-can-expand }]
				text 	{ key "convo.at-outpost-can-expand-button" icon "ui.pipicon.front-can-expand" }
				onShow	ExecuteOutpostSelectExpansion
				onClick ExecuteOutpostZoomToExpansion
				next 	{ goto outpost-expand }
			}
			;; i am altering the deal
			{	text { key "convo.tribute-reselect-button" }
				next { goto outpost-cancel1 }
			}
			{	text { key "convo.tribute-later-button" icon "convo.icon-back" }
			}
		]
	}

	outpost-cancel1 {
		;; NPC SAYS: so you want to cancel the deal?
		npcsays [{ lockey "convo.outpost-cancel1-npc" }]
		buttons [{	
			;; "yeah you're not needed anymore"
			text { key "convo.outpost-cancel1-say" } 
			next { goto outpost-cancel2 }
		}]
	}

	outpost-cancel2 {
		;; NPC SAYS "as you wish, but there will be consequences"
		npcsays [{ lockey "convo.outpost-cancel2-npc" }]
		buttons [
			{	;; 		confirm for reals
				text 	{ key "convo.outpost-cancel2-say" addmo #true 
						  npc "convo.outpost-cancel2-epilogue"}
				onClick	ExecuteCancelOutpost
				;; 		no next, restart from the top
			}
			{	;; 		cancel
				text 	{ key "convo.outpost-cancel2-later" icon "convo.icon-back" }
				;; 		no next, restart from the top
			}
		]
	}

	;; outpost collection (got more income than expenses)
	outpost-collect {
		; NPC SAYS "well here it is"
		npcsays [{ lockey "convo.tribute-collect-npc" }]
		buttons [
		{	;; 		 	"thank you (collect)"
			reqs 		[{ #type check-outpost-status is can-crew-collect }]
			text 		{ key "convo.tribute-collect-ok" npc "convo.tribute-collect-npc-epilogue" }
			onClick		ExecuteCollectionFromOutpost
			grants [
			  		{ #type consume-actions for convo }
			  	]
			;; no next - restart from top level
		}
		{	;; 		 	"i'll be back (snooze)"
			text 		{ key "convo.tribute-collect-later" icon "convo.icon-back" }
			;; no next - restart from top level
		}
		]
	}

	;; outpost support (expenses are higher than income)
	outpost-support {
		; NPC SAYS "well here it is"
		npcsays [{ lockey "convo.tribute-support-npc" }]
		buttons [
		{	;; 		 	"(pay up)"
			reqs 		[{ #type check-outpost-status is can-crew-collect }]
			text 		{ key "convo.tribute-support-ok" npc "convo.tribute-support-npc-epilogue" }
			onClick		ExecuteCollectionFromOutpost
			;; no next - restart from top level
		}
		{	;; 		 	"i'll be back (snooze)"
			text 		{ key "convo.tribute-support-later" icon "convo.icon-back" }
			;; no next - restart from top level
		}
		{	;; 			"let's reconsider"
			visreqs		[{ #type always-false }]
			text 		{ key "convo.tribute-support-other" }
			;; next		{ goto tribute-select-state } ;; TODO
		}
		]
	}

	;; we can expand territory in a new direction
	outpost-expand {
		; NPC SAYS "we could help some local widows and orphans"
		npcsays [{ lockey "convo.outpost-expand-npc" }]
		buttons [
		{	;; 		 	"let's do it (pay up)"
			reqs 		[{ #type special-can-pay-for-outpost-expansion } { #type check-convo-actions has enough }]
			text 		{ key "convo.outpost-expand-say" addmo #true npc "convo.outpost-expand-epilogue" }
			onClick		ExecuteOutpostPayForExpansion
			grants		[ { #type consume-actions for convo } { #type add-xp source from-social } ]
			;; no next - restart from top level
		}
		{	;; 			"let's reconsider"
			text 		{ key "convo.outpost-expand-later" npc "convo.outpost-expand-laterepi" icon "convo.icon-back" }
			next		{ goto at-outpost-state }
		}
		]
	}


	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	;;
	;; DEMANDS ON OTHER PLAYER OUTPOSTS

	
	demand-close-outpost-ask {
		;; npc says "maybe, maybe not. what's it to you?"
		npcsays [{ lockey "convo.outpost.nonhuman-npc" }]
		buttons [{
			;; i demand that you stop it
			text 	{ key "convo.outpost.nonhuman-say" }
			grants [ { #type consume-actions for convo  } ]
			onClick	ExecuteCloseOutpostRequest
			next 	{ reqs [{ #type check-convo-demand-state is notset to defiant }] 
						   then demand-close-outpost-agreed 
						   else demand-close-outpost-defiant }
		}
		{ ;; i'll be back for you...
			text { key "convo.outpost.nonhuman-back" }
		}
		]
	}


	demand-close-outpost-agreed {
		;; this is terrible. but fine.
		npcsays [{ lockey "convo.outpost.nonhuman-complies-npc" }]
		buttons [{
			text { key "convo.outpost.nonhuman-complies-say" npc "convo.outpost.nonhuman-epi" }
		}]
	}

	demand-close-outpost-defiant {
		;; no way i'm crossing that gang!
		npcsays [{ lockey "convo.outpost.nonhuman-defies-npc" }]
		buttons [{
			reqs 	[{ #type special-can-pay-for-close-outpost-demand }]
			text	{ key "convo.outpost.nonhuman-defies-bribe" }
			onClick	ExecuteCloseOutpostBribe
			next	{ reqs [{ #type check-convo-demand-state is notset to defiant }]
							then demand-close-outpost-bribe-yes else demand-close-outpost-bribe-no }
		} {
			text	{ key "convo.outpost.nonhuman-defies-attack" }
			onClick	ExecuteCloseOutpostAttack
			next	{ reqs [{ #type check-convo-demand-state is notset to defiant }]
							then demand-close-outpost-attack-yes else demand-close-outpost-attack-no }
		} {
			text	{ key "convo.outpost.nonhuman-defies-later" }
		}]
	}

	demand-close-outpost-bribe-yes {
		;; that's a lot of money
		npcsays [{ lockey "convo.outpost.nonhuman-bribe-yes-npc"}]
		buttons [{ text { key "convo.outpost.nonhuman-bribe-yes-say" 
						  npc "convo.outpost.nonhuman-epi" }}]
	}

	demand-close-outpost-bribe-no {
		;; no way, not even for that kind of money
		npcsays [{ lockey "convo.outpost.nonhuman-bribe-no-npc"}]
		buttons [{ 
			text { key "convo.outpost.nonhuman-bribe-no-say" }
			next { goto demand-close-outpost-defiant }
		}]
	}

	demand-close-outpost-attack-yes {
		;; you're a monster! but fine
		npcsays [{ lockey "convo.outpost.nonhuman-attack-yes-npc"}]
		buttons [{ text { key "convo.outpost.nonhuman-attack-yes-say" 
						  npc "convo.outpost.nonhuman-epi" }}]
	}

	demand-close-outpost-attack-no {
		;; no way, the other gang is even worse
		npcsays [{ lockey "convo.outpost.nonhuman-attack-no-npc"}]
		buttons [{ 
			text { key "convo.outpost.nonhuman-attack-no-say" }
			next { goto demand-close-outpost-defiant }
		}]
	}

	cop-at-node-start {
		npcsays [{ lockey "convo.cop-effect.at-node.blurb" }]
		buttons [{
			text 	{ key "convo.cop-effect.at-node.leave.button" addmo #true }
			onClick Goodbye
		}]
	}

	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	;;
	;; train station

	train-station-start {
		
		;; 
		npcsays [ 
			{ reqs [ { #type check-is-convo-inside-territory expected #false } { #type check-biz-in-paid-off-precinct expected #false } ] lockey "convo.train-station-fails" }
			{ reqs [ { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #false } ] lockey "convo.train-station-cops-fail" }
			{ reqs [ { #type check-is-convo-inside-territory expected #false } { #type check-biz-in-paid-off-precinct expected #true } ] lockey "convo.train-station-territory-fail" }
			{ reqs [ { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true } ]  lockey "convo.train-station-passes" }
		]
		buttons [
			{
				visreqs [
					{ #type check-is-convo-inside-territory expected #false } { #type check-biz-in-paid-off-precinct expected #false }
				]
				text	{ key "convo.train-station-fails-both" addmo #true }

				;; back to top
			}
			{
				visreqs [
					{ #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #false }
				]
				text { key "convo.train-station-territory-pass" addmo #true }

				;; back to top
			}
			{
				visreqs [
					{ #type check-is-convo-inside-territory expected #false } { #type check-biz-in-paid-off-precinct expected #true }
				]
				text { key "convo.train-station-cops-pass" addmo #true }

				;; back to top
			}
			{
				visreqs [
					{ #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true }
				]
				text { key "convo.train-station-all-pass" }

				next { goto train-station-bribe }
			}
		]
	}
	train-station-bribe {
		npcsays [
			{ reqs [ { #type check-module-in-convo has all of [ civic-freight-station ] } ] lockey "convo.train-station-bribe-frieght" }
			{ reqs [ { #type check-module-in-convo has all of [ civic-passenger-station ] } ] lockey "convo.train-station-bribe-passenger" }
		]
		buttons [
			{
				visreqs [ { #type check-module-in-convo has all of [ civic-freight-station ] } ]

				text { key "convo.train-station-bribe-confirm-freight" addmo #true }

				grants [ { #type force-start-quest-on-owner id train-station-bribe } ]

				next { goto train-station-bribe-outro }
			}
			{
				visreqs [ { #type check-module-in-convo has all of [ civic-passenger-station ] } ]

				text { key "convo.train-station-bribe-confirm-passenger" addmo #true }

				grants [ { #type force-start-quest-on-owner id train-station-bribe } ]

				next { goto train-station-bribe-outro }
			}
			{
				text { key "convo.train-station-bribe-reject" }
				;; to start
			}
		]
	}
	train-station-bribe-outro {
		npcsays [{ lockey "convo.train-station-bribe-outro" }]

		buttons [
			{
				text { key "convo.train-station-bribe-outro-bye" }
			}
		]
	}

	;; station missions
	train-station-mission-start {
		npcsays [
			{ reqs [ { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true } { #type check-owner-relbuffs has all of [ relbuff-passenger-bribe ] } ] lockey "convo.train-station-mission-start-passenger" }
			{ reqs [ { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true } { #type check-owner-relbuffs has all of [ relbuff-cargo-bribe ] } { #type check-owner-relbuffs has none of [ relbuff-cargo-active ] } ] lockey "convo.train-station-mission-start-cargo" }
			{ reqs [ { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true } { #type check-owner-relbuffs has all of [ relbuff-cargo-active relbuff-train-brick-wine ] } { #type check-player-skills has none of [ homebooze-brick-wine ] } ] lockey "convo.train-station-mission-three-repeat-brick-wine" }
			{ reqs [ { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true } { #type check-owner-relbuffs has all of [ relbuff-cargo-active relbuff-train-brick-wine ] } { #type check-player-skills has all of [ homebooze-brick-wine ] } ] lockey "convo.train-station-mission-three-stop-brick-wine" }
			{ reqs [ { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true } { #type check-owner-relbuffs has all of [ relbuff-cargo-active relbuff-train-cider ] } { #type check-player-skills has none of [ homebooze-cider ] } ] lockey "convo.train-station-mission-three-repeat-cider" }
			{ reqs [ { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true } { #type check-owner-relbuffs has all of [ relbuff-cargo-active relbuff-train-cider ] } { #type check-player-skills has all of [ homebooze-cider ] } ] lockey "convo.train-station-mission-three-stop-cider" }
			{ reqs [ { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true } { #type check-owner-relbuffs has all of [ relbuff-cargo-active relbuff-train-home-brew ] } { #type check-player-skills has none of [ homebooze-home-brew] } ] lockey "convo.train-station-mission-three-repeat-home-brew" }
			{ reqs [ { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true } { #type check-owner-relbuffs has all of [ relbuff-cargo-active relbuff-train-home-brew ] } { #type check-player-skills has all of [ homebooze-home-brew] } ] lockey "convo.train-station-mission-three-stop-home-brew" }
			{ reqs [ { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true } { #type check-owner-relbuffs has all of [ relbuff-cargo-active relbuff-train-moonshine ] } { #type check-player-skills has none of [ homebooze-moonshine ] } ] lockey "convo.train-station-mission-three-repeat-moonshine" }
			{ reqs [ { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true } { #type check-owner-relbuffs has all of [ relbuff-cargo-active relbuff-train-moonshine ] } { #type check-player-skills has all of [ homebooze-moonshine ] } ] lockey "convo.train-station-mission-three-stop-moonshine" }
			{ reqs [ { #type check-current-city is any of [ pittsburgh ] } { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true } { #type check-owner-relbuffs has all of [ relbuff-cargo-active relbuff-train-apple-jack ] } { #type check-player-skills has none of [ homebooze-apple-jack ] } ] lockey "convo.train-station-mission-three-repeat-apple-jack" }
			{ reqs [ { #type check-current-city is any of [ pittsburgh ] } { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true } { #type check-owner-relbuffs has all of [ relbuff-cargo-active relbuff-train-apple-jack ] } { #type check-player-skills has all of [ homebooze-apple-jack ] } ] lockey "convo.train-station-mission-three-stop-apple-jack" }			
			{ reqs [ { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true } { #type check-owner-relbuffs has all of [ relbuff-cargo-active relbuff-train-fake-wine ] } { #type check-player-skills has none of [ fake-wine ] } ] lockey "convo.train-station-mission-three-repeat-fake-wine" }
			{ reqs [ { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true } { #type check-owner-relbuffs has all of [ relbuff-cargo-active relbuff-train-fake-wine ] } { #type check-player-skills has all of [ fake-wine ] } ] lockey "convo.train-station-mission-three-stop-fake-wine" }
			{ reqs [ { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true } { #type check-owner-relbuffs has all of [ relbuff-cargo-active relbuff-train-sparkling-cider ] } { #type check-player-skills has none of [ sparkling-cider ] } ] lockey "convo.train-station-mission-three-repeat-sparkling cider" }
			{ reqs [ { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true } { #type check-owner-relbuffs has all of [ relbuff-cargo-active relbuff-train-sparkling-cider ] } { #type check-player-skills has all of [ sparkling-cider ] } ] lockey "convo.train-station-mission-three-stop-sparkling-cider" }
			{ reqs [ { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true } { #type check-owner-relbuffs has all of [ relbuff-cargo-active relbuff-train-fake-beer ] } { #type check-player-skills has none of [ fake-beer ] } ] lockey "convo.train-station-mission-three-repeat-fake-beer" }
			{ reqs [ { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true } { #type check-owner-relbuffs has all of [ relbuff-cargo-active relbuff-train-fake-beer ] } { #type check-player-skills has all of [ fake-beer ] } ] lockey "convo.train-station-mission-three-stop-fake-beer" }
			{ reqs [ { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true } { #type check-owner-relbuffs has all of [ relbuff-cargo-active relbuff-train-bathtub-gin ] } { #type check-player-skills has none of [ bathtub-ginworks ] } ] lockey "convo.train-station-mission-three-repeat-bathtub-gin" }
			{ reqs [ { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true } { #type check-owner-relbuffs has all of [ relbuff-cargo-active relbuff-train-bathtub-gin ] } { #type check-player-skills has all of [ bathtub-ginworks ] } ] lockey "convo.train-station-mission-three-stop-bathtub-gin" }
			{ reqs [ { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true } { #type check-owner-relbuffs has all of [ relbuff-cargo-active relbuff-train-fallback ] } ] lockey "convo.train-station-mission-three-fallback" }
			{ reqs [ { #type check-current-city is any of [ pittsburgh ] } { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true } { #type check-owner-relbuffs has all of [ relbuff-cargo-active relbuff-train-fruit-brandy ] } { #type check-player-skills has none of [ fruit-brandy ] } ] lockey "convo.train-station-mission-three-repeat-fruit-brandy" }
			{ reqs [ { #type check-current-city is any of [ pittsburgh ] } { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true } { #type check-owner-relbuffs has all of [ relbuff-cargo-active relbuff-train-fruit-brandy ] } { #type check-player-skills has all of [ fruit-brandy ] } ] lockey "convo.train-station-mission-three-stop-fruit-brandy" }
			{ reqs [ { #type check-current-city is any of [ cincinnati ] } { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true } { #type check-owner-relbuffs has all of [ relbuff-cargo-active relbuff-train-corn-whiskey ] } { #type check-player-skills has none of [ corn-whiskey ] } ] lockey "convo.train-station-mission-three-repeat-corn-whiskey" }
			{ reqs [ { #type check-current-city is any of [ cincinnati ] } { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #true } { #type check-owner-relbuffs has all of [ relbuff-cargo-active relbuff-train-corn-whiskey ] } { #type check-player-skills has all of [ corn-whiskey ] } ] lockey "convo.train-station-mission-three-stop-corn-whiskey" }
			{ reqs [ { #type check-is-convo-inside-territory expected #false } { #type check-biz-in-paid-off-precinct expected #false } ] lockey "convo.train-station-mission-start-both-fail-npc" }
			{ reqs [ { #type check-is-convo-inside-territory expected #false } { #type check-biz-in-paid-off-precinct expected #true } ] lockey "convo.train-station-mission-start-territory-fail-npc" }
			{ reqs [ { #type check-is-convo-inside-territory expected #true } { #type check-biz-in-paid-off-precinct expected #false } ] lockey "convo.train-station-mission-start-cops-fail-npc" }
		]

		buttons [
			{
				visreqs [
					{ #type check-owner-relbuffs has all of [ relbuff-passenger-bribe ] }
					{ #type check-is-convo-inside-territory expected #true }
					{ #type check-biz-in-paid-off-precinct expected #true }
					{ #type check-active-quest-count with owner is equalto value 0 }
				]
				reqs [
