{
	convos {

		;; conversations with your crew in order to start a scheme
		crewpeep-toplevel {
			npcsays	[{ lockey "convo.crew.hello" reqs [ { #type check-crew-has-a-scheme-to-offer expected true} ] } 
			;; then try to talk about social history
			{ #type rel-history-with-other-blurb reqs [{ #type check-peep-has-npc-history }] }
			{ #type rel-history-blurb reqs [{ #type check-peep-has-player-history }] }
			;; otherwise do either a "opening move" or subsequent blurbs
			{ #type toplevel-start-blurb rootkey "convo.toplevel-start" reqs [{ #type special-toplevel-start firststate #true }] }
			{ #type relationship-based-blurb rootkey "convo.toplevel-state" }
					 { lockey "convo.crew.searching-scheme" }
					 ]

			buttons [
				{
					visreqs	[
							{ #type check-crew-has-a-scheme-to-offer expected true}
							]
					text	{ key "convo.crew.start-scheme.human" icon "convo.crew.start-scheme.icon"}

					next	{ goto crewpeep-start-scheme }
				}
				{
					text	{ key "convo.crew.nevermind" icon "convo.icon-leave" }

					onClick Goodbye
				}
			]
		}

		crewpeep-leisure {
			npcsays	[{ lockey "convo.crew.hello" } 
					 { lockey "convo.crew.searching-scheme" }
					 ]

			buttons [
				{
					visreqs	[
							]
					text	{ key "convo.crew.start-scheme.human" icon "convo.crew.start-scheme.icon"}

					next	{ goto crewpeep-kill }
				}
				{
					text	{ key "convo.crew.nevermind" icon "convo.icon-leave" }

					onClick Goodbye
				}
			]
		}

		crewpeep-kill {
			npcsays	[{ lockey "convo.crew.hello" } 
					 { lockey "convo.crew.searching-scheme" }
					 ]

			buttons [
				{
					visreqs	[
							]
					text	{ key "convo.crew.start-scheme.human" icon "convo.crew.start-scheme.icon"}
					grants [{ #type kill-crew }]
				}
				{
					text	{ key "convo.crew.nevermind" icon "convo.icon-leave" }

					onClick Goodbye
				}
			]
		}

		crewpeep-start-scheme {
			npcsays	[{ lockey "convo.crew.start-scheme.select.npc"}]

			dynamicButtons CustomSchemeButtons
			dynamicTemplate {
				text { key "convo.aaaaaa" }

				next { goto crewpeep-confirm-scheme }
			}

			buttons [
			{
				text	{ key "convo.crew.back-button" icon "convo.icon-back" }

				next	{ goto crewpeep-toplevel }
			}
			]
		}

		crewpeep-confirm-scheme {
			npcsays	[{ lockey "convo.crew.confirm-scheme.npc"} ]

			buttons [
				{
					text	{ key "convo.crew.confirm-scheme.human" }

					onClick ExecuteStartScheme
				}
				{
					text	{ key "convo.crew.back-button" icon "convo.icon-back" }

					next	{ goto crewpeep-toplevel }
				}
			]
		}
	}
}
