{ entities [
	{ 
		ident { template weapon-base } 

		weapon {
			levelbuffs { value 0 mods [
				{ #type crew-peep-level-test-mod id levelup-combat is equalto value 1 delta 3 }
				{ #type crew-peep-level-test-mod id levelup-combat is equalto value 2 delta 5 }
				{ #type crew-peep-level-test-mod id levelup-combat is equalto value 3 delta 7 }
				{ #type crew-peep-level-test-mod id levelup-combat is equalto value 4 delta 9 }
				{ #type crew-peep-level-test-mod id levelup-combat is equalto value 5 delta 10 }

			] }
			hitpercent { value 0 mods [
				{ #type crew-peep-level-test-mod id levelup-combat is equalto value 1 delta 10 }
				{ #type crew-peep-level-test-mod id levelup-combat is equalto value 2 delta 15 }
				{ #type crew-peep-level-test-mod id levelup-combat is equalto value 3 delta 17 }
				{ #type crew-peep-level-test-mod id levelup-combat is equalto value 4 delta 19 }
				{ #type crew-peep-level-test-mod id levelup-combat is equalto value 5 delta 20 }
			] }
		}
	}

	{
		ident { template weapon-fists parent weapon-base }
		weapon {
			resid weapon-fists
			hitpercent { value 80  mods [
				{ #type traits-mod if [ trait-killer ] delta 15 }
				{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 1 delta 5 }
				{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 2 delta 10 }
				{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 3 delta 15 }
				{ #type crew-peep-level-test-mod id levelup-hoodsgang is equalto value 1 delta 5 }
			]}
			low 5 high 25
			traitbuffs { value 0 mods [
				{ #type traits-mod if [ trait-bossm ] delta 4 }
				{ #type traits-mod if [ trait-killer ] delta 20 }
				{ #type traits-mod if [ trait-cruel ] delta 5 }
				{ #type traits-mod if [ trait-kind ] delta -5 }
				{ #type traits-mod if [ trait-strong ] delta 10 }
				{ #type traits-mod if [ trait-weak ] delta -10 }
				{ #type crew-peep-role-test-mod is any of [ convict ] delta 5 }
				{ #type crew-peep-role-test-mod is any of [ enforcer ] delta 8 }
				{ #type crew-peep-role-test-mod is any of [ underboss ] delta 12 }
				{ #type crew-peep-role-test-mod is any of [ robber ] delta 5 }
				{ #type crew-peep-role-test-mod is any of [ connector ] delta 5 }
				{ #type crew-peep-level-test-mod id levelup-leader1 is equalto value 1 delta 5 }
				{ #type crew-peep-level-test-mod id levelup-leader2 is equalto value 1 delta 10 }
				{ #type crew-peep-level-test-mod id levelup-leader2a is equalto value 1 delta 10 }
				{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 1 delta 5 }
				{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 2 delta 7 }
				{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 3 delta 9 }
				{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 4 delta 11 }
				{ #type crew-peep-level-test-mod id levelup-hoodsgang is equalto value 1 delta 10 }
				{ #type crew-peep-level-test-mod id levelup-boxer is equalto value 1 delta 2 }
				{ #type crew-peep-level-test-mod id levelup-boxer is equalto value 2 delta 5 }
				{ #type crew-peep-level-test-mod id levelup-boxer is equalto value 3 delta 7 }
			]}
		}
	} 
	{
		ident { template weapon-bat parent weapon-base }
		weapon {
			resid weapon-bat
			tool #true
			hitpercent { value 80 mods [
			{ #type traits-mod if [ trait-killer ] delta 15 }
			{ #type skills-mod if [ starter-combat starter-conman ] delta 10 }
			{ #type skills-mod if [ starter-guns ] delta 15 }
			{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 1 delta 2 }
			{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 2 delta 2 }
			{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 3 delta 6 }
			{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 4 delta 15 }
			] }
			low 10 high 30
			traitbuffs { value 0 mods [
				{ #type traits-mod if [ trait-bossm ] delta 7 }
				{ #type traits-mod if [ trait-killer ] delta 20 }
				{ #type traits-mod if [ trait-aggressive ] delta 10 }
				{ #type traits-mod if [ trait-cautious ] delta -10 }
