{ maps [ { 
	id pittsburgh
	citytype pittsburgh

	;; cityname "Pittsburgh"  		;; let's use loc instead
	;; statename "Pennsylvania"

	citylockey	"city-name.pittsburgh"
	statelockey	"state-name.pennsylvania"
	citydesckey	"city-desc.pittsburgh"
	cityscreen	"Pittsburgh Screenshot"
	citypolunitkey	"city-pol-unit.district"

	map {
		;; logical map specification
		mapSize        { width 400 height 300 } ;; size in world units
		;; heatmapSpacing { width 8 height 8 }  ;; should be similar or larger than smallest block size
		;; beadSpacing { width 1 height 1 }     ;; should be default (1, 1) unless there's a good reason :)

		streetNames [ 
			"streets.usfounders" "streets.famouspeople" "streets.usstates" "streets.uscities"
			"streets.smalltown" "streets.trees" "streets.plants" "streets.birds" "streets.pitt" 
			"streets.lastnames" "streets.generic" ]

		nodes [
			{
				id BaseGrid
				nodeSpacing { width 8 height 10 }
;					forceStart { x 150 y 200 }
				forceAngle 0
				initialNames [ "streets.pitt" "streets.lastnames" ] 
			}
			{
				id Downtown
				nodeSpacing { width 10 height 10 }
				forceStart { x 188 y 128 }
				relativeSpeed 2
				forceMaxSize 80
				forceAngle 0
				dontSkipRoads #true
				initialNames [ "streets.usfounders" ]
			}
			{
				id NorthSide
				nodeSpacing { width 8 height 8 }
				forceStart { x 140 y 250 }
			;	relativeSpeed 2
			;	forceMaxSize 120
				forceAngle 35
				dontSkipRoads #true
				initialNames [ "streets.birds" ]
			}
			{
				id Bloomfield
				nodeSpacing { width 12 height 8 }
				forceStart { x 220 y 210 }
			;	relativeSpeed 2
			;	forceMaxSize 120
				forceAngle 80
				dontSkipRoads #true
				initialNames [ "streets.trees" ]
			}
			{
				id EastLiberty
				nodeSpacing { width 9 height 9 }
				forceStart { x 275 y 225 }
			;	relativeSpeed 2
			;	forceMaxSize 120
				forceAngle 30
				dontSkipRoads #true
				initialNames [ "streets.famouspeople" ]
			}
			{
				id Wilkinsburg
				nodeSpacing { width 10 height 8 }
				forceStart { x 306 y 186 }
			;	relativeSpeed 2
			;	forceMaxSize 120
				forceAngle 5
				dontSkipRoads #true
				initialNames [ "streets.uscities" ]
			}
			{
				id FoxChapel
				nodeSpacing { width 8 height 8 }
				forceStart { x 350 y 264 }
			;	relativeSpeed 2
			;	forceMaxSize 120
				forceAngle 10
				dontSkipRoads #true
				initialNames [ "streets.trees" ]
			}
			{
				id SouthSide
				nodeSpacing { width 8 height 8 }
				forceStart { x 210 y 143 }
				relativeSpeed 2
				forceMaxSize 40
				forceAngle -5
				dontSkipRoads #true
				initialNames [ "streets.pitt" ]
			}
			{
				id Homestead
				nodeSpacing { width 8 height 12 }
				forceStart { x 300 y 100 }
			;	relativeSpeed 2
			;	forceMaxSize 120
				forceAngle 0
				dontSkipRoads #true
				initialNames [ "streets.smalltown" ]
			}
			{
				id WestMifflin
				nodeSpacing { width 8 height 8 }
				forceStart { x 374 y 48 }
			;	relativeSpeed 2
			;	forceMaxSize 120
				forceAngle -10
				dontSkipRoads #true
				initialNames [ "streets.generic" ]
			}
			{
				id MtLebanon
				nodeSpacing { width 12 height 8 }
				forceStart { x 130 y 56 }
			;	relativeSpeed 2
			;	forceMaxSize 120
				forceAngle 10
				dontSkipRoads #true
				initialNames [ "streets.pitt" ]
			}
			{
				id McKeesRocks
				nodeSpacing { width 10 height 10 }
				forceStart { x 90 y 204 }
			;	relativeSpeed 2
			;	forceMaxSize 120
				forceAngle 20
				dontSkipRoads #true
				initialNames [ "streets.plants" ]
			}
			{
				id Bridgeville
				nodeSpacing { width 9 height 9 }
				forceStart { x 28 y 24 }
			;	relativeSpeed 2
			;	forceMaxSize 120
				forceAngle 0
				dontSkipRoads #true
				initialNames [ "streets.famouspeople" ]
			}		
			
		]

		rails [
			{
			 	id randomOakland
			 	random true
			 	randomRect { x 270 y 113 width 50 height 50 }
			}
			{
				id randomNorthHills
				random true
				randomRect { x 160 y 220 width 30 height 30 }
			}
			{
				id randomWilkinsburg
				random true 
				randomRect { x 306 y 186 width 25 height 25 }
			}
			{
				id randomHomestead
				random true
				randomRect { x 300 y 100 width 20 height 40 }
			}
			{
				id radnomCarnegie
				random true
				randomRect { x 70 y 120 width 40 height 40 }
			}
			{
				id randomSouthHills
				random true
				randomRect { x 130 y 56 width 80 height 50 }
			}
			{
				id randomMcKeesRocks
				random true
				randomRect { x 40 y 200 width 30 height 30 }
			}
		]

		districts [
			{
				tags [ downtown bizcenter ]
				locname "districts.downtown"
				start { x 195 y 170 } radius 25
			}
			{
				tags [ bizcenter ]
				locname "districts.pitt.beachview"
				start { x 145 y 105 } radius 20
			}
			{
				tags [ indcenter ]
				locname "districts.pitt.carnegie"
				start { x 60 y 111 } radius 30
			}
			{
				tags [ bizcenter ]
				locname "districts.pitt.shadyside"
				start { x 276 y 196 } radius 15
			}
			{
				tags [ bizcenter ]
				locname "districts.pitt.MtLebanon"
				start { x 100 y 28 } radius 15
			}
			{
				tags [ indcenter ]
				locname "districts.pitt.homestead"
				start { x 300 y 103 } radius 30
			}
		]
	}

