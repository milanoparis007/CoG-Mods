personalitiesFromTraits [
	{
		traits [ trait-unkind trait-cruel trait-careless trait-confident trait-irritable trait-strong ]
		givespersonality hatchetman
	}
	{
		traits [ trait-aggressive trait-sociable trait-loner trait-intelligent trait-agile trait-sharpeyed ]
		givespersonality thief
	}

	;; fallback always last	
	{ givespersonality default-goon-personality }
]


personalityAspects {
	;; note: for gangs, only N ~= 3 will be picked from this list
	borders [ 
		{ id expansionist lockey "aspect-expansionist.name" locicon "ui.aiicon.expansionist" }
		{ id isolationist lockey "aspect-isolationist.name" locicon "ui.aiicon.isolationist" }
		]
	combat [ 
		{ id aggressive lockey "aspect-aggressive.name" locicon "ui.aiicon.aggressive" }
		{ id peaceful lockey "aspect-peaceful.name" locicon "ui.aiicon.peaceful" }
		]
	business [ 
		{ id biz-fast lockey "aspect-biz-fast.name" locicon "ui.aiicon.biz-fast" }
		{ id biz-slow lockey "aspect-biz-slow.name" locicon "ui.aiicon.biz-slow" }
		]
	eth [ 
		{ id eth-like lockey "aspect-eth-like.name" locicon "ui.aiicon.eth-like" }
		{ id eth-dislike lockey "aspect-eth-dislike.name" locicon "ui.aiicon.eth-dislike" }
		]
	crew [ 
		{ id crew-large lockey "aspect-crew-large.name" locicon "ui.aiicon.crew-large" }
		]


	;; more here
}

personalities {
	default-goon-personality {
		id default-goon
		npccategory goononly
		aspects { value 0 }

		goon goon-idle-default
	}

	hatchetman {
		id hatchetman
		npccategory goononly
		aspects { value 0 }

		goon goon-idle-hatchetman
	}

	thief {
		id thief
		npccategory goononly
		aspects { value 0 }

		goon goon-idle-thief
	}

	default-gang-personality {
		id default-gang-personality
		npccategory gangonly
		aspects { value 3 }
		;; don't override specific configs
	}
}

players [
	{ 
		type AgentPlayer
		units units-default-cops-or-feds
		social social-default-cops-or-feds
		feds feds-default
	}

	{
		type CopPlayer
		units units-default-cops-or-feds
		social social-default-cops-or-feds
		precinct precinct-default
		combat combat-default-cops
		attack attack-default-cops
	}

	{
		type GangPlayer
		units units-default-gangs
		social social-default-gangs
		safehouse safehouse-default-gangs
		territory territory-default-gangs
		business business-default-gangs
		combat combat-default-gangs
		attack attack-default-gangs
	}

	{
		type GoonPlayer
		goon goon-idle-default
		units units-default-goons
		social social-default-goons
		territory territory-default-goons
		business business-default-goons
		safehouse safehouse-default-goons
		combat combat-default-goons
		attack attack-default-goons
	}

	{
		;; this is only used when debugging ai
		;; along with the set-human-ai flag
		type HumanPlayer
		units units-default-gangs
		social social-default-gangs
		safehouse safehouse-default-gangs
		territory territory-default-gangs
		business business-default-gangs
		combat combat-default-gangs
		attack attack-default-gangs
	}
]


