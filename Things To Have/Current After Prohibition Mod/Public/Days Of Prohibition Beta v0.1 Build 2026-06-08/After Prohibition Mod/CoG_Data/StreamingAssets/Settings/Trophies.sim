					locdesc			"trophy.chandelier.desc"
					Image			"Lighting Skyscraper"

					validThrones	[ throne-skyscraper ]

					render {
						drawPos [
							{ x 0 y 0 }
							{ x 1299 y 1224 }
						]
					}
				}
				{
					id hat-tree-skyscraper
					visReqs 		[]
