					locdesc			"trophy.chandelier.desc"
					Image			"Lighting"

					validThrones	[ throne-lodge ]

					render {
						drawPos [
							{ x 1285 y 1045 }
							{ x 0 y 0 }
						]
					}
				}
				{
					id chandelier-skyscraper
					visReqs			[]
					reqs			[ ]
					;; real req when hotel tied house victory condition clears the first time
