		text { key "convo.gangs.alliance-1.say" }
		next { reqs [{ #type check-owner-relationship is atleast value 50 }]
			   then gangwars-alliance-success
			   else gangwars-alliance-fail
		}
	}
	{
		text { key "convo.gangs.alliance-1.later" icon "convo.icon-leave" }
		next { goto gang-toplevel }
	}
	]
}

gangwars-alliance-success {
	npcsays [{ lockey "convo.gangs.alliance-success.npc" }]
	buttons [{
		text { key "convo.gangs.alliance-success.say" icon "convo.icon-check" }
		onClick GangWarsAllianceSuccess
		grants [
			{ #type add-rel-buff with owner id "relbuff-gangwars-alliance" }
			{ #type consume-actions for convo }
		]
		next { goto gang-toplevel }
	}]
}

gangwars-alliance-fail {
	npcsays [{ lockey "convo.gangs.alliance-fail.npc" }]
	grants [{ #type add-rel-buff with owner id "relbuff-gangwars-negative" }]
	buttons [{ text { key "convo.gangs.alliance-fail.say" } next { goto gang-toplevel } }]
}

