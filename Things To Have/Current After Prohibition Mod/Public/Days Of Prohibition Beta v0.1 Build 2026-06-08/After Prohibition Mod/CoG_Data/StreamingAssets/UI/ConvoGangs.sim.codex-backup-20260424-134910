{ convos {
;; interacting with gang npcs

gang-toplevel {
	npcsays [
		;{ #type rel-history-with-other-blurb reqs [{ #type check-peep-has-npc-history }] } ;; goons/gangs won't gossip about others
		{ #type rel-history-blurb reqs [{ #type check-peep-has-player-history }] }
		{ #type toplevel-start-blurb rootkey "convo.goons.toplevel.start" reqs [{ #type special-toplevel-start firststate #true }] }
		{ #type relationship-based-blurb rootkey "convo.goons.toplevel.state" }
	]
	buttons [
	{	;; can't talk, there's a cop here
		visreqs [{ #type check-blocking-cop expected #true }]
		text	{ key "convo.goons.cop-effect.at-node.button" addmo #true }
		next	{ goto gang-cop-at-node-start }
	}
	{
		;; you wanted to talk to me about something?
		visreqs [{ #type check-gang-has-convo-initiative type any }]
		reqs 	[{ #type check-blocking-cop expected #false }]

		onShow	StoreGangConvoInitiative
		text	{ key "convo.gangs.initiative" }
		next	{ #type next-state-chain defs [
					{ reqs [ { #type check-gang-has-convo-initiative type truce } ] then gang-init-truce }
					{ reqs [ { #type check-gang-has-convo-initiative type tied-house } ] then gang-init-tied-house }
					{ reqs [ { #type check-gang-has-convo-initiative type expansion-halt } ] then gang-init-expansion-treaty }
					{ reqs [ { #type check-gang-has-convo-initiative type joint-war } ] then gang-init-joint-war }
					{ reqs [ { #type check-gang-has-convo-initiative type stolen-outpost } ] then gang-init-stolen-outpost }
				] default gang-toplevel }
	}
	{	;; Crew Leisure
		visreqs [
			{ #type check-is-convo-aggro expected #false }
			{ #type check-crew-traits has any of [ trait-connected trait-confident trait-friendly trait-sociable ] }
			 { #type check-owner-relbuffs has none of [ relbuff-gangs-leisure-table-on-finish ] }
		 ]
		reqs 	[
			{ #type check-crew-traits has any of [ trait-connected trait-confident trait-friendly trait-sociable ] }
			 { #type check-owner-relbuffs has none of [ relbuff-gangs-leisure-table-on-finish ] }
			]

		text 	{ key "convo.peep-leisure.human" icon "quest.crewleisure.icon" }
		next	{ goto gang-leisure }
	}
	{	;; so about that favor you owe me (single favor)
		visreqs [{ #type check-relationship-tickets is equalto value 1 } { #type check-blocking-cop expected #false }
			 ]
		reqs 	[
				 { #type check-convo-actions has enough }]

		text 	{ key "convo.goon-single-favor-owed" icon "ui.ticket" }
		next	{ goto gang-redeem-favor-owed }
	}
	{	;; so about those favors you owe me (multiple favors)
		visreqs [{ #type check-relationship-tickets is morethan value 1 }
			
				 { #type check-blocking-cop expected #false }]
		reqs 	[
				 { #type check-convo-actions has enough }]

		text 	{ key "convo.goon-many-favors-owed" icon "ui.ticket" }
		next	{ goto gang-redeem-favor-owed }
	}
	{	;; gang offers
		visreqs [{ #type check-is-convo-aggro expected #false }
			{ #type check-owner-relbuffs has any of [ relbuff-gangs-loot1-buff ] }
			     { #type check-gang-has-convo-initiative type none }]
		reqs 	[{ #type check-convo-actions has enough } 
			{ #type check-owner-relationship is atleast value 10 }
			{ #type check-owner-relbuffs has any of [ relbuff-gangs-loot1-buff ] }
				 { #type check-blocking-cop expected #false }]
		text	{ key "convo.gangs.offers.button" icon "quest.offer.icon" }
		next	{ goto gang-offers }
	}
	{	;; matchmaker with goon
		text 	{
				key "convo.ticket-boost.goon.button"
				icon "ui.pipicon.social-goon-intro"
				addmo #true
			}

		visreqs [ { #type check-owner-relationship is moreorequalto value 1 } { #type check-can-boost-for-goon } ]
		onClick	StoreTicketBoostGoon
		next	{ goto ticket-goonin2-boost-start }
	}

	{	;; gang trade t1 liquor
		visreqs [{ #type check-is-convo-aggro expected #false }
			{ #type check-owner-relbuffs has none of [ relbuff-gangs-loan-unpaid ] }
			{ #type check-current-turn is moreorequalto value 4 }
			     { #type check-gang-has-convo-initiative type none }]
		reqs 	[{ #type check-convo-actions has enough }
			{ #type check-owner-relbuffs has none of [ relbuff-gangs-loan-unpaid ] }
				 { #type check-blocking-cop expected #false }]
		text	{ icon "quest.liquortrade3.icon" key "convo.gangs.trade1.button" }
		next	{ goto gang-trade-liquor-low }
	}
	{	;; gang trade t2 liquor
		visreqs [{ #type check-is-convo-aggro expected #false }
			{ #type check-owner-relbuffs has none of [ relbuff-gangs-loan-unpaid ] }
			{ #type check-owner-relationship is atleast value 20 }
			{ #type check-current-turn is moreorequalto value 35 }
			{ #type check-crew-peep-level id levelup-hoodsgang is atleast value 1 }
			{ #type check-relationship-tickets is atleast value 1 }
			     { #type check-gang-has-convo-initiative type none }]
		reqs 	[{ #type check-convo-actions has enough }
			{ #type check-owner-relbuffs has none of [ relbuff-gangs-loan-unpaid ] }
				 { #type check-blocking-cop expected #false }]
		text	{ key "convo.gangs.trade2.button" icon "quest.liquortrade2.icon" }
		next	{ goto gang-trade-liquor-high }
	}
	{	;; gang trade t1 drugs
		visreqs [{ #type check-is-convo-aggro expected #false }
			{ #type check-owner-relbuffs has none of [ relbuff-gangs-loan-unpaid ] }
			{ #type check-crew-peep-level id levelup-hoodsgang is atleast value 1 }
			{ #type check-current-month is any of [ 1 2 6 7 8 9 10 ] }
			{ #type check-owner-relationship is atleast value 15 }
			{ #type check-current-turn is moreorequalto value 30 }
			{ #type check-relationship-tickets is atleast value 1 }
			     { #type check-gang-has-convo-initiative type none }]
		reqs 	[{ #type check-convo-actions has enough }
			{ #type check-owner-relbuffs has none of [ relbuff-gangs-loan-unpaid ] }
				 { #type check-blocking-cop expected #false }]
		text	{ key "convo.gangs.trade3.button" icon "quest.drugstrade1.icon" }
		next	{ goto gang-trade-drugs-low }
	}
	{	;; gang loans
		visreqs [{ #type check-is-convo-aggro expected #false }
			{ #type check-owner-relbuffs has any of [ relbuff-gangs-loot1-buff ] }
			{ #type check-owner-relbuffs has none of [ relbuff-gangs-loan-unpaid ] }
			{ #type check-crew-peep-level id levelup-hoodsgang is atleast value 1 }
			{ #type check-relationship-tickets is atleast value 1 }
			{ #type check-current-turn is moreorequalto value 90 }
			     { #type check-gang-has-convo-initiative type none }]
		reqs 	[{ #type check-convo-actions has enough }
			{ #type check-owner-relbuffs has any of [ relbuff-gangs-loot1-buff ] }
			{ #type check-owner-relbuffs has none of [ relbuff-gangs-loan-unpaid ] }
				 { #type check-blocking-cop expected #false }]
		text	{ key "convo.gangs.loan1.button" icon "quest.loan1.icon" }
		next	{ goto gang-trade-loan-offer }
	}
	{	;; gang moneylaundering
		visreqs [{ #type check-is-convo-aggro expected #false }
			{ #type check-owner-relbuffs has none of [ relbuff-gangs-loot5-table-on-finish relbuff-gangs-loan-unpaid ] }
			{ #type check-current-turn is moreorequalto value 2 }
			{ #type check-crew-peep-level id levelup-streetcred1 is atleast value 1 }
				{ #type check-owner-relationship is atleast value 5 }
			     { #type check-gang-has-convo-initiative type none }]
		reqs 	[{ #type check-convo-actions has enough }
				 { #type check-owner-relbuffs has none of [ relbuff-gangs-loot5-table-on-finish ] }
				 { #type check-blocking-cop expected #false }]
		text	{ key "convo.gangs.dirtycash1.button" icon "quest.loan1.icon" }
		next	{ goto gang-money-in }
	}

	{	;; "let's have a truce"
		visreqs [{ #type check-gang-conflict-truce expected #false }
				 { #type check-gang-has-convo-initiative type none }]
		reqs    [{ #type check-gang-conflict-trucedays }
				 { #type check-convo-actions has enough }
				 { #type check-blocking-cop expected #false }]
		text 	{ key "convo.gangs.truce.button" }
		next 	{ reqs 	[{ #type check-gang-has-history-element-to-human labelled [ gang-broke-truce ] }]
				  then	gang-truce-broken
				  else	gang-truce
				}
	}

	{	;; stop expanding near me
		visreqs	[ { #type check-is-convo-aggro expected #false }
			      { #type check-has-expansion-treaty-with-gang expected #false }
				  { #type check-gang-has-convo-initiative type none }]
		reqs	[ { #type check-convo-actions has enough }
				  { #type check-blocking-cop expected #false }]

		text	{ key "convo.gangs.expansion-treaty.button"}
		next	{ reqs	[{ #type check-gang-has-history-element-to-human labelled [ gang-broke-truce ]}]
				  then	gang-truce-broken
				  else	gang-expansion-treaty
				}
	}

	{	;; help me fight this other gang
		visreqs	[ { #type check-is-convo-aggro expected #false }
				  { #type check-aggro-gang-exists }  
				  { #type check-gang-has-convo-initiative type none }]
		reqs	[ { #type check-convo-actions has enough }
				  { #type check-blocking-cop expected #false }]

		text	{ key "convo.gangs.joint-war.button"}
		next	{ reqs	[{ #type check-gang-has-history-element-to-human labelled [ gang-broke-truce ]}]
				  then	gang-truce-broken
				  else	gang-joint-war-choose-target
				}
	}

	{	;; GangWars Mod - let's form an alliance
		;; 전쟁 중이 아니고 (aggro=false), 관계 50+, 이미 동맹 아님
		visreqs [{ #type check-is-convo-aggro expected #false }
				  { #type check-owner-relationship is atleast value 50 }
				  { #type check-gang-has-convo-initiative type none }
				  { #type check-owner-relbuffs has none of [ relbuff-gangwars-alliance ] }]
		reqs	[{ #type check-convo-actions has enough } { #type check-owner-relbuffs has none of [ relbuff-gangwars-alliance ] }
				  { #type check-blocking-cop expected #false }]
		text	{ key "convo.gangs.alliance.button" }
		next	{ goto gangwars-alliance }
	}

	{	;; GangWars Mod - demand tribute (protection)
		;; 거절 버프가 있으면 6개월간 다시 요구 불가
		visreqs [{ #type check-is-convo-aggro expected #false }
				  { #type check-gang-has-convo-initiative type none }
				  { #type check-owner-relbuffs has none of [ relbuff-gangwars-vassal relbuff-gangwars-overlord relbuff-gangwars-alliance relbuff-gangwars-tribute-refused ] }]
		reqs	[{ #type check-convo-actions has enough } { #type check-owner-relbuffs has none of [ relbuff-gangwars-vassal relbuff-gangwars-overlord relbuff-gangwars-alliance relbuff-gangwars-tribute-refused ] }
				  { #type check-blocking-cop expected #false }]
		text	{ key "convo.gangs.tribute-demand.button" icon "quest.protection.icon" }
		next	{ goto gangwars-tribute-demand }
	}

	{	;; GangWars Mod - release vassal
		visreqs [{ #type check-owner-relbuffs has any of [ relbuff-gangwars-vassal ] }]
		reqs	[{ #type check-convo-actions has enough } { #type check-owner-relbuffs has any of [ relbuff-gangwars-vassal ] }
				  { #type check-blocking-cop expected #false }]
		text	{ key "convo.gangs.release-vassal.button" }
		next	{ goto gangwars-release-vassal }
	}

	{	;; so about that favor you owe me (single favor)
		visreqs [{ #type check-relationship-tickets is equalto value 1 } { #type check-blocking-cop expected #false }
			{ #type check-owner-relbuffs has any of [ relbuff-gangs-loot1-buff ] } ]
		reqs 	[
				 { #type check-convo-actions has enough }]

		text 	{ key "convo.goon-single-favor-owed" icon "ui.ticket" }
		next	{ goto gang-redeem-favor-owed }
	}
	{	;; so about those favors you owe me (multiple favors)
		visreqs [{ #type check-relationship-tickets is morethan value 1 }
			{ #type check-owner-relbuffs has any of [ relbuff-gangs-loot1-buff ] }
				 { #type check-blocking-cop expected #false }]
		reqs 	[
				 { #type check-convo-actions has enough }]

		text 	{ key "convo.goon-many-favors-owed" icon "ui.ticket" }
		next	{ goto gang-redeem-favor-owed }
	}

	{	;; listen, i want to buy out your tied house
		visreqs	[{ #type special-can-ask-about-tied-house }]
		reqs 	[{ #type check-convo-actions has enough }
				 { #type check-blocking-cop expected #false }]

		text	{ key "convo.gangs.tied-house-start" addmo #true }
		onShow 	StoreGangTiedHouseProposal
		
		next 	{ reqs	[{ #type special-has-valid-tied-house-proposal expected #true }]
				  then 	gang-tied-house-start
				  else	gang-tied-house-fail }
	}
	{	;; you stole my outpost
		visreqs [{ #type check-is-convo-aggro expected #false }
			     { #type check-npc-gang-stole-player-outpost expected #true }
			     { #type check-gang-has-convo-initiative type none }]
		reqs 	[{ #type check-convo-actions has enough }
				 { #type check-blocking-cop expected #false }]
		text	{ key "convo.gangs.stolen-outpost.button" }
		next 	{ reqs	[{ #type check-gang-has-history-element-to-human labelled [ gang-broke-truce ]}]
				  then	gang-truce-broken
				  else	gang-stolen-outpost
				}
	}
	{	;; gang robbery low
		visreqs [
			{ #type check-owner-relbuffs has none of [ relbuff-gangs-robbery1-table-on-finish relbuff-gangs-robbery2-table-on-finish ] }
			{ #type check-owner-relationship is lessorequalto value 10 }
			     { #type check-gang-has-convo-initiative type none }]
		reqs 	[{ #type check-convo-actions has enough }
			{ #type check-owner-relbuffs has none of [ relbuff-gangs-robbery1-table-on-finish relbuff-gangs-robbery2-table-on-finish ] }
				 { #type check-blocking-cop expected #false }]
		text	{ icon "convo.gangs.robbery.icon" key "convo.gangs.robbery1.button" }
		next	{ goto gang-robbery-low }
	}
	{	;; gang robbery high
		visreqs [
			{ #type check-is-convo-aggro expected #false }
			{ #type check-owner-relbuffs has none of [ relbuff-gangs-robbery1-table-on-finish relbuff-gangs-robbery2-table-on-finish ] }
			{ #type check-crew-peep-level id levelup-hoodsgang is atleast value 1 }
			{ #type check-owner-relationship is moreorequalto value 1 }]
		reqs 	[{ #type check-convo-actions has enough }
			{ #type check-owner-relbuffs has none of [ relbuff-gangs-robbery1-table-on-finish relbuff-gangs-robbery2-table-on-finish ] }
				 { #type check-blocking-cop expected #false }]
		text	{ icon "convo.gangs.robbery.icon" key "convo.gangs.robbery3.button" }
		next	{ goto gang-robbery-lowsmith }
	}
	{	;; gang hitsquad
		visreqs [{ #type check-is-convo-aggro expected #false }
			{ #type check-owner-relbuffs has none of [ relbuff-gangs-loan-unpaid ] }
				{ #type check-owner-relationship is lessthan value -60 }
			     { #type check-gang-has-convo-initiative type none }]
		reqs 	[{ #type check-convo-actions has enough }
				 { #type check-blocking-cop expected #false }]
		text	{ key "convo.gangs.hitsquad1.button" icon "convo.gangs.fight.icon" }
		next	{ goto gang-hitsquad1 }
	}
	{	;; unprovoked attack
		;;visreqs [{ #type check-convo-demand-state is notset to defiant }]
		reqs    [{ #type check-convo-actions has enough }
				 { #type check-blocking-cop expected #false }]
		text	{ key "convo.gangs.fight.button" icon "convo.gangs.fight.icon" }
		next	{ goto gang-fight-confirmation }
	}
	{	;; goodbye
		text 	{ key "convo.gangs.goodbye" icon "convo.icon-leave" mo "convo.goodbye-button.mo" }
		onClick	Goodbye
	}
	]
}

gang-cop-at-node-start {
	npcsays [{ lockey "convo.goons.cop-effect.at-node.blurb" }]
	buttons [{
		text	{ key "convo.goons.cop-effect.at-node.leave.button" 
				  icon "convo.icon-leave" mo "convo.goodbye-button.mo" }
		onClick Goodbye
	}]
}


;;
;; combat 

gang-fight-confirmation {
	npcsays [{ lockey "convo.gangs.fight.blurb"}]
	buttons [
	{	;; do the deed
		reqs 	[{ #type check-convo-actions has enough }]
		text	{ key "convo.gangs.fight.confirm" addmo #true }
		onShow  StoreCombat
		onClick ExecuteCombat
		grants [{ #type consume-actions for convo }]
	}
	{	;; goodbye
		text { key "convo.gangs.fight.cancel" icon "convo.icon-leave" mo "convo.goodbye-button.mo" }
		onClick	Goodbye
	}
	]
}

;;
;; Gang Offers

		gang-offers {
			npcsays [{ lockey "convo.gangs.offers.npc" }]
			buttons [{
			reqs 	[{ #type check-convo-actions has enough }
				{ #type check-module-in-player-territory has any of [ backroomcabaret ] }
				{ #type check-owner-relbuffs has none of [ relbuff-gangs-offersp ] }
				{ #type check-blocking-cop expected #false }]
			text { icon "quest.crewoffer.icon" key "convo.gangs.offers-dancers-price.npc" }
			next { goto gang-offers-dancers }
			}{ 
			reqs 	[{ #type check-convo-actions has enough }
				{ #type check-module-in-player-territory has any of [ backroomcabaret ] }
				{ #type check-owner-relbuffs has none of [ relbuff-gangs-offers ] }
				{ #type check-blocking-cop expected #false }]
			text { icon "quest.crewoffer.icon" key "convo.gangs.offers-dancers-purchase-price.npc" }
			next { goto gang-offers-dancers-purchase }
			}{ 
			reqs 	[{ #type check-convo-actions has enough }
				{ #type check-module-in-player-territory has any of [ production-recordstudio ] }
				{ #type check-owner-relbuffs has none of [ relbuff-gangs-offerspm ] }
				{ #type check-blocking-cop expected #false }]
			text { icon "quest.crewoffer2.icon" key "convo.gangs.offers-musician-price.npc" }
			next { goto gang-offers-musician }
			}{ 
			reqs 	[{ #type check-convo-actions has enough }
				{ #type check-module-in-player-territory has any of [ production-talentsource ] }
				{ #type check-owner-relbuffs has none of [ relbuff-gangs-offersm ] }
				{ #type check-blocking-cop expected #false }]
			text { icon "quest.crewoffer2.icon" key "convo.gangs.offers-musician-purchase-price.npc" }
			next { goto gang-offers-musician-purchase }
			}{ 
			reqs 	[{ #type check-convo-actions has enough }
				{ #type check-module-in-player-territory has any of [ production-cannabisdealerlow production-cannabisdealermid production-cannabisdealerhigh production-cannabisdealerstart 
				production-cannalbisdealerlow production-cannalbisdealermid production-cannalbisdealerhigh ] }
				{ #type check-owner-relbuffs has none of [ relbuff-gangs-offerspd ] }
				{ #type check-blocking-cop expected #false }]
			text { icon "quest.crewoffer4.icon" key "convo.gangs.offers-dealer-price.npc" }
			next { goto gang-offers-dealer }
			}{ 
			reqs 	[{ #type check-convo-actions has enough }
				{ #type check-module-in-player-territory has any of [ production-cannabisdealerlow production-cannabisdealermid production-cannabisdealerhigh production-cannabisdealerstart 
					production-cannalbisdealerlow production-cannalbisdealermid production-cannalbisdealerhigh ] }
				{ #type check-owner-relbuffs has none of [ relbuff-gangs-offersd ] }
				{ #type check-blocking-cop expected #false }]
			text { icon "quest.crewoffer3.icon" key "convo.gangs.offers-dealer-purchase-price.npc" }
			next { goto gang-offers-dealer-purchase }
			}]
		}

		gang-offers-dancers {
		npcsays [{ lockey "convo.gangs.offers-dancers-price.npc" }]
		buttons [{ 
			reqs 	[{ #type check-convo-actions has enough }{ #type check-owner-relbuffs has none of [ relbuff-gangs-offersp ] }{ #type check-player-cash type current is morethan value 940 }]
			text 	{ key "convo.gangs.offers-dancers-price.yes" 
				  npc "convo.gangs.offers-dancers-price.yes-epi" 
				  icon "convo.icon-check"
				}
				grants [ { #type consume-actions for convo } { #type add-rel-buff with player id "relbuff-gangs-offersp" }{ #type add-resource id exdancers qty 4 at safehouse }{ #type add-cash amount -940 at safehouse }] 
			}
			{	;; goodbye
			text { key "convo.gangs.fight.cancel" icon "convo.icon-leave" mo "convo.goodbye-button.mo" }
			onClick	Goodbye
			}]
		}

		gang-offers-dancers-purchase {
		npcsays [{ lockey "convo.gangs.offers-dancers-purchase-price.npc" }]
		buttons [{ 
			reqs 	[{ #type check-convo-actions has enough }{ #type check-player-has-too-many resource exdancersp is lessorequalto value 2 }{ #type check-owner-relbuffs has none of [ relbuff-gangs-offers ] }]
			text 	{ key "convo.gangs.offers-dancers-purchase-price.yes" 
				  npc "convo.gangs.offers-dancers-purchase-price.yes-epi" 
				  icon "convo.icon-check"
				}
				grants [ { #type consume-actions for convo } { #type add-rel-buff with player id "relbuff-gangs-offers" } { #type add-resource id exdancersp qty 1 at safehouse }] 
			}
			{	;; goodbye
			text { key "convo.gangs.fight.cancel" icon "convo.icon-leave" mo "convo.goodbye-button.mo" }
			onClick	Goodbye
			}]
		}

		gang-offers-musician {
		npcsays [{ lockey "convo.gangs.offers-musician-price.npc" }]
		buttons [{ 
			reqs 	[{ #type check-convo-actions has enough }{ #type check-owner-relbuffs has none of [ relbuff-gangs-offerspm ] }{ #type check-player-cash type current is morethan value 3300 }]
			text 	{ key "convo.gangs.offers-musician-price.yes" 
				  npc "convo.gangs.offers-musician-price.yes-epi" 
