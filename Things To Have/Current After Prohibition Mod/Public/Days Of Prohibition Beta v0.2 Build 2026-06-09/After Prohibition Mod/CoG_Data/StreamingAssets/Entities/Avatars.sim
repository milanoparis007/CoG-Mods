{ entities [


	{
		ident { template person-base }
		agent { 
			movesPerTurn { value 10 mods [
				{ #type law-mod laws [speed-limit] enacted true }
				{ #type law-mod laws [street-repairs] enacted true }
				{ #type crew-peep-level-value-mod id levelup-driving perlevel 2 } ;; 2 pts per level
				{ #type traits-mod if [ trait-sharpeyed trait-careless ] delta 1 }
				{ #type traits-mod if [ trait-myopic trait-clumsy ] delta -1 }
				{ #type crew-peep-role-test-mod	is any of [driver] delta 5 }
				{ #type crew-vehicle-template is equalto template vehicle-transit delta 10 }
				{ #type crew-vehicle-template is equalto template vehicle-sports-car delta 5 }
				{ #type crew-vehicle-template is equalto template vehicle-sportsbenz delta 4 }
				{ #type crew-vehicle-template is equalto template vehicle-bulletproof-sports-car delta 4 }
				{ #type crew-vehicle-template is equalto template vehicle-bmw327 delta 5 }
				{ #type crew-vehicle-template is equalto template vehicle-benz-ssk delta 4 }
				{ #type crew-vehicle-template is equalto template vehicle-jaguarm delta 7 }
				{ #type crew-vehicle-template is equalto template vehicle-bulletproof-jaguar delta 7 }
				{ #type crew-vehicle-template is equalto template vehicle-bmw delta 5 }
				{ #type crew-vehicle-template is equalto template vehicle-benz delta 4 }
				{ #type crew-vehicle-template is equalto template vehicle-jaguar delta 7 }
				{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 1 delta 5 }
				{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 2 delta 10 }
				{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 3 delta 15 }
				{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 4 delta 20 }
				{ #type is-biz-in-territory id train-station-freight expected #true delta 2 }
				{ #type crew-vehicle-condition is equalto type clunker multiplier 0.4 }
				{ #type crew-vehicle-condition is equalto type junk multiplier 0.2 }
			] }
			actionsPerTurn { value 3 mods [
				{ #type crew-peep-level-test-mod id levelup-actions is equalto value 1 delta 1 }
				{ #type crew-peep-level-test-mod id levelup-actions is equalto value 2 delta 2 }
				{ #type crew-peep-level-test-mod id levelup-actions is equalto value 3 delta 4 }
				{ #type crew-vehicle-template is equalto template vehicle-transit delta -1 }
				{ #type crew-peep-unpaid multiplier 0.5 }
				{ #type traits-mod if [ trait-lazy trait-slow ] delta -1 }
				{ #type traits-mod if [ trait-organized ] delta 1 }
				{ #type is-biz-in-territory id train-station-passenger expected #true delta 1 }
				{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 1 delta 3 }
				{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 2 delta 6 }
				{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 3 delta 9 }
				{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 4 delta 12 }
			]}
		}
		person {
		}
	}

	{
	    ident { template train }
	    mobile {
	    	type train
	    	locname	"vehicle.train.locname"
	    	locdesc "vehicle.train.locdesc"
			velocityTilesPerSecond 1

			usesGain #true
			movementGain 0.5
			movementMax 10
			rotationGain 1.375
			rotationMax 2
	    }
	    model {
	        prefabs [ "Vehicles/train_freight_a" "Vehicles/train_freight_b" "Vehicles/train_freight_c" "Vehicles/train_passenger" ]
			loadtype vehicle
			paletterow 3
        }
		script {
		}
	}

	{
	    ident { template vehicle-base }
	    mobile {
	    	type car
	    	locdesc #null
			velocityTilesPerSecond 15
			navOffsetTiles 0.35
	    	basePurchasePrice 100
	    }
	    model {
	        prefabs #null ;; override me plz
			loadtype vehicle
			suppressload #true ;; npc cars will be loaded as they're encountered
	        paletterow 3
		;	paletterowunknown 1
        }
        ; modules { } needs to be set up below
	    selection {
	        onfocus showinfo
	        onaction car
	    }
		script {
		}
	}

	;; cars

	{
		ident { template car-base parent vehicle-base }
		mobile {
			type car
			velocityTilesPerSecond 14
			navOffsetTiles 0.35
		}
		modules {
			slots [ { tags [ tag-inventory-vehicle-car ] } ]
		}
	}
	{
	    ident { template vehicle-car parent car-base }
	    mobile {
	    	locname "vehicle.car.name"
	    	locdesc "vehicle.car.desc"
	    	basePurchasePrice 400
	    	uiSprite "Vehicle Sedan"
	    }
        modules { 
			preinstalled [ inventory-vehicle-car ]
        }
	    model {
	        prefabs [ "Vehicles/Vehicle Car B" ]
        }
	}
