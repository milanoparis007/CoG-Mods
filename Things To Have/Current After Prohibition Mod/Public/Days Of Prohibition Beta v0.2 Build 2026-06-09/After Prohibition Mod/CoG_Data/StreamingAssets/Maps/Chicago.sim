{ maps [ { 
	id chicago
	citytype chicago

	;; cityname "Chicago"  		;; let's use loc instead
	;; statename "Illinois"
	;; citydesc	"Story..."

	citylockey	"city-name.chicago"
	statelockey	"state-name.illinois"
	citydesckey	"city-desc.chicago"
	cityscreen	"Chicago Screenshot"
	citypolunitkey	"city-pol-unit.ward"

	map {
		;; logical map specification
		mapSize        { width 300 height 400 } ;; size in world units
		;; heatmapSpacing { width 8 height 8 }  ;; should be similar or larger than smallest block size
		;; beadSpacing { width 1 height 1 }     ;; should be default (1, 1) unless there's a good reason :)

		streetNames [ 
			"streets.usfounders" "streets.famouspeople" "streets.usstates" "streets.uscities"
			"streets.smalltown" "streets.trees" "streets.plants" "streets.birds" "streets.chicago" 
			"streets.lastnames" "streets.generic" ]

		nodes [
			{
				id BaseGrid
				nodeSpacing { width 8 height 10 }
;					forceStart { x 150 y 200 }
				forceAngle 0
				initialNames [ "streets.chicago" "streets.usfounders" "streets.lastnames" "streets.uscities" ] 
			}
			{
				id "Milłoki"
				nodeSpacing { width 10 height 5 }
				forceStart { x 75 y 310 }
				relativeSpeed 2
				forceMaxSize 100
				forceMaxSpread { width 20 height 1 }
				forceAngle 45
				railCost 50
				dontSkipRoads #true
				initialNames [ "streets.plants" ]
			}
			{
				id ByTheRiverSouth
				nodeSpacing { width 8 height 8 }
				forceStart { x 10 y 65 }
				relativeSpeed 2
				forceMaxSize 60
				forceMaxSpread { width 50 height 5 }
				forceAngle -36
				railCost 50
				dontSkipRoads #true
				initialNames [ "streets.trees" ]
			}
			{
				id WestSideGrid
				nodeSpacing { width 8 height 10 }
				forceStart { x 23 y 240 }
;				forceMaxSize 250
				forceMaxSpread { width 40 height 200 }
				relativeSpeed 2
				forceAngle -2
				initialNames [ "streets.usstates" ]
			}
			{
				id SouthEastSideGrid
				nodeSpacing { width 10 height 8 }
				forceStart { x 175 y 75 }
				; forceMaxSize 250
				relativeSpeed 1
				forceAngle 2
				initialNames [ "streets.smalltown" ]
			}
			{
				id ByTheRiverNorthside
				nodeSpacing { width 7 height 5 }
				forceStart { x 120 y 300 }
				relativeSpeed 1.5
				forceMaxSize 60
				forceMaxSpread { width 5 height 30 }
				forceAngle -24
				railCost 50
				initialNames [ "streets.birds" ]
			}
			{
				id ArcherAve
				nodeSpacing { width 6 height 8 }
				forceStart { x 100 y 100 }
				relativeSpeed 2
				forceMaxSize 100
				forceMaxSpread { width 35 height 1 }
				forceAngle -55
				railCost 50
				dontSkipRoads #true
				initialNames [ "streets.birds" ]
			}
			{
				id ClarkSt
				nodeSpacing { width 6 height 8 }
				forceStart { x 205 y 360 }
				forceMaxSize 70
				forceMaxSpread { width 30 height 1 }
				relativeSpeed 2
				forceAngle 76
				railCost 50
				dontSkipRoads #true
			}
			{
				id LincolnAve
				nodeSpacing { width 6 height 8 }
				forceStart { x 145 y 370 }
				forceMaxSize 70
				forceMaxSpread { width 30 height 1 }
				relativeSpeed 2
				forceAngle 60
				railCost 50
				dontSkipRoads #true
			}
			{
				id GrandAve
				nodeSpacing { width 6 height 8 }
				forceStart { x 26 y 270 }
				forceMaxSize 70
				forceMaxSpread { width 20 height 1 }
				relativeSpeed 2
				forceAngle 13
				railCost 50
				dontSkipRoads #true
			}
			{
				id OgdenAve
				nodeSpacing { width 6 height 8 }
				forceStart { x 22 y 136 }
				forceMaxSize 25
				forceMaxSpread { width 30 height 1 }
				relativeSpeed 2
				forceAngle -35
				railCost 50
				dontSkipRoads #true
			}		
			;; and to fill in anything that gets caught between Ogden Ave and the river. May or may not keep this once we figure out a base/default grid while working on randomization...
			{
				id ExtraSouthwestSideGrid
				nodeSpacing { width 8 height 10 }
				forceAngle 3
				forceStart { x 30 y 110 }
				relativeSpeed 0.5
				initialNames [ "streets.trees" ]
			}	
			{
				id "connection-shorerd-east"
				nodeSpacing { width 12 height 12 }
				forceStart { x 252.5 y 170 }
				relativeSpeed 4
				forceMaxSize 400
				forceMaxSpread { width 400 height 1 }
				forceAngle 87.4
				railCost 50
				dontSkipRoads #true
				initialNames [ "streets.atlantic-city.connections" ]
				forceBridges #true
				connection #true
			}			
			
		]

		rails [
			{
				id test
				nodes [
					{ x 80 y 55 }
					{ x 120 y 60 }
					{ x 190 y 90 }
				]
			}
			{
				id randomWithRect
				random true
				randomRect { x 50 y 150 width 60 height 60 }
			}
			{
				id random2
				random true
			}
			{
				id random3
				random true
			}
			{
				id random4
				random true
			}
		]

		districts [
			{
				tags [ downtown bizcenter ]
				locname	"districts.downtown" ;; optional to display on the map
				start { x 210 y 200 } radius 30
			}
			{
				tags [ bizcenter ]
				locname	"districts.chi.southloop" 
				start { x 200 y 110 } radius 15
			}
			{
				tags [ bizcenter ]
				locname	"districts.chi.westloop"
				start { x 100 y 210 } radius 15
			}
			{
				tags [ bizcenter ]
				locname	"districts.chi.lincolnpark" 
				start { x 200 y 350 } radius 20
			}
			{
				tags [ indcenter ]
				locname	"districts.chi.gooseisland"
				start { x 130 y 300 } radius 35
			}
			{
				tags [ indcenter ]
				locname	"districts.chi.backoftheyards"
				start { x 120 y 90 } radius 30
			}
		]
	}

	terrain {
		;; terrain specification
		chunktiles { width 40 height 40 }  ;; max world size of each chunk tile (could be less)
		tileverts { width 1 height 1 } ;; number of vertices per tile, floats allowed to break up the grid
		terrainscale 15

		groundheight 0.5
		waterheight -0.2
		zwobble 0.01
		; xywobble 0
		mountainnodes [ ; mountains... Chicago.. hahaha... who do you think we are? Ubisoft?
			; {
			; 	id mountain
			; 	forceStart { x 25 y 25}
			; 	size 25
			; }
		]

		waternodes [
			{
				id LakeMichigan
			;	forceStart { x 300 y 400 }
				width 20
				deformers [
					{ x 250 y 400 } ;top left
					{ x 300 y 400 } ;top right
					{ x 270 y 0 } ;bottom left
					{ x 300 y 0 } ;bottom right
				]
				body true
				allowBridges false
			}
			{
				id ChicagoRiverMouth
				forceStart { x 255 y 240 }
				width 6
				forceFixedWidth true
				connectingNodes [
					MichiganAveBridge
				]
			}
			{
				id MichiganAveBridge
				forceStart { x 215 y 251 }
				width 7
				connectingNodes [
					ClartStBridge
				]
			}
			{
				id ClartStBridge
				forceStart { x 206 y 243 }
				width 7
				connectingNodes [
					CanalStBridge
				]
			}
			{
				id CanalStBridge
				forceStart { x 162 y 250 }
				width 7
				connectingNodes [
					WolfPoint
				]
			}
			{
				id WolfPoint
				forceStart { x 150 y 240 }
				width 7
				connectingNodes [
					GrandAveAveBridge
					MadisonStBridge
				]
			}
			{
				id GrandAveAveBridge
				forceStart { x 128 y 273 }
				width 7
				connectingNodes [
					GooseIslandSouth
				]
			}
			{
				id GooseIslandSouth
				forceStart { x 128 y 290 }
				width 7
				connectingNodes [
					DivisionStEast
					DivisionStWest
				]
			}
			{
				id DivisionStEast
				forceStart { x 130 y 300 }
				width 2
				connectingNodes [
					GooseIslandNorthE
				]
			}
			{
				id DivisionStWest
				forceStart { x 116 y 300 }
				width 4
				connectingNodes [
					GooseIslandNorthW
				]
			}
			{
				id GooseIslandNorthW
				forceStart { x 116 y 312 }
				width 4
				connectingNodes [
					CortlandEast
				]
			}
			{
				id GooseIslandNorthE
				forceStart { x 116 y 313 }
				width 2
				connectingNodes [

				]
			}
			{
				id CortlandEast
				forceStart { x 108 y 323 }
				width 5
				connectingNodes [
					CortlandWest
				]
			}
			{
				id CortlandWest
				forceStart { x 100 y 324 }
				width 4
				connectingNodes [
					AshalndAveNorthBridge
				]
			}
			{
				id AshalndAveNorthBridge
				forceStart { x 97 y 340 }
				width 4
				connectingNodes [
					DiverseyAve
				]
			}
			{
				id DiverseyAve
				forceStart { x 84 y 356 }
				width 5
				connectingNodes [
					RoscoeAve
				]
			}
			{
				id RoscoeAve
				forceStart { x 64 y 368 }
				width 4
				connectingNodes [
					IrvingParkRd
				]
			}
			{
				id IrvingParkRd
				forceStart { x 64 y 388 }
				width 3
				connectingNodes [
					MontroseAve
				]
			}
			{
				id MontroseAve
				forceStart { x 68 y 400 }
				width 2
			}

			;; south branch
			{
				id MadisonStBridge
				forceStart { x 144 y 228 }
				width 7
				connectingNodes [
					Congress
				]
			}
			{
				id Congress
				forceStart { x 148 y 214 }
				width 7
				connectingNodes [
					AirLineBridge
				]
			}
			{
				id AirLineBridge
				forceStart { x 150 y 180 }
				width 7
				connectingNodes [
					CermakRd
				]
			}
			{
				id CermakRd
				forceStart { x 143 y 164 }
				width 6
				connectingNodes [
					RacineAve
				]
			}
			{
				id RacineAve
				forceStart { x 125 y 160 }
				width 6
				connectingNodes [
					AshalndAveSouth
				]
			}
			{
				id AshalndAveSouth
				forceStart { x 110 y 148 }
				width 6
				connectingNodes [
					SDamenAve
					BubblyCreekStart
				]
			}
			{
				id SDamenAve
				forceStart { x 94 y 135 }
				width 6
				connectingNodes [
					SouthExit
				]
			}
			{
				id SouthExit
				forceStart { x 0 y 60 }
				width 6
			}

			;; bubbly creek
			{
				id BubblyCreekStart
				forceStart { x 112 y 140 }
				width 4
				connectingNodes [
					BubblyCreekOne
				]
			}
			{
				id BubblyCreekOne
				forceStart { x 114 y 132 }
				width 3
				connectingNodes [
					ThirtyFifthStreet
				]
			}
			{
				id ThirtyFifthStreet
				forceStart { x 124 y 123 }
				width 2
				connectingNodes [
					PershingRd
				]
			}
			{
				id PershingRd
				forceStart { x 123 y 110 }
				width 2
			}


			; {
			; 	id CalumetMouth
			; 	forceStart { x 265 y 70 }
			; 	connectingNodes [
			; 		CalumetBend
			; 	]
			; 	width 3
			; }
			; {
			; 	id CalumetBend
			; 	forceStart { x 230 y 70 }
			; 	width 3
			; 	connectingNodes [
			; 		CalumentLakeEntry
			; 	]
			; }
			; {
			; 	id CalumentLakeEntry
			; 	forceStart { x 220 y 90 }
			; 	allowBridges false
			; 	width 2
			; }
			; {
			; 	id LakeCalumet
			; 	forceStart { x 224 y 95 }
			; 	width 20
			; 	deformers [
			; 		{ x 221 y 105 } ;top left
			; 		{ x 227 y 98 } ;top right
			; 		{ x 220 y 83 } ;bottom left
			; 		{ x 227 y 80 } ;bottom right
			; 	]
			; 	body true
			; 	allowBridges false
			; }

		]
	}
	
	generator {
		totalInflux 150000
	
		lots [
			{ mindensity 0.4 		lot "empty-lot-42" probfail 0.2 }
			{ mindensity 0.00001	lot "empty-lot-22" probfail 0.2 }
			{ mindensity 0.0 		lot "empty-lot-12" }
		]

		decoNodes {
			maxdensity	1
			maxappeal	1
			centers		40
			spread 		{ default 2 lowappeal 7 }
			lotpercent  { default 100 lowappeal 75 }
		}

		specialBuildings {
			policeStation	{ configs [ "police-station" ] }
			trainStation    { configs [ "passenger-station" "cargo-station" ] }
			civicsAndOthers [

				; these are everywhere

				{ configs [ "worship-regular" "school-regular" ] 
					skipEvery { from 340 to 720 } }

				{ configs [ "fire-station-small" ] 
					skipEvery { from 1200 to 2000 } }

				{ configs [ "school-large" ] 
					skipEvery { from 600 to 800 } }
                { configs [ "com-medium-philly-bank" ]
                    skipEvery { from 900 to 1300 }
                    maxPerDistrict 1 }

				{ configs [ "civic-government-medium" "civic-hospital-medium" "civic-post-office-medium" ] 
					skipEvery { from 800 to 900 } }

				; everywhere but uncommon

				{ configs [ "fire-station-large" ] 
					skipEvery { from 1000 to 2000 } }

				{ configs [ "worship-large" ] 
					skipEvery { from 1200 to 2000 } }

				;; extremely uncommon oustide of downtown

				{ configs [ "downtown-medium-commercial" "downtown-large-commercial" ]
					skipEvery { from 10000 to 20000 } }
				{ configs [ "ind-union-hall" "importm-regular" "industrial-zone-large" "industrial-zone-medium" ]
					skipEvery { from 20000 to 40000 } }

				; big ones stand out too much to be sprinkled around
				;{ configs [ "civic-government-large" "civic-hospital-large" "civic-post-office-large" "school-large" ] 
				;	skipEvery { from 500 to 600 } }

				; higher distribution in specific districts

				
                { configs [ "com-large-downtown-bank" ]
                    districtTags [ downtown ]
                    skipEvery { from 160 to 260 }
                    maxPerDistrict 1 }
                { configs [ "com-large-downtown-bank" ]
                    districtTags [ bizcenter ]
                    skipEvery { from 220 to 360 }
                    maxPerDistrict 1 }
				{ configs [ "worship-large" "civic-government-large" "civic-post-office-large" ] 
					districtTags [ downtown ]
					skipEvery { from 10 to 20 } }
				{ configs [ "downtown-medium-commercial" ]
					districtTags [ downtown ]
					skipEvery { from 800 to 1600 } }
				{ configs [ "downtown-medium-commercial" ]
					districtTags [ bizcenter ]
					skipEvery { from 900 to 1800 } }
				{ configs [ "downtown-large-commercial" ]
					districtTags [ downtown ]
					skipEvery { from 80 to 140 } }
				{ configs [ "downtown-large-commercial" ]
					districtTags [ bizcenter ]
					skipEvery { from 10 to 20 }
					maxPerDistrict 1 }

				{ configs [  "worship-large" 
							"civic-government-large" "civic-hospital-large" "civic-post-office-large" "school-large" ] 
					districtTags [ bizcenter ]
					skipEvery { from 4 to 8 } }
				{ configs [ "ind-union-hall" "importm-regular" ]
					districtTags [ indcenter ]
					skipEvery { from 100 to 150 }
					maxPerDistrict 5
				}
				{ configs [ "industrial-zone-medium" ]
					districtTags [ indcenter ]
					skipEvery { from 1800 to 2200 }
				}
				{ configs [ "industrial-zone-large" ]
					districtTags [ indcenter ]
					skipEvery { from 3000 to 4000 }
					maxPerDistrict 4
				}
			]
		}
    	nodeCenterScore 1.0 
    	otherCenterScore 0.3
    	otherCenterCount 3	

    	lowAppealThreshold 0.3
    	midAppealThreshold 0.7
	}

	playerStart {
    	nodesKnownAtStart 14
    	nodesFriendlyAtStart 5
    	mapEdgePlacementMargin 40
    	mapEdgePlacementPenalty 0.1

    	resourcesUnlocked [
    		;; mundane resources
    		apple-juice grape-juice crocks malt
    		barrels half-barrels steel-barrels bottles small-bottles

    		;; materials
    		bricks lumber

    		;; flavor resources
    		gasoline

    		;; initial illegal resources
    		neutral-alcohol moonshine cider home-brew brick-wine dirty-cash counterfeitcash cook cfood rfood rfoodsupplies lockpicks liquor-license cigarettes french75 cloverclub bloodsand boulevardier negroni french75mix cloverclubmix bloodsandmix boulevardiermix negronimix

    		;; weapons
    		weapon-crowbar weapon-bat weapon-knife

    	]
	}

	moveinScores {
		resSameEthnicityBoost 10

		emptyLotBase { from 0 to 1 }

		resInitialSeeds 5
		resResidentialAreaBoost 1
		resCommercialAreaBoost 0
		resIndustrialAreaBoost -4
		resRailOrTerminalBoost -4
		
		indInitialSeeds 50
		indResidentialAreaBoost -1
		indCommercialAreaBoost 1
		indIndustrialAreaBoost 1
		indRailOrTerminalBoost 0.5

		comInitialSeeds 50
		comResidentialAreaBoost 1
		comCommercialAreaBoost 0.8
		comIndustrialAreaBoost 0
		comRailOrTerminalBoost 0

		interestingNodeProbabilities {
			;; this means: 10% of nodes prefer to have 3 businesses, etc
			;; they should add up to 1.0 but if they don't it's okay
			3  0.1
			2  0.5
			1  0.3
			0  0.1
		}

		;; means that 90% of nodes are allowed to have a potential
		;; business if the interesting count is below total count
		potentialNodeProbability 0.9
	}

	familyGenerator {
		initialFamiliesRatio 0.75 ; initial fams compared to real businesses
		kidsCount [ 0 0 1 2 2 3 3 3 4 4 4 5 5 6 6 7 7 8 8 9 9 10 ]
		marriageRatio 0.9
		marriageAgeRange { from 18 to 30 }

		childMortalityRatio 0.05
        childMortalityAgeRange { from 0 to 2 }
        adultMortalityAgeRange { from 50 to 80 }

		traitsPerPerson { from 1 to 3 }
		probTraitInherited 0.6
		probTraitOther 0.4

		friendsAge { from 16 to 19 }
		friendsCount { from 2 to 5 }
	}

	seasons {
		seasonBlendASRWidth 15
		resGroundColor { r 164 g 193 b 94 a 255 }
		;comGroundColor { r 139 g 173 b 55 a 255 }
		comGroundColor { r 164 g 193 b 94 a 255 }
		indGroundColor { r 132 g 126 b 111 a 255 }

		data [
		{	season spring
			dateRange { from 75 to 175 }
			
			foliageHueShift { from 0 to 0 }
			foliageSaturationShift -0.1
			groundHueShift -0.04
			groundSaturationShift -0.1

			sunColor { r 255 g 253 b 249 a 255 }
			sunIntensity 1.2
			ambientColor { r 179 g 184 b 209 a 255 }
			ambientIntensity 0.1
			fogColor { r 190 g 157 b 96 a 255 }
			fogIntensity 0.003

			weather { type rain hoursOfDay { from 21 to 24 } prob 0.3 }
		} 
		{	season summer
			dateRange { from 160 to 260 }

			foliageHueShift { from 0 to 0.1 }
			foliageSaturationShift 0
			groundHueShift -0.02
			groundSaturationShift -0.1
			
			sunColor { r 255 g 247 b 230 a 255 }
			sunIntensity 1.2
			ambientColor { r 209 g 209 b 209 a 255 }
			ambientIntensity 0.1
			fogColor { r 190 g 157 b 96 a 255 }
			fogIntensity 0.005

			weather { type dust hoursOfDay { from 17 to 20 } prob 0.8 }
		}
		{	season fall
			dateRange { from 245 to 345 }

			foliageHueShift { from -0.14 to -0.04 }
			foliageSaturationShift 0.1
			groundHueShift -0.1
			groundSaturationShift -0.2
			
			sunColor { r 255 g 244 b 220 a 255 }
			sunIntensity 1.2
			ambientColor { r 204 g 170 b 155 a 255 }
			ambientIntensity 0.1
			fogColor { r 212 g 164 b 47 a 255 }
			fogIntensity 0.005

			weather { type rain hoursOfDay { from 21 to 24 } prob 0.3 }
		}
		{	season winter
			dateRange { from 330 to 90 }

			foliageHueShift { from -0.14 to -0.04 } ;; keep fall colors
			foliageSaturationShift 0.0
			groundHueShift -0.1
			groundSaturationShift -0.7
			
			sunColor { r 221 g 221 b 235 a 255 }
			sunIntensity 0.9
			ambientColor { r 128 g 144 b 196 a 255 }
			ambientIntensity 0
			fogColor { r 190 g 157 b 96 a 255 }
			fogIntensity 0.007

			weather { type snow hoursOfDay { from 6 to 21 } prob 0.5 }
		}
		]
	}

	ethnicMakeup { 
		nationalities {
			am 30
			de 10
			pl 10
			af 10
			la 5
			as 3
			ru 4
			ir 7
			se 4
			it 4
			cz 2
			at 2
			no 2
			en 2
			ca 2
			hu 1
			lt 1
			dk 1
			sc 1
		}
		skin {
			am { names [ light ] proportions [ 100 ] }
			it { names [ light medium ] proportions [ 80 20 ] }
			as { names [ light medium ] proportions [ 80 20 ] }
			af { names [ dark ] proportions [ 100 ] }
			la { names [ medium ] proportions [ 100 ] }
			others { names [ light ] proportions [ 100 ] }
		}
	}

	groups [
		{ type AgentPlayer count 1 }
		{ type CopPlayer count 21 }
		{ type GangPlayer count 21 }
 		{ type GoonPlayer count 35 }
	]

	newspaperExtras {
		;; these are loc strings unique to this city
		subheadsCityGeneral [ newspaper-chicago ]
		subheadsCityDated [ newspaper-dated-chicago ]
		subheadsCitySequences [ newspaper-seq-chicago-barrel newspaper-seq-chicago-whiskey ]
	}

} ] }
