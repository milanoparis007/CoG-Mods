		;;
		;; resource groups for modules
		;; each group gets exploded into a flat list of individual resources 
		;; during module initialization
		;;
		;; currently they're only available in consume modules! but easy enough to apply elsewhere

		group-homebooze {
			type module-group
			groupmembers [ brick-wine home-brew cider moonshine ]
		}
		group-cider {
			type module-group
			groupmembers [ cider sparkling-cider ]
		}
		group-wine {
			type module-group
			groupmembers [ brick-wine fake-wine ]
		}
