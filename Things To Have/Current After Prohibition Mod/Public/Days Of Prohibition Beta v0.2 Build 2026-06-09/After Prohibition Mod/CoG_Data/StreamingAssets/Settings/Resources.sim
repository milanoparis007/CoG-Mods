	ethPackAlcohols {
		german-lager {
			ethId	de
			resource {
				entity ethnic-alcohol ;; german-lager
				locname	"res.german-lager.name"
				loclistname "res.german-lager.listname"
				locdesc "res.german-lager.desc"
				locicon "res.german-lager.icon"
				locbatch "res.any-resource.batch"
				buy { cash 25 }
				sell { cash 27 }
				buyPriceModifier { value 1 }
				sellPriceModifier { value 1 mods [ { #type skills-mod if [ german-brew ] multiplier 1.3 } ]}
				relbuff { points 20 forcedayz 252 }
				unitid unit-case
				rescat rescat-booze
				illegal #true
			}


			common {
				tags [ tag-biz-back ]
				upgradetag tag-upgrade-booze-track-one
				visreqs [{ #type check-has-eth-pack-and-is-eth eth de }]
				reqs [	{ #type check-player-territory-size is atleast value 20 }
						{ #type check-player-skills has all of [ ethnic-production ]}]
				display {
					icon "Module German Lager"
					locicon	"module.icons.german-lager"
					locname	"module.german-lager.name"
					locdesc	"module.german-lager.desc"
					locInstallDetail "module.german-lager.details"
					locintroflavor "convo.ticket-intro-flavor.module.german-lager"
					operationSprite "Accent Counterfeit Beer"
					accentSprite "Operation Fake Beer"
				}
				purchase {
					size [ tag-size-small tag-size-medium ]
					verticals [ tag-vert-booze ]
					buildTurns { value 3 }
					cashCost { cash -1000 }
					consume [ { id barrels qty -5 } { id pipes qty -2 }]
				}
} }
