	territory {
		;; territory zoom display percentage: a value [0, 1] that defines at what
		;; point when zooming out the territory ownership of the map begins to show
		territoryDisplayZoomRange { from 0.25 to 0.4 }

		;; zoom levels for when to show various types of picks
		showBuildingPicksZoomRange { from 0.0 to 0.15 }
		showSummaryPicksZoomRange { from 0.15 to 0.25 }

		showWeatherZoomRange { from 0.0 to 0.07 } ;; weather only on tight zoom in
		showCloudsZoomRange { from 0.4 to 0.7 }  ;; similar to names

		timeOfDayColors {
			timeASRWidth 2
			emissiveMultiplier { r 1.0 g 0.7 b 0.3 a 1.0 }
			segments [
			{
				hourRange { from 5 to 9 }
				colorMultiplier { r 1.0 g 0.8 b 0.7 a 1.0 }
				nightValue 0
			}
			{
				hourRange { from 7 to 18 }
				colorMultiplier { r 1.0 g 1.0 b 1.0 a 1.0 }
				nightValue 0
			}
			{
				hourRange { from 16 to 20 }
				colorMultiplier { r 1.0 g 0.8 b 0.6 a 1.0 }
				nightValue 0
			}
			{
				hourRange { from 18 to 22 }
				colorMultiplier { r 0.7 g 0.6 b 0.6 a 1.0 }
				nightValue 0.5
			}
			{
				hourRange { from 20 to 7 }
				colorMultiplier { r 0.25 g 0.25 b 0.3 a 1.0 }
				nightValue 1
			}
			]
		}
	}

	dlcs {
		entries [
			{ packid deluxe locname "dlc-panel.name.deluxe" locicon "dlc-panel.icon.deluxe" }
			{ packid atlantic-city locname "dlc-panel.name.atlantic-city" locicon "dlc-panel.icon.atlantic-city" }
			{ packid criminal-record locname "dlc-panel.name.criminal-record" locicon "dlc-panel.icon.criminal-record"}
			{ packid shadow-government locname "dlc-panel.name.shadow-government" locicon "dlc-panel.icon.shadow-government"}
		]
	}

	tutorial {
		rngseed     0612061206
		demoseed	2026133337
		mapdef      chicago 
		firstName	"tut.newgame.firstname"
		lastName    "tut.newgame.lastname"

		safehouseFrontModule	source-forge-front-starter
		ziggyBackModule			bootlegger-homebooze-d
		ziggyFriendBackModule	bootlegger-homebooze-a-large

		grants [
			{ #type add-resource id home-brew qty 110 at safehouse }
			{ #type add-cash amount 200 at crew }
			{ #type add-cash amount 500 at safehouse }
		]
	}

	generator {
		procGenYears { from 1871 to 1920 }
		startDayOfYear 152 ;; june 1

		endYear 1933
		endDayOfYear 336 ;; dec 3, 1933

		daysPerTurnCityGenMax 365
		daysPerTurnInteractive 7

		traitTypes [
			{
				locname "archetype.random.name"
				locdesc "archetype.random.desc"
			}
			{
				locname	"archetype.streetwise.name"
				locdesc	"archetype.streetwise.desc"

				traits [
					"trait-sharpeyed"
					"trait-careless"
					"trait-curious"
				]
			}
			{
				locname	"archetype.brawler.name"
				locdesc	"archetype.brawler.desc"

				traits [
					"trait-strong"
					"trait-agile"
					"trait-ugly"
				]
			}
			{
				locname	"archetype.chatterbox.name"
				locdesc "archetype.chatterbox.desc"

				traits [
					"trait-talkative"
					"trait-sociable"
					"trait-careless"
				]
			}
			{
				locname "archetype.iron-fist.name"
				locdesc "archetype.iron-fist.desc"

				traits [
					"trait-cruel"
					"trait-aggressive"
					"trait-irritable"
				]
			}
			{
				locname "archetype.bookworm.name"
				locdesc "archetype.bookworm.desc"

				traits [
					"trait-intelligent"
					"trait-hardworking"
					"trait-myopic"
					"trait-boss"
				]
			}
			{
				locname "archetype.churchgoer.name"
				locdesc "archetype.churchgoer.desc"

				traits [
					"trait-religious"
					"trait-upright"
					"trait-friendly"
				]
			}
			{
				locname "archetype.easygoing.name"
				locdesc "archetype.easygoing.desc"

				traits [
					"trait-confident"
					"trait-lazy"
					"trait-forgiving"
				]
			}
			{
				locname "archetype.bossy.name"
				locdesc "archetype.bossy.desc"

				traits [
					"trait-organized"
					"trait-intelligent"
					"trait-unkind"
					"trait-boss"
				]
			}
			{
				locname "archetype.tough.name"
				locdesc "archetype.tough.desc"

				traits [
					"trait-slow"
					"trait-strong"
					"trait-confident"
				]
			}
			{
				locname "archetype.fragile.name"
				locdesc "archetype.fragile.desc"

				traits [
					"trait-weak"
					"trait-hardworking"
					"trait-friendly"
				]
			}
			{
				locname "archetype.antisocial.name"
				locdesc "archetype.antisocial.desc"

				traits [
					"trait-loner"
					"trait-irreverent"
					"trait-strong"
				]
			}
			{
				locname "archetype.pretty-dumb.name"
				locdesc	"archetype.pretty-dumb.desc"

				traits [
					"trait-attractive"
					"trait-slow"
					"trait-tall"
				]
			}
			{
				locname "archetype.underestimated.name"
				locdesc "archetype.underestimated.desc"

				traits [
					"trait-ugly"
					"trait-short"
					"trait-intelligent"
				]
			}
			{
				locname "archetype.terrorist.name"
				locdesc "archetype.terrorist.desc"

				traits [
					"trait-immoral"
					"trait-vindictive"
					"trait-agile"
				]
			}
		]
	}

	victory {
		endHeadline			"newspaper-headline.prohibition-ends"
		endPhoto 			{ sprite "New Crew 1" }

		territoryControl	0.30
		numberOfCaptains	7
		numberOfAffiliates	25
		numberOfSchemes		20
		numberOfCasinos		1
		goonsNeutralized	0.50
		gangsEliminated		0.50
