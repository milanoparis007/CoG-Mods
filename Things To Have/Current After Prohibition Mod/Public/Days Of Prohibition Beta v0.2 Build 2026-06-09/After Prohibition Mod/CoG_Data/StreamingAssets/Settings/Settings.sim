{ general {
	debug { 
	;	skipSwoop #true
	;	skipDecos #true
		;skipStarterQuests #true
		;showdebugZoneColors #true
		forceRandomSeed 3366
		forcePacks [ deluxe preorder atlantic-city criminal-record ethpackde ethpackir ethpackit ethpackpl ethpacken shadow-government ]
		;showGoonsAtStartup #true
		;ignoreSeasons #true
		;powerfulGuns #true
		;startingTrucks 1
		;disableIndirectInstancing #true

		;dumpModCount #true
		;dumpModSkills #true
		;dumpBizCount #true
		;dumpAIStatsOnExit #true
		;dumpTraits #true
		;runOnlyAIUntil 1928
	}

	visuals {
		;; vsync: 0 = off, 1 = sync every frame (usually 60hz, depends on hardware), 
		;         2 = every second frame (usually 30hz), and so on up to 4.
		;forceVsync 1
		
		;; fps limit: if vsync is off, 0 = highest possible, # = target desired fps. 
		;;            if vsync is on, this value is ignored and vsync fps is used.
		;forceFPSLimit 60
	}

	trains {
		allowRailOverWater #true
		
		terminalEdgeMinDistance 39
		exitEdgeMaxDistance 10
		exitLateralMaxDistance 50
		otherTerminalMinDistance 30

		randomRegionRetries 15
		randomRailRetries 20
		railConnectionsRetries 60
		
		path {
			defaultCost 1
			unitDistanceCost 100
			sharedTrackCostMultiplier 0.33
			edgeTrackCostMultiplier 2

			headingChangePenalty 4
			expensiveEdgeWidth 10
		}
	}

