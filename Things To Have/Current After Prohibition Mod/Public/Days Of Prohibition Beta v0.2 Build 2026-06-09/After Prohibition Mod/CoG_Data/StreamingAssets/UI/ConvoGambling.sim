{
	convos {

	;; conversations with the manager of a casino
		gambling-manager-toplevel {
			npcsays [
			    { lockey "convo.gambling.needs-money" reqs [ { #type check-gambling-house-in-debt delta negative } ] }
				{ lockey "convo.gambling.debtors" reqs [ { #type check-gambling-house-has-debtors } ] }
			{ #type rel-history-with-other-blurb reqs [{ #type check-peep-has-npc-history }] }
			{ #type rel-history-blurb reqs [{ #type check-peep-has-player-history }] }
			{ #type toplevel-start-blurb rootkey "convo.toplevel-start" reqs [{ #type special-toplevel-start firststate #true }] }
			{ #type relationship-based-blurb rootkey "convo.toplevel-state" }
				{ lockey "convo.gambling.excess" reqs [ { #type check-gambling-house-in-debt delta positive } ] }
				{ lockey "convo.gambling.basic" }
			]

			buttons [
				{
					text	{ key "convo.gambling.collect.human" npc "convo.gambling.collect.npc" }

					onShow	StoreCasinoInformation
					onClick ShowTransferMoneyPopup
				}
				{
					visreqs [{ #type check-casino-has-bannable-gamblers }]
					text { key "convo.gambling.ban-gambler.human-start"}

					onShow StoreCasinoInformation

					next { goto gambling-manager-ban-select }
				}
				{	
					visreqs [
						 { #type check-module-in-convo has any of [ home-small home-large ] }
			                        ]
					reqs 	[
						 { #type check-owner-relbuffs has none of [ relbuff-gangs-leisure-table-on-finish ] }
						 ]

					text 	{ key "convo.crew-leisure.human" icon "quest.crewleisure.icon" }
					next	{ goto crew-leisure }
				}
				{	
					visreqs [
						 { #type check-module-in-convo has any of [ brothel-house brothel-fancy ] }
			                        ]
					reqs 	[
						 { #type check-owner-relbuffs has none of [ relbuff-gangs-leisure-table-on-finish ] }
						 ]

					text 	{ key "convo.crew-leisure2.human" icon "quest.crewleisure2.icon" }
					next	{ goto crew-leisure2 }
				}
				{	
					visreqs [
						 { #type check-module-in-convo has any of [ brothel-house brothel-fancy ] }
 						 { #type check-player-skills has any of [ talent-scout ] }
			                        ]
					reqs 	[
						 { #type check-owner-relbuffs has none of [ relbuff-gangs-leisure-table-on-finish ] }
						 ]

					text 	{ key "convo.crew-leisure3.human" icon "quest.crewleisure2.icon" }
					next	{ goto crew-leisure3 }
				}
				;; please heal me!
				{	
					visreqs	[{ #type check-should-prompt-heal }]
					text 	{ key "convo.gambling.heal-ok-button" icon "ui.pipicon.heal-prompt"
							  npc "convo.initiative-heal-ok-npc" }

					onClick ExecuteHealReward
					next { goto gambling-manager-toplevel }
				}
				{
					text { key "convo.gambling.nothing-button" icon "convo.icon-leave" }

					onClick Goodbye
				}
			]
		}

		gambling-manager-ban-select {
			npcsays [ { lockey "convo.gambling.ban-gambler.npc-start" }]

			dynamicButtons CustomGamblerBanButtons
			dynamicTemplate {
				text { key "convo.aaaaaaa"} ;; determined at runtime

				next { goto gambling-manager-ban-confirm }
			}

			buttons [
				{
					text { key "convo.gambling.back-button" icon "convo.icon-back" }

					next { goto gambling-manager-toplevel }
				}
			]
		}

		crew-leisure {
			npcsays [{ lockey "convo.gangs.leisure-price.npc" }]
			buttons [{ 
				reqs 	[{ #type check-convo-actions has enough }{ #type check-player-cash type current is morethan value 500 }
					{ #type check-module-in-convo has any of [ home-small home-large ] }
				]
				text 	{ key "convo.gangs.leisure-price.yes" 
				 		 npc "convo.gangs.leisure.yes-epi" 
				 		 icon "convo.icon-check"
				}
				grants [
		 			{ #type add-rel-buff with player id "relbuff-gangs-leisure-table-on-finish" }
		 			{ #type add-rel-buff with player id "relbuff-gangs-leisure-buff" }
					{ #type consume-actions all #true }
					{ #type add-resource id streetcredit qty 1 at safehouse }
					{ #type add-xp delta 125 }
					{ #type add-cash amount -500 at crew }] 
				}
				{	;; goodbye
					text { key "convo.gangs.fight.cancel" icon "convo.icon-leave" mo "convo.goodbye-button.mo" }
						onClick	Goodbye
				}
			]
		}

		crew-leisure2 {
			npcsays [{ lockey "convo.gangs.leisure2-price.npc" }]
			buttons [{ 
				reqs 	[{ #type check-convo-actions has enough }{ #type check-player-cash type current is morethan value 120 }
					{ #type check-module-in-convo has any of [ brothel-house brothel-fancy ] }
				]
				text 	{ key "convo.gangs.leisure2-price.yes" 
				 		 npc "convo.gangs.leisure2.yes-epi" 
				 		 icon "convo.icon-check"
				}
				grants [
		 			{ #type add-rel-buff with player id "relbuff-gangs-leisure-table-on-finish" }
		 			{ #type add-rel-buff with player id "relbuff-gangs-leisure-buff" }
					{ #type consume-actions all #true }
					{ #type add-xp delta 20 }
					{ #type add-cash amount -120 at crew }] 
				}
				{	;; goodbye
					text { key "convo.gangs.fight.cancel" icon "convo.icon-leave" mo "convo.goodbye-button.mo" }
						onClick	Goodbye
				}
			]
		}

		crew-leisure3 {
			npcsays [{ lockey "convo.gangs.leisure3-price.npc" }]
			buttons [{ 
				reqs 	[{ #type check-convo-actions has enough }{ #type check-player-cash type current is morethan value 350 }
					{ #type check-module-in-convo has any of [ brothel-house brothel-fancy ] }
				]
				text 	{ key "convo.gangs.leisure3-price.yes" 
				 		 npc "convo.gangs.leisure3.yes-epi" 
				 		 icon "convo.icon-check"
				}
				grants [
		 			{ #type add-rel-buff with player id "relbuff-gangs-leisure-table-on-finish" }
		 			{ #type add-rel-buff with player id "relbuff-gangs-leisure-buff" }
					{ #type consume-actions all #true }
					{ #type add-resource id streetcredit qty 1 at safehouse }
					{ #type add-resource id exdancers qty 2 at safehouse }
					{ #type add-xp delta 80 }
					{ #type add-cash amount -350 at crew }] 
				}
				{	;; goodbye
					text { key "convo.gangs.fight.cancel" icon "convo.icon-leave" mo "convo.goodbye-button.mo" }
						onClick	Goodbye
				}
			]
		}

		gambling-manager-ban-confirm {
			npcsays [{ lockey "convo.gambling.ban-gambler.npc-confirm"} ]

			buttons [
				{
					text { key "convo.gambling.ban-gambler.human-confirm"}

					onClick	ExecuteBanGambler

					;; ExecuteBanGambler ends the conversation, hence no next.
				}
				{
					text { key "convo.gambling.back-button" icon "convo.icon-back" }

					next { goto gambling-manager-toplevel }
				}
			]
		}


		;; This is identical to above, but without a return button. This is because if they hit return, they will be in an invalid state.
		gambling-manager-ban-confirm-special {
			npcsays	[{ lockey "convo.gambling.ban-gambler.npc-confirm"} ]

			buttons [
				{
					text { key "convo.gambling.ban-gambler.human-confirm"}

					onClick ExecuteBanGambler

					;; ExecuteBanGambler ends the conversation, hence no next.
				}
			]
		}

	;; conversations with a debtor

	debtor-toplevel {
		npcsays [ { #type debtor-convo-blurb ctx Intro} ]

		buttons [ 
			{
				text { 
					dynkey [{ #type debtor-convo-blurb ctx HumanBlurb }]
				}

				next { goto debtor-intermediary }
			}
			{
				text { key "convo.gambling.debtor.nevermind" icon "convo.icon-back" }

				onClick Goodbye
			}
		]
	}

	debtor-intermediary {
		npcsays	[ { #type debtor-convo-blurb ctx NPCBlurb} ]

		buttons [
			{
				text { key "convo-repayment.pay-cash.humanblurb" 
					   mo  "convo-repayment.pay-cash.humanblurb.mo" }

				onShow	StorePayCashRepayment

				next	{ goto debtor-demand-cash }
			}
			{
				text { 
					dynkey [{ #type debtor-convo-blurb ctx BeforeChoice }]
					mo "convo-debt.any.beforechoice.mo"
				}

				onShow StoreDebtorRepayments

				next { goto debtor-repayments }
			}
			{
				visreqs [{ #type check-gambler-has-next-level-of-credit }]

				reqs [{ #type check-can-clear-gambler-debt }]

				text { key "convo-repayment.extend-credit.humanblurb" 
					   mo  "convo-repayment.extend-credit.humanblurb.mo" }

				onShow StoreDebtorRepayments ;; This is just to gain access to the replacements for now.

				next { goto debtor-extend-credit }
			}
			{
				text { key "convo.gambling.debtor.nevermind" icon "convo.icon-back" }

				onClick Goodbye
			}
		]
	}

	debtor-repayments {
		npcsays	[{ lockey "convo-debt.response" }]

		dynamicButtons	CustomDebtRepaymentButtons
		dynamicTemplate {
			text	{ key "convo.aaaaaaaaaaa" } ;; determined at runtime

			next { goto debtor-repayments-step2 }
		}

		buttons [
				{
					text	{ key "convo.ticket-back-button" icon "convo.icon-back" }
					next	{ goto debtor-toplevel }
				}
			]
		}

	debtor-repayments-step2 {
		npcsays	[{ #type debtor-repayment-step-blurb ctx NPCIntro }]

		buttons[
			{
				text { dynkey	[{ #type debtor-repayment-step-blurb ctx HumanBlurb }] }
				next { goto debtor-repayment-confirm }
			}
		]
		}

	debtor-repayment-confirm
		{
			npcsays	[{ #type debtor-repayment-step-blurb ctx NPCAccept }]

			buttons[
				{
					text {
						dynkey	[{ #type debtor-repayment-step-blurb ctx HumanAccept }]
						mo   "convo-repayment.generic.confirm.mo"
						icon "convo.icon-repayment-confirm"
					}

					onClick	DoAttachRepayment
				}
				{
					text	{ key "convo.ticket-back-button" icon "convo.icon-back" }
					next	{ goto debtor-toplevel }
				}
			]
		}


	debtor-demand-cash
	{
		npcsays	[{ lockey "convo-repayment.pay-cash.npcaccept" }]

		buttons [
			{
				text	{ 
					key "convo-repayment.pay-cash.humanaccept" 
					mo   "convo-repayment.generic.confirm.mo"
					icon "convo.icon-repayment-confirm"
				}

				onClick	DoAttachPayCash

				next 	{ goto debtor-toplevel }
			}
			{
				text	{ key "convo.ticket-back-button" icon "convo.icon-back" }
				next	{ goto debtor-toplevel }
			}
		]
	}

	debtor-extend-credit
	{
		npcsays	[{ lockey "convo-repayment.extend-credit.npcaccept" }]

		buttons	[
			{
				text	{ 
					key "convo-repayment.extend-credit.humanaccept" 
					mo   "convo-repayment.generic.confirm.mo"
					icon "convo.icon-repayment-confirm"
				}

				onClick	ExecuteExtendCredit

				grants 	[ { #type add-social-action id debtor-extend-credit } ]
				next	{ goto debtor-toplevel }
			}
			{
				text	{ key "convo.ticket-back-button" icon "convo.icon-back" }
				next	{ goto debtor-toplevel }
			}
		]
	}

	;; different toplevels for repayment statuses

		repayment-pending-toplevel 
		{
			npcsays	[{ lockey "convo-debt.repayment-pending" }]

			buttons [
				{
					onShow StorePendingRepayment

					text { key "convo.gambling.debtor.repayment-not-ripe" icon "convo.icon-back" }

					onClick Goodbye
				}
			]
		}

		repayment-ready-toplevel
		{
			npcsays	[{ lockey "convo-debt.repayment-ready" }]
			buttons [
				{
					text { key "convo-debt.repayment-ready.human" }

					onClick DoExecuteGrantsOnRepayment

					grants 	[ { #type add-social-action id debtor-payother } ]
				}
				{
					text { key "convo.gambling.debtor.nevermind" icon "convo.icon-back" }

					onClick Goodbye
				}
			]
		}

		repayment-fail-toplevel
		{
			npcsays	[{ lockey "convo-debt.repayment-fail" }]
			buttons [
				{
					text { key "convo-debt.repayment-fail.human" }

					onClick DoCleanupGamblerOnFail
				}
			]
		}

		repayment-cash-toplevel
		{
			npcsays	[{ lockey "convo-debt.repayment-cash" }]
			buttons	[
				{
					text { key "convo-debt.repayment-cash.human-less" }

					onClick ExecuteRepayCashLess

					grants 	[ { #type add-social-action id debtor-paycash-some } ]
				}
				{
					text { key "convo-debt.repayment-cash.human-full" }

					next { goto repayment-cash-full }
				}
				{
					text { key "convo.ticket-back-button" icon "convo.icon-back" }
					
					onClick Goodbye
				}
			]
		}

		repayment-cash-full
		{
			npcsays [{ lockey "convo-debt.repayment-cash.npc-full" }]
			buttons [
				{
					text { key "convo-debt.repayment-cash.human-full.epilogue" }

					onClick ExecuteRepayCashFull

					grants 	[ { #type add-social-action id debtor-paycash-full } ]
				}
			]
			
		}
	}
}