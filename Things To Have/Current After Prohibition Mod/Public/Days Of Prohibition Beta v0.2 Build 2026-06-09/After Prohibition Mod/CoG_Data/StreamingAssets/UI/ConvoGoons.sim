;; TICKET SPEND
;; call in a favor

goon-redeem-favor-owed {
	npcsays [ { #type rel-type-blurb to player keyroot "convo.ticket-group-soc-npc" } ]

	buttons [
	{	;; 		"need your support with a common friend"
		text 	{ key "convo.ticket-npcboost-button" icon "ui.pipicon.social" addmo #true }

		reqs 	[{ #type check-npc-knows-common-friend }]
	  	onClick ShowTicketBoostPopup
		;; next state will be advanced in code
	}
	{	;; 		"never mind"
		text 	{ key "convo.ticket-back-button" icon "convo.icon-back" }
		next 	{ goto goon-toplevel }
	}
] }

;; ticket boost - got one
goon-ticket-npcboost-confirm {
	; NPC SAYS "we both know X"
	npcsays [{ lockey "convo.ticket-npcboost-confirm-npc" }]
	buttons [
	{	;; 		"let's do it"
		text 	{ key "convo.ticket-npcboost-confirm-button" 
				  npc "convo.ticket-npcboost-epilogue-npc" }

		onClick  ExecuteTicketBoost
		grants	[{ #type consume-tickets count 1 }
			{ #type consume-actions for convo }
			{ #type add-xp source from-social }]
		next 	{ goto goon-toplevel }
	}
	{	;; 		"never mind"
		text 	{ key "convo.ticket-back-button" icon "convo.icon-back" }
		grants 	[{ #type center-camera-on-building }]
		next 	{ goto goon-toplevel }
	}
	]
}

;; ticket boost - nobody available
goon-ticket-npcboost-none {
	; NPC SAYS "i don't have anyone"
	npcsays [{ lockey "convo.ticket-npcboost-none-npc" }]
	buttons [
	{	;; 		"never mind"
		text 	{ key "convo.ticket-npcboost-none-button" }
		grants 	[{ #type center-camera-on-building }]
		next 	{ goto goon-toplevel }
	}
	]
}

goon-money-in {
	npcsays [{ lockey "convo.gangs.dirtycash1b-price.npc" }]
	buttons [{ 
		reqs 	[{ #type check-player-cash type current is morethan value 550 }]
		text 	{ key "convo.gangs.dirtycash1b-price.yes" 
				  npc "convo.gangs.dirtycash1-price.yes-epi" 
				  icon "convo.icon-check"
				}
		grants [{ #type consume-actions all #true }
		 { #type add-rel-buff with player id "relbuff-gangs-loot5-table-on-finish" }
		 { #type add-heat-buff-at-node id "heatbuff-gangs-loot1-table-on-finish" instant #true }
		 { #type add-rel-buff with player id "relbuff-gangs-loot1-buff" }
		{ #type add-resource id streetcredit qty 2 at safehouse }
		{ #type add-xp delta 50 }
		{ #type add-cash amount -550 at safehouse }
		{ #type add-resource id dirty-cash qty 700 at safehouse }]
		next 	{ goto goon-toplevel }
	}
	{	;; goodbye
		text { key "convo.gangs.fight.cancel" icon "convo.icon-leave" mo "convo.goodbye-button.mo" }
		onClick	Goodbye
		next 	{ goto goon-toplevel }
	}
	]
}

;; ticket goon intro
	ticket-goonin-boost-start {
		npcsays [{ lockey "convo.ticket-boost.goon.start.blurb" }]
		buttons [
		{
			text 	{ key "convo.ticket-boost.goon.start.button" }
			onClick	ExecuteNPCSelectionZoom
			next	{ goto ticket-goonin-boost-tell-more }
		}
		]
	}
	
	ticket-goonin-boost-tell-more {
		npcsays [{ lockey "convo.ticket-boost.goon.tell-more.blurb" }]
		buttons [
		{	;; 		"let's do it"
			text 	{ key "convo.ticket-boost.goon.tell-more.button" }

			onClick ExecuteTicketGoonBoost
			grants	[
					 { #type consume-actions for convo }
					 { #type add-xp source from-social }]

			;; no next - restart from top level
		}
		{	;; 		"never mind"
			text 	{ key "convo.ticket-back-button" icon "convo.icon-back" }
			grants  [{ #type center-camera-on-building }]
			next 	{ goto goon-toplevel }
		}
		]
	}

} }