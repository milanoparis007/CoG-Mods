	{
		ident { template road-or-rail-base }
		board {
			canBeStretchedToSize #true
		}
		selection {
			onfocus none
			onaction none
		}
		model {
			loadtype immediate
		}
	}
	{
		ident { template road-edge parent road-or-rail-base }
