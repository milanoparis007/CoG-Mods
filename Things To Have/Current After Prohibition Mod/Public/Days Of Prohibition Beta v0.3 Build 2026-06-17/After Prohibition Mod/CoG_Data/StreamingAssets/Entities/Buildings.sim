				{ zone res appeal 0.8 templates [ "res-med-sixflat" ] }
				{ zone res appeal 0.0 templates [ "res-med-sixflat" "res-low-tenement-medium-nyc" ] }
				{ zone com templates [ 
					"com-medium-store-one" "com-medium-restaurant-one" 
					"com-medium-store-two" "com-medium-restaurant-two" "com-medium-amusements" "com-medium-theater" 
					"com-medium-gas-station" "com-medium-dealership" "com-medium-dealership-fancy" "downtown-medium-commercial" "com-medium-store-jewelry"
				] }
				{ zone ind templates [ "ind-med-shop" "ind-med-deliver" "ind-medium-factory" "ind-medium-outdoor" "industrial-zone-medium" ]}
			]
			boardwalk [
				{ zone com templates [ "com-medium-boardwalk-one" ] }
				{ zone ind templates [ "com-medium-boardwalk-one" ] }
				{ zone res templates [ "res-medium-boardwalk" ] }
			]
