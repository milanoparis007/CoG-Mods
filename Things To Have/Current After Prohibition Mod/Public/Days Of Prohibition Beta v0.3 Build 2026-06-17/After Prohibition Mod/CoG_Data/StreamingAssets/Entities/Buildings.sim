	;; lots of lots

	{
		ident { template empty-lot-base tags [ empty-lot ] }
		board { }
		selection {
			onfocus showinfo
			onaction building
		}
		;;model { 
		;;	paletterow 3 
		;;	loadtype building
		;;}

	}
	{
		ident { template empty-lot-12 parent empty-lot-base }
		board { lotsize { width 1 height 3 } }
		lot { 
			lotdecos [
				{ zone com templates [ "lotdeco-sl-abandoned-other" "lotdeco-sl-clutter" ] }
				{ zone ind templates [ "lotdeco-sl-abandoned-other" "lotdeco-sl-clutter" "lotdeco-sl-construction" ] }
				{ zone res appeal 0.6 templates [ "lotdeco-sl-park-a" "lotdeco-sl-park-b" "lotdeco-sl-park-a" "lotdeco-sl-park-b" "cemetery-small" ] }
				{ zone res appeal 0.0 templates [ "lotdeco-sl-abandoned-res" "lotdeco-sl-construction" "lotdeco-sl-clutter" "lotdeco-sl-clutter" ] }
			]
			upgrades [
				{ zone res appeal 1.0 templates [ 
					"res-hi-large-house-pitt" 
					"res-hi-large-house-cin"
					"res-hi-detroit-tudor"
				] }
				{ zone res appeal 0.8 templates [ 
					"res-hi-graystone" "res-hi-fourflat"
					"res-med-bungalow" "res-med-twoflat" "res-med-threeflat" "res-med-brownstone"
					"res-med-sided-house-pitt" "duplex-pittsburgh" 
					"res-med-bungalow-cincinnati" "italianate-two-story" "italianate-three-story"
					"res-med-bungalow-detroit" "detroit-house" "res-hi-detroit-tudor"
				] }
				{ zone res appeal 0.0 templates [ "res-med-bungalow" "res-med-twoflat" "res-med-threeflat" "res-med-brownstone" "res-low-cottage" "res-low-cottage-detroit" "res-med-sided-house-pitt" 
				"res-low-tenement-small" "res-low-tenement-small-pittsburgh" "res-low-tenement-small-cincinnati" "res-low-tenement-small-detroit"
				 "res-low-tenement-small-nyc" "res-med-sided-house-pitt" "duplex-pittsburgh" "res-med-bungalow-detroit" "detroit-house" "res-hi-detroit-tudor" ] }
				{ zone com templates [ "com-small-store-one" "com-small-store-two" "com-small-restaurant-one" "com-small-restaurant-two" ]}
				{ zone ind templates [ "ind-small-auto" "ind-small-factory" "ind-small-delivery" ]}
			]
			boardwalk [
				{ zone com templates [ "com-small-boardwalk-one" ] }
				{ zone ind templates [ "com-small-boardwalk-one" ] }
				{ zone res templates [ "res-small-boardwalk" ] }
			]
		}
		;;model { prefabs [ "Testing/Prefabs/testlot model 1x2" ] }
	}
	{
		ident { template empty-lot-22 parent empty-lot-base }
		board { lotsize { width 2 height 3 } }
		lot { 
			lotdecos [
				{ zone res appeal 0.2 templates [ "lotdeco-ml-park-a" "lotdeco-ml-park-a" "lotdeco-ml-park-a" "cemetery-medium"] }
				{ zone com appeal 0.0 templates [ "parking-lot" ] }
				{ zone ind appeal 0.0 templates [ "parking-lot" ] }
			]
			upgrades [
