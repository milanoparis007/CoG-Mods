{ entities [

	{
		ident { template corner-tmpl }
		corner { }
		selection { onfocus showinfo onaction corner }
	}

	{
		ident { template building-base }
		board { 
			discoverable #true
			colliderHeight 2
		}
		building { }
		selection {
			onfocus showinfo
			onaction building
		}
		model { 
			paletterow 0
			paletterowunknown 2
			loadtype building
			indirectInstancing #true
		}
	}
	{
		ident {
			template res-base
			parent building-base
			tags [ building res ]
		}
		building { type res }
		model { 
			paletterow 0
			paletterowunknown 2
		}
		residence { }
		modules { 
			slots [
				{ tags [ tag-inventory-small ] }
				{ tags [ tag-res-gambling ] }
			]
		}
	}

	;; Track "low end"

	;; SMALL

	{
		ident { template res-low-cottage parent res-base }
		model {
			slots {
				core [
					{ model "Buildings/Resd/Bldg_Cottage1_Core_A" }
					{ model "Buildings/Resd/Bldg_Cottage1_Core_B" }
				]
				facade [
					{ model "Buildings/Resd/Bldg_Cottage1_Front_A" }
					{ model "Buildings/Resd/Bldg_Cottage1_Front_B" }
					{ model "Buildings/Resd/Bldg_Cottage1_Front_C" }
				]
				decofront [
					{ model "Buildings/Resd/Bldg_Cottage1_Props_A" }
					{ model "Buildings/Resd/Bldg_Cottage1_Props_B" }
					{ model "Buildings/Resd/Bldg_Cottage1_Props_C" }
				]
				decoback [
					{ model "Buildings/Resd/Bldg_Cottage1_Back_A" }
					{ model "Buildings/Resd/Bldg_Cottage1_Back_B" }
				]
				; dynamic [
				; ]
			}
			unknownslots {
				core [
					{ model "Buildings/Unknown/Bldg_UndiscoveredS1_Core_A" }
					{ model "Buildings/Unknown/Bldg_UndiscoveredS1_Core_B" }
				]
				facade [
					{ model "Buildings/Unknown/Bldg_UndiscoveredS1_Front_A" }
					{ model "Buildings/Unknown/Bldg_UndiscoveredS1_Front_B" }
				]
				decofront [
				]
				decoback [
					{ model "Buildings/Unknown/Bldg_UndiscoveredS1_Back_A" }
					{ model "Buildings/Unknown/Bldg_UndiscoveredS1_Back_B" }
				]
			}
			prefabs [ ] 
			unknowns [ ]
		}
		board { 
			lotsize { width 1 height 3 } 
			colliderHeight 0.5
			reqsToUseAsUpgrade [ { #type check-current-city is none of [ philadelphia pittsburgh detroit new-york ] } ]
		}
		building { 
			aoepop 5
		}
		residence { 
			locname	"building.residence-cottage.locname"
			locdesc	"building.residence-cottage.locdesc"
			apartments 3
		}
	}
	{
		ident { template res-low-cottage-detroit parent res-med-bungalow-detroit }
		building { 
			aoepop 5
		}
		residence { 
			locname	"building.residence-cottage.locname"
			locdesc	"building.residence-cottage.locdesc"
			apartments 3
		}
	}	
	{
		ident { template res-low-tenement-small parent res-base }
		model {
			slots {
				core [
					{ model "Buildings/Resd/Bldg_TenementS1_Core_A" }
					{ model "Buildings/Resd/Bldg_TenementS1_Core_B" }
				]
				facade [
					{ model "Buildings/Resd/Bldg_TenementS1_Front_A" }
					{ model "Buildings/Resd/Bldg_TenementS1_Front_B" }
					{ model "Buildings/Resd/Bldg_TenementS1_Front_C" }
				]
				decofront [
					{ model "Buildings/Resd/Bldg_TenementS1_Props_A" }
					{ model "Buildings/Resd/Bldg_TenementS1_Props_B" }
					{ model "Buildings/Resd/Bldg_TenementS1_Props_C" }
				]
				decoback [
					{ model "Buildings/Resd/Bldg_TenementS1_Back_A" }
					{ model "Buildings/Resd/Bldg_TenementS1_Back_B" }
				]
				; dynamic [
				; ]
			}
			unknownslots {
				core [
					{ model "Buildings/Unknown/Bldg_UndiscoveredS2_Core_A" }
					{ model "Buildings/Unknown/Bldg_UndiscoveredS2_Core_B" }
				]
				facade [
					{ model "Buildings/Unknown/Bldg_UndiscoveredS2_Front_A" }
					{ model "Buildings/Unknown/Bldg_UndiscoveredS2_Front_B" }
				]
				decofront [
				]
				decoback [
					{ model "Buildings/Unknown/Bldg_UndiscoveredS2_Back_A" }
					{ model "Buildings/Unknown/Bldg_UndiscoveredS2_Back_B" }
				]
			}
			prefabs [  ]
			unknowns [ ]
		}
		board { 
			lotsize { width 1 height 3 } 
			colliderHeight 1.5
			reqsToUseAsUpgrade [ { #type check-current-city is none of [ pittsburgh philadelphia cincinnati detroit new-york ] } ]
		}
		building { 
			aoepop 5
		}
		residence { 
			locname	"building.small-tenement.locname"
			locdesc	"building.small-tenement.locdesc"
			apartments 6
		}
	}


