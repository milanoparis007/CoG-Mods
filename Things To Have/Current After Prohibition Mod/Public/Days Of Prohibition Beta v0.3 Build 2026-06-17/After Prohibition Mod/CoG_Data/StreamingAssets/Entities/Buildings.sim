	;; commercial buildings

	{
		ident {
			template com-base
			parent building-base
			tags [ building com ]
		}
		building { type com aoepop 3 }
		delivery { }
		model { }
		modules { }
	}
	{
		ident { template com-small parent com-base }
		board { 
			lotsize { width 1 height 3 } 
			colliderHeight 1
		}
		building { }
		model {
			slotOverrides {
				matchingRowShort {
					core [
						{ model "buildings/Com/Bldg_BusinessfrontCont1_Core_A" }
						{ model "buildings/Com/Bldg_BusinessfrontCont1_Core_B" }
					]
					facade [
						{ model "buildings/Com/Bldg_BusinessfrontCont1_Front_A" }
						{ model "buildings/Com/Bldg_BusinessfrontCont1_Front_B" }
						{ model "buildings/Com/Bldg_BusinessfrontCont1_Front_C" }
					]
					decofront [
						{ model "buildings/Com/Bldg_BusinessfrontSStore_Props_A" }
						{ model "buildings/Com/Bldg_BusinessfrontSStore_Props_B" }
						{ model "buildings/Com/Bldg_BusinessfrontSStore_Props_C" }
						{ model "buildings/Com/Bldg_BusinessfrontSStore_Props_D" }
						{ model "buildings/Com/Bldg_BusinessfrontSStore_Props_E" }
					]
					decoback [
						{ model "buildings/Com/Bldg_BusinessfrontCont1_Back_A" }
						{ model "buildings/Com/Bldg_BusinessfrontCont1_Back_B" }
					]
				}
				matchingRowTall {
					core [
						{ model "buildings/Com/Bldg_BusinessfrontCont2_Core_A" }
						{ model "buildings/Com/Bldg_BusinessfrontCont2_Core_B" }
					]
					facade [
						{ model "buildings/Com/Bldg_BusinessfrontCont2_Front_A" }
						{ model "buildings/Com/Bldg_BusinessfrontCont2_Front_B" }
						{ model "buildings/Com/Bldg_BusinessfrontCont2_Front_C" }
					]
					decofront [
						{ model "buildings/Com/Bldg_BusinessfrontSStore_Props_A" }
						{ model "buildings/Com/Bldg_BusinessfrontSStore_Props_B" }
						{ model "buildings/Com/Bldg_BusinessfrontSStore_Props_C" }
						{ model "buildings/Com/Bldg_BusinessfrontSStore_Props_D" }
						{ model "buildings/Com/Bldg_BusinessfrontSStore_Props_E" }
					]
					decoback [
						{ model "buildings/Com/Bldg_BusinessfrontCont2_Back_A" }
						{ model "buildings/Com/Bldg_BusinessfrontCont2_Back_B" }
					]
				}
			}
		}
		modules {
			slots [
				{ tags [ tag-biz-front ] }
				{ tags [ tag-inventory-small ] }
				{ tags [ tag-biz-back ] }
			]
		}
	}
