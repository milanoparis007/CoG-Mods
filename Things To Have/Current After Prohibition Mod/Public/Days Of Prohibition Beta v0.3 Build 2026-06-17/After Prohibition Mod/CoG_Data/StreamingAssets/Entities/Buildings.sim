	}
	{
		ident { template res-low-tenement-medium-nyc parent res-low-tenement-medium }
		model {
			slots {
				core [
					{ model "Buildings/Resd/nyc/Bldg_TenementsMed_NYC_CoreD" }
					{ model "Buildings/Resd/nyc/Bldg_TenementsMed_NYC_CoreE" }
					{ model "Buildings/Resd/nyc/Bldg_TenementsMed_NYC_CoreF" }
				]
				facade [
					{ model "Buildings/Resd/nyc/Bldg_TenementsMed_NYC_FrontD" }
					{ model "Buildings/Resd/nyc/Bldg_TenementsMed_NYC_FrontE" }
					{ model "Buildings/Resd/nyc/Bldg_TenementsMed_NYC_FrontF" }
				]
				decofront [
					{ model "Buildings/Resd/nyc/Bldg_TenementsMed_NYC_PropD" }
					{ model "Buildings/Resd/nyc/Bldg_TenementsMed_NYC_PropE" }
					{ model "Buildings/Resd/nyc/Bldg_TenementsMed_NYC_PropF" }
				]
				decoback [
					{ model "Buildings/Resd/nyc/Bldg_TenementsMed_NYC_BackD" }
					{ model "Buildings/Resd/nyc/Bldg_TenementsMed_NYC_BackE" }
					{ model "Buildings/Resd/nyc/Bldg_TenementsMed_NYC_BackF" }
				]
			}
			slotOverrides {
				matchingRowShort {
					core [
						{ model "Buildings/Resd/nyc/Bldg_TenementsMed_NYC_CoreA" }
						{ model "Buildings/Resd/nyc/Bldg_TenementsMed_NYC_CoreB" }
						{ model "Buildings/Resd/nyc/Bldg_TenementsMed_NYC_CoreC" }
					]
					facade [
						{ model "Buildings/Resd/nyc/Bldg_TenementsMed_NYC_FrontA" }
						{ model "Buildings/Resd/nyc/Bldg_TenementsMed_NYC_FrontB" }
						{ model "Buildings/Resd/nyc/Bldg_TenementsMed_NYC_FrontC" }
					]
					decofront [
						{ model "Buildings/Resd/nyc/Bldg_TenementsMed_NYC_PropA" }
						{ model "Buildings/Resd/nyc/Bldg_TenementsMed_NYC_PropB" }
						{ model "Buildings/Resd/nyc/Bldg_TenementsMed_NYC_PropC" }
					]
					decoback [
						{ model "Buildings/Resd/nyc/Bldg_TenementsMed_NYC_BackA" }
						{ model "Buildings/Resd/nyc/Bldg_TenementsMed_NYC_BackB" }
						{ model "Buildings/Resd/nyc/Bldg_TenementsMed_NYC_BackC" }
					]
				}
				matchingRowTall {
					core [
						{ model "Buildings/Resd/nyc/Bldg_Tenement_CoreA" }
						{ model "Buildings/Resd/nyc/Bldg_Tenement_CoreB" }
						{ model "Buildings/Resd/nyc/Bldg_Tenement_CoreC" }
					]
					facade [
						{ model "Buildings/Resd/nyc/Bldg_Tenement_FrontA" }
						{ model "Buildings/Resd/nyc/Bldg_Tenement_FrontB" }
						{ model "Buildings/Resd/nyc/Bldg_Tenement_FrontC" }
					]
					decofront [
						{ model "Buildings/Resd/nyc/Bldg_Tenement_PropA" }
						{ model "Buildings/Resd/nyc/Bldg_Tenement_PropB" }
						{ model "Buildings/Resd/nyc/Bldg_Tenement_PropC" }
					]
					decoback [
						{ model "Buildings/Resd/nyc/Bldg_Tenement_BackA" }
						{ model "Buildings/Resd/nyc/Bldg_Tenement_BackB" }
						{ model "Buildings/Resd/nyc/Bldg_Tenement_BackC" }
					]
				}
			}
		}
		board { 
			colliderHeight 2
			reqsToUseAsUpgrade [ { #type check-current-city is any of [ new-york ] } ]
		}
		building { 
			aoepop 10
		}
		residence { 
			apartments 200
		}
	}

