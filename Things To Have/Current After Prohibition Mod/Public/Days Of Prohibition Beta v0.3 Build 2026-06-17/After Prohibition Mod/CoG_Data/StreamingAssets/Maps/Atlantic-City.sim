{ maps [ { 
	id atlantic-city
	citytype atlantic-city

	;; cityname "Chicago"  		;; let's use loc instead
	;; statename "Illinois"
	;; citydesc	"Story..."

	citylockey	"city-name.atlantic-city"
	statelockey	"state-name.new-jersey"
	citydesckey	"city-desc.atlantic-city"
	cityscreen	"Atlantic City Screenshot"
	citylocicon	"city-icon.atlantic-city"
	citypolunitkey	"city-pol-unit.ward"

	map {
		;; logical map specification
		mapSize        { width 700 height 400 } ;; size in world units
		;; heatmapSpacing { width 8 height 8 }  ;; should be similar or larger than smallest block size
		;; beadSpacing { width 1 height 1 }     ;; should be default (1, 1) unless there's a good reason :)

