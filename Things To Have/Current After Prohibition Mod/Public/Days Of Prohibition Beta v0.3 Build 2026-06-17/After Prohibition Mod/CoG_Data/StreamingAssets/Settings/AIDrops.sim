					locdesc "convo.goons.rewards.offer.blurb.business-entry.level-two-high"
					selectionweight { value 20 }
					expirationdayz { value 28 }
					cashbuyin { value -1000 mods [ { #type skills-mod if [ starter-goons ] multiplier 0.9 } ] }
					cashbuyinmultiplier { from 1 to 1.25 }
					readyafterdayz { value 35 }
					cooldowndayz { value 56 }
					visreqs [
						{ #type check-current-city is any of [ pittsburgh ] }
						{ #type check-player-unlocked-resources has all of [ fruit-brandy ] forcehuman #true }
						{ #type check-player-skills has any of [ small-speakeasy ] forcehuman #true }
						{ #type check-player-skills has none of [ bootleg-whiskey bootleg-vodka bootleg-brandy bootleg-rum ] forcehuman #true }
					]
					grants [  
						{ #type add-resource id fruit-brandy qty 70 at safehouse }
					]
				}
				{
					id biz-goon-corn-whiskey-lor
					locdesc "convo.goons.rewards.offer.blurb.business-entry.level-two"
					selectionweight { value 20 }
					expirationdayz { value 28 }
					cashbuyin { value -500 mods [ { #type skills-mod if [ starter-goons ] multiplier 0.9 } ] }
					cashbuyinmultiplier { from 1 to 1.25 }
					readyafterdayz { value 35 }
					cooldowndayz { value 56 }
					visreqs [
						{ #type check-current-city is any of [ cincinnati ] }
						{ #type check-player-produced-total resource corn-whiskey is lessthan value 1 forcehuman #true }
						{ #type check-player-unlocked-resources has all of [ corn-whiskey ] forcehuman #true }
						{ #type check-player-skills has none of [ bootleg-whiskey bootleg-vodka bootleg-brandy bootleg-rum ] forcehuman #true }
						{ #type check-player-skills has none of [ small-speakeasy ] forcehuman #true }
					]
					grants [  
						{ #type add-resource id corn-whiskey qty 35 at safehouse }
					]
				}
				{
					id biz-goon-corn-whiskey-highr
					locdesc "convo.goons.rewards.offer.blurb.business-entry.level-two-high"
					selectionweight { value 20 }
					expirationdayz { value 28 }
					cashbuyin { value -1000 mods [ { #type skills-mod if [ starter-goons ] multiplier 0.9 } ] }
					cashbuyinmultiplier { from 1 to 1.25 }
					readyafterdayz { value 35 }
					cooldowndayz { value 56 }
					visreqs [
						{ #type check-current-city is any of [ cincinnati ] }
						{ #type check-player-unlocked-resources has all of [ corn-whiskey ] forcehuman #true }
						{ #type check-player-skills has none of [ bootleg-whiskey bootleg-vodka bootleg-brandy bootleg-rum ] forcehuman #true }
						{ #type check-player-skills has any of [ small-speakeasy ] forcehuman #true }
					]
					grants [  
						{ #type add-resource id corn-whiskey qty 70 at safehouse }
					]
				}

				{	;; special "no-op" roll
					id loot-entry-none
					selectionweight { value 5 }
					cashbuyin { value 0.0 }
					;cashbuyinmultiplier { from 1.0 to 2.0 }
					expirationdayz { value 0 }
					readyafterdayz { value 0 }
					cooldowndayz { value 14 }
					visreqs []
				}
			]
		}

		;; default goon over here
		obstacle-goon {
			id obstacle-goon
			locintro "convo.ticket-boost.goon.flavor.obstacle-goon"
		}
	}

	}

	}
}