				{ #type manager-level-test-mod id levelup-mechanic is equalto value 2 multiplier 0.8 }
				{ #type manager-level-test-mod id levelup-mechanic is equalto value 3 multiplier 0.75 }
				{ #type manager-level-test-mod id levelup-mechanic is equalto value 4 multiplier 0.5 }
			] }

			;; heat generated
