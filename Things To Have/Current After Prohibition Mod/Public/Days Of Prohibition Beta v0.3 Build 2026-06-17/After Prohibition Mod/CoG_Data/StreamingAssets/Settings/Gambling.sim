	{
		id street-dice

		visreqs	[ ]
		reqs [ { #type check-player-skills has any of [ gambling-tables ] } ]

		locicon "amenity.street-dice.icon"
		locname	"amenity.street-dice.name"
		locdesc	"amenity.street-dice.desc"
		banner	"Amenity Dice Game"

		buildCost { value -150 mods [
			{ #type manager-level-test-mod id levelup-mechanic is equalto value 1 multiplier 0.9 }
			{ #type manager-level-test-mod id levelup-mechanic is equalto value 2 multiplier 0.8 }
			{ #type manager-level-test-mod id levelup-mechanic is equalto value 3 multiplier 0.75 }
			{ #type manager-level-test-mod id levelup-mechanic is equalto value 4 multiplier 0.5 }
		] }
		buildDayz { value 7 }

		minOperationCost { value 50 }
		recommendedFunds { value 100 }

		weeklyCost { value -5 mods [ 
			{ #type traits-mod-on-manager if [ trait-organized ] multiplier 0.9 }
			{ #type amenity-mod if [ chandeliers ] perAmenityMultiplier 0.8 }
			] }

		behavior {
			type Rake

			slots {
				slotCount { value 10 mods [ 
					{ #type amenity-mod if [ valet-parking ] perAmenityDelta 5 }
				] }
				slotFillChance { value 0.99 }
				slotDropChance { value 0.28 mods [ { #type amenity-mod if [ smoking-lounge ] perAmenityMultiplier 0.5 } ]}

				slotStartingCashMin { value 25 }
				slotStartingCashMax { value 300 }
			}

			rake {
				rakePercent { value 25 }
				rakeEdge	{ value 1 mods [
					{ #type traits-mod if [ trait-intelligent trait-quiet ] multiplier 1.5 }
					{ #type traits-mod if [ trait-sociable trait-myopic ] multiplier 0.9 }
					{ #type traits-mod if [ trait-cautious trait-confident trait-attractive trait-sharpeyed trait-aggressive] multiplier 1.1 }
					{ #type traits-mod if [ trait-slow trait-nervous trait-talkative ] multiplier 0.3 }
					]}
			}

			;; how much each customer spends per turn
			minBetPerPlayer { value 5 mods [
				{ #type traits-mod-on-manager if [ trait-hardworking trait-organized trait-intelligent trait-irreverent trait-attractive trait-strong ] multiplier 1.1 }
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 1 multiplier 1.1 }
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 2 multiplier 1.2 }
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 3 multiplier 1.3 }
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 4 multiplier 1.5 }
				{ #type manager-level-test-mod id levelup-brothel-mangager is equalto value 1 multiplier 1.1 }
				{ #type manager-level-test-mod id levelup-brothel-mangager is equalto value 2 multiplier 1.2 }
				{ #type manager-level-test-mod id levelup-brothel-mangager is equalto value 3 multiplier 1.3 }
				{ #type manager-level-test-mod id levelup-brothel-mangager is equalto value 4 multiplier 1.5 }
				{ #type amenity-mod if [ bar-small ] perAmenityMultiplier 1.1 }
				]
			}
			maxBetPerPlayer { value 25 mods [
				{ #type traits-mod-on-manager if [ trait-hardworking trait-organized trait-intelligent trait-irreverent trait-attractive trait-strong ] multiplier 1.1 }
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 1 multiplier 1.1 }
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 2 multiplier 1.2 }
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 3 multiplier 1.3 }
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 4 multiplier 1.5 }
				{ #type manager-level-test-mod id levelup-brothel-mangager is equalto value 1 multiplier 1.1 }
				{ #type manager-level-test-mod id levelup-brothel-mangager is equalto value 2 multiplier 1.2 }
				{ #type manager-level-test-mod id levelup-brothel-mangager is equalto value 3 multiplier 1.3 }
				{ #type manager-level-test-mod id levelup-brothel-mangager is equalto value 4 multiplier 1.5 }
				{ #type manager-level-test-mod id levelup-brothel-mangager is equalto value 5 multiplier 1.5 }
				{ #type amenity-mod if [ bar-small ] perAmenityMultiplier 1.1 }
				]
			}

			;; rake type doesn't have a win chance or multiplier! should be left as undefined

			heatPerPlayer { value 0.5 mods [ 
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 1 multiplier 0.9 }
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 2 multiplier 0.8 }
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 3 multiplier 0.75 }
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 4 multiplier 0.5 }
				{ #type manager-level-test-mod id levelup-brothel-mangager is equalto value 1 multiplier 0.9 }
				{ #type manager-level-test-mod id levelup-brothel-mangager is equalto value 2 multiplier 0.8 }
				{ #type manager-level-test-mod id levelup-brothel-mangager is equalto value 3 multiplier 0.75 }
				{ #type manager-level-test-mod id levelup-brothel-mangager is equalto value 4 multiplier 0.5 }
				{ #type manager-level-test-mod id levelup-house-manager is equalto value 1 multiplier 0.9 }
				{ #type manager-level-test-mod id levelup-house-manager is equalto value 2 multiplier 0.8 } 
				{ #type manager-level-test-mod id levelup-house-manager is equalto value 3 multiplier 0.75 }
				{ #type manager-level-test-mod id levelup-house-manager is equalto value 4 multiplier 0.5 }
