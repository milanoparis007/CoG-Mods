			{ #type manager-level-test-mod id levelup-brothel-manager is equalto value 1 multiplier 1.05 }
			{ #type manager-level-test-mod id levelup-brothel-manager is equalto value 2 multiplier 1.1 }
			{ #type manager-level-test-mod id levelup-brothel-manager is equalto value 3 multiplier 1.15 } 
			{ #type manager-level-test-mod id levelup-brothel-manager is equalto value 4 multiplier 1.2 } 
				{ #type amenity-mod if [ bar-small ] perAmenityMultiplier 1.1 }
				]}

			;; payout multiplier over bet if they win
			payoutMultiplier { value 0.5 }

			;; 1 = 1% customer wins, 99% house wins
			playerWinChancePercent { value 13 mods [
				{ #type traits-mod-on-manager if [ trait-organized trait-mellow trait-confident trait-irreverent trait-attractive trait-strong ] multiplier 0.9 }
				{ #type manager-level-test-mod id levelup-brothel-managerl is equalto value 1 multiplier 0.9 }
				{ #type manager-level-test-mod id levelup-brothel-managerl is equalto value 2 multiplier 0.8 }
				{ #type manager-level-test-mod id levelup-brothel-managerl is equalto value 3 multiplier 0.75 } 
				{ #type manager-level-test-mod id levelup-brothel-managerl is equalto value 4 multiplier 0.7 }
			] }

			;; heat generated

			heatPerPlayer { value 7 mods [ 
				{ #type manager-level-test-mod id levelup-brothel-managerl is equalto value 1 multiplier 0.9 }
				{ #type manager-level-test-mod id levelup-brothel-managerl is equalto value 2 multiplier 0.8 }
				{ #type manager-level-test-mod id levelup-brothel-managerl is equalto value 3 multiplier 0.75 } 
				{ #type manager-level-test-mod id levelup-brothel-managerl is equalto value 4 multiplier 0.4 }
			] }			

			;; customers supported -- ONLY NEEDED FOR AOE
			maxCustomers	{ value 45 mods [ 
				{ #type manager-level-test-mod id levelup-brothel-managerl is equalto value 4 multiplier 1.12 }
					{ #type manager-level-test-mod id levelup-hoods is equalto value 1 multiplier 1.12 }
					{ #type manager-level-test-mod id levelup-hoods is equalto value 2 multiplier 1.25 } 
					{ #type manager-level-test-mod id levelup-hoods is equalto value 3 multiplier 1.38 }
					{ #type manager-level-test-mod id levelup-hoods is equalto value 4 multiplier 1.51 }
			] }

		}
	}
	{ 	id fancy-brothelam

		visreqs [ { #type check-player-skills has any of [ fancy-brothels ] } { #type check-ethnicity is player oneof [ af ] }  ]
		reqs [ { #type check-player-skills has any of [ fancy-brothels ] } { #type check-ethnicity is player oneof [ af ] }  ]

		locicon "amenity.fancy-brothelam.icon"
		locname	"amenity.fancy-brothelam.name"
		locdesc	"amenity.fancy-brothelam.desc"
		banner	"Amenity Policy Game"
	
		buildCost { value -1200 mods [
		] } 
		buildDayz { value 21 }

		minOperationCost { value 250 }
		recommendedFunds { value 6000 }

		weeklyCost { value -40 mods [ 
			{ #type traits-mod-on-manager if [ trait-organized trait-mellow trait-confident trait-irreverent trait-attractive trait-strong ] multiplier 0.97 }
			{ #type amenity-mod if [ chandeliers ] perAmenityMultiplier 0.8 }
			{ #type manager-level-test-mod id levelup-brothel-manager is equalto value 1 multiplier 1 }
			{ #type manager-level-test-mod id levelup-brothel-manager is equalto value 2 multiplier 1.05 }
			{ #type manager-level-test-mod id levelup-brothel-manager is equalto value 3 multiplier 1.1 } 
			{ #type manager-level-test-mod id levelup-brothel-manager is equalto value 4 multiplier 1.1 } 
			] }

		behavior {
			type AOE

			slots {
				slotCount { value 0 }
			}

			;; how much each customer spends per turn
			minBetPerPlayer { value 5 mods [
			{ #type traits-mod-on-manager if [ trait-organized trait-mellow trait-confident trait-irreverent trait-attractive trait-strong ] multiplier 1.1 }
				{ #type amenity-mod if [ bar-small ] perAmenityMultiplier 1.1 }
			{ #type manager-level-test-mod id levelup-brothel-manager is equalto value 1 multiplier 1 }
			{ #type manager-level-test-mod id levelup-brothel-manager is equalto value 2 multiplier 1.15 }
			{ #type manager-level-test-mod id levelup-brothel-manager is equalto value 3 multiplier 1.2 } 
			{ #type manager-level-test-mod id levelup-brothel-manager is equalto value 4 multiplier 1.3 } 
				]}
			maxBetPerPlayer { value 10  mods [
			{ #type traits-mod-on-manager if [ trait-organized trait-mellow trait-confident trait-irreverent trait-attractive trait-strong ] multiplier 1.1 }
			{ #type amenity-mod if [ bar-small ] perAmenityMultiplier 1.1 }
			{ #type manager-level-test-mod id levelup-brothel-manager is equalto value 1 multiplier 1 }
			{ #type manager-level-test-mod id levelup-brothel-manager is equalto value 2 multiplier 1.15 }
			{ #type manager-level-test-mod id levelup-brothel-manager is equalto value 3 multiplier 1.2 } 
			{ #type manager-level-test-mod id levelup-brothel-manager is equalto value 4 multiplier 1.3 } 
				]}

			;; payout multiplier over bet if they win
			payoutMultiplier { value 0.5 }

			;; 1 = 1% customer wins, 99% house wins
			playerWinChancePercent { value 7 mods [
			{ #type traits-mod-on-manager if [ trait-organized trait-mellow trait-confident trait-irreverent trait-attractive trait-strong ] multiplier 0.8 }
				{ #type manager-level-test-mod id levelup-brothel-managerl is equalto value 1 multiplier 0.9 }
				{ #type manager-level-test-mod id levelup-brothel-managerl is equalto value 2 multiplier 0.8 }
				{ #type manager-level-test-mod id levelup-brothel-managerl is equalto value 3 multiplier 0.75 } 
				{ #type manager-level-test-mod id levelup-brothel-managerl is equalto value 4 multiplier 0.7 }
			] }

			;; heat generated

			heatPerPlayer { value 6 mods [ 
				{ #type manager-level-test-mod id levelup-brothel-managerl is equalto value 1 multiplier 0.9 }
				{ #type manager-level-test-mod id levelup-brothel-managerl is equalto value 2 multiplier 0.8 }
				{ #type manager-level-test-mod id levelup-brothel-managerl is equalto value 3 multiplier 0.75 } 
				{ #type manager-level-test-mod id levelup-brothel-managerl is equalto value 4 multiplier 0.4 }
			] }

			;; customers supported -- ONLY NEEDED FOR AOE
			maxCustomers	{ value 32 mods [ 
				{ #type manager-level-test-mod id levelup-brothel-managerl is equalto value 4 multiplier 1.25 }
					{ #type manager-level-test-mod id levelup-hoods is equalto value 1 multiplier 1.25 }
					{ #type manager-level-test-mod id levelup-hoods is equalto value 2 multiplier 1.5 } 
					{ #type manager-level-test-mod id levelup-hoods is equalto value 3 multiplier 1.75 }
					{ #type manager-level-test-mod id levelup-hoods is equalto value 4 multiplier 2 }
			] }

		}
	}

