		] }
		buildDayz { value 35 }

		minOperationCost { value 150 } ;; must be less than build cost :)
		recommendedFunds { value 500 }

		weeklyCost { value -8 mods [ 
			] }

		behavior {

			slots {
				slotCount { value 0 } ;; should always be 0 for AOE amenities
			}

			type AOE
			
			;; how much each customer spends per turn
			minBetPerPlayer { value 25 mods [
			{ #type amenity-mod if [ rentaldecor ] perAmenityMultiplier 1.1 }
