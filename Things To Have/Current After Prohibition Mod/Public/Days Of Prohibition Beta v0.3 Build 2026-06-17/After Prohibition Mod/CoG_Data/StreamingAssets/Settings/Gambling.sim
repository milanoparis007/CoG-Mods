	;;
	;; brothels and loansharks

	{ 	id loan-shark

		visreqs [ ]
		reqs [ { #type check-player-skills has any of [ moneylaundering ] } ]

		locicon "amenity.loan-shark.icon"
		locname	"amenity.loan-shark.name"
		locdesc	"amenity.loan-shark.desc"
		banner	"Amenity Table Games"
	
		buildCost { value -1500 mods [
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 1 multiplier 0.9 }
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 2 multiplier 0.8 } 
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 3 multiplier 0.75 }
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 4 multiplier 0.5 }
		] } 
		buildDayz { value 21 }

		minOperationCost { value 50 }
		recommendedFunds { value 100 }

		weeklyCost { value -145 mods [ 
			{ #type traits-mod-on-manager if [ trait-organized trait-mellow ] multiplier 0.8 }
			{ #type amenity-mod if [ chandeliers ] perAmenityMultiplier 0.8 }
			{ #type manager-level-test-mod id levelup-street-boss is equalto value 1 multiplier 1 }
			{ #type manager-level-test-mod id levelup-street-boss is equalto value 2 multiplier 1.1 } 
			{ #type manager-level-test-mod id levelup-street-boss is equalto value 3 multiplier 1.1 }
			{ #type manager-level-test-mod id levelup-street-boss is equalto value 4 multiplier 1.2 }
			] }

		behavior {
			type Slots

			slots {
				;; MODDED: Keep the low-level loan shark capped at 2 base debtor slots
				slotCount { value 2 mods [
					{ #type amenity-mod if [ valet-parking ] perAmenityDelta 2 }
					{ #type manager-level-test-mod id levelup-hoods is equalto value 1 multiplier 1.5 }
					{ #type manager-level-test-mod id levelup-hoods is equalto value 2 multiplier 2 }
					{ #type manager-level-test-mod id levelup-hoods is equalto value 3 multiplier 2.5 }
					{ #type manager-level-test-mod id levelup-hoods is equalto value 4 multiplier 3 }
				] }
				slotFillChance { value 0.99 mods [ { #type amenity-mod if [ bar-small ] perAmenityMultiplier 1.4 } ]}
				;; MODDED: Reduced drop chance from 0.32 to 0.15 to retain customers longer
				slotDropChance { value 0.15 }

				slotStartingCashMin { value 1000 }
				slotStartingCashMax { value 2200 }
			}

			;; how much each customer spends per turn
			minBetPerPlayer { value 30 mods [
				{ #type traits-mod-on-manager if [ trait-hardworking trait-organized trait-intelligent trait-mellow ] multiplier 1.2 }
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 1 multiplier 1.1 }
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 2 multiplier 1.2 } 
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 3 multiplier 1.2 }
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 4 multiplier 1.3 }
				{ #type amenity-mod if [ bar-small ] perAmenityMultiplier 1.1 }
				]}
			maxBetPerPlayer { value 100 mods [
				{ #type traits-mod-on-manager if [ trait-hardworking trait-organized trait-intelligent trait-mellow ] multiplier 1.2 }
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 1 multiplier 1.1 }
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 2 multiplier 1.2 } 
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 3 multiplier 1.2 }
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 4 multiplier 1.3 }
				{ #type amenity-mod if [ bar-small ] perAmenityMultiplier 1.1 }
				]}


			;; payout multiplier over bet if they win, 5 == 5x == 5:1 payout
			payoutMultiplier { value 15 }

			;; 1 = 1% customer wins, 99% house wins
			playerWinChancePercent { value 0 mods [
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 1 multiplier 1 }
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 2 multiplier 1 }
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 3 multiplier 1 }
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 4 multiplier 1 }
			] }

			;; heat generated
			heatPerPlayer { value 10 mods [ 
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 1 multiplier 0.9 }
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 2 multiplier 0.8 } 
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 3 multiplier 0.75 }
				{ #type manager-level-test-mod id levelup-street-boss is equalto value 4 multiplier 0.5 }
			] }
		}
	}
