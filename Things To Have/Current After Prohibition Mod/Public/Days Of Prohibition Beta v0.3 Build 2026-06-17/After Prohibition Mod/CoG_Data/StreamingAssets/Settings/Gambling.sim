{ gambling {

	startup {
		minCorners	{ value 10 mods [
			{ #type current-city-mod is any of [ atlantic-city ] check id-only delta -7 }
		] }

		casinosPerPrecinct	{ value 5 mods [
			{ #type current-city-mod is any of [ atlantic-city ] check id-only delta 2 }
			{ #type is-biz-in-territory id realtorsource expected #true delta 5 }
			{ #type law-mod laws [ casino ] enacted true }
		] }

		weeklyCostModifier { value 1 }

		sizeLabels [
			;; largest to smallest!
			{ min 100 key "convo.ticket-gambling-house.influence-large" }
			{ min 40 key "convo.ticket-gambling-house.influence-medium" }
			{ min 0 key "convo.ticket-gambling-house.influence-small" }
		]
	}

	bets {
		minBetModifier { value 1 mods [
			{ #type traits-mod if [ trait-cautious trait-nervous] multiplier 0.7 }
			]}

		maxBetModifier { value 1 mods [
			{ #type traits-mod if [ trait-confident ] multiplier 1.2}
			{ #type traits-mod if [ trait-careless ] multiplier 1.5}
			{ #type traits-mod if [ trait-mellow trait-cautious trait-nervous] multiplier 0.9}
			]}

		numMinBetsBeforeBan	10
	}

	aoe {
		customersPerPop { value 0.04 mods [ 
			{ #type same-ethnicity-at-node-mod multiplier 0.01 } 
			{ #type amenity-mod if [ plush-carpets ] perAmenityMultiplier 1.2 }
			{ #type amenity-mod if [ imported-furniture ] perAmenityMultiplier 1.5 } 
		] }
		estimatedStartAOE	30
	}

	amenityDefs [
	{ 	id slot-machines

		visreqs []
		reqs []

		locicon "amenity.slot-machines.icon"
		locname	"amenity.slot-machines.name"
		locdesc	"amenity.slot-machines.desc"
		banner	"Amenity Roulette"
	
		buildCost { value -1000 mods [
			{ #type manager-level-test-mod id levelup-mechanic is equalto value 1 multiplier 0.9 }
			{ #type manager-level-test-mod id levelup-mechanic is equalto value 2 multiplier 0.8 }
			{ #type manager-level-test-mod id levelup-mechanic is equalto value 3 multiplier 0.75 }
			{ #type manager-level-test-mod id levelup-mechanic is equalto value 4 multiplier 0.5 }
		] }
		buildDayz { value 35 }

		minOperationCost { value 500 } ;; must be less than build cost :)
		recommendedFunds { value 600 }

		weeklyCost { value -5 mods [
			{ #type traits-mod-on-manager if [ trait-organized ] multiplier 0.9 }
			{ #type amenity-mod if [ chandeliers ] perAmenityMultiplier 0.8 }
			{ #type manager-level-test-mod id levelup-house-manager is equalto value 1 multiplier 0.9 }
			{ #type manager-level-test-mod id levelup-house-manager is equalto value 2 multiplier 0.8 } 
			{ #type manager-level-test-mod id levelup-house-manager is equalto value 3 multiplier 0.75 }
			{ #type manager-level-test-mod id levelup-house-manager is equalto value 4 multiplier 0.5 }
		]}

		behavior {

			slots {
				slotCount { value 0 } ;; should always be 0 for AOE amenities
			}

			type AOE
			
			;; how much each customer spends per turn
			minBetPerPlayer { value 0.5 mods [
				{ #type traits-mod-on-manager if [ trait-hardworking trait-organized trait-intelligent ] multiplier 1.1 }
				{ #type manager-level-test-mod id levelup-pitboss is equalto value 1 multiplier 1.1 }
				{ #type manager-level-test-mod id levelup-pitboss is equalto value 2 multiplier 1.2 }
				{ #type manager-level-test-mod id levelup-pitboss is equalto value 3 multiplier 1.3 }
				{ #type manager-level-test-mod id levelup-pitboss is equalto value 4 multiplier 1.5 }
				{ #type amenity-mod if [ bar-small ] perAmenityMultiplier 1.1 }
				]}
			maxBetPerPlayer { value 1.5 mods [
				{ #type traits-mod-on-manager if [ trait-hardworking trait-organized trait-intelligent ] multiplier 1.1 }
				{ #type manager-level-test-mod id levelup-pitboss is equalto value 1 multiplier 1.1 }
				{ #type manager-level-test-mod id levelup-pitboss is equalto value 2 multiplier 1.2 }
				{ #type manager-level-test-mod id levelup-pitboss is equalto value 3 multiplier 1.3 }
				{ #type manager-level-test-mod id levelup-pitboss is equalto value 4 multiplier 1.5 }
				{ #type amenity-mod if [ bar-small ] perAmenityMultiplier 1.1 }
				]}

			;; payout multiplier over bet if they win
			payoutMultiplier { value 25 }

			;; 1 = 1% customer wins, 99% house wins
			playerWinChancePercent { value 2 mods [
				{ #type manager-level-test-mod id levelup-mechanic is equalto value 1 multiplier 0.9 }
				{ #type manager-level-test-mod id levelup-mechanic is equalto value 2 multiplier 0.8 }
				{ #type manager-level-test-mod id levelup-mechanic is equalto value 3 multiplier 0.75 }
				{ #type manager-level-test-mod id levelup-mechanic is equalto value 4 multiplier 0.5 }
			] }

			;; heat generated
			heatPerPlayer { value 0.1 mods [ 
				{ #type manager-level-test-mod id levelup-house-manager is equalto value 1 multiplier 0.9 }
				{ #type manager-level-test-mod id levelup-house-manager is equalto value 2 multiplier 0.8 } 
				{ #type manager-level-test-mod id levelup-house-manager is equalto value 3 multiplier 0.75 }
				{ #type manager-level-test-mod id levelup-house-manager is equalto value 4 multiplier 0.5 }
			] }

			;; customers supported -- ONLY NEEDED FOR AOE
			maxCustomers	{ value 50 }
		}
	}
	{ 	id blackboards

		visreqs [ { #type check-player-skills has any of [ gambling-numbers ] } ]
		reqs [ { #type check-player-skills has any of [ gambling-clean-money ] } ]

		locicon "amenity.sports-blackboards.icon"
		locname	"amenity.sports-blackboards.name"
		locdesc	"amenity.sports-blackboards.desc"
		banner	"Amenity Sports Betting"
	
		buildCost { value -2500 mods [
			{ #type manager-level-test-mod id levelup-mechanic is equalto value 1 multiplier 0.9 }
			{ #type manager-level-test-mod id levelup-mechanic is equalto value 2 multiplier 0.8 }
			{ #type manager-level-test-mod id levelup-mechanic is equalto value 3 multiplier 0.75 }
			{ #type manager-level-test-mod id levelup-mechanic is equalto value 4 multiplier 0.5 }
		] }
		buildDayz { value 35 }

		minOperationCost { value 1500 } ;; must be less than build cost :)
		recommendedFunds { value 1200 }

		weeklyCost { value -15 mods [ 
			{ #type traits-mod-on-manager if [ trait-organized ] multiplier 0.9 }
			{ #type amenity-mod if [ chandeliers ] perAmenityMultiplier 0.8 }
			{ #type manager-level-test-mod id levelup-house-manager is equalto value 1 multiplier 0.9 }
			{ #type manager-level-test-mod id levelup-house-manager is equalto value 2 multiplier 0.8 } 
			{ #type manager-level-test-mod id levelup-house-manager is equalto value 3 multiplier 0.75 }
			{ #type manager-level-test-mod id levelup-house-manager is equalto value 4 multiplier 0.5 }
			] }

		behavior {

			slots {
				slotCount { value 0 } ;; should always be 0 for AOE amenities
			}

			type AOE
			
			;; how much each customer spends per turn
			minBetPerPlayer { value 4 mods [
				{ #type traits-mod-on-manager if [ trait-hardworking trait-organized trait-intelligent ] multiplier 1.1 }
				{ #type manager-level-test-mod id levelup-pitboss is equalto value 1 multiplier 1.1 }
				{ #type manager-level-test-mod id levelup-pitboss is equalto value 2 multiplier 1.2 }
				{ #type manager-level-test-mod id levelup-pitboss is equalto value 3 multiplier 1.3 }
				{ #type manager-level-test-mod id levelup-pitboss is equalto value 4 multiplier 1.5 }
				{ #type amenity-mod if [ bar-small ] perAmenityMultiplier 1.1 }
				]}
			maxBetPerPlayer { value 6 mods [
				{ #type traits-mod-on-manager if [ trait-hardworking trait-organized trait-intelligent ] multiplier 1.1 }
				{ #type manager-level-test-mod id levelup-pitboss is equalto value 1 multiplier 1.1 }
				{ #type manager-level-test-mod id levelup-pitboss is equalto value 2 multiplier 1.2 }
				{ #type manager-level-test-mod id levelup-pitboss is equalto value 3 multiplier 1.3 }
				{ #type manager-level-test-mod id levelup-pitboss is equalto value 4 multiplier 1.5 }
				{ #type amenity-mod if [ bar-small ] perAmenityMultiplier 1.1 }
				]}

			;; payout multiplier over bet if they win
			payoutMultiplier { value 30 }

			;; 1 = 1% customer wins, 99% house wins
			playerWinChancePercent { value 2 mods [
				{ #type manager-level-test-mod id levelup-mechanic is equalto value 1 multiplier 0.9 }
				{ #type manager-level-test-mod id levelup-mechanic is equalto value 2 multiplier 0.8 }
				{ #type manager-level-test-mod id levelup-mechanic is equalto value 3 multiplier 0.75 }
				{ #type manager-level-test-mod id levelup-mechanic is equalto value 4 multiplier 0.5 }
			] }

			;; heat generated
			heatPerPlayer { value 0.5 mods [ 
				{ #type manager-level-test-mod id levelup-house-manager is equalto value 1 multiplier 0.9 }
				{ #type manager-level-test-mod id levelup-house-manager is equalto value 2 multiplier 0.8 } 
				{ #type manager-level-test-mod id levelup-house-manager is equalto value 3 multiplier 0.75 }
				{ #type manager-level-test-mod id levelup-house-manager is equalto value 4 multiplier 0.5 }
			] }

			;; customers supported -- ONLY NEEDED FOR AOE
			maxCustomers	{ value 25 }

		}
	}
