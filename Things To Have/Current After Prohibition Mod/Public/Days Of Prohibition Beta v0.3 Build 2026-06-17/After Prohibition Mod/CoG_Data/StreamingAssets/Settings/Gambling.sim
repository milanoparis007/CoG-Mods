	;;
	;; rake games

	{
		id poker-game

		visreqs	[]
		reqs	[]

		locicon "amenity.poker-game.icon"
		locname	"amenity.poker-game.name"
		locdesc	"amenity.poker-game.desc"
		banner	"Amenity Poker"

		buildCost { value -5000 mods [
			{ #type manager-level-test-mod id levelup-mechanic is equalto value 1 multiplier 0.9 }
			{ #type manager-level-test-mod id levelup-mechanic is equalto value 2 multiplier 0.8 }
			{ #type manager-level-test-mod id levelup-mechanic is equalto value 3 multiplier 0.75 }
			{ #type manager-level-test-mod id levelup-mechanic is equalto value 4 multiplier 0.5 }
		] }
		buildDayz { value 35 }

		minOperationCost { value 300 }
		recommendedFunds { value 350 }

		weeklyCost { value -25 mods [ 
			{ #type traits-mod-on-manager if [ trait-organized ] multiplier 0.9 }
			{ #type amenity-mod if [ chandeliers ] perAmenityMultiplier 0.8 }
			{ #type manager-level-test-mod id levelup-house-manager is equalto value 1 multiplier 0.9 }
			{ #type manager-level-test-mod id levelup-house-manager is equalto value 2 multiplier 0.8 } 
			{ #type manager-level-test-mod id levelup-house-manager is equalto value 3 multiplier 0.75 }
			{ #type manager-level-test-mod id levelup-house-manager is equalto value 4 multiplier 0.5 }
			] }

		behavior {
			type Rake

			slots {
				slotCount { value 4 mods [ 
					{ #type amenity-mod if [ card-parlor ] perAmenityDelta 2 } 
					{ #type amenity-mod if [ valet-parking ] perAmenityDelta 1 } 
				] }
				slotFillChance { value 0.6 }
				slotDropChance { value 0.2 mods [ { #type amenity-mod if [ smoking-lounge ] perAmenityMultiplier 0.5 } ]}

				slotStartingCashMin { value 800 }
				slotStartingCashMax { value 1000 }
			}

			rake {
				rakePercent { value 10 }
				rakeEdge	{ value 1 mods [
					{ #type traits-mod if [ trait-intelligent trait-quiet trait-sharpeyed ] multiplier 1.5 }
					{ #type traits-mod if [ trait-sociable trait-myopic ] multiplier 0.9 }
					{ #type traits-mod if [ trait-cautious trait-confident trait-attractive] multiplier 1.1 }
					{ #type traits-mod if [ trait-slow trait-nervous trait-talkative ] multiplier 0.3 }
					]}
			}

			;; how much each customer spends per turn
			minBetPerPlayer { value 100 mods [
				{ #type traits-mod-on-manager if [ trait-hardworking trait-organized trait-intelligent ] multiplier 1.1 }
				{ #type manager-level-test-mod id levelup-pitboss is equalto value 1 multiplier 1.1 }
				{ #type manager-level-test-mod id levelup-pitboss is equalto value 2 multiplier 1.2 }
				{ #type manager-level-test-mod id levelup-pitboss is equalto value 3 multiplier 1.3 }
				{ #type manager-level-test-mod id levelup-pitboss is equalto value 4 multiplier 1.5 }
				{ #type amenity-mod if [ bar-small ] perAmenityMultiplier 1.1 }
				]
			}
			maxBetPerPlayer { value 150 mods [
				{ #type traits-mod-on-manager if [ trait-hardworking trait-organized trait-intelligent ] multiplier 1.1 }
				{ #type manager-level-test-mod id levelup-pitboss is equalto value 1 multiplier 1.1 }
				{ #type manager-level-test-mod id levelup-pitboss is equalto value 2 multiplier 1.2 }
				{ #type manager-level-test-mod id levelup-pitboss is equalto value 3 multiplier 1.3 }
				{ #type manager-level-test-mod id levelup-pitboss is equalto value 4 multiplier 1.5 }
				{ #type amenity-mod if [ bar-small ] perAmenityMultiplier 1.1 }
				]
			}

			;; rake type doesn't have a win chance or multiplier! should be left as undefined

			heatPerPlayer { value 10 mods [ 
				{ #type manager-level-test-mod id levelup-house-manager is equalto value 1 multiplier 0.9 }
				{ #type manager-level-test-mod id levelup-house-manager is equalto value 2 multiplier 0.8 } 
				{ #type manager-level-test-mod id levelup-house-manager is equalto value 3 multiplier 0.75 }
				{ #type manager-level-test-mod id levelup-house-manager is equalto value 4 multiplier 0.5 }
