	debtLevels [
	{
		id   level1
		initial #true
		cash { value 1000 mods [ 
			{ #type amenity-mod if [ uniforms ] perAmenityMultiplier 0.8 } 
		] }

		convo {
			npcintro 		"convo-debt.level1.npcintro"
			humanblurb 		"convo-debt.level1.humanblurb"
			npcblurb 		"convo-debt.level1.npc"
			beforechoice	"convo-debt.any.beforechoice"
		}

		repayments [
		 	{ id get-building-low		success 0.5		appearChance 1 }
		 	{ id get-car  				success 0.7		appearChance 1 }
		 	{ id get-pickup-truck		success 0.6		appearChance 0.4 } 
		 	{ id get-cargo-truck	success 0.6		appearChance 0.2 }
		 	{ id get-building-hi	success 0.9		appearChance 1 } 
		 	{ id get-delivery-truck		success 0.6		appearChance 0.3 }
		 	{ id get-building-med		success 0.7		appearChance 1 }
		 	{ id get-parking-spot-truck success 0.8		appearChance 0.4 }
		 	{ id grant-family-intro		success 0.7		appearChance 1 }
		 	{ id get-sports-car 	success 0.3		appearChance 0.2 }
		 	{ idlist [ 
				reveal-imports-canadian 
