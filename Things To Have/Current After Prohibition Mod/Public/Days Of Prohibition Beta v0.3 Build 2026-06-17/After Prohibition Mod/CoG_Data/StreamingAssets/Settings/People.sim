					;; no buff; they're dead
					locblurb "convo.social.crewdeath-ign"
					locentry "entry.social.crewdeath-ign"
					dayz 365
				}
				{	id crewdeath-ign-inf
					valence Negative	category Physical
					buffid relbuff-social-crewdeath-ign-inf
					locblurb "convo.social.crewdeath-ign-inf"
					locentry "entry.social.crewdeath-ign-inf"
					dayz 365
				}
				;; social actions, mostly quest related
				{	id quest-complete
					valence Positive	category Social
					buffid relbuff-social-quest-complete
					locblurb "convo.social.quest.complete"
					locentry "entry.social.quest.complete"
					dayz 252
				}
				{	id quest-complete-inf
					valence Positive	category Social
					buffid relbuff-social-quest-complete-inf
					locblurb "convo.social.quest.complete-inf"
					locentry "entry.social.quest.complete-inf"
					dayz 252
				}
				{
					id ethnic-help
					valence Positive	category Social
					buffid relbuff-ethnic-help
					locblurb "convo.social.ethnic.help"
					locentry "entry.social.ethnic.help"
					dayz 126
				}
				{
					id ethnic-help-inf
					valence Positive	category Social
