				{ #type crew-peep-level-test-mod id levelup-protection is equalto value 4 delta -15 }
				{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 1 delta -1 }
				{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 2 delta -2 }
				{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 3 delta -4 }
				{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 4 delta -8 }
				{ #type crew-peep-level-test-mod id levelup-hoodsgang is equalto value 1 delta -3 }
				{ #type traits-mod if [ trait-hardworking ] delta 3 }
				{ #type traits-mod if [ trait-lazy ] delta -3 }
			] }

