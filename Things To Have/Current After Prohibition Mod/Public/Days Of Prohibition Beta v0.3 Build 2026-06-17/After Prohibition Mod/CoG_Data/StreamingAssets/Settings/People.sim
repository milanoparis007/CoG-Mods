			vehicleTruckCap {
				value 1 
				mods [
					{ #type vehicle-modules-capacity-mod type truck }
					{ #type law-mod laws [ parking-contract ] enacted true }
					{ #type skills-mod if [ starter-vehicles ] delta 1 }
					{ #type is-biz-in-territory id train-station-freight expected #true delta 2 }
					{ #type skills-mod if [ delivery-driving ] delta 1 }
					{ #type quest-mod id homebooze-upgrade-truck is completed delta 1 }
					{ #type quest-mod id neighborhood-opportunity-low-one is completed delta 1 }
					{ #type quest-mod id neighborhood-opportunity-med-one is completed delta 1 }
					{ #type quest-mod id neighborhood-opportunity-med-six is completed delta 1 }
					{ #type quest-mod id level-two-bonus-sparkling-cider is completed delta 1 }
					{ #type quest-mod id level-two-bonus-fake-wine is completed delta 1 }
					{ #type quest-mod id level-two-bonus-fake-beer is completed delta 1 }
					{ #type quest-mod id level-two-bonus-bathtub-gin is completed delta 1 }
					{ #type quest-mod id booze-surplus-bonus-trucks is completed delta 2 }
					{ #type quest-mod id delivery-van-brick-wine is completed delta 1 }
					{ #type quest-mod id delivery-van-cider is completed delta 1 }
					{ #type quest-mod id delivery-van-home-brew is completed delta 1 }
					{ #type quest-mod id delivery-van-moonshine is completed delta 1 }
					{ #type quest-mod id build-small-garage is completed delta 1 }
					{ #type quest-mod id vehicle-quest-pickup-three-nobooze is completed delta 2 }
					{ #type quest-mod id level-two-upgrade-truck is completed delta 1 }
					{ #type player-installed-module-mod id production-homebooze-brick-wine-dock permodule 1 lockey "mod.player-installed-module.brick-wine" }
					{ #type player-installed-module-mod id production-homebooze-cider-dock permodule 1 lockey "mod.player-installed-module.cider" }
					{ #type player-installed-module-mod id production-homebooze-moonshine-dock permodule 1 lockey "mod.player-installed-module.moonshine" }
					{ #type player-installed-module-mod id production-homebooze-home-brew-dock permodule 1 lockey "mod.player-installed-module.home-brew" }
					{ #type add-player-counter-mod id "debt-parking" lockey "mod.add-player-counter-mod.from-gamblers" }
					{ #type law-mod laws [ truck-permits ] enacted true }
					{ #type controlled-biz-mod perbiz 1 }
				;	{ #type quest-mod id neighborhood-opportunity-hi-one is completed delta 1 }
				]
			}
