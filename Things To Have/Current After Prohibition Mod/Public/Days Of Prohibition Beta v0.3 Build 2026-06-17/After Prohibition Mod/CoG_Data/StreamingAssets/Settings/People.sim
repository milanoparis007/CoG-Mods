{ 
	people {

	social {
		respect {
			gainThreshold { value 95 mods [ { #type skills-mod if [ starter-territory ] delta -15 }
			{ #type skills-mod if [ starter-guns ] delta -50 }
			{ #type skills-mod if [ starter-conman ] delta -50 }
			{ #type skills-mod if [ starter-gang ] delta -50 }
			{ #type skills-mod if [ starter-og ] delta -50 }
			] }
			lossThreshold { value 50 }
			velocityPerTurn { value 15 mods [ 
			{ #type skills-mod if [ starter-guns ] delta 25 }
			{ #type skills-mod if [ starter-conman ] delta 35 }
			{ #type skills-mod if [ starter-gang ] delta 25 }
			{ #type skills-mod if [ starter-og ] delta 35 }
			] }

			bizRelationshipMultiplier { value 0.75 } ;; multiplier from avg relationship to respect
			fromSafehouse { value 300 } ;; how much comes from having a safehouse in that node
			fromNeighborOutside { value 15 } ;; respect from territory nodes to their non-owned neighbors
			fromNeighborInside { value 20 } ;; respect from territory nodes to other territory nodes
			fromSameEthnicity { value 15 } ;; if the main ethnicity on this node == player ethnicity

			finalRespectMultiplier { value 1 } ;; is this desirable? a final multiplier to respect from everything
		}

		outposts {
			buildCost { value -100 mods [
				{ #type outpost-closures-mod perclosure -300 }
				{ #type relationship-mod is atleast value 30 delta 50 }
				{ #type territory-size-mod pernode -10 skip 12 }
				{ #type same-ethnicity-at-node-mod multiplier 50 }
				{ #type npc-in-player-automation-mod expected #true multiplier 0.9 }
				{ #type traits-mod if [ trait-nervous ] multiplier 1.25 }
				{ #type traits-mod if [ trait-confident ] multiplier 0.9 }
				{ #type traits-mod if [ trait-bossm ] multiplier 0.9 }
				{ #type skills-mod if [ starter-territory ] multiplier 0.9 }
				{ #type crew-peep-role-test-mod is any of [ enforcer ] multiplier 0.5 }
			] }
				
			monthlyCost { value 0 } ;; base monthly cost for the front itself? if set, should be negative

			tributePerBiz { value 20 mods [
					{ #type territory-size-mod pernode 4 skip 24 }
					{ #type crew-size-mod percrew 2 skip 4 }
					{ #type crew-peep-level-test-mod id levelup-smooth-talker is equalto value 1 delta 15 }
					{ #type crew-peep-level-test-mod id levelup-smooth-talker id equalto value 2 delta 23 }
					{ #type crew-peep-level-test-mod id levelup-hoodsgang is equalto value 1 delta 10 }
					{ #type crew-peep-level-test-mod id levelup-captain is equalto value 1 delta 10 }
					{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 1 delta 9 }
					{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 2 delta 12 }
					{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 3 delta 18 }
					{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 4 delta 18 }
					{ #type traits-mod if [ trait-bossm ] multiplier 1.75 }
					{ #type crew-peep-level-test-mod id levelup-leader1 is equalto value 1 delta 10 }
					{ #type crew-peep-level-test-mod id levelup-leader2 is equalto value 1 delta 15 }
					{ #type skills-mod if [ starter-protection ] delta 10 }
				] }

			;; see respect gainThreshold above
			respTargetAtOutpost { value 100 }
			respTargetNearOutpost { value 100 }
			pumpPerDayUp { value 6 } 
			pumpPerDayDown { value 1 } 

			expansionDefs [
				{   id outpost-exp-1	
					locdesc "outpost.exp-1.desc"
					locline "outpost.exp-1.line"
					convonpc "outpost.exp-1.convonpc"
					convosay "outpost.exp-1.convosay"
					visreqs []
					monthlyCost { value -10 mods [ ] }
				}
				{   id outpost-exp-2
					locdesc "outpost.exp-2.desc"
					locline "outpost.exp-2.line"
					convonpc "outpost.exp-2.convonpc"
					convosay "outpost.exp-2.convosay"
					visreqs [{ #type check-immigrant is player expected #true } { #type check-player-same-ethnicity }]
					monthlyCost { value -8 mods [] }
				}
				{   id outpost-exp-3
					locdesc "outpost.exp-3.desc"
					locline "outpost.exp-3.line"
					convonpc "outpost.exp-3.convonpc"
					convosay "outpost.exp-3.convosay"
					visreqs [{ #type check-is-convo-inside-territory expected #true }]
					monthlyCost { value -8 mods [ ] }
				}
				{
					id outpost-exp-4
					locdesc "outpost.exp-4.desc"
					locline "outpost.exp-4.line"
					convonpc "outpost.exp-4.convonpc"
					convosay "outpost.exp-4.convosay"
					visreqs [ { #type check-owner-traits has any of [ trait-friendly trait-sociable trait-talkative ] } ]
					monthlyCost { value -10 mods [ ] }
				}
				{
					id outpost-exp-5
					locdesc "outpost.exp-5.desc"
					locline "outpost.exp-5.line"
					convonpc "outpost.exp-5.convonpc"
					convosay "outpost.exp-5.convosay"
					visreqs [ { #type check-owner-traits has any of [ trait-compassionate trait-religious trait-forgiving ] } ]
					monthlyCost { value -22 mods [ ] }
				}
				{
					id outpost-exp-6
					locdesc "outpost.exp-6.desc"
					locline "outpost.exp-6.line"
					convonpc "outpost.exp-6.convonpc"
					convosay "outpost.exp-6.convosay"
					visreqs [ ]
					monthlyCost { value 0 mods [{ #type territory-size-mod pernode -1 skip 24 } ] }
				}
				{
					id outpost-exp-7
					locdesc "outpost.exp-7.desc"
					locline "outpost.exp-7.line"
					convonpc "outpost.exp-7.convonpc"
					convosay "outpost.exp-7.convosay"
					visreqs [ ]
					monthlyCost { value 0 mods [{ #type territory-size-mod pernode 2 skip 24 } ] }
				}
				{
					id outpost-exp-8
					locdesc "outpost.exp-8.desc"
					locline "outpost.exp-8.line"
					convonpc "outpost.exp-8.convonpc"
					convosay "outpost.exp-8.convosay"
					visreqs [ ]
					monthlyCost { value 0 mods [{ #type crew-size-mod percrew 1 skip 2 } ] }
				}
				{
					id outpost-exp-9
					locdesc "outpost.exp-9.desc"
					locline "outpost.exp-9.line"
					convonpc "outpost.exp-9.convonpc"
					convosay "outpost.exp-9.convosay"
					visreqs [ 
						{ #type check-module-in-convo has any of [
							bootlegger-homebooze-a bootlegger-homebooze-b bootlegger-homebooze-c bootlegger-homebooze-d
							corner-speakeasy-a corner-speakeasy-b corner-speakeasy-c corner-speakeasy-d
							sink-homebooze-industrial-a sink-homebooze-industrial-b sink-homebooze-industrial-c sink-homebooze-industrial-d
							sink-bottled-booze-industrial-a sink-bottled-booze-industrial-b sink-bottled-booze-industrial-c sink-bottled-booze-industrial-d
							small-speakeasy-NPC-a small-speakeasy-NPC-b small-speakeasy-NPC-c small-speakeasy-NPC-d
						] }
					]
					monthlyCost { value 10 }
				}
				{
					id outpost-exp-10
					locdesc "outpost.exp-10.desc"
					locline "outpost.exp-10.line"
					convonpc "outpost.exp-10.convonpc"
					convosay "outpost.exp-10.convosay"
					visreqs [ 
						{ #type check-module-in-convo has any of [
							bootlegger-homebooze-a bootlegger-homebooze-b bootlegger-homebooze-c bootlegger-homebooze-d
							corner-speakeasy-a corner-speakeasy-b corner-speakeasy-c corner-speakeasy-d
							sink-homebooze-industrial-a sink-homebooze-industrial-b sink-homebooze-industrial-c sink-homebooze-industrial-d
							sink-bottled-booze-industrial-a sink-bottled-booze-industrial-b sink-bottled-booze-industrial-c sink-bottled-booze-industrial-d
							small-speakeasy-NPC-a small-speakeasy-NPC-b small-speakeasy-NPC-c small-speakeasy-NPC-d
						] }
						{ #type check-npc-gets-player-deliveries }	
					]
					monthlyCost { value 2 mods [ ] }
				}
				{
					id outpost-exp-11
					locdesc "outpost.exp-11.desc"
					locline "outpost.exp-11.line"
					convonpc "outpost.exp-11.convonpc"
					convosay "outpost.exp-11.convosay"
					visreqs [ ]
					monthlyCost { value 8 mods [
					{ #type player-installed-module-mod id brothel-house permodule 5 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id brothel-fancy permodule 10 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id backroomlaundererl permodule 35 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id production-moneylaunderingmid permodule 20 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id production-moneylaunderinghigh permodule 25 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id production-cannabisdealerstart permodule -10 lockey "mod.player-installed-module.brick-wine" }
					{ #type player-installed-module-mod id production-cannabisdealerlow permodule -15 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id production-cannabisdealermid permodule -15 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id production-cannabisdealerhigh permodule -20 lockey "mod.player-installed-module.brick-wine" }
					{ #type player-installed-module-mod id production-cannalbisdealerlow permodule -15 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id production-cannalbisdealermid permodule -15 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id production-cannalbisdealerhigh permodule -20 lockey "mod.player-installed-module.brick-wine" }
					{ #type player-installed-module-mod id gang-hideout-large permodule 20 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id gang-hideout permodule 15 lockey "mod.player-installed-module.brick-wine" } 
				] }
				}
				{
					id outpost-exp-12
					locdesc "outpost.exp-12.desc"
					locline "outpost.exp-12.line"
					convonpc "outpost.exp-12.convonpc"
					convosay "outpost.exp-12.convosay"
					visreqs [ { #type check-is-convo-at-corner-with-controlled-building expected #true } ]
					monthlyCost { value 4 mods [] }
				}
				{   id outpost-exp-13
					locdesc "outpost.exp-13.desc"
					locline "outpost.exp-13.line"
					convonpc "outpost.exp-13.convonpc"
					convosay "outpost.exp-2.convosay"
					visreqs [{ #type check-immigrant is player expected #true } { #type check-immigrant is owner expected #true } ]
					monthlyCost { value 8 mods [] }
				}
				{   id outpost-exp-14
					locdesc "outpost.exp-14.desc"
					locline "outpost.exp-14.line"
					convonpc "outpost.exp-14.convonpc"
					convosay "outpost.exp-14.convosay"
					visreqs [{ #type check-immigrant is player expected #false } { #type check-immigrant is owner expected #false } ]
					monthlyCost { value 5 }
				}
				{
					id outpost-exp-15
					locdesc "outpost.exp-15.desc"
					locline "outpost.exp-15.line"
					convonpc "outpost.exp-15.convonpc"
					convosay "outpost.exp-15.convosay"
					visreqs [ { #type check-owner-traits has any of [ trait-aggressive trait-confident trait-immoral ] } ]
					monthlyCost { value -12 mods [ ] }
				}
				;; a few more with no visreqs
				{   id outpost-exp-17	
					locdesc "outpost.exp-17.desc"
					locline "outpost.exp-17.line"
					convonpc "outpost.exp-17.convonpc"
					convosay "outpost.exp-17.convosay"
					visreqs [ { #type check-player-territory-size is lessthan value 30 } ]
					monthlyCost { value 4 }
				}
				{   id outpost-exp-18	
					locdesc "outpost.exp-18.desc"
					locline "outpost.exp-18.line"
					convonpc "outpost.exp-18.convonpc"
					convosay "outpost.exp-18.convosay"
					visreqs [ { #type check-player-territory-size is morethan value 60 } ]
					monthlyCost { value 8 }
				}
				{   id outpost-exp-19	
					locdesc "outpost.exp-17.desc"
					locline "outpost.exp-17.line"
					convonpc "outpost.exp-17.convonpc"
					convosay "outpost.exp-17.convosay"
					visreqs [ ]
					monthlyCost { value 1 mods [ ] }
				}
				{   id outpost-exp-20	
					locdesc "outpost.exp-18.desc"
					locline "outpost.exp-18.line"
					convonpc "outpost.exp-18.convonpc"
					convosay "outpost.exp-18.convosay"
					visreqs [ { #type check-player-territory-size is atleast value 60 } ]
					monthlyCost { value 1 mods [  ] }
				}
			]
		}
		heat {
			velocityPerTurn { value 5 }
			finalHeatMultiplier { value 1 }
			bizRelationshipMultiplier { value 5.0 }
			fromNeighborsProportion { value 0.8 }
			fromBusinesses { value 50.0 mods [
				{ #type territory-size-mod pernode 2 skip 1 }
				{ #type skills-mod if [ starter-buildings ] multiplier 0.8 }
				{ #type law-mod laws [ police-commission-appointment ] enacted true }
			] }
		}

		police {
			raidThreshold { value 100 mods [ { #type law-mod laws [ cop-funding mayor-election ] enacted true } { #type skills-mod if [ starter-cops ] delta 20 } ] }
			raidChance { value 1 }
			raidDurationDayz { from 7 to 14 }
			raidCheckCooldownDayz { value 0 }
			raidNodeCooldownDayz { value 42 }
			premium	0.3

			donationCost { value -3500 mods [
				{ #type law-mod laws [internal-affairs mayor-election] enacted true }
				{ #type crew-peep-role-test-mod is any of [ negotiator ] multiplier 0.5 }
				{ #type crew-peep-role-test-mod is any of [ advisor ] multiplier 0.5 }
				{ #type territory-size-mod pernode -10 skip 1 }
				{ #type traits-mod if [ trait-bossm ] multiplier 0.95 }
				{ #type crew-peep-level-test-mod id levelup-leader2 is equalto value 1 multiplier 0.75 }
				{ #type crew-peep-level-test-mod id levelup-smooth-talker is atleast value 1 multiplier 0.75 }
				{ #type traits-mod-on-either if [ trait-aggressive trait-confident ] multiplier 0.9 }
				{ #type traits-mod-on-either if [ trait-nervous ] multiplier 1.1 }
				{ #type traits-mod-on-either if [ trait-upright ] multiplier 2.4 }
				{ #type relationship-mod is atleast value 20 multiplier 0.75 }
				{ #type skills-mod if [ starter-cops ] multiplier 0.8 }
				{ #type num-casinos-in-precinct-mod multiplier 1.2 }
				] }
				
			donationDayz { value 730 mods [ { #type skills-mod if [ starter-cops ] delta 60 } ] }
			donationFromPolDayz	{ value 1460 mods [ { #type skills-mod if [ starter-cops ] delta 60 } ] }

			feds {
				hintCooldownDayz { value 14 }
				raidPhotos [ { sprite "Debris" } { sprite "Postcard" lockey "postcard.fedsraid" } ]

				arrestDayz { value 90 }
				arrestPhotos [ { sprite "Police Van" } { sprite "Postcard" lockey "postcard.fedarrest" } ]
				arrestBribe { value -4500 mods [
					{ #type territory-size-mod pernode -200 skip 10 }
					{ #type traits-mod if [ trait-nervous ] multiplier 1.25 }
					{ #type traits-mod if [ trait-confident ] multiplier 0.8 }
				{ #type traits-mod-on-either if [ trait-upright ] multiplier 2.4 }
				] }

				trialPhotos [{ sprite "Police Van" }]

				trialReleaseProbHuman { value 0.5 mods [
					{ #type territory-size-mod pernode -0.01 skip 24 }
					{ #type crew-peep-level-test-mod id levelup-lawyers is atleast value 1 multiplier 1.5 }
					{ #type crew-peep-level-test-mod id levelup-lawyers is atleast value 2 multiplier 1.7 }
					{ #type player-installed-module-mod id player-legal-lawoffice permodule 0.25 lockey "mod.player-installed-module.brick-wine" }
					{ #type player-installed-module-mod id brothel-house permodule -0.05 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id brothel-fancy permodule -0.03 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id gang-hideout-large permodule -0.1 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id gang-hideout permodule -0.05 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id gangdend-player permodule -0.03 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id gangden-player permodule -0.03 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id gangdendl-player permodule -0.05 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id gangdenl-player permodule -0.05 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id production-cannabisdealerstart permodule -0.1 lockey "mod.player-installed-module.brick-wine" }
					{ #type player-installed-module-mod id production-cannabisdealerlow permodule -0.1 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id production-cannabisdealermid permodule -0.2 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id production-cannabisdealerhigh permodule -0.3 lockey "mod.player-installed-module.brick-wine" }
					{ #type player-installed-module-mod id production-cannalbisdealerlow permodule -0.1 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id production-cannalbisdealermid permodule -0.2 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id production-cannalbisdealerhigh permodule -0.3 lockey "mod.player-installed-module.brick-wine" }
					{ #type player-installed-module-mod id casino-small permodule -0.01 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id casino-medium permodule -0.03 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id casino-large permodule -0.05 lockey "mod.player-installed-module.brick-wine" }
					{ #type player-installed-module-mod id gambling-house-small permodule -0.01 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id gambling-house-medium permodule -0.03 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id gambling-house-large permodule -0.05 lockey "mod.player-installed-module.brick-wine" } 
				] }
				trialReleaseProbGang { value 0.5 mods [
				] }
				prisonTimeYears { value 2 mods [
					{ #type crew-peep-level-test-mod id levelup-lawyers is atleast value 1 multiplier 0.85 }
					{ #type crew-peep-level-test-mod id levelup-lawyers is atleast value 2 multiplier 0.6 }
					{ #type player-installed-module-mod id player-legal-lawoffice permodule -4 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id gangdend-player permodule 2 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id gangden-player permodule 2 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id gangdendl-player permodule 3 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id gangdenl-player permodule 3 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id brothel-house permodule 2 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id brothel-fancy permodule 2 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id gang-hideout-large permodule 1 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id gang-hideout permodule 1 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id bootlegger-backroomgrifter permodule 1 lockey "mod.player-installed-module.brick-wine" }
					{ #type player-installed-module-mod id production-cannabisdealerstart permodule 2 lockey "mod.player-installed-module.brick-wine" }
					{ #type player-installed-module-mod id production-cannabisdealerlow permodule 3 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id production-cannabisdealermid permodule 5 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id production-cannabisdealerhigh permodule 10 lockey "mod.player-installed-module.brick-wine" }
					{ #type player-installed-module-mod id production-cannalbisdealerlow permodule 3 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id production-cannalbisdealermid permodule 5 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id production-cannalbisdealerhigh permodule 10 lockey "mod.player-installed-module.brick-wine" }
					{ #type player-installed-module-mod id casino-small permodule 1 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id casino-medium permodule 2 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id casino-large permodule 3 lockey "mod.player-installed-module.brick-wine" }
					{ #type player-installed-module-mod id gambling-house-small permodule 1 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id gambling-house-medium permodule 2 lockey "mod.player-installed-module.brick-wine" } 
					{ #type player-installed-module-mod id gambling-house-large permodule 3 lockey "mod.player-installed-module.brick-wine" } 
				] }
			}
		}

		;; tickets are called milestones if you ever need to find this damned thing
		relationships {
			milestones { value 15 mods [
				{ #type person-same-eth-as-human-mod expected #true delta -3 }
				{ #type person-relative-of-human-mod expected #true delta -2 }
			] }
			affiliateLevel { value 4 }
			tradeEffects {
				pointsPerTradeExtra { value 4 mods [
					{ #type same-ethnicity-at-node-mod multiplier 1.5 }
					{ #type npc-in-player-automation-mod expected #true delta 2 }
				] }
				maxHeatPerIllegalBiz { value 80.0 mods [
					;	{ #type traits-mod-on-manager if [ trait-cautious ] multiplier 0.8 }
					] }
				heatPerIllegalTrade { value 30.0  mods [ 
					{ #type same-ethnicity-at-node-mod multiplier -10 } 
					{ #type is-node-in-territory expected #true delta 2 }
					{ #type is-node-in-territory expected #false delta -2 }
				] }

				rememberForDayz { value 42 }
				maxEntries { value 20 }
			}
			
			socialInferenceSkipChance [
				{ linktype Self probability 1.0 }
				{ linktype Family probability 0.0 }
				{ linktype Acquaintance probability 0.0 }
			]

			;; list of social actions, -inf are actions that are propagated along the network
			;; e.g., violence comes when you whoop people, violence-inf is what their friends hear about
			
			;; please make sure to match relbuff length appropriately 

			socialActions [
				;; physical attacks on individuals
				{	id violence
					valence Negative	category Physical
					buffid relbuff-social-violence
					locblurb "convo.social.violence"
					locentry "entry.social.violence"
					cancels [ got-relboost-from-npc ]
					dayz 252
				}
				{	id violence-inf
					valence Negative	category Physical
					buffid relbuff-social-violence-inf
					locblurb "convo.social.violence-inf"
					locentry "entry.social.violence-inf"
					dayz 252
				}
				{	id killing
