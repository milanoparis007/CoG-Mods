		costs {
			moveOnKnownNode { value 3 mods [{ #type crew-vehicle-template is equalto template vehicle-transit delta -1 }{ #type crew-peep-level-test-mod id levelup-hoodsgang is equalto value 1 delta -2 }] }
			moveOnOwnedNode { value 4 mods [{ #type crew-peep-level-test-mod id levelup-hoodsgang is equalto value 1 delta -2 }] }
			moveOnUnknownNode { value 7 mods [{ #type crew-vehicle-template is equalto template vehicle-transit delta -2 }{ #type crew-peep-level-test-mod id levelup-hoodsgang is equalto value 1 delta -2 }] }
			pathOnUnknownPenalty { value 10 mods [] }
			
			scopeOutCost { actions 1 }
			attackCost { actions 1 mods [{ #type crew-peep-level-test-mod id levelup-hoodsgang is equalto value 1 delta -1 }] }
			healCost { actions 1 mods [{ #type crew-peep-level-test-mod id levelup-hoodsgang is equalto value 1 delta -1 }] }
			convoCost { actions 1 }
		}

		intros {
			;; total 1
			localFriendWeight 0.6
			playerBizWeight 0.3
			transactionWeight 0.1

			transactionLifetimeDayz 84
			countToIntroduce 10
		}

		demands {
			transitions [
				{
					atOwner #true
					;; these are player facing percentages, so 0-100, not our usual 0-1 :(
					requestToComplyPercent { value 70 mods [ ;; biz owners start high
						;; in enemy territory
						{ #type crew-peep-level-test-mod id levelup-hoodsbomb is equalto value 1 delta 80 }
						{ #type in-territory-mod owner non-human delta -50 }
						;; already doing business - need a new mod for scheduled deliveries
						{ #type npc-in-player-automation-mod expected #true delta 20 }
						;; friends/family...
						{ #type relationship-mod is morethan value 10 delta 10 }
						{ #type relationship-mod is morethan value 20 delta 10 }
						{ #type relationship-mod is morethan value 25 delta 5 }
						{ #type relationship-mod is morethan value 30 delta 5 }
						;; people don't like you...
						{ #type relationship-mod is lessthan value -6 delta -5 }
						{ #type relationship-mod is lessthan value -12 delta -5 }
						{ #type relationship-mod is lessthan value -15 delta -5 }
						{ #type relationship-mod is lessthan value -20 delta -5 }
						;; same ethnicity
						{ #type same-ethnicity-at-node-mod multiplier 10 }
						;; traits
						{ #type traits-mod if [ trait-mellow trait-nervous trait-weak ] delta 5 }
						{ #type traits-mod if [ trait-hardworking ] delta -5 }
						] }
					bribeToComplyPercent { value 50 mods [ ;; start with 50%
						;; equally balanced forces = base chance, 2x stronger = +50% etc
						{ #type relative-crew-strength-territory-mod delta -1 multiplier 50 }
						;; friends/family bonus
						{ #type relationship-mod is morethan value 10 delta 10 }
						{ #type relationship-mod is morethan value 20 delta 20 }
						;; same ethnicity
						{ #type same-ethnicity-at-node-mod multiplier 20 }
						] }
					bribeToComplyAmount { value 1000 mods [] }
					forceToComplyPercent { value 70 mods [
						{ #type traits-mod if [ trait-vindictive ] delta -5 }
						{ #type traits-mod if [ trait-irritable ] delta -5 }
						{ #type traits-mod if [ trait-cruel ] delta -5 }	
						{ #type traits-mod if [ trait-forgiving ] delta 5 }
						{ #type traits-mod if [ trait-weak ] delta 5 }
						] }
					forceToComplySocial "propdamage"
					forceToComplyHeatBuff "heatbuff-violent-extortion"

					explainCompliance #true
					photos [ { sprite "Debris" } { sprite "Postcard" lockey "postcard.protection" } ]
				}
				{
					atGoon #true
					;; these are player facing percentages, so 0-100, not our usual 0-1 :(
					requestToComplyPercent { value 0 mods [
						;; (strength ratio - 1.0) * 50  <-->  at 2:1 it's 50% pass, at 4:1 it's 100%
						{ #type relative-crew-strength-mod delta -1 multiplier 50 }
						{ #type skills-mod if [ starter-goons ] delta 0.1 }
					] }
					forceToComplyPercent { value 0 mods [ 
						;; (total health - 60) * -5  <-->  health > 60 = 0%, health = 50 = 50%, health < 40 = 100%
						{ #type crew-health-mod of target type total delta -60 multiplier -5 }
					] }
					forceToComplySocial "demand-attack"

					explainCompliance #true
					;photos [ { sprite "Result Injury" } { sprite "Postcard" lockey "postcard.smallattack" } ]
				}
				{
					atGang #true
					;; these are player facing percentages, so 0-100, not our usual 0-1 :(
					requestToComplyPercent { value 0 mods [
						;; (strength ratio - 1.0) * 50  <-->  at 2:1 it's 50% pass, at 4:1 it's 100%
						{ #type relative-crew-strength-mod delta -1 multiplier 50 }
						;; but peaceful gangs will get a 50% on top of that
						{ #type ai-personality-mod if [ peaceful ] delta 50 }
					] }
					forceToComplyPercent { value 0 mods [ 
						;; (total health - 60) * -5  <-->  health > 60 = 0%, health = 50 = 50%, health < 40 = 100%
						{ #type crew-health-mod of target type total delta -60 multiplier -5 }
						;; but aggressive gangs will never be forced to comply
						{ #type ai-personality-mod if [ aggressive ] multiplier 0 }
					] }
					forceToComplySocial "demand-attack"

					explainCompliance #true
					;photos [ { sprite "Result Injury" } { sprite "Postcard" lockey "postcard.smallattack" } ]				
				}
			]
			
			defs [
				{ demand AllowBizAccess
					atGoon #true
					atGang #true
					onSuccess { playerSocial "demand-allow-biz" }
				}
				{ demand StopAggro
					atGoon #true 
					onSuccess { playerSocial "demand-stop-aggro" }
				}
				{ demand StopStealingOutpost
					atGang #true
				}
				{ demand StopHarassing
					atGoon #true 
				}
				{ demand Protection	
					atOwner #true 	
				}
				{ demand CloseOutpost 
					atOwner #true
					bribeAllowed #true
					;; no onSuccess - that social action is recorded in code
				}
			]
			
			cashcost { value -1000 mods [] }
		}
	}

	vehicleSettings {

		maxVehicleHealth { value 100 }

		healthTypes [
			{ morethan 50 category good canwork #true showbar #false color { r 97 g 137 b 74 a 255 } }
			{ morethan 30 category worn canwork #true showbar #true color { r 97 g 137 b 74 a 255 } }
			{ morethan 10 category clunker canwork #true showbar #true color { r 196 g 128 b 57 a 255 } }
			{ morethan -1 category junk canwork #false showbar #true color { r 209 g 44 b 40 a 255 } }
		]

		healthLoss [ {
			source from-driving  ;; every driving action
			points { value -0.5 mods [ { #type skills-mod if [ delivery-driving ] delta 0.1 } 
				{ #type crew-vehicle-template is equalto template vehicle-transit delta -2 }
				{ #type skills-mod if [ starter-vehicles ] delta 0.1 }	] }
		} {
		  	source from-firearm  ;; firearm attack only (knives don't do nothin)
			points { value -5 mods [ { #type random-delta-mod from -10 to 0 } ] }
		} {
		 	source from-arrest	 ;; banged up from being arrested
			points { value -5 mods [ { #type random-delta-mod from -5 to 0 } ] }
		} ]
	}

	combatSettings {
		
		maxCrewHealth { value 100 }

	
		crewHealingPoints { value 30 mods [
			{ #type traits-mod if [ trait-strong ] delta 30 } ;  200%
			{ #type traits-mod if [ trait-agile  ] delta 10 }
			{ #type traits-mod if [ trait-immoral ] delta 5 }
			{ #type traits-mod if [ trait-clumsy ] delta 1 }
			{ #type traits-mod if [ trait-weak   ] delta 1 } ;  50%
		] }

		vehicleDamageReduction { value 0 mods [
			{ #type crew-peep-level-test-mod id levelup-hoods is equalto value 1 delta 2 }
            { #type crew-peep-level-test-mod id levelup-hoods is equalto value 2 delta 5 }
            { #type crew-peep-level-test-mod id levelup-hoods is equalto value 3 delta 8 }
            { #type crew-peep-level-test-mod id levelup-hoods is equalto value 4 delta 12 }
            { #type crew-vehicle-template is equalto template vehicle-bulletproof-sports-car delta 10 }
            { #type crew-vehicle-template is equalto template vehicle-bulletproof-car delta 20 }
            { #type crew-vehicle-template is equalto template vehicle-bulletproof-independence delta 10 }
            { #type crew-vehicle-template is equalto template vehicle-bulletproof-jaguar delta 20 }
            { #type crew-vehicle-template is equalto template vehicle-bulletproof-camino delta 10 }
            { #type crew-vehicle-template is equalto template vehicle-bulletproof-phantom delta 20 }
            { #type crew-vehicle-template is equalto template vehicle-bulletproof-truck delta 10 }
			]}

		crewHealthTypes [
			;; healthy
			{ morethan 90 category 0 canwork #true color { r 97 g 137 b 74 a 255 }
				locname "ui.health.0" 
				lochurt "ui.fight-hurt.0" 
				locunhurt "ui.fight-unhurt.0" } 
			;; roughed up
			{ morethan 60 category 1 canwork #true color { r 137 g 158 b 53 a 255 }  
				locname "ui.health.1" 
				lochurt "ui.fight-hurt.1" 
				locunhurt "ui.fight-unhurt.1" } 
			;; injured
			{ morethan 30 category 2 canwork #false color { r 196 g 128 b 57 a 255 }
				locname "ui.health.2" 
				lochurt "ui.fight-hurt.2" 
				locunhurt "ui.fight-unhurt.2" } 
			;; incapacitated
			{ morethan 0  category 3 canwork #false color { r 209 g 44 b 40 a 255 }
				locname "ui.health.3" 
				lochurt "ui.fight-hurt.3" 
				locunhurt "ui.fight-unhurt.3" } 
			;; dead
			{ morethan -1 category 4 canwork #false color { r 209 g 44 b 40 a 255 }
				locname "ui.health.4" 
				lochurt "ui.fight-hurt.4" 
				locunhurt "ui.fight-unhurt.4" } 
		]

		crewDeath {
			supportSocial "crewdeath-sup"
			questName [ brick-wine-sink-one ] ;; fixme
			questSocial "crewdeath-sup"
			ignoreSocial "crewdeath-ign"
		}

		eliminateGangPhotos [ { sprite "Police Van" } ]
	}

	buildingSettings {
		ctrlMaxBuildingHealth { value 100 }

		ctrlAttackPoints   { value -35 mods [
			{ #type manager-exists-mod expected #true delta 5 } ;; less damage if there's a manager
		] }
		ctrlHealingPoints  { value 25 mods [
			;{ #type manager-exists-mod expected #true delta 10 } ;; heal faster if there's a manager
		] }

		humanAttackedPhotos [ { sprite "Debris" } { sprite "Postcard" lockey "postcard.building-human-attacked" } ]
		humanDestroyedPhotos [ { sprite "Debris" } { sprite "Postcard" lockey "postcard.building-human-destroyed" } ]
		gangAttackedPhotos [ { sprite "Debris" } { sprite "Postcard" lockey "postcard.building-gang-attacked" } ]
		gangDestroyedPhotos [ { sprite "Debris" } { sprite "Postcard" lockey "postcard.building-gang-destroyed" } ]

		healthTypes [
			{ morethan 95 showbar #false color { r 97 g 137 b 74 a 255 } }
			{ morethan 50 showbar #true color { r 97 g 137 b 74 a 255 } }
			{ morethan 10 showbar #true color { r 196 g 128 b 57 a 255 } }
			{ morethan -1 showbar #true color { r 209 g 44 b 40 a 255 } }
		]
	}

	businessSettings {
		startingBusinesses [ 
			;; list of business definitions - they need to have a valid starter module
			biz-grocery-starter 
			biz-grocery-starter-b
			biz-fruit-stand-starter 
			biz-fruit-stand-starter-b
			biz-barber-starter 
			biz-barber-starter-b
			biz-forge-starter 
			biz-forge-starter-b
			biz-cold-storage-starter 
			biz-cold-storage-starter-b
			biz-lumberyard-starter
			biz-lumberyard-starter-b

			;; pittsburgh
			biz-lunch-counter-starter
			biz-lunch-counter-starter-b
			biz-lunch-counter-starter
			biz-lunch-counter-starter-b

			;; cincinnati
			biz-butcher-shop-starter
			biz-butcher-shop-starter-b
			biz-butcher-shop-starter
			biz-butcher-shop-starter-b
			biz-cold-storage-starter-cincinnati
			biz-cold-storage-starter-cincinnati-b
			biz-lumberyard-starter-cincinnati
			biz-lumberyard-starter-cincinnati-b

			;; detroit
			biz-poolhall-starter
			biz-poolhall-starter-b
			biz-poolhall-starter
			biz-poolhall-starter-b

			;; philadelphia
			biz-cafe-fruit-starter
			biz-cafe-fruit-starter
			biz-cafe-fruit-starter
			biz-cafe-citrus-starter

			;; new york
			biz-funeral-home-starter
			biz-funeral-home-starter-b
			biz-florist-starter
			biz-florist-starter-b
			biz-cold-storage-starter-new-york
			biz-cold-storage-starter-new-york-b
			biz-lumberyard-starter-new-york
			biz-lumberyard-starter-new-york-b

			;; these don't have a starter module yet
			;biz-mason-starter
			;biz-tobacconist-starter 
			;biz-dairy-starter 
		] 

		positiveBlurbsAbove { value 10 }
		negativeBlurbsBelow { value -1 }
		;buySellAny { value -10 }

		buySellIllegalEtc {
			minrel { value 12 mods [
					{ #type skills-mod if [ starter-crew ] delta -4 }
					{ #type traits-mod if [ trait-nervous ] delta 5 }
					{ #type traits-mod if [ trait-careless ] delta -5 }
					{ #type traits-mod if [ trait-cautious ] delta 5 }
					{ #type traits-mod if [ trait-immoral ] delta -5 }
					{ #type traits-mod if [ trait-curious ] delta -5 }
					{ #type is-node-in-territory expected #true delta -18 }
					{ #type skills-mod if [ italian-persuasion] delta -5 }
				]
			}

			unknown   "convo.buysell.resunknown"
			unknownmo "convo.buysell.resunknown.mo"
			notrust   "convo.buysell.notrust"
			notrustmo "convo.buysell.notrust.mo"
			both      "convo.buysell.notrust-resunknown"
			bothmo    "convo.buysell.notrust-resunknown.mo"

			header	  "convo.buysell-button-header"
		}

		tiedHouseSettings {
			durationDayz { value 252 }
			costFromOwner { value -200 mods [ 
				{ #type relationship-mod is atleast value 30 multiplier 0.5 }
				{ #type traits-mod if [ trait-friendly ] multiplier 0.75 }
			]}
			costFromGang { value -500 mods [ 
				{ #type relationship-mod is lessthan value -10 multiplier 3 }
				{ #type ai-personality-mod if [ aggressive ] multiplier 2 }
			]}
			costFromHuman { value -500 mods [ 
				{ #type relationship-mod is morethan value 10 delta -10 }
				{ #type ai-personality-mod if [ peaceful ] multiplier 1.5 }
			]}
		}

		forcedClosure {
			durationDayz { value 126 }
			relBuffForOriginator relbuff-forceclose-originator
			socialForHumanCause biz-forceclose-cause
		}

		globalModuleModifiers {
			buildTimeModifier { value 1 mods [{ #type skills-mod if [ german-efficiency ] multiplier 0.8 }]}
			buildCostModifier { value 1 mods [{ #type skills-mod if [ german-efficiency ] multiplier 0.9 }]}
			destroyCostModifier	{ value 0.5 mods [{ #type skills-mod if [german-efficiency] multiplier 0.9}]}
		}
	}


}


