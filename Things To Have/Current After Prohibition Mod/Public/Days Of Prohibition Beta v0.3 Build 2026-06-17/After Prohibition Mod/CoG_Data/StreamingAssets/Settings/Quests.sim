{ quests {

    global {
        questNumberCap { value 3 mods [
                { #type controlled-biz-mod perbiz 1 skip 1 }
                { #type skills-mod if [ starter-crew ] delta 1 }
            ] }

        reqs [
        ;    { #type always-false } ;; disable quest requests while testing
            { #type check-active-quests-within-cap }
            { #type check-active-quest-count with owner is atmost value 2 }
            { #type check-waiting-quest with owner expected #false }
            { #type check-owner-relbuffs has none of [ relbuff-canadian-friend ] }
        ]

        npcStartProb { value 1 }
    }


    root {
    groups [
        {   ;; tutorial quests, always hidden
            reqs [{ #type always-false }]
            quests [
                {
                    id tutorial-money
                    locname "quest.tutorial-money.name"
                    locdesc "quest.tutorial-money.desc"
                    locicon "quest.generic.icon"
                    goals [{ #type goal-have-cash goal 1200 }]
                    choices #null
                }
                {
                    id tutorial-crocks
                    locname "quest.tutorial-crocks.name"
                    locdesc "quest.tutorial-crocks.desc"
                    locicon "quest.resources.icon"
                    goals [{ #type goal-have-goods-at-safehouse resource crocks goal 50 }]
                    choices #null
                }
                {
                    id tutorial-territory
                    locname "quest.tutorial-territory.name"
                    locdesc "quest.tutorial-territory.desc"
                    locicon "quest.territory.icon"
                    goals [{ #type goal-have-territory goal 5 }]

                    beforechoice    "quest.tutorial-territory.beforechoice"
                    choices [
                        {
                            locdesc "quest.tutorial-territory.c1"
                            grants [
                                { #type add-cash amount 400 at crew }
                                { #type start-tutorial lesson 14 }
                            ]
                        }
                    ]
                    afterchoice    "quest.tutorial-territory.afterchoice"
                }
                {
                    id tutorial-crew
                    locname "quest.tutorial-crew.name"
                    locdesc "quest.tutorial-crew.desc"
                    locicon "quest.social.icon"
                    goals [{ #type goal-have-crew goal 2 }]

                    beforechoice    "quest.tutorial-crew.beforechoice"
                    choices [
                        {
                            locdesc "quest.tutorial-crew.c1"
                            grants [
                                { #type add-cash amount 1000 at crew }
                                { #type start-tutorial lesson 15 }
                            ]
                        }
                    ]
                    afterchoice    "quest.tutorial-crew.afterchoice"
                }
                {
                    id tutorial-building
                    locname "quest.tutorial-building.name"
                    locdesc "quest.tutorial-building.desc"
                    locicon "quest.social.icon"
                    goals [{ #type goal-have-buildings goal 2 }]

                    beforechoice    "quest.tutorial-building.beforechoice"
                    choices [
                        {
                            locdesc "quest.tutorial-building.c1"
                            grants [
                                { #type add-resource id weapon-winchester qty 1 at crew }
                            ]
                        }
                    ]
                    afterchoice    "quest.tutorial-building.afterchoice"
                }
            ]
        }

        ; {
        ;     reqs [
        ;         { #type check-is-convo-at-controlled-building expected #false }
        ;         { #type check-convo-query id kb-can-intro-for-business }
        ;     ]
        ;     quests [
        ;         {
        ;             id social-test
        ;             locname "quest.social-test.name"
        ;             locdesc "quest.social-test.desc"
        ;             locicon "quest.generic.icon"
        ;             goals [
        ;                 { #type goal-deliver-cash test atleast goal 50 }
        ;             ]

        ;             requestinfo {
        ;                 introsteps [
        ;                     "quest.social-test.npc1"
        ;                     "quest.social-test.human1"
        ;                     "quest.social-test.npc2"
        ;                     "quest.social-test.human2"
        ;                 ]
        ;                 introending "quest.generic.introending"
        ;             }

        ;             beforechoice "quest.generic.beforechoice"

        ;             choices [
        ;                 {
        ;                     locdesc "convo.ticket-moduleintro-tellmore-button"
        ;                     onClick ExecuteTicketIntro
        ;                     grants [
        ;                         { #type add-rel-buff id relbuff-social-quest-complete }
        ;                     ]
        ;                 }
        ;             ]
        ;         }
        ;     ]
        ; }


        {   ;; protection quests, they are first so that desperate npcs will always request this first
            ;; it doesn't have to be burglary, but that's what we're testing with
            reqs [ 
                { #type check-building-type has any of [ business ] }
                { #type check-current-turn is atleast value 6 }
            ]
            quests [
                {   id protection-broken-burglary
                    locname "quest.protection-broken"
                    locdesc "quest.protection-broken.desc"
                    locicon "quest.fronts.icon"
                    reqs [
                        { #type check-tribute-status is paying }
                        { #type check-peep-has-history-element labelled [ burglary extortion vandalism ] }
                    ]
                    goals [
                        ;; reversed quest! goal completion leads to unhappiness
                        { #type goal-npc-gains-social-history-element labelled [ burglary extortion vandalism ] test atleast goal 1 }
                    ]

                    requestinfo {
                        introsteps [
                            "quest.protection-broken.npc1"
                            "quest.protection-broken.human1"
                            "quest.protection-broken.npc2"
                            "quest.protection-broken.human2"
                        ]
                        introending "quest.protection-broken.introending"
                    }

                    unhappyOnSuccess #true
                    beforechoice "quest.protection-broken.beforechoice"
                    choices [
                        {
                            locdesc "quest.protection-broken.c1"
                            grants [
                                { #type add-social-action id "quest-protection-neg" } ;; negative for "succeeding" the quest
                                { #type post-ticker locdesc "quest.protection-broken.ticker-body" locicon "button.info" } ;; tell the player about it
                            ]
                        }
                    ]
                    afterchoice "quest.protection-broken.afterchoice"

                    expiration {
                        expiresAfterDayz 42
                        locblurb    "convo.expired-goon-quest.finish.blurb"
                        locdesc     "convo.expired-goon-quest.finish.button"
                        locepilogue "convo.expired-goon-quest.finish.post-protected.blurb"
                        grants [
                            { #type add-social-action id "quest-protection-pos" } ;; positive for "succeeding" the quest
                        ]
                    }
                }
                {   id helping-hands-burglary
                    locname "quest.goon-trouble"
                    locdesc "quest.goon-trouble.desc"
                    locicon "quest.fronts.icon"
                    reqs [
                        { #type check-npc-gets-player-deliveries }
                        { #type check-peep-has-history-element labelled [ burglary extortion vandalism ] }
                    ]
                    goals [
                        ;; reversed quest! goal completion leads to unhappiness
                        { #type goal-npc-gains-social-history-element labelled [ burglary extortion vandalism ] test atleast goal 1 }
                    ]

                    requestinfo {
                        introsteps [
                            "quest.goon-trouble.npc1"
                            "quest.goon-trouble.human1"
                            "quest.goon-trouble.npc2"
                            "quest.goon-trouble.human2"
                        ]
                        introending "quest.goon-trouble.introending"
                    }

                    unhappyOnSuccess #true
                    beforechoice "quest.goon-trouble.beforechoice"
                    choices [
                        {
                            locdesc "quest.goon-trouble.c1"
                            grants [
                                { #type add-social-action id "goon-trouble-neg" } ;; negative for "succeeding" the quest
                                { #type post-ticker locdesc "quest.goon-trouble.ticker-body" locicon "button.info" } ;; tell the player about it
                            ]
                        }
                    ]
                    afterchoice "quest.goon-trouble.afterchoice"

                    expiration {
                        expiresAfterDayz 42
                        locblurb    "convo.expired-goon-quest.finish.blurb"
                        locdesc     "convo.expired-goon-quest.finish.button"
                        locepilogue "convo.expired-goon-quest.finish.post.blurb"
                        grants [
                            { #type add-social-action id "goon-trouble-pos" } ;; positive for "failing" the quest
                        ]
                    }
                }
            ]
        } ;; end group

        { ;; grant for new buildng
            debugname "quest group new building"

            reqs [
                { #type check-building-type has any of [ business ] }
                { #type check-current-turn is atleast value 6 }
                { #type check-player-territory-size is atleast value 6 }
                { #type check-is-convo-at-controlled-building expected #false }
                { #type check-did-buy-sell-anything expected #true }
                { #type check-potential-biz-building }
                { #type check-potential-biz-family }
                { #type check-is-convo-at-corner-with-controlled-building expected #false }
                { #type check-quests has all of [ outpost-building-takeover family-building-takeover ethnic-building-takeover ] status neverstarted }
                { #type check-module-in-player-territory has any of [ 
                    production-homebooze-brick-wine production-homebooze-brick-wine-dock production-homebooze-brick-wine-improved production-homebooze-brick-wine-improved-upgrade production-homebooze-cider production-homebooze-cider-dock production-homebooze-cider-improved production-homebooze-cider-improved-upgrade 
                    production-homebooze-home-brew production-homebooze-home-brew-dock production-homebooze-home-brew-improved production-homebooze-home-brew-improved-upgrade production-homebooze-moonshine production-homebooze-moonshine-dock production-homebooze-moonshine-improved production-homebooze-moonshine-improved-upgrade 
                    production-homebooze-apple-jack-a production-homebooze-apple-jack-b production-homebooze-apple-jack-improved production-homebooze-apple-jack-improved-upgrade
                    production-homebooze-corn-moonshine production-homebooze-corn-moonshine-improved production-homebooze-corn-moonshine-improved-upgrade
                    production-homebooze-fruit-wine production-homebooze-fruit-wine-improved production-homebooze-fruit-wine-improved-upgrade
                    production-homebooze-homemade-brandy production-homebooze-homemade-brandy-improved-upgrade
                ] }
            ]
            quests [
                { ;; has outpost - first choice
                    id outpost-building-takeover
                    locname "quest.outpost-building-takeover.name"
                    locdesc "quest.outpost-building-takeover.desc"
                    locicon "quest.building.icon"
                    goals [
                        { #type goal-deliver-cash test atleast goal 500 }
                    ]
                    reqs [
                        { #type check-has-outpost location this-building expected #true }
                        { #type check-outpost-expanding expected #false }
                    ]

                    requestinfo {
                        introsteps [
                            "quest.outpost-building-takeover.npc1"
                            "quest.outpost-building-takeover.human1"
                            "quest.outpost-building-takeover.npc2"
                            "quest.outpost-building-takeover.human2"
                        ]
                        introending "quest.outpost-building-takeover.introending"
                    }

                    beforechoice "quest.outpost-building-takeover.beforechoice"
                    choices [
                        {
                            locdesc "quest.outpost-building-takeover.c1"
                            grants [
                                { #type grant-building }
                            ]
                        }
                    ]
                    afterchoice "quest.outpost-building-takeover.afterchoice"
                }
                { ;; is a family member (close or otherwise)
                    id family-building-takeover
                    locname "quest.family-building-takeover.name"
                    locdesc "quest.family-building-takeover.desc"
                    locicon "quest.building.icon"
                    goals [
                        { #type goal-deliver-cash test atleast goal 300 }
                    ]
                    reqs [
                        { #type check-is-convo-inside-territory player human expected #true }
                        { #type check-relationship-exists from player oftype family }
                    ]

                    requestinfo {
                        introsteps [
                            "quest.family-building-takeover.npc1"
                            "quest.family-building-takeover.human1"
                            "quest.family-building-takeover.npc2"
                            "quest.family-building-takeover.human2"
                        ]
                        introending "quest.family-building-takeover.introending"
                    }

                    beforechoice "quest.family-building-takeover.beforechoice"
                    choices [
                        {
                            locdesc "quest.family-building-takeover.c1"
                            grants [
                                { #type grant-building }
                            ]
                        }
                    ]
                    afterchoice "quest.family-building-takeover.afterchoice"
                }
                { ;; same ethnicity - after territory expansion...
                    id ethnic-building-takeover
                    locname "quest.ethnic-building-takeover.name"
                    locdesc "quest.ethnic-building-takeover.desc"
                    locicon "quest.building.icon"
                    goals [
                        { #type goal-deliver-cash test atleast goal 400 }
                    ]
                    reqs [
                        { #type check-player-same-ethnicity }
                        { #type check-is-convo-inside-territory player human expected #true }
                        { #type check-player-territory-size is atleast value 4 }
                        { #type check-relationship-exists from player oftype acquaintance }
                        { #type check-immigrant is player expected #true }
                        { #type check-immigrant is owner expected #true }
                        { #type check-relationship-milestones is atleast value 1 }
                    ]

                    requestinfo {
                        introsteps [
                            "quest.ethnic-building-takeover.npc1"
                            "quest.ethnic-building-takeover.human1"
                            "quest.ethnic-building-takeover.npc2"
                            "quest.ethnic-building-takeover.human2"
                        ]
                        introending "quest.ethnic-building-takeover.introending"
                    }

                    beforechoice "quest.ethnic-building-takeover.beforechoice"
                    choices [
                        {
                            locdesc "quest.ethnic-building-takeover.c1"
                            grants [
                                { #type grant-building }
                            ]
                        }
                    ]
                    afterchoice "quest.ethnic-building-takeover.afterchoice"
                }
            ]
        }

        { ;; JUMP STARTER QUESTS
            debugname "quest group jumpstarter"

            reqs [
                { #type check-building-type has any of [ business ] }
                { #type check-is-convo-at-controlled-building expected #false }
                { #type check-illegal-goods are locked }
                { #type check-owner-relationship is moreorequalto value -4 }
                { #type check-owner-relationship is lessorequalto value 15 }
                { #type check-quests has none of [ brick-wine-sink-one cider-sink-one home-brew-sink-one moonshine-sink-one neutral-alcohol-source-one neutral-alcohol-source-two apple-jack-sink-one fruit-wine-sink-one homemade-brandy-sink-one ] status active }
                { #type check-player-produced-total resource sparkling-cider is lessthan value 1 }
                { #type check-player-produced-total resource fake-wine is lessthan value 1 }
                { #type check-player-produced-total resource fake-beer is lessthan value 1 }
                { #type check-player-produced-total resource bathtub-gin is lessthan value 1 }
                { #type check-player-produced-total resource fruit-brandy is lessthan value 1 }
                { #type check-player-produced-total resource corn-whiskey is lessthan value 1 }
                { #type check-player-produced-total resource amaretto is lessthan value 1 }
                { #type check-current-turn is lessthan value 100 }
            ]
            quests [
                {
                    id brick-wine-sink-one
                    locname "quest.brick-wine-sink-one.name"
                    locdesc "quest.brick-wine-sink-one.desc"
                    locicon "quest.homebooze.icon"
                    goals [
                        { #type goal-deliver-goods resource brick-wine test atleast goal 5 }
                    ]
                    reqs [
                        { #type check-quests has all of [ brick-wine-sink-one ] status neverstarted with owner }
                        { #type check-module-in-player-territory has any of [ fruit-store-starter small-lumberyard-starter production-homebooze-brick-wine production-homebooze-brick-wine-dock production-homebooze-brick-wine-improved production-homebooze-brick-wine-improved-upgrade ] scope player-only }
                        { #type check-module-with-skill-tags has any of [ tag-quest-brick-wine-sink ] }
                    ]

                    requestinfo {
                        introsteps [
                            "quest.homebooze-sink.npc1"
                            "quest.brick-wine-sink-one.human1"
                            "quest.homebooze-sink.npc2"
                            "quest.homebooze-sink.human2"
                        ]
                        introending "quest.homebooze-sink.introending"
                    }

                    beforechoice "quest.brick-wine-sink-one.beforechoice"
                    choices [
                        {
                            locdesc "quest.homebooze-sink.c1"
                            grants [
                                { #type add-rel-buff with owner id "relbuff-quest-homebooze" }
                            ]
                        }
                    ]
                    afterchoice "quest.homebooze-sink.afterchoice"
                }
                {
                    id cider-sink-one
                    locname "quest.cider-sink-one.name"
                    locdesc "quest.cider-sink-one.desc"
                    locicon "quest.homebooze.icon"
                    reqs [
                        { #type check-quests has all of [ cider-sink-one ] status neverstarted with owner }
                        { #type check-module-in-player-territory has any of [ source-grocery-starter source-cold-storage-small-starter production-homebooze-cider production-homebooze-cider-dock production-homebooze-cider-improved production-homebooze-cider-improved-upgrade ] scope player-only }
                        { #type check-module-with-skill-tags has any of [ tag-quest-cider-sink ] }
                    ]
                    goals [
                        { #type goal-deliver-goods resource cider test atleast goal 5 }
                    ]

                    requestinfo {
                        introsteps [
                            "quest.homebooze-sink.npc1"
                            "quest.cider-sink-one.human1"
                            "quest.homebooze-sink.npc2"
                            "quest.homebooze-sink.human2"
                        ]
                        introending "quest.homebooze-sink.introending"
                    }

                    beforechoice "quest.cider-sink-one.beforechoice"
                    choices [
                        {
                            locdesc "quest.homebooze-sink.c1"
                            grants [
                                { #type add-rel-buff with owner id "relbuff-quest-homebooze" }
                            ]
                        }
                    ]
                    afterchoice "quest.homebooze-sink.afterchoice"
                }
                {
                    id home-brew-sink-one
                    locname "quest.home-brew-sink-one.name"
                    locdesc "quest.home-brew-sink-one.desc"
                    locicon "quest.homebooze.icon"
                    reqs [
                        { #type check-quests has all of [ home-brew-sink-one ] status neverstarted with owner }
                        { #type check-module-in-player-territory has any of [ source-forge-front-starter source-deli-starter production-homebooze-home-brew production-homebooze-home-brew-dock production-homebooze-home-brew-dock production-homebooze-home-brew-improved production-homebooze-home-brew-improved-upgrade ] scope player-only }
                        { #type check-module-with-skill-tags has any of [ tag-quest-home-brew-sink ] }
                    ]
                    goals [
                        { #type goal-deliver-goods resource home-brew test atleast goal 5 }
                    ]

                    requestinfo {
                        introsteps [
                            "quest.homebooze-sink.npc1"
                            "quest.home-brew-sink-one.human1"
                            "quest.homebooze-sink.npc2"
                            "quest.homebooze-sink.human2"
                        ]
                        introending "quest.homebooze-sink.introending"
                    }

                    beforechoice "quest.home-brew-sink-one.beforechoice"
                    choices [
                        {
                            locdesc "quest.homebooze-sink.c1"
                            grants [
                                { #type add-rel-buff with owner id "relbuff-quest-homebooze" }
                            ]
                        }
                    ]
                    afterchoice "quest.homebooze-sink.afterchoice"
                }
                {
                    id moonshine-sink-one
                    locname "quest.moonshine-sink-one.name"
                    locdesc "quest.moonshine-sink-one.desc"
                    locicon "quest.homebooze.icon"
                    reqs [
                        { #type check-quests has all of [ moonshine-sink-one ] status neverstarted with owner }
                        { #type check-module-in-player-territory has any of [ flavor-barber-starter butcher-starter production-homebooze-moonshine production-homebooze-moonshine-dock production-homebooze-moonshine-improved production-homebooze-moonshine-improved-upgrade production-homebooze-corn-moonshine production-homebooze-corn-moonshine-improved production-homebooze-corn-moonshine-improved-upgrade ] scope player-only }
                        { #type check-module-with-skill-tags has any of [ tag-quest-moonshine-sink ] }
                    ]
                    goals [
                        { #type goal-deliver-goods resource moonshine test atleast goal 5 }
                    ]

                    requestinfo {
                        introsteps [
                            "quest.homebooze-sink.npc1"
                            "quest.moonshine-sink-one.human1"
                            "quest.homebooze-sink.npc2"
                            "quest.homebooze-sink.human2"
                        ]
                        introending "quest.homebooze-sink.introending"
                    }

                    beforechoice "quest.moonshine-sink-one.beforechoice"
                    choices [
                        {
                            locdesc "quest.homebooze-sink.c1"
                            grants [
                                { #type add-rel-buff with owner id "relbuff-quest-homebooze" }
                            ]
                        }
                    ]
                    afterchoice "quest.homebooze-sink.afterchoice"
                }
                {
                    id apple-jack-sink-one
                    locname "quest.apple-jack-sink-one.name"
                    locdesc "quest.apple-jack-sink-one.desc"
                    locicon "quest.homebooze.icon"

                    reqs [
                        { #type check-quests has all of [ apple-jack-sink-one ] status neverstarted with owner }
                        { #type check-module-in-player-territory has any of [ flavor-restaurant-starter production-homebooze-apple-jack-a production-homebooze-apple-jack-b production-homebooze-apple-jack-improved production-homebooze-apple-jack-improved-upgrade ] }
                        { #type check-module-with-skill-tags has any of [ tag-quest-apple-jack-sink ] }
                    ]
                    goals [
                        { #type goal-deliver-goods resource apple-jack test atleast goal 5 }
                    ]

                    requestinfo {
                        introsteps [
                            "quest.homebooze-sink.npc1"
                            "quest.apple-jack-sink-one.human1"
                            "quest.homebooze-sink.npc2"
                            "quest.homebooze-sink.human2"
                        ]
                        introending "quest.homebooze-sink.introending"
                    }

                    beforechoice "quest.apple-jack-sink-one.beforechoice"
                    choices [
                        {
                            locdesc "quest.homebooze-sink.c1"
                            grants [
                                { #type add-rel-buff with owner id "relbuff-quest-homebooze" }
                            ]
                        }
                    ]
                    afterchoice "quest.homebooze-sink.afterchoice"
                }
                {
                    id fruit-wine-sink-one
                    locname "quest.fruit-wine-sink-one.name"
                    locdesc "quest.fruit-wine-sink-one.desc"
                    locicon "quest.homebooze.icon"

                    reqs [
                        { #type check-quests has all of [ fruit-wine-sink-one ] status neverstarted with owner }
                        { #type check-module-in-player-territory has any of [ pool-hall-starter production-homebooze-fruit-wine production-homebooze-fruit-wine-improved production-homebooze-fruit-wine-improved-upgrade ] }
                        { #type check-module-with-skill-tags has any of [ tag-quest-fruit-wine-sink ] }
                    ]
                    goals [ { #type goal-deliver-goods resource fruit-wine test atleast goal 5 } ]

                    requestinfo {
                        introsteps [
                            "quest.homebooze-sink.npc1"
                            "quest.fruit-wine-sink-one.human1"
                            "quest.homebooze-sink.npc2"
                            "quest.homebooze-sink.human2"
                        ]
                        introending "quest.homebooze-sink.introending"
                    }

                    beforechoice "quest.fruit-wine-sink-one.beforechoice"
                    choices [
                        {
                            locdesc "quest.homebooze-sink.c1"
                            grants [
                                { #type add-rel-buff with owner id "relbuff-quest-homebooze" }
                            ]
                        }
                    ]
                    afterchoice "quest.homebooze-sink.afterchoice"
                }
                {
                    id homemade-brandy-sink-one
                    locname "quest.homemade-brandy-sink-one.name"
                    locdesc "quest.homemade-brandy-sink-one.desc"
                    locicon "quest.homebooze.icon"

                    reqs [
                        { #type check-quests has all of [ homemade-brandy-sink-one ] status neverstarted with owner }
                        { #type check-module-in-player-territory has any of [ cafe-starter-fruit cafe-starter-citrus production-homebooze-homemade-brandy production-homebooze-homemade-brandy-improved-upgrade ] }
                        { #type check-module-with-skill-tags has any of [ tag-quest-homemade-brandy-sink ] }
                    ]
                    goals [ { #type goal-deliver-goods resource homemade-brandy test atleast goal 5 } ]

                    requestinfo {
                        introsteps [
                            "quest.homebooze-sink.npc1"
                            "quest.homemade-brandy-sink-one.human1"
                            "quest.homebooze-sink.npc2"
                            "quest.homebooze-sink.human2"
                        ]
