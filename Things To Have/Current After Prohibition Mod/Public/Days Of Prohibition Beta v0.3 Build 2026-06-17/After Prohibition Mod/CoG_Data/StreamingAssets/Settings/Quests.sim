        ;; pittsburgh-specific quests (those that don't follow a general template)

        { 
            reqs [
                { #type check-building-type has any of [ business ] }
                { #type check-is-convo-at-controlled-building expected #false }
                { #type check-current-city is any of [ pittsburgh ] }
            ]
            quests [
                {
                    id bottle-rack-build
                    locname "quest.bottle-rack-build.name"
                    locdesc "quest.bottle-rack-build.desc"
                    locicon "skill.knowledge-general.icon"
                    reqs [
                        { #type always-false }
                    ]
                    goals [
                        { #type goal-deliver-cash test atleast goal 300 }
