        ;; cincinnati-specific quests (those that don't follow a general template)

        {   ;; for selling off large amounts of bourbon
            reqs [
                { #type check-current-city is any of [ cincinnati ] }
                { #type check-is-convo-at-controlled-building expected #false }
            ]
            quests [
                {
                    id bourbon-unlock-moonshine
                    locname "quest.bourbon-unlock.name"
                    locdesc "quest.bourbon-unlock.desc"
                    locicon "quest.bottles.icon"

                    reqs [
                        { #type check-player-skills has all of [ corn-whiskey ] }
                        { #type check-owner-relbuffs has all of [ relbuff-bourbon-knowledge ] }
                        { #type check-player-unlocked-resources has none of [ bourbon ] }
                        { #type check-quests has none of [ bourbon-reveal-quest bourbon-unlock-moonshine bourbon-unlock-kentuckians bourbon-unlock-kentucky-brick-wine bourbon-unlock-kentucky-cider bourbon-unlock-kentucky-home-brew bourbon-unlock-kentucky-moonshine ] status active }
                    ]
                    goals [
                        { #type goal-deliver-goods resource corn-whiskey test atleast goal 10 }
                    ]

                    requestinfo {
                        introsteps [
                            "quest.bourbon-unlock-moonshine.npc1"
                            "quest.bourbon-unlock.human1"
                            "quest.bourbon-unlock-moonshine.npc2"
                            "quest.bourbon-unlock.human2"
                        ]
                        introending "quest.bourbon-unlock.introending"
                    }

                    beforechoice "quest.bourbon-unlock-moonshine.beforechoice"
                    choices [
                        {
                            locdesc "quest.bourbon-unlock.c1"
                            grants [
                                { #type add-skill id bourbon-reveal }
                                { #type add-rel-buff with owner id "relbuff-social-quest-complete" }
                            ]
                        }
                    ]
                    afterchoice "quest.bourbon-general.afterchoice"
                }
                {
                    id bourbon-unlock-kentuckians
                    locname "quest.bourbon-unlock.name"
