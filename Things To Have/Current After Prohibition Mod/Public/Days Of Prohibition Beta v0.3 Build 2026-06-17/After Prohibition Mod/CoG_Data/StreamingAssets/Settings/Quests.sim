                        { #type check-relationship-tickets is atleast value 1 }
                        { #type check-player-skills has any of [ improved-homebooze-brick-wine improved-homebooze-cider improved-homebooze-home-brew improved-homebooze-moonshine ] }
                        { #type check-player-unlocked-resources has none of [ bourbon ] }
                        { #type check-quests has none of [ bourbon-reveal-quest bourbon-unlock-moonshine bourbon-unlock-kentuckians bourbon-unlock-kentucky-brick-wine bourbon-unlock-kentucky-cider bourbon-unlock-kentucky-home-brew bourbon-unlock-kentucky-moonshine ] status active }
                    ]
                    goals [
                        { #type goal-deliver-cash test atleast goal 500 }
                    ]

                    requestinfo {
                        introsteps [
                            "quest.bourbon-unlock-kentuckians.npc1"
                            "quest.bourbon-unlock.human1"
                            "quest.bourbon-unlock-kentuckians.npc2"
