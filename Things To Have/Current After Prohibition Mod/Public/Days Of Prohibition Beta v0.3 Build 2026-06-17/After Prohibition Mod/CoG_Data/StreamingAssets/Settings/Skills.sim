{ skills {


items [


;; homebrewing manufacture skills

{
	id homebooze-moonshine
	locname "skill.homebooze-moonshine.name"
	locdesc "skill.homebooze-moonshine.desc"
	locconv "skill.homebooze-moonshine.conv"
	locicon "skill.homebooze-moonshine.icon"

	banner "TODO"
	tags [ tag-skills-moonshine ]

	unlocksResources [ corn-syrup ]

	reqs [ 
	]
	visreqs [ 
		{ #type check-can-buy-sell playercan buyorsell } 
		{ #type check-current-city is none of [ cincinnati new-york ] }
		{ #type check-quests has none of [ 
			homebooze-moonshine-quest 
			;vehicle-quest-pickup-three-home-brew player-same-ethnicity-one native-born-one bootlegger-build-bonus-brick-wine bootlegger-build-bonus-cider bootlegger-build-bonus-home-brew 
		] status active }
		{ #type check-player-territory-size is moreorequalto value 5 }
	]

	quest {
		id homebooze-moonshine-quest
		locname "skill.homebooze-moonshine-quest.name"
		locdesc "skill.homebooze-moonshine-quest.desc"
		locicon "skill.homebooze-moonshine.icon"
		skillquest #true
		goals [
			{ #type goal-deliver-goods resource neutral-alcohol test atleast goal 16 }
		]

        beforechoice "quest.generic-skill.beforechoice"
        choices [ {
            locdesc "quest.generic-skill.button"
			grants [ { #type grant-skill-from-quest } { #type add-skill-rel-bump } ]
        } ]
        afterchoice  "quest.generic-skill.afterchoice"
	}
}
