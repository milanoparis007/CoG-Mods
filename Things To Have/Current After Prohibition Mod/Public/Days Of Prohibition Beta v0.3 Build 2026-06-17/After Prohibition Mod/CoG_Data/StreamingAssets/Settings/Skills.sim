experience
{
	points [ {
		source from-driving  ;; every driving action
		points { value 1 mods [
				{ #type traits-mod if [ trait-intelligent ] delta 1 }
				{ #type traits-mod if [ trait-sharpeyed ] multiplier 1.2 }
				{ #type traits-mod if [ trait-myopic ] multiplier 0.5 }
			] }
	} {
	  	source from-combat   ;; attack only
		points { value 190 mods [
			{ #type traits-mod if [ trait-aggressive ] delta 5 }
			{ #type traits-mod if [ trait-strong ] delta 5 }
			{ #type traits-mod if [ trait-weak ] delta 1 }
			{ #type traits-mod if [ trait-religious trait-upright ] multiplier 2 }
			{ #type traits-mod if [ trait-cruel trait-agile trait-vindictive ] multiplier 3 }
		] }
	} {
	 	source from-module	 ;; being a manager during a production cycle
		points { value 10 mods [
			{ #type traits-mod if [ trait-intelligent ] delta 2  }
			{ #type traits-mod if [ trait-hardworking ] multiplier 1.2 }
			{ #type traits-mod if [ trait-organized ] multiplier 1.2 }
			{ #type traits-mod if [ trait-lazy ] multiplier 0.8 }
			{ #type traits-mod if [ trait-careless ] multiplier 0.8 }
		] }   ;; TODO
	} {
		source from-delivery ;; a single automation step (on top of driving)
		points { value 10 mods [
				{ #type traits-mod if [ trait-intelligent ] delta 1 }
				{ #type traits-mod if [ trait-talkative ] multiplier 1.2 }
				{ #type traits-mod if [ trait-irritable ] multiplier 0.75 }
				{ #type skills-mod if [ starter-buildings ] multiplier 1.25 }
			] }
	} {
		source from-social ;; getting xp from social action
		points { value 30 mods [
			{ #type traits-mod if [ trait-sociable trait-friendly ] delta 2 }
			{ #type traits-mod if [ trait-irritable trait-unkind ] delta -2 }
		] }
	} {
		source from-gambler	;; whenever a gambler shows up
		points { value 10 mods [
			{ #type traits-mod if [ trait-friendly trait-talkative trait-religous trait-mellow ] delta 5 }
			{ #type traits-mod if [ trait-irritable trait-quiet ] delta -1 }
		] }
	} ]

	tuning {
		firstThreshold { value 40 mods [
			{ #type traits-mod if [ trait-intelligent ] delta -5 }
			{ #type traits-mod if [ trait-slow ] delta 5 }
		] }
		thresholdMultiplier { value 1.5 }
	}

	levelups [
	{
		id 			levelup-captain
		highest		1
		captain		#true ;; note: special
		locname		"levelup.captain.name"
		locdesc		"levelup.captain.desc"
		locicon		"levelup.captain.icon"
		hint		hintLevelupCaptain
		visreqs 	[
			{ #type check-crew-peep is notplayer }
			{ #type check-crew-rank is none }
			{ #type check-crew-peep-level id levelup-hoodsgang is atleast value 1 }
		]
	} {
		id 			levelup-leader1
		highest		1
		locname		"levelup.leader1.name"
		locdesc		"levelup.leader1.desc"
		locicon		"levelup.leader1.icon"
		hint		hintLevelupCombat
		visreqs		[
			{ #type check-crew-peep-level id levelup-streetcred2 is atleast value 1 }
		]
	} {
