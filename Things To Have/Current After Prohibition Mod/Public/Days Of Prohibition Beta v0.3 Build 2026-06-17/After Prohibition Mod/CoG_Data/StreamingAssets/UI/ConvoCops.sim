{

convos {

	cop-toplevel {
		npcsays [
			{ lockey "convo.cops.toplevel.waiting" reqs [{ #type check-cop-waiting expected #true }] }
			{ #type relationship-based-blurb rootkey "convo.cops.toplevel.blurb" }
		]

		buttons [ 

	{
		;; you wanted to talk to me about something?
		visreqs [{ #type check-gang-has-convo-initiative type any }]
		reqs 	[]

		onShow	StoreGangConvoInitiative
		text	{ key "convo.gangs.initiative" }
		next	{ #type next-state-chain defs [
					{ reqs [ { #type check-gang-has-convo-initiative type truce } ] then gang-init-truce }
					{ reqs [ { #type check-gang-has-convo-initiative type tied-house } ] then gang-init-tied-house }
					{ reqs [ { #type check-gang-has-convo-initiative type expansion-halt } ] then gang-init-expansion-treaty }
					{ reqs [ { #type check-gang-has-convo-initiative type joint-war } ] then gang-init-joint-war }
					{ reqs [ { #type check-gang-has-convo-initiative type stolen-outpost } ] then gang-init-stolen-outpost }
				] default cop-toplevel }
	}

	{	;; "let's have a truce"
		visreqs [{ #type check-gang-conflict-truce expected #false }
				 { #type check-gang-has-convo-initiative type none }]
		reqs    [{ #type check-gang-conflict-trucedays }
				 { #type check-convo-actions has enough }
				]
		text 	{ key "convo.gangs.truce.button" }
		next 	{ reqs 	[{ #type check-gang-has-history-element-to-human labelled [ gang-broke-truce ] }]
				  then	gang-truce-broken
				  else	gang-truce
				}
	}
		{	;; opportunity to suck up if the relationship is not positive
			visreqs []
			text {
				key "convo.cops.compliment.say" npc "convo.cops.compliment.npc"
			}

			grants [{ #type add-rel-buff with owner id "relbuff-cop-compliment" }
			]
			next { goto cop-toplevel }
		}
		{	;; "i would love to show my appreciation for all your hard work"
			visreqs [	
				{ #type check-owner-relationship is atleast value 0 }
				{ #type check-cop-donation expected #false }
			]
			reqs [{ #type check-owner-relationship is atleast value 5 }]

			text { key "convo.cops.donation-intro.say" }

			next	{ reqs [{ #type check-owner-relationship is atleast value 15 }]
					  then cop-donation-step1 
					  else cop-donation-rejected }
		}

		{	;; say, would you pass this along to the feds?
			visreqs [	
				{ #type check-relationship-tickets is atleast value 1 }
			]
			reqs [
				{ #type check-cop-donation expected #true }
				{ #type check-cop-knows-aggro-gang truce #false }
			]

			text { key "convo.cops.fedhint.say" icon "convo.cops.fedhint.icon" }
			next { goto cop-fedhint-step1 }
		}
		{	;; "glad we have a good working relationship"
			visreqs [	
				{ #type check-cop-donation expected #true }
			]

			text { key "convo.cops.donation-happy.say" npc "convo.cops.donation-happy.npc" }

			grants [{ #type add-rel-buff with owner id "relbuff-cop-compliment" }]
			onClick	Goodbye
		}

		{	;; so i have this acquaintance in federal jail
			visreqs [
				{ #type check-player-crew-in-jail select in-jail-not-bribed is atleast value 1 }
			]
			reqs [
				{ #type check-crew-role id advisor }
				{ #type check-owner-relationship is atleast value 15 }
			]

			onShow StoreCopJailOffer
			text { key "convo.cops.jailpay.say" icon "convo.cops.jailpay.icon" }
			next { goto cop-jailpay-step1 }
		}
		{	;; so about this jailed acquaintance we talked about
			visreqs [
				{ #type check-player-crew-in-jail select in-jail-bribed is atleast value 1 }
			]

			text { key "convo.cops.jailpaid.say" icon "convo.cops.jailpaid.icon" }
			next { goto cop-jailpaid-step1 }
		}
		{	;; find any good weapons on your beat?
			visreqs [
				{ #type check-relationship-tickets is atleast value 1 }
				{ #type check-cop-donation expected #true }
				{ #type check-owner-relbuffs has none of [ relbuff-cop-weapon-drop ] }
			]
			reqs [
				
			]
			text { key "convo.cops.weapons.inquire" icon "convo.cops.weapons.icon" }
			next { goto cop-weapons-step1 }
		}
		{	;; find any good weapons on your beat? - buff active
			visreqs [
				{ #type check-relationship-tickets is atleast value 1 }
				{ #type check-cop-donation expected #true }
				{ #type check-owner-relbuffs has any of [ relbuff-cop-weapon-drop ] }
			]
			reqs [
				{ #type check-owner-relbuffs has none of [ relbuff-cop-weapon-drop ] }
			]
			text { key "convo.cops.weapons.inquire" icon "convo.cops.weapons.icon" }
			next { goto cop-weapons-step1 }
		}

		{	;; opportunity to suck up if the relationship is not positive
			visreqs [{ #type check-crew-peep is notplayer }{ #type check-player-cash type current is morethan value 5000 }{ #type check-crew-stat type individual id peeps-killed is atleast value 1 }]
			text {
				key "convo.cops.snitch.say" npc "convo.cops.snitch.npc" icon "convo.cops.fedhint.icon"
			}

			grants [{ #type arrest-crew }
			{ #type add-rel-buff with owner id "relbuff-cop-compliment2" }
			{ #type add-cash amount -5000 at safehouse }]
			next { goto cop-toplevel }
		}
		{	;; opportunity to suck up if the relationship is not positive
			visreqs [{ #type check-crew-peep is notplayer }{ #type check-player-cash type current is morethan value 5000 }{ #type check-crew-peep-level id levelup-dealer is atleast value 1 }]
			text {
				key "convo.cops.snitch.say" npc "convo.cops.snitch.npc" icon "convo.cops.fedhint.icon"
			}

			grants [{ #type arrest-crew }{ #type add-rel-buff with owner id "relbuff-cop-compliment2" }{ #type add-cash amount -5000 at safehouse }]
			next { goto cop-toplevel }
		}
		{	;; unprovoked attack
			;;visreqs [  ]
			reqs    [{ #type check-convo-actions has enough }]
			text	{ key "convo.gangs.fight.button" icon "convo.gangs.fight.icon" }
			next	{ goto cop-fight-confirmation }
		}

		{	;; so this is goodbye
			text {
				key "convo.cops.goodbye" icon "convo.icon-leave" mo "convo.goodbye-button.mo"
			}
			onClick	Goodbye
		}
		]
	}

	;; combat

		cop-fight-confirmation {
			npcsays [{ lockey "convo.gangs.fight.blurb"}]
			buttons [
			{	;; do the deed
			reqs 	[{ #type check-convo-actions has enough }]
			text	{ key "convo.gangs.fight.confirm" addmo #true }
			onShow  StoreCombat
			onClick ExecuteCombat
			grants [{ #type consume-actions for convo }]
		}
	{	;; goodbye
		text { key "convo.gangs.fight.cancel" icon "convo.icon-leave" mo "convo.goodbye-button.mo" }
		onClick	Goodbye
	}
	]
}

	;; donations

	cop-donation-rejected {
		npcsays [{ lockey "convo.cops.donation-rejected.npc" }]
		buttons [{
			text { key "convo.cops.donation-rejected.say" icon "convo.icon-leave" }
			onClick Goodbye
		}]
	}

	cop-donation-step1 {
		npcsays [{ lockey "convo.cops.donation-step1.npc" }]
		buttons [{
			text { key "convo.cops.donation-step1.say" }
			onShow StoreCopDonation
			next { goto cop-donation-step2 }
		}]
	}
	cop-donation-step2 {
		npcsays [
			{ lockey "convo.cops.donation-step2.npc.alt" reqs [{ #type check-cop-waiting expected #true }] }
			{ lockey "convo.cops.donation-step2.npc" }
		]
		buttons [{
			text { key "convo.cops.donation-step2.say" }
			next { goto cop-donation-step3 }
		}]
	}
	cop-donation-step3 {
		npcsays [{ lockey "convo.cops.donation-step3.npc" }]
		buttons [{
			reqs [{ #type special-can-pay-for-cop-donation }]
			text { 	key "convo.cops.donation-step3.sayyes" 
					npc "convo.cops.donation-step3.epiyes" icon "convo.icon-check" }
					
			onClick ExecuteCopDonation
			next { goto cop-toplevel }
		} {
			text { key "convo.cops.donation-step3.sayno" npc "convo.cops.donation-step3.epino" icon "convo.icon-back" }
			next { goto cop-toplevel }
		}]
	}

	;; fed raids

	cop-fedhint-step1 {
		npcsays [{ lockey "convo.cops.fedhint-step1.npc" }]
		buttons [{
			onShow StoreCopFedHint
			text { key "convo.cops.fedhint-step1.say" } 
			next { reqs [{ #type special-can-execute-cop-fed-hint }] 
				   then cop-fedhint-step2 
				   else cop-fedhint-later }
		}]
	}
	cop-fedhint-step2 {
		npcsays [{ lockey "convo.cops.fedhint-step2.npc" }]
		buttons [{
			text { key "convo.cops.fedhint-step2.say" }
			next { goto cop-fedhint-step3 }
		}]
	}
	cop-fedhint-step3 {
		npcsays [{ lockey "convo.cops.fedhint-step3.npc" }]
		buttons [{
			text { 	key "convo.cops.fedhint-step3.sayyes" 
					npc "convo.cops.fedhint-step3.epiyes" icon "convo.icon-check" }
					
			onClick ExecuteCopFedHint
			grants [
				;{ #type add-rel-buff id "relbuff-cop-fedhint" }
				{ #type consume-tickets count 1 }
			]
			next { goto cop-toplevel }
		} {
			text { key "convo.cops.fedhint-step3.sayno" npc "convo.cops.fedhint-step3.epino" icon "convo.icon-back" }
			next { goto cop-toplevel }
		}]
	}

	cop-fedhint-later {
		npcsays [{ lockey "convo.cops.fedhint-later.npc" }]
		buttons [{
			text { key "convo.cops.fedhint-later.say" } 
			next { goto cop-toplevel }
		}]
	}


	;; bribe while awaiting trial

	cop-jailpay-step1 {
		npcsays [{ lockey "convo.cops.jailpay-step1.npc" }]
		buttons [{
			text { key "convo.cops.jailpay-step1.say" } 
			next { goto cop-jailpay-step2 }
		}]
	}
	cop-jailpay-step2 {
		npcsays [{ lockey "convo.cops.jailpay-step2.npc" }]
		buttons [{
			text { key "convo.cops.jailpay-step2.say" }
			next { goto cop-jailpay-step3 }
		}]
	}
	cop-jailpay-step3 {
		npcsays [{ lockey "convo.cops.jailpay-step3.npc" }]
		buttons [{
			text { key "convo.cops.jailpay-step3.say" }
			next { goto cop-jailpay-step4 }
		}]
	}
	cop-jailpay-step4 {
		npcsays [{ lockey "convo.cops.jailpay-step4.npc" }]
		buttons [{
			reqs [{ #type special-can-pay-for-cop-jail-bribe }]
			text { 	key "convo.cops.jailpay-step4.sayyes" 
					npc "convo.cops.jailpay-step4.epiyes" icon "convo.icon-check" }
					
			onClick ExecuteCopJailOffer
			next { goto cop-toplevel }
		} {
			text { key "convo.cops.jailpay-step4.sayno" npc "convo.cops.jailpay-step4.epino" icon "convo.icon-back" }
			next { goto cop-toplevel }
		}]
	}

	cop-jailpaid-step1 {
		npcsays [{ lockey "convo.cops.jailpaid-step1.npc" }]
		buttons [{
			text { key "convo.cops.jailpaid-step1.say" } 
			next { goto cop-jailpaid-step2 }
		}]
	}
	cop-jailpaid-step2 {
		npcsays [{ lockey "convo.cops.jailpaid-step2.npc" }]
		buttons [{
			text { key "convo.cops.jailpaid-step2.say" npc "convo.cops.jailpaid-step2.epi" } 
			next { goto cop-toplevel }
		}]
	}

	;; weapons found
	cop-weapons-step1 {
		npcsays [ { lockey "convo.cops.weapons.look-what-i-found" } ]
		buttons [
			{
				reqs [ { #type check-relationship-tickets is atleast value 2 } ]
				text { key "convo.cops.weapons.billy-club" npc "convo.weapons.epi" icon "weapon.bat.icon"  }
				grants [ { #type add-resource id weapon-billy-club qty 1 at crew } { #type consume-tickets count 2 } { #type add-rel-buff with owner id "relbuff-cop-weapon-drop" } ]
				next { goto cop-toplevel }
			}
			{
				reqs [ { #type check-relationship-tickets is atleast value 1 } { #type check-player-has-too-many resource weapon-switchblade is lessthan value 2 } ]
				text { key "convo.cops.weapons.switchblade" npc "convo.weapons.epi" icon "weapon.knife.icon" }
				grants [ { #type add-resource id weapon-switchblade qty 1 at crew } { #type consume-tickets count 2 } { #type add-rel-buff with owner id "relbuff-cop-weapon-drop" } ]
				next { goto cop-toplevel }
			}
			{
				reqs [ { #type check-relationship-tickets is atleast value 1 } { #type check-player-has-too-many resource weapon-colt is lessthan value 2 } { #type check-player-crew-size is atleast value 2 } ]
				text { key "convo.cops.weapons.colt" npc "convo.weapons.epi" icon "weapon.colt.icon" }
				grants [ { #type add-resource id weapon-colt qty 1 at crew } { #type consume-tickets count 2 } { #type add-rel-buff with owner id "relbuff-cop-weapon-drop" } ]
				next { goto cop-toplevel }
			}
			{
				reqs [ { #type check-relationship-tickets is atleast value 2 } { #type check-player-has-too-many resource weapon-pistol is lessthan value 2 } { #type check-player-crew-size is atleast value 2 } ]
				text { key "convo.cops.weapons.pistol" npc "convo.weapons.epi" icon "weapon.pistol.icon" }
				grants [ { #type add-resource id weapon-pistol qty 1 at crew } { #type consume-tickets count 2 } { #type add-rel-buff with owner id "relbuff-cop-weapon-drop" } ]
				next { goto cop-toplevel }
			}
			{
				reqs [  { #type check-relationship-tickets is atleast value 3 } { #type check-player-has-too-many resource weapon-winchester is lessthan value 2 } { #type check-player-crew-size is atleast value 3 } ]
				text { key "convo.cops.weapons.winchester" npc "convo.weapons.epi" icon "weapon.winchester.icon" }
				grants [ { #type add-resource id weapon-winchester qty 1 at crew } { #type consume-tickets count 3 } { #type add-rel-buff with owner id "relbuff-cop-weapon-drop" } ]
				next { goto cop-toplevel }
			}
			{
				reqs [  { #type check-relationship-tickets is atleast value 4 } { #type check-player-has-too-many resource weapon-thompson is lessthan value 1 } { #type check-player-crew-size is atleast value 5 } ]
				text { key "convo.cops.weapons.thompson" npc "convo.weapons.epi" icon "weapon.thompson.icon" }
				grants [ { #type add-resource id weapon-thompson qty 1 at crew } { #type consume-tickets count 4 } { #type add-rel-buff with owner id "relbuff-cop-weapon-drop" } ]
				next { goto cop-toplevel }
			}

		]
	}



	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

	;; federal agents 

	fed-toplevel {
		npcsays [{ lockey "convo.feds.toplevel.blurb" }]
		buttons [ {	text { key "convo.feds.goodbye" icon "convo.icon-leave" }
			onClick	Goodbye
		} ]
	}
}
}