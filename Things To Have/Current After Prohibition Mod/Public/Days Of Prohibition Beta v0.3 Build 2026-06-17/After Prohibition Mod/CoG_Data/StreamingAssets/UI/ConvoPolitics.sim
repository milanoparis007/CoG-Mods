{
	convos {

		;; conversations with your crew in order to start a scheme
		politician-toplevel {
			npcsays	[ { #type relationship-based-blurb rootkey "convo.politician.hello-sponsor" reqs [{ #type check-political-rel type sponsored } { #type special-toplevel-start firststate #true }] } 
					  { #type relationship-based-blurb rootkey "convo.politician.hello-opponent" reqs [{ #type check-political-rel type opponent } { #type special-toplevel-start firststate #true }]}
					  { #type relationship-based-blurb rootkey "convo.politician.hello" reqs [ { #type special-toplevel-start firststate #true } ] }
					  { #type relationship-based-blurb rootkey "convo.toplevel-state" }
					  ]


			buttons [
				{	
					visreqs [{ #type check-convo-query id kb-has-expired-quest-with-owner }]

					text 	{ key "convo.expired-quest.button" icon "ui.pipicon.quest" addmo #true }

					onShow  StoreQuestActive
					next 	{ goto show-quest-expired }
				}
				{
					visreqs [ { #type check-political-rel type sponsored }
							  { #type check-election-stage-in-this-ward stage offcycle expected #false }]
					reqs	[ { #type check-election-stage-in-this-ward stage campaign }
							  { #type check-owner-relbuffs has none of [ relbuff-recent-campaign-action ] }]
					text	{ key "convo.politician.campaign-actions"}

					next 	{ goto politician-campaign-actions }
				}
				{
					visreqs [ { #type check-political-rel type sponsored }
							 { #type check-election-stage-in-this-ward stage offcycle expected #false }]
					reqs	[ ]
					
					text	{ key "convo.politician.campaign-donation" }

					next 	{ goto politician-campaign-donation }
				}
				{
					visreqs [ 
						{ #type check-political-rel type sponsored }
						{ #type check-election-stage-in-this-ward stage offcycle }   
					]
					reqs [ { #type check-laws has any of [ transportation-contract ] active #true } ]
					text { key "convo.politician.transportation-contract" }
					next { goto politician-transportation-contract }
				}
				{
					visreqs [ 
						{ #type check-political-rel type sponsored }
						{ #type check-player-territory-size is atleast value 12 }
						{ #type check-election-stage-in-this-ward stage offcycle }  
					]
					reqs [ { #type check-laws has any of [ abandoned-property-seizure ] active #true } { #type check-owner-relbuffs has none of [ relbuff-abandoned-property ] } ]
					text { key "convo.politician.abandoned-property-seizure" }
					next { goto politician-abandoned-property }
				}
				{
					visreqs [
						{ #type check-political-rel type sponsored }
						{ #type check-election-stage-in-this-ward stage offcycle } 
					]
					reqs [
						{ #type check-laws has any of [ police-commission-appointment ] active #true }
					]
					text { key "convo.politician.police-commission" }
					next { goto police-commission-appointment }
				}
				{
					text	{ key "convo.crew.nevermind-politician" icon "convo.icon-leave" }

					onClick Goodbye
				}
			]
		}

		politician-campaign-actions {
			npcsays [ { lockey "convo.politician.campaign-actions.npc" } ]

			dynamicButtons CustomCampaignActionButtons
			dynamicTemplate {
				text { key "convo.aaaaaaa"} ;; determined at runtime

				next { goto politician-campaign-action-confirm }
			}

			buttons [
				{
					text	{ key "convo.crew.nevermind-politician" icon "convo.icon-leave" }

					next	{ goto politician-toplevel }
				}
			]
		}

		politician-campaign-action-confirm {
			npcsays [ { lockey "convo.politician.campaign-actions.npc-confirm"} ]

			buttons [
				{
					text	{ key "convo.politician.campaign-actions.confirm" 
							  npc	   "convo.politician.campaign-actions.npc-confirm.epilogue"}

					onClick	DoPerformCampaignAction
				}
				{
					text	{ key "convo.crew.nevermind-politician" icon "convo.icon-leave" }

					onClick Goodbye
				}
			]
		}

		politician-campaign-donation {
			npcsays	[ { lockey "convo.politician.campaign-donation.npc" }]

			buttons [
				{
					reqs [ { #type check-has-cash-in-vehicle amount 1000 }]
					visreqs [ { #type check-laws has any of [ dirty-money-crackdown ] active #false } ]

					text	{ key "convo.politician.campaign-donation.thousand" }

					grants	[ { #type grant-donation-to-politician amount 1000 }]
					next	{ goto donation-thank-you }
				}
				{
					reqs [ { #type check-has-cash-in-vehicle amount 1500 }]
					visreqs [ { #type check-laws has any of [ dirty-money-crackdown ] active #true } ]

					text	{ key "convo.politician.campaign-donation.1500" }

					grants	[ { #type grant-donation-to-politician amount 1500 }]
					next	{ goto donation-thank-you }
				}
				{
					reqs [ { #type check-has-cash-in-vehicle amount 2000 }]
					visreqs [ {  #type check-laws has any of [ dirty-money-crackdown ] active #false } ]

					text	{ key "convo.politician.campaign-donation.two-thousand" }

					grants	[ { #type grant-donation-to-politician amount 2000 }]
					next	{ goto donation-thank-you }
				}
				{
					reqs [ { #type check-has-cash-in-vehicle amount 3000 }]
					visreqs [ {  #type check-laws has any of [ dirty-money-crackdown ] active #true } ]

					text	{ key "convo.politician.campaign-donation.three-thousand" }

					grants	[ { #type grant-donation-to-politician amount 3000 }]
					next	{ goto donation-thank-you }
				}
				{
					reqs [ { #type check-has-cash-in-vehicle amount 5000 }]
					visreqs [  { #type check-laws has any of [ dirty-money-crackdown ] active #false } ]

					text	{ key "convo.politician.campaign-donation.five-thousand" }

					grants	[ { #type grant-donation-to-politician amount 5000 }]
					next	{ goto donation-thank-you }
				}
				{
					reqs [ { #type check-has-cash-in-vehicle amount 7500 }]
					visreqs [  { #type check-laws has any of [ dirty-money-crackdown ] active #true } ]

					text	{ key "convo.politician.campaign-donation.7500" }

					grants	[ { #type grant-donation-to-politician amount 7500 }]
					next	{ goto donation-thank-you }
				}
				{
					reqs [ { #type check-has-cash-in-vehicle amount 10000 }]
					visreqs [ { #type check-laws has any of [ dirty-money-crackdown ] active #false } ]

					text	{ key "convo.politician.campaign-donation.ten-thousand" }

					grants	[ { #type grant-donation-to-politician amount 10000 }]
					next	{ goto donation-thank-you }
				}
				{
					reqs [ { #type check-has-cash-in-vehicle amount 15000 }]
					visreqs [ { #type check-laws has any of [ dirty-money-crackdown ] active #true } ]

					text	{ key "convo.politician.campaign-donation.fifteen" }

					grants	[ { #type grant-donation-to-politician amount 15000 }]
					next	{ goto donation-thank-you }
				}
				{
					reqs [ { #type check-has-cash-in-vehicle amount 15000 } ]
					visreqs [ { #type check-owner-relbuffs has none of [ relbuff-politics-loot1-table-on-finish ] } { #type check-player-has-too-many resource kidnaptarget2 is lessthan value 2 } { #type check-current-turn is moreorequalto value 100 } ]

					text	{ icon "convo.gangs.robbery.icon" key "convo.politician.politicalaction-kidnapping" }

					grants	[ { #type add-rel-buff with player id "relbuff-politics-loot1-table-on-finish" }
						  { #type grant-donation-to-politician amount 15000 } { #type add-resource id kidnaptarget2 qty 1 at safehouse }]
					next	{ goto donation-thank-you }
				}
				{
					text	{ key "convo.crew.nevermind-politician" icon "convo.icon-leave" }

					next	{ goto politician-toplevel }
				}
			]
		}
		donation-thank-you {
			npcsays [ { lockey "convo.donation-thank-you-npc" } ]
			buttons [
				{
					text { key "convo.donation-thank-you-other-biz" }
					next { goto politician-toplevel }
				}
				{
					text	{ key "convo.crew.nevermind-politician" icon "convo.icon-leave" }

					onClick Goodbye
				}
			]
		}

		politician-abandoned-property {
			npcsays [ { lockey "convo.politician-abandoned-property.npc" } ]

			buttons [
				{
					text { key "convo.politician-abandoned-property-yes" }
					grants [
						{ #type grant-building }
						{ #type add-rel-buff with owner id relbuff-abandoned-property }
					]
					next	{ goto politician-toplevel }
				}
				{
					text { key "convo.politician-abandoned-property-no" }
					next	{ goto politician-toplevel }
				}
			]
		}
		police-commission-appointment {
			npcsays [ 
				{ lockey "convo.politician-police-commission-not-paid.npc" reqs [ { #type check-biz-in-paid-off-precinct expected #false } ] }
				{ lockey "convo.politician-police-commission-paid.npc" reqs [ { #type check-biz-in-paid-off-precinct expected #true } ] } 
			]
			buttons [
				{
					text { key "convo.politician-police-commission-not-paid" }
					visreqs [
						{ #type check-biz-in-paid-off-precinct expected #false }
					]
					grants [
						{ #type grant-cops-paid-off-in-precinct }
					]
					next	{ goto politician-cop-paid }
				}
				{
					text { key "convo.politician-police-commission-paid" }
					visreqs [
						{ #type check-biz-in-paid-off-precinct expected #true }
					]
					next	{ goto politician-toplevel }
				}
			]
		}
		politician-cop-paid {
			npcsays [ { lockey "convo.politician-cop-paid.npc" } ]
			buttons [
				{
					text { key "convo.politician-cop-paid" }
					next	{ goto politician-toplevel }
				}
			]
		}

		show-quest-expired {
			npcsays [{ #type expired-blurb }
					 { lockey "convo.delivery-quest-done-npc" }] ;; this may be overridden from previous step

			dynamicButtons CustomExpirationButtons ;; get the buttons from the quest def's expiration info
			dynamicTemplate {
				text 	{ key "convo.expired-quest.template" dis "convo.expired-quest.template" }
				onClick ExecuteExpirationFinish
				next 	{ goto show-quest-expired-post }
			}
		}

		show-quest-expired-post {
			npcsays [{ lockey "convo.goodbye-npc" }] ;; note: should be overridden in last step
			buttons []
		}


		politician-transportation-contract {
			npcsays [ 
				{ lockey "convo.politician-transportation-contract-yes.npc" reqs [ { #type check-owner-relbuffs has none of [ relbuff-transportation-contract ] } ] } 
				{ lockey "convo.politician-transportation-contract-no.npc" reqs [ { #type check-owner-relbuffs has any of [ relbuff-transportation-contract ] } ] } 
			]

			buttons [
				{
					visreqs [ 
						{ #type check-player-skills has none of [ fake-wine sparkling-cider fake-beer bathtub-ginworks ] } 
						{ #type check-player-produced-total resource brick-wine is lessthan value 1 }
						{ #type check-owner-relbuffs has none of [ relbuff-transportation-contract ] }
					]
					text { key "convo.politician-transportation-contract-homemade-goods" }
					grants [ { #type add-resource id brick-wine qty 180 at safehouse } { #type add-rel-buff with owner id "relbuff-transportation-contract" } ]
				}
				{
					visreqs [ 
						{ #type check-player-skills has none of [ fake-wine sparkling-cider fake-beer bathtub-ginworks ] } 
						{ #type check-player-produced-total resource cider is lessthan value 1 }
						{ #type check-owner-relbuffs has none of [ relbuff-transportation-contract ] }
					]
					text { key "convo.politician-transportation-contract-homemade-goods" }
					grants [ { #type add-resource id cider qty 160 at safehouse } { #type add-rel-buff with owner id "relbuff-transportation-contract" } ]
				}
				{
					visreqs [ 
						{ #type check-player-skills has none of [ fake-wine sparkling-cider fake-beer bathtub-ginworks ] } 
						{ #type check-player-produced-total resource home-brew is lessthan value 1 }
						{ #type check-owner-relbuffs has none of [ relbuff-transportation-contract ] }
					]
					text { key "convo.politician-transportation-contract-homemade-goods" }
					grants [ { #type add-resource id home-brew qty 200 at safehouse } { #type add-rel-buff with owner id "relbuff-transportation-contract" } ]
				}
				{
					visreqs [ 
						{ #type check-player-skills has none of [ fake-wine sparkling-cider fake-beer bathtub-ginworks ] } 
						{ #type check-player-produced-total resource moonshine is lessthan value 1 }
						{ #type check-owner-relbuffs has none of [ relbuff-transportation-contract ] }
					]
					text { key "convo.politician-transportation-contract-homemade-goods" }
					grants [ { #type add-resource id moonshine qty 120 at safehouse } { #type add-rel-buff with owner id "relbuff-transportation-contract" } ]
				}
				{
					visreqs [ 
						{ #type check-player-skills has none of [ fake-wine sparkling-cider fake-beer bathtub-ginworks fruit-brandy ] } 
						{ #type check-player-produced-total resource apple-jack is lessthan value 1 }
						{ #type check-owner-relbuffs has none of [ relbuff-transportation-contract ] }
						{ #type check-current-city is any of [ pittsburgh ] }
					]
					text { key "convo.politician-transportation-contract-homemade-goods" }
					grants [ { #type add-resource id apple-jack qty 160 at safehouse } { #type add-rel-buff with owner id "relbuff-transportation-contract" } ]
				}
				{
					visreqs [ 
						{ #type check-player-skills has none of [ fake-wine sparkling-cider fake-beer bathtub-ginworks ] } 
						{ #type check-player-produced-total resource fruit-wine is lessthan value 1 }
						{ #type check-owner-relbuffs has none of [ relbuff-transportation-contract ] }
						{ #type check-current-city is any of [ detroit ] }
					]
					text { key "convo.politician-transportation-contract-homemade-goods" }
					grants [ { #type add-resource id fruit-wine qty 160 at safehouse } { #type add-rel-buff with owner id "relbuff-transportation-contract" } ]
				}
				{
					visreqs [ 
						{ #type check-player-skills has none of [ fake-wine sparkling-cider fake-beer bathtub-ginworks ] } 
						{ #type check-player-produced-total resource homemade-brandy is lessthan value 1 }
						{ #type check-owner-relbuffs has none of [ relbuff-transportation-contract ] }
						{ #type check-current-city is any of [ philadelphia ] }
					]
					text { key "convo.politician-transportation-contract-homemade-goods" }
					grants [ { #type add-resource id homemade-brandy qty 160 at safehouse } { #type add-rel-buff with owner id "relbuff-transportation-contract" } ]
				}
				{
					visreqs [ 
						{ #type check-player-skills has any of [ fake-wine sparkling-cider fake-beer bathtub-ginworks ] } 
						{ #type check-player-skills has none of [ booze-bottling ] } 
						{ #type check-player-produced-total resource fake-wine is lessthan value 1 }
						{ #type check-owner-relbuffs has none of [ relbuff-transportation-contract ] }
					]
					text { key "convo.politician-transportation-contract-level-two" }
					grants [ { #type add-resource id fake-wine qty 160 at safehouse } { #type add-rel-buff with owner id "relbuff-transportation-contract" } ]
				}
				{
					visreqs [ 
						{ #type check-player-skills has any of [ fake-wine sparkling-cider fake-beer bathtub-ginworks ] } 
						{ #type check-player-produced-total resource sparkling-cider is lessthan value 1 }
						{ #type check-player-skills has none of [ booze-bottling ] } 
						{ #type check-owner-relbuffs has none of [ relbuff-transportation-contract ] }
					]
					text { key "convo.politician-transportation-contract-level-two" }
					grants [ { #type add-resource id sparkling-cider qty 160 at safehouse } { #type add-rel-buff with owner id "relbuff-transportation-contract" } ]
				}
				{
					visreqs [ 
						{ #type check-player-skills has any of [ fake-wine sparkling-cider fake-beer bathtub-ginworks ] } 
						{ #type check-player-produced-total resource fake-beer is lessthan value 1 }
						{ #type check-owner-relbuffs has none of [ relbuff-transportation-contract ] }
						{ #type check-player-skills has none of [ booze-bottling ] } 
					]
					text { key "convo.politician-transportation-contract-level-two" }
					grants [ { #type add-resource id fake-beer qty 160 at safehouse } { #type add-rel-buff with owner id "relbuff-transportation-contract" } ]
				}
				{
					visreqs [ 
						{ #type check-player-skills has any of [ fake-wine sparkling-cider fake-beer bathtub-ginworks ] } 
						{ #type check-player-produced-total resource bathtub-gin is lessthan value 1 }
						{ #type check-owner-relbuffs has none of [ relbuff-transportation-contract ] }
						{ #type check-player-skills has none of [ booze-bottling ] } 
					]
					text { key "convo.politician-transportation-contract-level-two" }
					grants [ { #type add-resource id bathtub-gin qty 160 at safehouse } { #type add-rel-buff with owner id "relbuff-transportation-contract" } ]
				}
				{
					visreqs [ 
						{ #type check-player-skills has any of [ fake-wine sparkling-cider fake-beer bathtub-ginworks fruit-brandy ] } 
						{ #type check-player-produced-total resource fruit-brandy is lessthan value 1 }
						{ #type check-owner-relbuffs has none of [ relbuff-transportation-contract ] }
						{ #type check-current-city is any of [ pittsburgh ] }
						{ #type check-player-skills has none of [ booze-bottling ] } 
					]
					text { key "convo.politician-transportation-contract-level-two" }
					grants [ { #type add-resource id fruit-brandy qty 160 at safehouse } { #type add-rel-buff with owner id "relbuff-transportation-contract" } ]
				}
				{
					visreqs [ 
						{ #type check-player-skills has any of [ fake-wine sparkling-cider fake-beer bathtub-ginworks corn-whiskey ] } 
						{ #type check-player-produced-total resource corn-whiskey is lessthan value 1 }
						{ #type check-owner-relbuffs has none of [ relbuff-transportation-contract ] }
						{ #type check-current-city is any of [ cincinnati ] }
						{ #type check-player-skills has none of [ booze-bottling ] } 
					]
					text { key "convo.politician-transportation-contract-level-two" }
					grants [ { #type add-resource id corn-whiskey qty 160 at safehouse } { #type add-rel-buff with owner id "relbuff-transportation-contract" } ]
				}
				{
					visreqs [ 
						{ #type check-player-skills has any of [ booze-bottling ] } 
						{ #type check-owner-relbuffs has none of [ relbuff-transportation-contract ] }
						{ #type check-player-unlocked-resources has all of [ whiskey-barrel ] }
					]
					text { key "convo.politician-transportation-contract-barrels.whiskey" }
					grants [ { #type add-resource id whiskey-barrel qty 3 at safehouse } { #type add-rel-buff with owner id "relbuff-transportation-contract" } ]
				}
				{
					visreqs [ 
						{ #type check-player-skills has any of [ booze-bottling ] } 
						{ #type check-owner-relbuffs has none of [ relbuff-transportation-contract ] }
						{ #type check-player-unlocked-resources has all of [ vodka-barrel ] }
					]
					text { key "convo.politician-transportation-contract-barrels.vodka" }
					grants [ { #type add-resource id vodka-barrel qty 3 at safehouse } { #type add-rel-buff with owner id "relbuff-transportation-contract" } ]
				}
				{
					visreqs [ 
						{ #type check-player-skills has any of [ booze-bottling ] } 
						{ #type check-owner-relbuffs has none of [ relbuff-transportation-contract ] }
						{ #type check-player-unlocked-resources has all of [ rum-barrel ] }
					]
					text { key "convo.politician-transportation-contract-barrels.rum" }
					grants [ { #type add-resource id rum-barrel qty 3 at safehouse } { #type add-rel-buff with owner id "relbuff-transportation-contract" } ]
				}
				{
					visreqs [ 
						{ #type check-player-skills has any of [ booze-bottling ] } 
						{ #type check-owner-relbuffs has none of [ relbuff-transportation-contract ] }
						{ #type check-player-unlocked-resources has all of [ brandy-barrel ] }
					]
					text { key "convo.politician-transportation-contract-barrels.brandy" }
					grants [ { #type add-resource id brandy-barrel qty 3 at safehouse } { #type add-rel-buff with owner id "relbuff-transportation-contract" } ]
				}
				{
					visreqs [ { #type check-owner-relbuffs has any of [ relbuff-transportation-contract ] } ]
					text { key "convo.politician-transportation-contract.notyet" }
				}
			]
		}
	}
}