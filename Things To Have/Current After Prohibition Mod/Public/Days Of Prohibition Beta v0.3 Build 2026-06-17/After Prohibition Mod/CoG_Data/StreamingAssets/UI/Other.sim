moduleIntros [ ;; these are in order, last one is fallback
	{
		tags [ tag-biz-cider ]
		locs {
			unknownConsumes "convo.moduleintro.cider.unknown-consumes"
			unknownProduces "convo.moduleintro.cider.unknown-produces"
			knownConsumes "convo.moduleintro.cider.known-consumes"
			knownProduces "convo.moduleintro.no-illegal"
		}
	}
	{
		tags [ tag-biz-brick-wine ]
		locs {
			unknownConsumes "convo.moduleintro.brick-wine.unknown-consumes"
			unknownProduces "convo.moduleintro.brick-wine.unknown-produces"
			knownConsumes "convo.moduleintro.brick-wine.known-consumes"
			knownProduces "convo.moduleintro.no-illegal"
		}
	}
	{
		tags [ tag-biz-home-brew ]
		locs {
			unknownConsumes "convo.moduleintro.home-brew.unknown-consumes"
			unknownProduces "convo.moduleintro.home-brew.unknown-produces"
			knownConsumes "convo.moduleintro.home-brew.known-consumes"
			knownProduces "convo.moduleintro.no-illegal"
		}
	}
	{
		tags [ tag-biz-moonshine ]
