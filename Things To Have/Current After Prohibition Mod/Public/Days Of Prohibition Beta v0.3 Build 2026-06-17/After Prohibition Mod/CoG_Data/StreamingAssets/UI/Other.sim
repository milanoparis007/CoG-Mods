	;; corner queries

	kb-corner-territory-owned {
		type 	corner-fn
		testfn	territory-update 

		resetevents [ player-territory-changed ]
		icon 	"ui.pipicon.territory"
		;; no locdesc, this could be anyone's territory
	}
	kb-corner-territory-expanded {
