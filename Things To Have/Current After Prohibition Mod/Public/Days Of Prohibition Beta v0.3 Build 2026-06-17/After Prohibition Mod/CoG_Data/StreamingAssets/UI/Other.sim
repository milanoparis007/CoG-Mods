	kb-casino-out-of-cash {
		type building-fn
		testfn	casino-out-of-cash

		resetevents	[ casino-money-change ]

		icon	"ui.pipicon.casino-needs-money"
		locdesc	"ui.pip.kb-casino-needs-money"
	}
	kb-canada-related {
		type building-fn
		testfn	canada-related

		resetevents	[ quest-started-immediate quest-progress-immediate quest-completed-immediate quest-canceled-immediate 
					  quest-request-declined player-territory-changed player-got-intro-immediate ]

		icon	"ui.pipicon.canada-related"
