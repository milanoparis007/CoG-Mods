		testfn	delivery-update

		resetevents [ building-delivery-happened ]

		icon	"ui.pipicon.delivery-failed"
		locdesc "ui.pip.kb-delivery-failed"
	}

	kb-controlled-empty-slot {
		type 	building-fn
		testfn	controlled-update

		resetevents [ building-module-installed ]

		icon 	"ui.pipicon.biz-expand"
		locdesc "ui.pip.kb-controlled-empty-slot"
	}

	kb-controlled-upgrade-available {
		type 	building-fn
		testfn	controlled-update

		resetevents [ building-module-installed ]

		icon 	"ui.pipicon.biz-upgrade"
		locdesc "ui.pip.kb-controlled-upgrade-available"
