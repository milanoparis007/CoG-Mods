	kb-resevent-ready-this-turn {
		type 	building-fn
		testfn	resevent-update

		resetevents [ building-res-event-happened ]

		icon	"ui.pipicon.resevent"
		locdesc	"ui.pip.kb-has-resevent-this-turn"
	}

	kb-biz-recent-trade-ai {
		type 	building-fn
		testfn	biz-recent-trade-ai

		resetevents [ building-trade-history-cleared ]

		icon 	"ui.pipicon.biz-recent-trade-ai"
		locdesc	"ui.pip.kb-biz-recent-trade-ai"
	}

	kb-biz-recent-trade-human {
		type 	building-fn
		testfn	biz-recent-trade-human

		resetevents [ building-trade-history-cleared ]

		icon 	"ui.pipicon.biz-recent-trade-human"
