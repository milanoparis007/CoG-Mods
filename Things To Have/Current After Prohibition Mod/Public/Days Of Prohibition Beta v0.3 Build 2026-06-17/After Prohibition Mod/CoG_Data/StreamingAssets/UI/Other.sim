newspaperDefaults {
	subheadsGeneral [ newspaper-general ]
	subheadsDated [ newspaper-dated-general ]
	subheadsSequences [ newspaper-seq-general-elephant ]
	;; these need to be filled in by city map defs
	;subheadsCityGeneral
	;subheadsCityDated
	;subheadsCitySequences
}

playerQueries {

	;; convo queries with owner
	;; only convo queries can have reqs and visreqs

	kb-has-active-quest-with-owner {
		type	convo-query
		visreqs [{ #type check-active-delivery-quest with owner type manual }]
		
		resetevents [ quest-started-immediate quest-progress-immediate quest-completed-immediate quest-canceled-immediate
					  player-skills-changed-immediate player-used-social-ticket ]

		icon	"ui.pipicon.quest"
		locdesc "ui.pip.kb-has-active-quest-with-owner"
	}

	kb-civic-buidling {
		type	convo-query
		visreqs	[ { #type check-module-in-convo has any of [
				civic-passenger-station civic-freight-station
			] } ]

			icon 	"ui.pipicon.civic-building"
			locdesc "ui.pip.kb-civic-buidling"
	}
	
	kb-has-expired-quest-with-owner {
		type	convo-query
		visreqs [{ #type check-expired-quest-with-owner }]
		
		resetevents [ quest-started-immediate quest-progress-immediate quest-completed-immediate quest-canceled-immediate 
					  player-skills-changed-immediate player-used-social-ticket some-entity-tickets-changed ]

		icon	"ui.pipicon.quest-ready"
		locdesc "ui.pip.kb-has-expired-quest-with-owner"
	}

	kb-can-hire-new-crew {
		type	convo-query
		visreqs [{ #type check-relationship-tickets is atleast value 1 }
				 { #type check-connections-and-cap-for-crew-intro }
				 { #type check-relationship-for-crew-intro }]
		
		resetevents [ player-used-social-ticket some-entity-tickets-changed quest-completed-immediate ]

		icon	"ui.pipicon.social-crew"
		locdesc "ui.pip.kb-can-hire-new-crew"
	}

	kb-can-learn-new-skills {
		type	convo-query
		visreqs [{ #type check-relationship-tickets is atleast value 1 }
				 { #type check-can-learn-new-skills }]
		
		resetevents [ quest-started-immediate quest-progress-immediate quest-completed-immediate 
					  quest-marked-waiting-immediate quest-canceled-immediate quest-request-declined
					  player-skills-changed-immediate player-used-social-ticket player-territory-changed
					  some-entity-relationship-changed some-entity-tickets-changed ]
		
		icon	"ui.pipicon.social-skill"
		locdesc "ui.pip.kb-can-learn-new-skills"
	}

	kb-can-intro-for-business {
		type 	convo-query
		visreqs [{ #type check-relationship-tickets is atleast value 1 }
				 { #type check-can-intro-for-business }]

		resetevents [ player-used-social-ticket quest-completed-immediate some-entity-tickets-changed some-entity-relationship-changed ]

		icon	"ui.pipicon.social-bizintro"
		locdesc "ui.pip.kb-can-intro-for-business"
	}

	kb-cash-boost {
		type	convo-query
		visreqs [
			{ #type check-relationship-tickets is atleast value 2 }
			{ #type check-player-cash type highwater is lessthan value 1100 }
			{ #type check-module-in-player-territory has none of [
				production-homebooze-brick-wine production-homebooze-cider production-homebooze-home-brew production-homebooze-moonshine production-homebooze-apple-jack-a production-homebooze-apple-jack-b
			] scope player-only }
			{ #type check-current-turn is atleast value 20 }
			{ #type check-did-buy-sell-anything expected #true }
		]

		resetevents [ player-used-social-ticket some-entity-tickets-changed ]

		icon	"ui.pipicon.cash-boost"
		locdesc "ui.pip.kb-cash-boost"
	}

	kb-can-boost-for-goon {
		type 	convo-query
		visreqs [{ #type check-relationship-tickets is atleast value 1 }
				 { #type check-player-territory-size is atleast value 1 }
				 { #type check-can-boost-for-goon }]

		resetevents [ player-used-social-ticket some-entity-tickets-changed ]

		icon	"ui.pipicon.social-goon-intro"
		locdesc "ui.pip.kb-can-boost-for-goon"
	}

	kb-can-take-over-business {
		type	convo-query
		visreqs	[{ #type check-relationship-tickets is atleast value 1 }
				 { #type check-is-convo-at-corner-with-controlled-building expected #false }
				 { #type special-biz-purchase-pip test HighWatermark }
				 { #type check-potential-biz-building }
				 { #type check-potential-biz-family }
				 { #type check-rel-flag id "building-takeover" is notset lockey "req.check-rel-flag.building-takeover" }
				 { #type check-quests has none of 
				 	[ outpost-building-takeover family-building-takeover ethnic-building-takeover deliveries-active-one-beta neighborhood-opportunity-med-six ] 
				 	status active with owner }
				 ]

		resetevents [ player-used-social-ticket some-entity-tickets-changed player-building-takeover-immediate player-rel-flags-changed-immediate
				quest-started-immediate quest-progress-immediate quest-completed-immediate quest-canceled-immediate ]
	
		icon	"ui.pipicon.social-expansion"
		locdesc "ui.pip.kb-can-take-over-business"
	}


	;; building queries called from code

	kb-qreq-should-start { ;; quest request start
		type 	building-fn
		testfn 	qreq-start

		resetevents [ quest-started-immediate quest-progress-immediate quest-completed-immediate quest-canceled-immediate 
					  quest-request-declined player-territory-changed player-got-intro-immediate ]

		icon	"ui.pipicon.quest-available"
		locdesc "ui.pip.kb-qreq-should-start"
	}

	kb-qreq-should-finish { ;; quest request finish
		type 	building-fn
		testfn	qreq-finish		

		resetevents [ quest-started-immediate quest-progress-immediate quest-completed-immediate quest-canceled-immediate ]

		icon	"ui.pipicon.quest-ready"
		locdesc "ui.pip.kb-qreq-should-finish"
	}

	kb-front-belongs-to-human {
		type 	building-fn
		testfn	front-data-update

		resetevents [ player-outposts-all-updated player-outpost-changed ]

		;; no icon, we'll use one of the ones below
		locdesc "ui.pip.kb-front-belongs-to-human"
	}

	kb-front-belongs-to-ai {
		type 	building-fn
		testfn	front-data-update

		resetevents [ player-outposts-all-updated player-outpost-changed ]

		icon 	"ui.pipicon.front-ai"
		locdesc "ui.pip.kb-front-belongs-to-ai"
	}

	kb-front-active {
		type 	building-fn
		testfn	front-data-update

		resetevents [ player-outposts-all-updated player-outpost-changed ]

		icon 	"ui.pipicon.front-active"
		locdesc "ui.pip.kb-front-active"
	}

	kb-front-expanding {
		type 	building-fn
		testfn	front-data-update

		resetevents [ player-outposts-all-updated player-outpost-changed ]

		icon 	"ui.pipicon.front-expanding"
		locdesc "ui.pip.kb-front-expanding"
	}

	kb-front-can-expand {
		type 	building-fn
		testfn	front-data-update

		resetevents [ player-outposts-all-updated player-outpost-changed player-tribute-changed]

		icon 	"ui.pipicon.front-can-expand"
		locdesc "ui.pip.kb-front-can-expand"
	}

	kb-front-needs-support {
		type 	building-fn
		testfn	front-data-update

		resetevents [ player-outposts-all-updated player-outpost-changed player-tribute-changed ]

		icon 	"ui.pipicon.front-needs"
		locdesc "ui.pip.kb-front-needs-support"
	}

	kb-front-needs-support-urgent {
		type 	building-fn
		testfn	front-data-update

		resetevents [ player-outposts-all-updated player-outpost-changed player-tribute-changed ]

		icon 	"ui.pipicon.front-needs-urgent"
		locdesc "ui.pip.kb-front-needs-support-urgent"
	}

	kb-front-ready-to-collect {
		type 	building-fn
		testfn	front-data-update

		resetevents [ player-outposts-all-updated player-outpost-changed player-tribute-changed ]

		icon 	"ui.pipicon.front-ready"
		locdesc "ui.pip.kb-front-ready-to-collect"
	}

	kb-extorted-biz {
		type 	building-fn
		testfn	front-data-update

		resetevents [ player-outpost-changed player-tribute-changed ]

		icon 	"ui.pipicon.front-extortion"
		locdesc "ui.pip.kb-extorted-biz"
	}

	kb-production-stalled {
		type 	building-fn
		testfn	production-stalled

		resetevents [ building-module-result-changed ]

		icon	"ui.pipicon.biz-stalled"
		locdesc "ui.pip.kb-production-stalled"
	}

	kb-building-damaged {
		type 	building-fn
		testfn	building-damaged

		resetevents [ building-health-changed ]

		icon	"ui.pipicon.damaged"
		locdesc "ui.pip.kb-damaged"
	}
	
	kb-cop-paidoff {
		type 	building-fn
		testfn	cop-paidoff

		icon	"ui.pipicon.cop-paidoff"
		locdesc "ui.pip.cop-paidoff"
	}
	
	kb-heal-prompt {
		type 	building-fn
		testfn	heal-prompt
		
		resetevents [ crew-health-changed ]

		icon	"ui.pipicon.heal-prompt"
		locdesc "ui.pip.heal-prompt"
	}

	kb-delivery-success {
		type 	building-fn
		testfn	delivery-update

		resetevents [ building-delivery-happened ]

		icon	"ui.pipicon.delivery"
		locdesc "ui.pip.kb-delivery-success"
	}

	kb-delivery-insufficient {
		type 	building-fn
		testfn	delivery-update

		resetevents [ building-delivery-happened ]

		icon	"ui.pipicon.delivery-incomplete"
		locdesc "ui.pip.kb-delivery-insufficient"
	}

	kb-delivery-failed {
