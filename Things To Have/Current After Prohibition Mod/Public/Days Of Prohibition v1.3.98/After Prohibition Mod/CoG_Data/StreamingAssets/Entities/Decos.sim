	{ 	
		ident {
			template lot-deco-base 
			parent deco-base 
			tags [ building ]
		}
		building { type unknown }
		board {	
			discoverable #true
			lotsize { width 1 height 3 } 
		}
		selection { }
		model {
			paletterow 0
			paletterowunknown 2
			loadtype building
			indirectInstancing #true

			slots 		 { core [ ] facade [ ] decofront [ ] decoback [ ] }
			unknownslots { core [ ] facade [ ] decofront [ ] decoback [ ] }
			unknownslots {
				core 		[ { model "Buildings/Unknown/Bldg_UndiscoveredS1_Core_A" }	]
				facade 		[ { model "Buildings/Unknown/Bldg_UndiscoveredS1_Front_A" } ]
				decoback 	[ { model "Buildings/Unknown/Bldg_UndiscoveredS1_Back_A" } ]
				decofront	[ ]
			}

			prefabs 	[ ]
			unknowns 	[ ]
		}
	}


	{
		ident { template lotdeco-sl-abandoned-res parent lot-deco-base }
		model {
			slots 		 { 
				core [ 
						{ model "Decos/Deco_SL_AbandonedResd_A" } 
						{ model "Buildings/Lots/LotDeco_DerelictResdSmall_B" }
					] 
				}
		}
	}
	{
		ident { template lotdeco-sl-abandoned-other parent lot-deco-base }
		model {
			slots 		 { 
				core [ { model "Decos/Deco_SL_AbandonedOther_A" } ] 
			}

		}
	}
	{
		ident { template lotdeco-sl-clutter parent lot-deco-base }
		model {
			slots 		 { 
				core [ 
					{ model "Decos/Deco_SL_Clutter_A" } 
					{ model "Buildings/Lots/LotDeco_VacantSmall_B" }
				] 
			}
		}
	}
	{
		ident { template lotdeco-sl-construction parent lot-deco-base }
		model {
			slots 		 { 
				core [ 
					{ model "Buildings/Lots/LotDeco_ConstructionSmall_Core_A" }
					{ model "Buildings/Lots/LotDeco_ConstructionSmall_Core_B" }
					{ model "Buildings/Lots/LotDeco_ConstructionSmall_Core_C" }
				] 
				decofront [
					{ model "Buildings/Lots/LotDeco_ConstructionSmall_Props_A" }
					{ model "Buildings/Lots/LotDeco_ConstructionSmall_Props_B" }
					{ model "Buildings/Lots/LotDeco_ConstructionSmall_Props_C" }
				]
			}
		}
	}
	{
		ident { template lotdeco-sl-park-a parent lot-deco-base }
		model {
			slots 		 { core [ { model "Decos/Deco_SL_Park_A" } ] }
			unknownslots { 
				core [ { model "Decos/Deco_SL_Park_A" } ]  facade [] decoback [] decofront []
			}
		}
	}
	{
		ident { template lotdeco-sl-park-b parent lot-deco-base }
		model {
			slots 		 { core [ { model "Decos/Deco_SL_Park_B" } ] }
			unknownslots { 
				core [ { model "Decos/Deco_SL_Park_B" } ]  facade [] decoback [] decofront []
			}
		}
	}
	;; double lot decos
	{
		ident { template lotdeco-double-base parent lot-deco-base }
		board {
			lotsize { width 2 height 3 }
		}
		model {
			unknownslots {
				core [
					{ model "Buildings/Unknown/Bldg_UndiscoveredM1_Core_A" }
					{ model "Buildings/Unknown/Bldg_UndiscoveredM1_Core_B" }
				]
				facade [
					{ model "Buildings/Unknown/Bldg_UndiscoveredM1_Front_A" }
					{ model "Buildings/Unknown/Bldg_UndiscoveredM1_Front_B" }
				]
				decofront [
				]
				decoback [
					{ model "Buildings/Unknown/Bldg_UndiscoveredM1_Back_A" }
					{ model "Buildings/Unknown/Bldg_UndiscoveredM1_Back_B" }
				]
			}
		}
	}

	{
		ident { template lotdeco-ml-park-a parent lotdeco-double-base }
		board {	
			lotsize { width 2 height 3 } 
		}
		model {
			slots 		 { core [ { model "Decos/Deco_ML_Park_A" } ] }
			unknownslots { 
				core [ { model "Decos/Deco_ML_Park_A" } ] facade [] decoback [] decofront []
			}
		}
	}
	{
		ident { template parking-lot parent lotdeco-double-base }
		model {
			slots {
				core [
					{ model "Buildings/Lots/LotDeco_ParkingLotMedium_Core_A" }
					{ model "Buildings/Lots/LotDeco_ParkingLotMedium_Core_B" }
				]
				decofront [
					{ model "Buildings/Lots/LotDeco_ParkingLotMedium_Props_A" }
					{ model "Buildings/Lots/LotDeco_ParkingLotMedium_Props_A" }
				]
			}
		}
	}
	{
		ident { template cemetery-small	parent lot-deco-base }
		model {
			slots {
				core [
					{ model "Buildings/Lots/LotDeco_CemeterySmall_A" }
				]
			}
		}
	}
	{
		ident { template cemetery-medium parent lotdeco-double-base }
		model {
			slots {
				core [
					{ model "Buildings/Lots/LotDeco_CemeteryMedium_Core_A" }
					{ model "Buildings/Lots/LotDeco_CemeteryMedium_Core_B" }
				]
				decofront [
					{ model "Buildings/Lots/LotDeco_CemeteryMedium_Props_A" }
					{ model "Buildings/Lots/LotDeco_CemeteryMedium_Props_B" }
				]
			}
		}
	}

] }
