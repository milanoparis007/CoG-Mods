{ entities [

	{ 	
		ident { template deco-base }
		board {	
			lotsize { width 0 height 0 } 

			;; only use this for decos that get "revealed" as the player drives around:
			;; discoverable #true
		}
		model { 
			loadtype deco
			indirectInstancing #true
			seasonal #false
			unknowns [ "Decos/a_single_tri" ]
		}
	}

	; ---------------------
	; Decos: Trees, Residential, Ind/Comm Areas
	; ---------------------

	{ 	ident { template road-rail-deco-base parent deco-base } 
		model { paletterow 1 paletterowunknown 1 }
