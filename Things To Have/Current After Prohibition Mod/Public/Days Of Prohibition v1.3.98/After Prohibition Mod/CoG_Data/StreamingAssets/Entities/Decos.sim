	; ----------------------
	; Residential Area Props
	; ----------------------

	{
		ident { template deco-tree-base parent deco-base }
		model {
			seasonal #true
			paletterow 1
			paletterowunknown 1
			hillsokay #true

			autoplace { ground none appeal any zone any } ;; not near buildings or trains
		}
	}

	{
		ident { template deco-tree-XXL parent deco-tree-base }
		board {	lotsize { width 4 height 4 } }
		model {
			prefabs [
				"Decos/Deco_XXL_Trees_A"
			]

			autoplace { appeal high zone res }
		}
	}

	{
		ident { template deco-tree-L parent deco-tree-base }
		board {	lotsize { width 2 height 2 } }
