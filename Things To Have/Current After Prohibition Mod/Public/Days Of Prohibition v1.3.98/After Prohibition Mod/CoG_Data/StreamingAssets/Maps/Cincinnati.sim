			{
				id Downtown
				forceStart { x 156 y 47 }
				nodeSpacing { width 8 height 10 }
				forceAngle -10
				forceMaxSize 200
				forceMaxSpread { width 50 height 100 }
				relativeSpeed 2
				stopAtWater #true
			}
			{
				id PriceHill
