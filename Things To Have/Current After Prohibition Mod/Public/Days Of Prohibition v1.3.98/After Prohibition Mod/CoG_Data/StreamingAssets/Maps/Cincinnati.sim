				forceAngle 15
				forceMaxSize 75
				forceMaxSpread { width 50 height 50 }
				relativeSpeed 3
			}
			{
				id CollegeHill
				forceStart { x 71 y 330 }
				nodeSpacing { width 8 height 10 }
				forceAngle 15
				forceMaxSize 75
				forceMaxSpread { width 25 height 75 }
				relativeSpeed 2
			}
			{
				id EastEnd
				forceStart { x 343 y 321 }
				nodeSpacing { width 8 height 10 }
				forceAngle 0
				forceMaxSize 40
				forceMaxSpread { width 20 height 20 }
				relativeSpeed 2
			}
			{
				id Kentucky
				forceStart { x 276 y 75 }
				nodeSpacing { width 8 height 10 }
				forceAngle 0
				forceMaxSize 90
				forceMaxSpread { width 20 height 20 }
				relativeSpeed 5
				allowAsIsland #true
				forceBridges #true
			}

		]
		rails [
			{
				id mainline
				nodes [
					{ x 117 y 76 }
					{ x 109 y 160 }
					{ x 113 y 299 }
					{ x 105 y 374 }
				]
			}
			{
				id mainline2
				nodes [
					{ x 76 y 74 }
					{ x 40 y 50 }
					{ x 17 y 50 }
				]
			}
			
			{
				id randomRailEast
				random true
				randomRect { x 262 y 162 width 25 height 35 } 
			}
			{
				id randomRailNorthEast
				random true
				randomRect { x 345 y 262 width 25 height 35 } 
			}			
		]
		districts [
			{
				tags [ downtown bizcenter ]
				locname	"districts.downtown" ;; optional to display on the map
				start { x 152 y 52 } radius 30
			}
			{
				tags [ kentucky ]
				locname	"districts.kentucky"
				start { x 276 y 60 } radius 50
			}
			{
				tags [ pricehill indcenter ]
				locname	"districts.pricehill"
				start { x 37 y 65 } radius 30
			}
			{
				tags [ northside bizcenter ]
				locname	"districts.northside"
				start { x 102 y 313 } radius 25
			}
			{
				tags [ hydepark bizcenter ]
				locname	"districts.hydepark"
				start { x 318 y 196 } radius 25
			}
			{
				tags [ walnuthills indcenter ]
				locname "districts.walnuthills"
				start { x 283 y 147 } radius 40
			}
		]
	}
