{ maps [ {
	id cincinnati
	citytype cincinnati

	;; cityname "Cincinnati"  		;; let's use loc instead
	;; statename "Ohio"

	citylockey	"city-name.cincinnati"
	statelockey	"state-name.ohio"
	citydesckey	"city-desc.cincinnati"
	cityscreen	"Cincinnati Screenshot"
	citylocicon	"city-icon.cincinnati"
	citypolunitkey	"city-pol-unit.ward"

	map {
		mapSize		{ width 400 height 400 }
		streetNames [ 
			"streets.usfounders" "streets.famouspeople" "streets.usstates" "streets.uscities"
			"streets.smalltown" "streets.trees" "streets.plants" "streets.birds" 
			"streets.lastnames" "streets.generic" ]
