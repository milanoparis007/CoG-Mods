{ maps [ { 
	id new-york
	citytype new-york

	;; cityname "Chicago"  		;; let's use loc instead
	;; statename "Illinois"
	;; citydesc	"Story..."

	citylockey	"city-name.new-york"
	statelockey	"state-name.new-york"
	citydesckey	"city-desc.new-york"
	cityscreen	"New York Screenshot"
	citylocicon	"city-icon.new-york"
	citypolunitkey	"city-pol-unit.ward"

	map {
		;; logical map specification
		mapSize        { width 600 height 500 } ;; size in world units
		;; heatmapSpacing { width 8 height 8 }  ;; should be similar or larger than smallest block size
		;; beadSpacing { width 1 height 1 }     ;; should be default (1, 1) unless there's a good reason :)

		streetNames [ 
			"streets.usfounders" "streets.famouspeople" "streets.usstates" "streets.uscities"
			"streets.smalltown" "streets.trees" "streets.plants" "streets.birds" "streets.chicago" 
			"streets.lastnames" "streets.generic" ]

		nodes [
			{
				id Manhattan
				nodeSpacing { width 8 height 8 }
				forceStart { x 126 y 258 }
				forceAngle 30
				relativeSpeed 1
				forceMaxSpread { width 28 height 30 }
				allowAsIsland #true
				initialNames [ "streets.trees" ]
			}
			{
				id LowerManhattan
				nodeSpacing { width 6 height 8 }
				forceStart { x 66 y 90 }
				forceAngle 35
				relativeSpeed 1
				forceMaxSpread { width 45 height 15 }
				forceBridges #true
			}
			{
				id Harlem
				nodeSpacing { width 8 height 8 }
				forceStart { x 216 y 410 }
				forceAngle 32
				relativeSpeed 1
				forceMaxSpread { width 20 height 15 }
				initialNames [ "streets.birds" ]
			}
			{
				id Bronx
				nodeSpacing { width 8 height 10 }
				forceAngle -10
				forceStart { x 360 y 462 }
				relativeSpeed 1
				forceMaxSpread { width 20 height 20 }
				initialNames [ "streets.usstates" ]
			}
			{
				id SouthBronx
				nodeSpacing { width 10 height 8 }
				forceAngle 10
				forceStart { x 289 y 467 }
				relativeSpeed 1
				forceMaxSpread { width 15 height 15 }
				initialNames [ "streets.usstates" ]
			}
			{
				id AstoriaQueens
				nodeSpacing { width 10 height 6 }
				forceStart { x 276 y 266 }
				forceAngle 32
				relativeSpeed 1
				forceMaxSpread { width 20 height 20 }
				initialNames [ "streets.uscities" ]
			}
			{
				id Flushing
				nodeSpacing { width 8 height 6 }
				forceStart { x 540 y 250 }
				forceAngle -5
				relativeSpeed 1
				forceMaxSpread { width 15 height 15 }
				initialNames [ "streets.plants" ]
			}
			{
				id Queens
				nodeSpacing { width 6 height 8 }
				forceAngle { x 560 y 136 }
				forceAngle 5
				relativeSpeed 1
				forceMaxSpread { width 25 height 25 }
				initialNames [ "streets.generic" ]
			}
			{
				id CoronaQueens
				nodeSpacing { width 8 height 6 }
				forceStart { x 440 y 191 }
				forceAngle 10
				relativeSpeed 1
				forceMaxSpread { width 20 height 20 }
