	generator {
		totalInflux 300000
	
		lots [
			{ mindensity 0.4 		lot "empty-lot-42" probfail 0.2 }
			{ mindensity 0.00001	lot "empty-lot-22" probfail 0.2 }
			{ mindensity 0.0 		lot "empty-lot-12" }
		]

		decoNodes {
			maxdensity	1
			maxappeal	1
			centers		40
			spread 		{ default 2 lowappeal 7 }
			lotpercent  { default 100 lowappeal 75 }
		}

		specialBuildings {
			policeStation	{ configs [ "police-station" ] }
			trainStation    { configs [ "passenger-station" "cargo-station" ] }
			civicsAndOthers [

				; these are everywhere

				{ configs [ "worship-regular" "school-regular" ] 
					skipEvery { from 340 to 720 } }

				{ configs [ "fire-station-small" ] 
					skipEvery { from 800 to 900 } }

				{ configs [ "school-large" ] 
					skipEvery { from 600 to 800 } }
                { configs [ "com-medium-philly-bank" ]
                    skipEvery { from 900 to 1300 }
                    maxPerDistrict 1 }

				{ configs [ "civic-government-medium" "civic-hospital-medium" "civic-post-office-medium" ] 
					skipEvery { from 800 to 900 } }

				; everywhere but uncommon

				{ configs [ "fire-station-large" ] 
					skipEvery { from 1000 to 2000 } }

				{ configs [ "worship-large" ] 
					skipEvery { from 1200 to 2000 } }

				;; extremely uncommon oustide of downtown

				{ configs [ "downtown-medium-commercial" "downtown-large-commercial" "downtown-large-commercial-new-york" ]
					skipEvery { from 10000 to 20000 } }
				{ configs [ "ind-union-hall" "importm-regular" "industrial-zone-large" "industrial-zone-medium" ]
					skipEvery { from 20000 to 40000 } }

				; big ones stand out too much to be sprinkled around
				;{ configs [ "civic-government-large" "civic-hospital-large" "civic-post-office-large" "school-large" ] 
				;	skipEvery { from 500 to 600 } }

				; higher distribution in specific districts

				
                { configs [ "com-large-downtown-bank" ]
                    districtTags [ downtown ]
                    skipEvery { from 160 to 260 }
                    maxPerDistrict 1 }
                { configs [ "com-large-downtown-bank" ]
                    districtTags [ bizcenter ]
                    skipEvery { from 220 to 360 }
                    maxPerDistrict 1 }
				{ configs [ "worship-large" "civic-government-large" "civic-post-office-large" ] 
					districtTags [ downtown ]
					skipEvery { from 10 to 20 } }
				{ configs [ "downtown-medium-commercial" ]
					districtTags [ downtown ]
					skipEvery { from 900 to 1500 } }
				{ configs [ "downtown-medium-commercial" ]
					districtTags [ bizcenter ]
					skipEvery { from 900 to 1800 } }
				{ configs [ "downtown-large-commercial" "downtown-large-commercial-new-york" ]
					districtTags [ downtown ]
					skipEvery { from 80 to 140 } }
				{ configs [ "downtown-large-commercial" "downtown-large-commercial-new-york" ]
					districtTags [ bizcenter ]
					skipEvery { from 10 to 20 }
					maxPerDistrict 1 }

				{ configs [ "worship-large"
							"civic-government-large" "civic-hospital-large" "civic-post-office-large" "school-large" ] 
					districtTags [ bizcenter ]
					skipEvery { from 4 to 8 } }
				{ configs [ "ind-union-hall" "importm-regular" ]
					districtTags [ indcenter ]
					skipEvery { from 100 to 150 }
					maxPerDistrict 5
				}
				{ configs [ "industrial-zone-medium" ]
					districtTags [ indcenter ]
					skipEvery { from 5600 to 6400 }
				}
				{ configs [ "industrial-zone-large" ]
					districtTags [ indcenter ]
					skipEvery { from 10000 to 12000 }
					maxPerDistrict 4
				}
			]
		}
    	nodeCenterScore 1.0 
    	otherCenterScore 0.3
    	otherCenterCount 3	

    	lowAppealThreshold 0.3
    	midAppealThreshold 0.7
	}

	playerStart {
    	nodesKnownAtStart 14
    	nodesFriendlyAtStart 5
    	mapEdgePlacementMargin 40
    	mapEdgePlacementPenalty 0.1
    	starterPack	NewYorkStarterPack

    	resourcesUnlocked [
    		;; mundane resources
    		apple-juice grape-juice crocks malt rye corn-syrup
    		barrels half-barrels steel-barrels bottles small-bottles

    		;; materials
    		bricks lumber

    		;; flavor resources
    		gasoline

    		;; initial illegal resources
    		neutral-alcohol moonshine cider home-brew brick-wine dirty-cash counterfeitcash cook cfood rfood rfoodsupplies lockpicks liquor-license cigarettes french75 cloverclub bloodsand boulevardier negroni french75mix cloverclubmix bloodsandmix boulevardiermix negronimix

    		;; weapons
    		weapon-crowbar weapon-bat weapon-knife

    	]
	}

	moveinScores {
		resSameEthnicityBoost 10

		emptyLotBase { from 0 to 1 }

		resInitialSeeds 5
		resResidentialAreaBoost 1
		resCommercialAreaBoost 0
		resIndustrialAreaBoost -4
		resRailOrTerminalBoost -4
		
		indInitialSeeds 50
		indResidentialAreaBoost -1
		indCommercialAreaBoost 1
		indIndustrialAreaBoost 1
		indRailOrTerminalBoost 0.5

		comInitialSeeds 50
		comResidentialAreaBoost 1
		comCommercialAreaBoost 0.8
		comIndustrialAreaBoost 0
		comRailOrTerminalBoost 0

		interestingNodeProbabilities {
			;; this means: 10% of nodes prefer to have 3 businesses, etc
			;; they should add up to 1.0 but if they don't it's okay
			3  0.1
			2  0.2
			1  0.4
			0  0.3
		}

		;; means that 90% of nodes are allowed to have a potential
		;; business if the interesting count is below total count
		potentialNodeProbability 0.9
	}

	familyGenerator {
		initialFamiliesRatio 0.75 ; initial fams compared to real businesses
		kidsCount [ 0 0 1 2 2 3 3 3 4 4 4 5 5 6 6 7 7 8 8 9 9 10 ]
		marriageRatio 0.9
		marriageAgeRange { from 18 to 30 }

		childMortalityRatio 0.05
        childMortalityAgeRange { from 0 to 2 }
        adultMortalityAgeRange { from 50 to 80 }

		traitsPerPerson { from 1 to 3 }
		probTraitInherited 0.8
		probTraitOther 0.2

		friendsAge { from 16 to 19 }
		friendsCount { from 2 to 5 }
	}

	seasons {
		seasonBlendASRWidth 15
		resGroundColor { r 164 g 193 b 94 a 255 }
		;comGroundColor { r 139 g 173 b 55 a 255 }
		comGroundColor { r 164 g 193 b 94 a 255 }
		indGroundColor { r 132 g 126 b 111 a 255 }

		data [
		{	season spring
			dateRange { from 60 to 165 }
			
			foliageHueShift { from 0 to 0 }
			foliageSaturationShift -0.1
			groundHueShift -0.04
			groundSaturationShift -0.1

			sunColor { r 255 g 253 b 249 a 255 }
			sunIntensity 1.2
			ambientColor { r 179 g 184 b 209 a 255 }
			ambientIntensity 0.1
			fogColor { r 190 g 157 b 96 a 255 }
			fogIntensity 0.003

			weather { type rain hoursOfDay { from 21 to 24 } prob 0.3 }
		} 
		{	season summer
			dateRange { from 145 to 265 }

			foliageHueShift { from 0 to 0.1 }
			foliageSaturationShift 0
			groundHueShift -0.02
			groundSaturationShift -0.1
			
			sunColor { r 255 g 247 b 230 a 255 }
			sunIntensity 1.2
			ambientColor { r 209 g 209 b 209 a 255 }
			ambientIntensity 0.1
			fogColor { r 190 g 157 b 96 a 255 }
			fogIntensity 0.005

			weather { type dust hoursOfDay { from 17 to 20 } prob 0.8 }
		}
		{	season fall
			dateRange { from 250 to 355 }

			foliageHueShift { from -0.14 to -0.04 }
			foliageSaturationShift 0.1
			groundHueShift -0.1
			groundSaturationShift -0.2
			
			sunColor { r 255 g 244 b 220 a 255 }
			sunIntensity 1.2
			ambientColor { r 204 g 170 b 155 a 255 }
			ambientIntensity 0.1
			fogColor { r 212 g 164 b 47 a 255 }
			fogIntensity 0.005

			weather { type rain hoursOfDay { from 21 to 24 } prob 0.3 }
		}
		{	season winter
			dateRange { from 340 to 75 }

			foliageHueShift { from -0.14 to -0.04 } ;; keep fall colors
			foliageSaturationShift 0.0
			groundHueShift -0.1
			groundSaturationShift -0.7
			
			sunColor { r 221 g 221 b 235 a 255 }
			sunIntensity 0.9
			ambientColor { r 128 g 144 b 196 a 255 }
			ambientIntensity 0
			fogColor { r 190 g 157 b 96 a 255 }
			fogIntensity 0.007

			weather { type snow hoursOfDay { from 6 to 21 } prob 0.5 }
		}
		]
	}

	ethnicMakeup { 
		nationalities {
			am 34
			ru 10
			af 7
			la 2
			as 2
			it 10
			ir 10
			de 5
			pl 5
			at 4
			en 2
			fr 2
			ro 2
			se 2
			ca 1
			cz 1
			gr 1
			nl 1
			no 1
			sc 1
		}
		skin {
			am { names [ light ] proportions [ 100 ] }
			fr { names [ light dark ] proportions [ 95 5 ] }
			it { names [ light medium ] proportions [ 80 20 ] }
			af { names [ dark ] proportions [ 100 ] }
			la { names [ medium ] proportions [ 100 ] }
			as { names [ light medium ] proportions [ 80 20 ] }
			others { names [ light ] proportions [ 100 ] }
		}
	}

	groups [
		{ type AgentPlayer count 16 }
		{ type CopPlayer count 15 }
		{ type GangPlayer count 16 }
 		{ type GoonPlayer count 10 }
	]

	newspaperExtras {
		;; these are loc strings unique to this city
		subheadsCityGeneral [ newspaper-chicago ]
		subheadsCityDated [ newspaper-dated-chicago ]
		subheadsCitySequences [ newspaper-seq-chicago-barrel newspaper-seq-chicago-whiskey ]
	}

} ] }
