						grants [
							{ #type add-resource id weapon-pistol qty 2 at safehouse }
							{ #type add-resource id grape-juice qty 30 at safehouse }
						]
					}
					{
						visreqs [
							{ #type check-current-month is any of [ 1 2 3 4 ] }
							{ #type check-current-turn is moreorequalto value 58 }
						]
						locdesc "resultquest.smuggling-booze.c4"
						grants [
							{ #type add-resource id weapon-pistol qty 2 at safehouse }
							{ #type add-resource id neutral-alcohol qty 20 at safehouse }
