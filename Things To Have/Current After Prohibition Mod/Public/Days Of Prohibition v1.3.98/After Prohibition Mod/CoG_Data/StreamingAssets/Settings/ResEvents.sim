		{
			#type res-event-result-quest
			id smuggling-cider-low
			visreqs [
				{ #type check-player-produced-total resource cider is moreorequalto value 1 }
				{ #type check-player-skills has none of [ improved-homebooze-cider ] }
			]
			locroot "resresults.smuggling-quest"
			loceventresult "resresults.smuggling-homemade-booze.eventresult"

			grants [
				{ #type consume-actions for convo }
			]

			quest {
				id resultquest-cider-low
				locname "resultquest.cider-smuggling.name"
				locdesc "resultquest.cider-smuggling.desc"
				locicon "quest.generic.icon"

				goals [
