						]
						locdesc "resultquest.smuggling-booze.c5"
						grants [
							{ #type add-resource id weapon-pistol qty 2 at safehouse }
							{ #type add-resource id malt qty 50 at safehouse }
						]
					}
					{
						visreqs [
							{ #type check-current-month is any of [ 2 4 6 8 10 12 ] }
							{ #type check-current-turn is moreorequalto value 58 }
						]
						locdesc "resultquest.smuggling-booze.c6"
						grants [
							{ #type add-resource id weapon-pistol qty 2 at safehouse }
						]
					}
					{
						visreqs [
							{ #type check-current-month is any of [ 1 3 5 7 9 11 ] }
							{ #type check-current-turn is moreorequalto value 58 }
						]
						locdesc "resultquest.smuggling-booze.c7"
						grants [
							{ #type add-resource id weapon-pistol qty 2 at safehouse }
						]
					}
					{
						visreqs [
							{ #type check-current-turn is moreorequalto value 58 }
							{ #type check-current-month is any of [ 2 4 6 8 10 12 ] }
						]
						locdesc "resultquest.smuggling-booze.c8"
						grants [
							{ #type add-resource id weapon-pistol qty 2 at safehouse }
						]
					}
					{
						visreqs [
							{ #type check-current-turn is moreorequalto value 58 }
							{ #type check-current-month is any of [ 1 3 5 7 9 11 ] }
						]
						locdesc "resultquest.smuggling-booze.c9"
						grants [
							{ #type add-resource id weapon-pistol qty 2 at safehouse }
						]
					}
				]
				afterchoice "resultquest.smuggling-booze.afterchoice"

				expiration {
					expiresAfterDayz 105
					locblurb "convo.expired-smuggling-booze.finish.blurb"
					locdesc "convo.expired-smuggling-booze.finish.button"
					locepilogue "convo.expired-smuggling-booze.post.blurb"
					
					refundPercent { value 50 }
					grants [
						{ #type add-rel-buff with owner id "relbuff-resevent-quest-expired" }
					]
				}
			}
		}
