{
	people {


	residentialEvents {

		resSearchNearbyCorners 8

		events [
		{ 
			id 			dinner-party	
			visreqs 	[
				{ #type check-is-convo-at-controlled-building expected #false }
				{ #type check-player-territory-size is atleast value 8 }
			]
			waitturns	{ value 2 }
			buyincash	{ value -100 mods [ 
					{ #type territory-size-mod pernode -10 skip 1 }
				] }
			probskip	{ value 0.75 }
			locroot		"resevents.dinner-party"
			locicon		"resevents.dinner-party.icon"
			locname		"resevents.dinner-party.name"
			locdesc		"resevents.dinner-party.desc"
			npcintro	"resevents.dinner-party.npc-intro"
			
			tickerinfo	"resevents.dinner-party.tickerinfo"
			tickerstart	"resevents.dinner-party.tickerstart"
			
			results		{ ;; result ids and probabilities; everyone should have intros for fallback
				result-intro 0.01
				result-relbuff-enemy 0.5
				result-relbuff-other 0.05
				result-intro-business 1
				smuggling-brick-wine-low 0.5
				smuggling-brick-wine-high 0.3
				result-homebooze-skills 0.2
				result-visible-gain-one 1
				result-visible-gain-two 1
				result-visible-gain-three 1
				result-visible-gain-four 1
				result-add-fireplace 1
			}
		}
		{ 
			id 			poker-night
			visreqs 	[
				{ #type check-is-convo-at-controlled-building expected #false }
				{ #type check-player-cash type highwater is atleast value 2500 }
			]
			waitturns	{ value 3 }
			buyincash	{ value -400 }
			probskip	{ value 0.75 }
			locroot		"resevents.poker-night"
			locicon		"resevents.poker-night.icon"
			locname		"resevents.poker-night.name"
			locdesc		"resevents.poker-night.desc"
			npcintro	"resevents.poker-night.npc-intro"

			tickerinfo	"resevents.poker-night.tickerinfo"
			tickerstart	"resevents.poker-night.tickerstart"

			results		{ ;; result ids and probabilities; everyone should have intros for fallback
				smuggling-cider-low 0.4
				smuggling-cider-high 0.4
				result-homebooze-skills 0.3
				result-relbuff-enemy 0.2
			;	result-permits 0.5
				result-intro 0.01 
			}
		}
		{
			id			working-lunch
			visreqs		[
				{ #type check-is-convo-at-controlled-building expected #false }
				{ #type check-is-convo-inside-territory player human expected #true }
				{ #type check-player-cash type highwater is atleast value 2000 }
			]
			waitturns	{ value 3 }
			buyincash	{ value -200 }
			probskip	{ value 0.75 }
			locroot		"resevents.working-lunch"
			locicon		"resevents.working-lunch.icon"
			locname		"resevents.working-lunch.name"
			locdesc		"resevents.working-lunch.desc"
			npcintro 	"resevents.working-lunch.npc-intro"

			tickerinfo	"resevents.working-lunch.tickerinfo"
			tickerstart	"resevents.working-lunch.tickerstart"

			results		{
				result-homebooze-skills 0.7
				smuggling-brick-wine-low 0.3
				smuggling-brick-wine-high 0.4
				result-relbuff-enemy 0.4
				smuggling-cider-high 0.5
				result-intro 0.01
			}
		}
		{
			id		bourbon-smuggling
			visreqs [
				{ #type always-false } ;; turn this off pending localisation
				{ #type check-current-city is any of [ cincinnati ] }
				{ #type check-location-district-tags has any of [ pricehill downtown hydepark ] }
				{ #type check-is-convo-at-controlled-building expected #false }
				{ #type check-player-unlocked-resources has any of [ corn-whiskey ] }
				{ #type check-quests has none of [ bourbon-unlock bourbon-smuggling-one bourbon-smuggling-two bourbon-smuggling-kentucky bourbon-supplies bourbon-knowledge-quest ] status active }
				{ #type check-owner-relbuffs has none of [ relbuff-resevent-quest-expired ] }
			]
			waitturns	{ value 6 }
			buyincash	{ value -200 } 
			probskip	{ value 0.25 }
			locroot		"resevents.bourbon-smuggling"
			locicon		"resevents.bourbon-smuggling.icon"
			locname		"resevents.bourbon-smuggling.name"
			locdesc		"resevents.bourbon-smuggling.desc"
			npcintro	"resevents.bourbon-smuggling.npcintro"

			tickerinfo	"resevents.bourbon-smuggling.tickerinfo"
			tickerstart "resevents.bourbon-smuggling.tickerstart"

			results {
				bourbon-unlock 1
				bourbon-smuggling-one 1
				bourbon-smuggling-two 1
				smuggling-cider-low 0.6
				smuggling-cider-high 0.4
				bourbon-supplies 1
			}
		}
		{
			id		bourbon-kentucky
			visreqs [
				{ #type always-false } ;; turn this off pending localisation
				{ #type check-location-district-tags has any of [ kentucky ] }
				{ #type check-current-city is any of [ cincinnati ] }
				{ #type check-is-convo-at-controlled-building expected #false }
				{ #type check-player-unlocked-resources has any of [ corn-whiskey ] }
				{ #type check-quests has none of [ bourbon-unlock bourbon-smuggling-kentucky bourbon-knowledge-quest bourbon-supplies ] status active }
				{ #type check-owner-relbuffs has none of [ relbuff-resevent-quest-expired ] }
			]
			waitturns	{ value 6 }
			buyincash 	{ value -400 }
			probskip	{ value 0.15 }
			locroot 	"resevents.bourbon-kentucky"
			locicon		"resevents.bourbon-kentucky.icon"
			locdesc		"resevents.bourbon-kentucky.desc"
			locname 	"resevents.bourbon-kentucky.name"
			npcintro	"resevents.bourbon-kentucky.npcintro"

			tickerinfo	"resevents.bourbon-smuggling.tickerinfo"
			tickerstart "resevents.bourbon-smuggling.tickerstart"

			results {
				bourbon-unlock 1
				bourbon-smuggling-kentucky 1
				bourbon-knowledge-quest 1
				bourbon-supplies 1
			}
		}
		]

		results [
		{
			#type			res-event-result-intro
			id 				result-intro
			; visreqs			[]  ;; intro is fallback, it should have no visreqs
			locroot			"resresults.intro"
			loceventresult	"resresults.intro.eventresult"

			grants 			[{ #type consume-actions for convo }]
		}
		{
		 	#type			res-event-result-relbuff
		 	id 				result-relbuff-enemy
		 	visreqs			[{ #type check-player-negative-connections is atleast value 1 }]
		 	locroot			"resresults.relbuff-enemy"
		 	loceventresult	"resresults.relbuff-enemy.eventresult"
		 	relbuffenemy	#true
		}
		{
		 	#type			res-event-result-relbuff
		 	id 				result-relbuff-other
		 	visreqs			[{ #type check-player-negative-connections is equalto value 0 }]
		 	locroot			"resresults.relbuff-other"
		 	loceventresult	"resresults.relbuff-other.eventresult"
		 	relbuffenemy	#false
		}
		{
			#type			res-event-result-intro
			id				result-intro-business
			visreqs			[{ #type check-can-intro-for-business }]
			locroot			"resresults.business-intro"
			loceventresult	"resresults.business-intro.eventresult"

			grants 			[ { #type consume-actions for convo } { #type intro-to-useful-friend } ]
		}
		{
			#type			res-event-result-quest
			id				result-visible-gain-one
			visreqs 		[ 
				{ #type check-player-unlocked-resources has none of [ sparkling-cider ] } 
				{ #type check-module-in-player-territory has any of [ production-homebooze-cider production-homebooze-cider-improved production-homebooze-cider-improved-upgrade ] scope player-only }
			]

			locroot			"resresults.visible-gain"
			loceventresult	"resresults.visible-gain.eventresult"

			grants [ { #type consume-actions for convo } { #type unlock-resource id sparkling-cider } ]
		}
		{
			#type			res-event-result-quest
			id				result-visible-gain-two
			visreqs 		[ 
				{ #type check-player-unlocked-resources has none of [ fake-wine ] } 
				{ #type check-module-in-player-territory has any of [ production-homebooze-brick-wine production-homebooze-brick-wine-improved production-homebooze-brick-wine-improved-upgrade ] scope player-only }
			]

			locroot			"resresults.visible-gain"
			loceventresult	"resresults.visible-gain.eventresult"

			grants [ { #type consume-actions for convo } { #type unlock-resource id fake-wine } ]
		}
		{
			#type			res-event-result-quest
			id				result-visible-gain-three
			visreqs 		[ 
				{ #type check-player-unlocked-resources has none of [ fake-beer ] } 
				{ #type check-module-in-player-territory has any of [ production-homebooze-home-brew production-homebooze-home-brew-improved production-homebooze-home-brew-improved-upgrade ] scope player-only }
			]

			locroot			"resresults.visible-gain"
			loceventresult	"resresults.visible-gain.eventresult"

			grants [ { #type consume-actions for convo } { #type unlock-resource id fake-beer } ]
		}
		{
			#type			res-event-result-quest
			id				result-visible-gain-four
			visreqs 		[ 
				{ #type check-player-unlocked-resources has none of [ bathtub-gin ] } 
				{ #type check-module-in-player-territory has any of [ production-homebooze-moonshine production-homebooze-moonshine-improved production-homebooze-moonshine-improved-upgrade ] scope player-only }
			]

			locroot			"resresults.visible-gain"
			loceventresult	"resresults.visible-gain.eventresult"

			grants [ { #type consume-actions for convo } { #type unlock-resource id bathtub-gin } ]
		}

;; POKER GAMES - Smuggling opps

		{ ;; get a dump of a type of homemade booze that you don't make
			#type			res-event-result-quest
			id				result-quest-homebooze-one
			visreqs			[
				{ #type check-player-produced-total resource fake-wine is lessthan value 1 }
				{ #type check-player-produced-total resource fake-beer is lessthan value 1 }
				{ #type check-player-produced-total resource sparkling-cider is lessthan value 1 }
				{ #type check-player-produced-total resource bathtub-gin is lessthan value 1 }
			]
			locroot			"resresults.quest-homebooze"
			loceventresult	"resresults.quest-homebooze.eventresult"

			grants			[{ #type consume-actions for convo }]

			quest			{
				id result-quest-homebooze
				locname		"resultquest.quest-homebooze.name"
				locdesc		"resultquest.quest-homebooze.desc"
				locicon		"quest.generic.icon"

				goals		[
					{ #type goal-deliver-cash test atleast goal 750 }
				]

				beforechoice "resultquest.quest-homebooze.beforechoice"
				choices [
					{
						locdesc "resultquest.quest-homebooze.c1"
						grants [ { #type add-resource id brick-wine qty 135 at safehouse } ]
					}
					{
						locdesc "resultquest.quest-homebooze.c2"
						grants [ { #type add-resource id cider qty 125 at safehouse } ]
					}
					{
						locdesc "resultquest.quest-homebooze.c3"
						grants [ { #type add-resource id home-brew qty 175 at safehouse } ]
					}
					{
						locdesc "resultquest.quest-homebooze.c4"
						grants [ { #type add-resource id moonshine qty 75 at safehouse } ]
					}
					{
						visreqs [
							{ #type check-current-city is any of [ pittsburgh ] }
						]
						locdesc "resultquest.quest-homebooze.c5"
						grants [ { #type add-resource id apple-jack qty 120 } ]
					}
					{
						visreqs [
							{ #type check-current-city is any of [ detroit ] }
						]
						locdesc "resultquest.quest-homebooze.c6"
						grants [ { #type add-resource id fruit-wine qty 135 at safehouse } ]
					}
				]
				afterchoice "quest.quest-homebooze.afterchoice"
				expiration {
                    expiresAfterDayz 70
                    locblurb  "convo.expired-homebooze-quest.finish.blurb"
                    locdesc     "convo.expired-homebooze-quest.finish.button"
                    locepilogue "convo.expired-homebooze-quest.finish.post.blurb"

                    refundPercent 	{ value 20 }
                    grants [
                        { #type add-rel-buff with owner id "relbuff-resevent-quest-expired" }
                    ]
                }
			}
		}
		{ ;; get some useful documents
			#type res-event-result-quest
			id result-permits
			visreqs [
				{ #type check-current-turn is atleast value 20 }
			]
			locroot "resresults.permits"
			loceventresult "resresults.permits.eventresult"

			grants [
				{ #type consume-actions for convo }
			]

			quest 	{
				id result-quest-permits
				locname "resultquest.quest-permits.name"
				locdesc "resultquest.quest-permits.desc"
				locicon "quest.generic.icon"

				goals [
					{ #type goal-deliver-cash test atleast goal 100 }
				]

				beforechoice "resultquest.quest-permits.beforechoice"
				choices [
					{
						locdesc "resultquest.quest-permits.c1"
						grants [
							{ #type add-resource id permits qty 1 at safehouse }
						]
					}
				]
				afterchoice "resultquest.quest-permits.afterchoice"
				expiration {
					expiresAfterDayz 35
					locblurb "convo.expired-poker-night.finish.blurb"
					locdesc "convo.expired-poker-night.finish.button"
					locepilogue "convo.expired-poker-night.post.blurb"

					refundPercent { value 1 }
					grants [
                        { #type add-rel-buff with owner id "relbuff-resevent-quest-expired" }
                    ]
				}
			}
		}
		{
			#type res-event-result-quest
			id smuggling-brick-wine-low
			visreqs []
